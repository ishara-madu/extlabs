# Local Development Environment Variables for Cloudflare Workers/Pages
# Copy this file to .dev.vars and fill in your GitHub OAuth App credentials

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
SUPER_ADMIN_GITHUB_USERNAME=ishara-madu
GEMINI_API_KEYS=key1,key2,key3

# Cloudflare R2 Object Storage (Images & Media)
# Configured via wrangler.jsonc (binding: "R2", bucket_name: "extlabs-images")

# Google OAuth Configuration (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Cloudflare Global Edge Cache Purge (Automated instant edge invalidation)
# CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
