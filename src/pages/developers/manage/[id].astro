---
// src/pages/developers/manage/[id].astro
import "../../../styles/global.css";
import DeveloperNavbar from "../../../components/DeveloperNavbar.astro";
import Footer from "../../../components/Footer.astro";
import { 
  ArrowLeft, 
  ExternalLink, 
  Star, 
  Box, 
  Eye,
  TrendingUp,
  Globe,
  Laptop,
  Pencil,
  Copy,
  ArrowRight,
  FolderGit2,
  BarChart3,
  Mail,
  X,
  AlertTriangle,
  EyeOff,
  Trash2,
  Clock,
  Send,
  Bell
} from '@lucide/astro';
import { 
  getDb, 
  getDeveloperByUserIdOrSlug, 
  getDeveloperExtensionDetail,
  getExtensionRegionalAnalytics,
  getExtensionRatingBreakdown,
  getLatestExtensionNotification,
  getActiveLifecycleRequestsForExtension,
  type ManageExtensionDetail,
  type ExtensionRegionalTelemetry,
  type DbNotification,
  type LifecycleRequest
} from "../../../lib/db";
import { getSessionUser } from "../../../lib/auth";

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/developers/dashboard', 302);
}

// 1. Database Connection & Authentication
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

if (!user) {
  return Astro.redirect(`/developers/login?auth_required=true&redirect=${encodeURIComponent(`/developers/manage/${id}`)}`, 302);
}

let developer = null;
let dbExtension: ManageExtensionDetail | null = null;
let dbRegionalTelemetry: ExtensionRegionalTelemetry[] = [];
let dbRatingBreakdown = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
let latestNotification: DbNotification | null = null;
let pendingLifecycleRequests: LifecycleRequest[] = [];

if (db) {
  try {
    if (user) {
      developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
    }
    const isStaffAdmin = Boolean(user && ['super_admin', 'moderator', 'security_auditor'].includes(user.role));
    dbExtension = await getDeveloperExtensionDetail(db, id, isStaffAdmin ? undefined : developer?.id);
    dbRegionalTelemetry = await getExtensionRegionalAnalytics(db, id);
    if (dbExtension) {
      dbRatingBreakdown = await getExtensionRatingBreakdown(db, dbExtension.id);
      latestNotification = await getLatestExtensionNotification(db, dbExtension.id);
      pendingLifecycleRequests = await getActiveLifecycleRequestsForExtension(db, dbExtension.id);
    }
  } catch (err) {
    console.error("Database error fetching extension detail & telemetry:", err);
  }
}

const pendingUnpublishReq = pendingLifecycleRequests.find(r => r.request_type === 'unpublish');
const pendingDeleteReq = pendingLifecycleRequests.find(r => r.request_type === 'delete');

if (!dbExtension) {
  return Astro.redirect('/developers/dashboard', 302);
}

// Normalize extension detail
const rawDownloadCount = typeof (dbExtension as any).download_count === 'number'
  ? (dbExtension as any).download_count
  : (typeof (dbExtension as any).downloads_count === 'number' ? (dbExtension as any).downloads_count : 0);

const rawReviewCount = typeof (dbExtension as any).review_count === 'number'
  ? (dbExtension as any).review_count
  : (typeof (dbExtension as any).reviews_count === 'number' ? (dbExtension as any).reviews_count : 0);

const rawRating = rawReviewCount > 0 && typeof dbExtension.rating === 'number'
  ? dbExtension.rating
  : 0;

// 1. Normalize Status & Update Status (100% aligned with Dashboard & Admin review queue)
const isPending = dbExtension.status === 'pending_review' || dbExtension.review_status === 'pending';
const isRejected = dbExtension.status === 'rejected' || dbExtension.review_status === 'rejected';
const isDraft = dbExtension.status === 'draft';
const hasPendingDraft = Boolean(dbExtension.has_pending_draft || dbExtension.draft_data);

let appStatus: 'Production' | 'In Review' | 'Rejected' | 'Draft' = 'Production';
let updateStatus = 'Live on Directory';

if (isRejected) {
  appStatus = 'Rejected';
  updateStatus = 'Review rejected';
} else if (isPending) {
  appStatus = 'In Review';
  updateStatus = 'Pending admin review';
} else if (isDraft) {
  appStatus = 'Draft';
  updateStatus = 'Draft (not published)';
} else if (hasPendingDraft) {
  appStatus = 'Production';
  updateStatus = 'Draft edits pending';
} else {
  appStatus = 'Production';
  updateStatus = 'Live on Directory';
}

// 2. Normalize Slug, Package ID, Dates, and Categories
const slug = dbExtension.slug || id;
const packageId = `io.extlabs.${slug.replace(/[-_]/g, '')}`;

let lastUpdated = 'Recently';
if (dbExtension.updated_at) {
  try {
    const d = new Date(dbExtension.updated_at);
    lastUpdated = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch {}
}

const categoryLabels: Record<string, string> = {
  ai: 'AI & Smart Tools',
  dev: 'Developer Tools',
  productivity: 'Productivity',
  privacy: 'Security & Privacy',
  social: 'Social & Communication',
  utilities: 'Utilities',
  media: 'Photos & Media',
  ecommerce: 'Shopping & Finance'
};
const categoryName = categoryLabels[dbExtension.category?.toLowerCase()] || dbExtension.category || 'Utility';

// 3. Verification Badge Label
let verificationLabel = 'Verified Package';
let verificationClass = 'text-slate-500 font-normal';
if (isRejected) {
  verificationLabel = 'Review Rejected';
  verificationClass = 'text-rose-600 font-medium';
} else if (isPending) {
  verificationLabel = 'Under Review';
  verificationClass = 'text-amber-600 font-medium';
} else if (isDraft) {
  verificationLabel = 'Draft Package';
  verificationClass = 'text-slate-400';
}

const ext = {
  id: dbExtension.id || id,
  slug,
  packageId,
  name: dbExtension.name || 'Untitled Extension',
  version: dbExtension.version_name || dbExtension.current_version || '1.0.0',
  downloadCount: rawDownloadCount,
  rating: rawRating,
  reviewCount: rawReviewCount,
  weeklyUsers: typeof dbExtension.weekly_active_users === 'number'
    ? dbExtension.weekly_active_users
    : 0,
  category: dbExtension.category || 'productivity',
  categoryName,
  tagline: dbExtension.tagline || dbExtension.short_description || 'No description available',
  appStatus,
  status: appStatus,
  updateStatus,
  hasPendingDraft,
  verificationLabel,
  verificationClass,
  lastUpdated,
  reviewStatus: dbExtension.review_status || 'approved',
  monetagUrl: dbExtension.monetag_direct_link || '',
  githubRepo: dbExtension.source_repo_url || '',
  iconUrl: dbExtension.icon_url || '/icons/extension-placeholder.avif',
  developerWebsite: dbExtension.developer_website || developer?.website || '',
  supportEmail: dbExtension.support_email || '',
  docsUrl: dbExtension.docs_url || ''
};

const hasTelemetry = ext.downloadCount >= 10;
const hasReviews = ext.reviewCount > 0;

// Dynamic Region Name & Flag Resolvers (Native Intl + Unicode standard)
const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });

function getCountryName(code: string): string {
  if (!code || code === 'GLOBAL') return 'Other Countries';
  try {
    return regionNames.of(code.toUpperCase()) || code;
  } catch {
    return code;
  }
}

function getFlagEmoji(code: string): string {
  if (!code || code === 'GLOBAL') return '🌐';
  try {
    const codePoints = code
      .toUpperCase()
      .split('')
      .map((c) => 127397 + c.charCodeAt(0));
    return String.fromCodePoint(...codePoints);
  } catch {
    return '🌐';
  }
}

// Dynamic Top Download Regions Calculation from Cloudflare D1
interface RegionDisplay {
  country: string;
  code: string;
  flag: string;
  percentage: number;
  installs: string;
  color: string;
}

const colorPalette = [
  "bg-blue-600",
  "bg-indigo-500",
  "bg-slate-700",
  "bg-emerald-600"
];

let topRegions: RegionDisplay[] = [];
let tier1Pct = 0;

if (dbRegionalTelemetry.length > 0) {
  const rawList = dbRegionalTelemetry.map((r) => ({
    code: r.country_code,
    downloads: r.total_downloads
  }));

  const totalDownloads = rawList.reduce((sum, c) => sum + c.downloads, 0) || ext.downloadCount || 1;
  const top4 = rawList.filter((r) => r.code !== 'GLOBAL').slice(0, 4);
  const top4InstallsSum = top4.reduce((sum, c) => sum + c.downloads, 0);
  const otherInstallsCount = Math.max(0, totalDownloads - top4InstallsSum);

  let accumulatedPct = 0;
  topRegions = top4.map((c, index) => {
    const pct = Math.max(1, Math.round((c.downloads / totalDownloads) * 100));
    accumulatedPct += pct;
    return {
      country: getCountryName(c.code),
      code: c.code,
      flag: getFlagEmoji(c.code),
      percentage: pct,
      installs: c.downloads.toLocaleString(),
      color: colorPalette[index] || "bg-blue-500"
    };
  });

  const otherPct = Math.max(0, 100 - accumulatedPct);
  if (otherPct > 0 && otherInstallsCount > 0) {
    topRegions.push({
      country: "Other Countries",
      code: "GLOBAL",
      flag: "🌐",
      percentage: otherPct,
      installs: otherInstallsCount.toLocaleString(),
      color: "bg-slate-400"
    });
  }

  const tier1Codes = new Set(["US", "DE", "GB", "JP", "CA", "AU"]);
  const tier1Installs = rawList
    .filter((c) => tier1Codes.has(c.code))
    .reduce((sum, c) => sum + c.downloads, 0);
  tier1Pct = Math.min(100, Math.round((tier1Installs / totalDownloads) * 100));
}

// Real Ratings Breakdown from Cloudflare D1
const ratingsBreakdown = hasReviews ? ([5, 4, 3, 2, 1] as const).map((stars) => {
  const count = dbRatingBreakdown[stars] || 0;
  const percentage = ext.reviewCount > 0 ? Math.round((count / ext.reviewCount) * 100) : 0;
  return {
    stars,
    percentage,
    count: count.toLocaleString()
  };
}) : [];

// Real Target Browsers
let supportedBrowsers: string[] = ['Chrome', 'Brave', 'Edge', 'Opera'];
try {
  const rawBrowsers = typeof dbExtension.supported_browsers === 'string'
    ? JSON.parse(dbExtension.supported_browsers || '[]')
    : dbExtension.supported_browsers;
  if (Array.isArray(rawBrowsers) && rawBrowsers.length > 0) {
    supportedBrowsers = rawBrowsers.map((b: string) => b.charAt(0).toUpperCase() + b.slice(1));
  }
} catch {}
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Manage {ext.name} — ExtLabs Developer Console</title>
    <meta name="description" content="Manage extension configuration, update Monetag Direct Links, and monitor 30-day install analytics." />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true&redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Dedicated Developer Console Navbar -->
    <DeveloperNavbar />

    <!-- Main Manage View Container (Soft Shaded Borderless Google Console Theme: bg-[#f0f4f9]) -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-6">
      
      <!-- Top Breadcrumb & Extension Header -->
      <div class="space-y-4">
        
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors font-medium">
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>Developer Console</span>
          </a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-500">Extensions</span>
          <span class="text-slate-300">/</span>
          <span class="text-slate-900 font-medium truncate max-w-xs">{ext.name}</span>
        </div>

        <!-- Extension Title Bar (Soft Shaded Borderless Card) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 bg-[#f0f4f9] rounded-2xl border-0 shadow-2xs">
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-2xs overflow-hidden">
              {ext.iconUrl ? (
                <img src={ext.iconUrl} alt={ext.name} class="w-full h-full object-cover" />
              ) : (
                <Box class="w-6 h-6 text-white" />
              )}
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2.5 flex-wrap">
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight" id="display-ext-name">
                  {ext.name}
                </h1>

                <!-- App Status -->
                {ext.appStatus === 'Production' && (
                  <span class="text-slate-700 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>Production</span>
                  </span>
                )}
                {ext.appStatus === 'In Review' && (
                  <span class="text-amber-700 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    <span>In Review</span>
                  </span>
                )}
                {ext.appStatus === 'Rejected' && (
                  <span class="text-rose-700 font-semibold text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                    <span>Rejected</span>
                  </span>
                )}
                {ext.appStatus === 'Draft' && (
                  <span class="text-slate-500 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <span>Draft</span>
                  </span>
                )}

                <span class="text-slate-300">•</span>

                <!-- Update Status with Color Matching (Consistent with All Extensions Table) -->
                {ext.updateStatus === 'Live on Directory' && (
                  <span class="text-emerald-600 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                    <span>Live on Directory</span>
                  </span>
                )}
                {ext.updateStatus === 'Pending admin review' && (
                  <span class="text-amber-600 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>
                    <span>Pending admin review</span>
                  </span>
                )}
                {ext.updateStatus === 'Draft edits pending' && (
                  <span class="text-blue-600 font-medium text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                    <span>Draft edits pending</span>
                  </span>
                )}
                {ext.updateStatus === 'Review rejected' && (
                  <span class="text-rose-600 font-semibold text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span>
                    <span>Review rejected</span>
                  </span>
                )}
                {ext.updateStatus === 'Draft (not published)' && (
                  <span class="text-slate-500 text-xs inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
                    <span>Draft (not published)</span>
                  </span>
                )}

                <span class="text-slate-300">•</span>

                <!-- Version -->
                <span class="font-mono text-xs text-slate-500">
                  v{ext.version}
                </span>
              </div>
              
              <!-- Package ID, Category & Verification Metadata -->
              <p class="text-xs text-slate-500 flex items-center gap-2 flex-wrap">
                <span>Package: <span class="font-mono text-slate-700 font-medium">{ext.packageId}</span></span>
                <span class="text-slate-300">•</span>
                <span class={ext.verificationClass}>{ext.verificationLabel}</span>
                <span class="text-slate-300">•</span>
                <span>{ext.categoryName}</span>
                <span class="text-slate-300">•</span>
                <span>Updated {ext.lastUpdated}</span>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 shrink-0">
            <a
              href={`/extension/${ext.slug}`}
              target="_blank"
              class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium rounded-xl inline-flex items-center gap-1.5 transition-colors shadow-2xs cursor-pointer"
            >
              <Eye class="w-3.5 h-3.5 text-slate-500" />
              <span>{ext.appStatus === 'Production' ? 'View Store Listing' : 'Preview Store Listing'}</span>
            </a>

            <!-- Dedicated Edit Button (Navigates to Edit Page in Blue Styling) -->
            <a
              href={`/developers/manage/${ext.slug}/edit`}
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl inline-flex items-center gap-1.5 cursor-pointer transition-colors shadow-2xs"
            >
              <Pencil class="w-3.5 h-3.5 text-white" />
              <span>Edit Details</span>
            </a>
          </div>

        </div>

      </div>

      <!-- Extension-Specific Special Notification Banner (Appears only when there is an active notification for this extension, otherwise displays clean empty state) -->
      {latestNotification ? (
        <div 
          id="extension-notification-banner"
          data-notification-id={latestNotification.id}
          class={`p-5 rounded-2xl shadow-2xs space-y-2.5 transition-opacity duration-200 ${
            latestNotification.type === 'error' 
              ? 'bg-[#fff5f5] ring-1 ring-rose-200/80 border-0' 
              : 'bg-[#f0f4f9] border-0'
          }`}
        >
          <!-- Top Row: Extension Icon Pill, Type Indicator, Sender Info, Date, and Dismiss Button -->
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-2 flex-wrap">
              <!-- Extension Icon & Name Pill -->
              {(latestNotification.extension_icon_url || ext.iconUrl) && (
                <div class="inline-flex items-center gap-1.5 bg-white border border-slate-200/80 rounded-full pl-1 pr-2.5 py-0.5 text-xs text-slate-800 shadow-2xs">
                  <img
                    src={latestNotification.extension_icon_url || ext.iconUrl}
                    alt={ext.name}
                    class="w-4 h-4 rounded-full object-cover shrink-0"
                  />
                  <span class="font-medium text-[11px] truncate max-w-[150px]">{ext.name}</span>
                </div>
              )}

              <span class="inline-flex items-center gap-1.5 text-xs font-semibold">
                {latestNotification.type === 'error' && (
                  <>
                    <span class="w-2 h-2 rounded-full bg-rose-600 shrink-0"></span>
                    <span class="text-rose-700 font-bold">Submission Rejected</span>
                  </>
                )}
                {latestNotification.type === 'success' && (
                  <>
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                    <span class="text-emerald-700">Update</span>
                  </>
                )}
                {latestNotification.type === 'warning' && (
                  <>
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                    <span class="text-amber-700">Warning</span>
                  </>
                )}
                {(latestNotification.type === 'info' || latestNotification.type === 'announcement' || !['success', 'warning', 'error'].includes(latestNotification.type)) && (
                  <>
                    <span class="w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
                    <span class="text-blue-700">Notice</span>
                  </>
                )}
              </span>
              <span class="text-slate-300">•</span>
              <span class={`text-xs font-medium ${latestNotification.type === 'error' ? 'text-rose-800' : 'text-slate-600'}`}>
                {latestNotification.sender_name || 'ExtLabs Review Team'}
              </span>
              <span class="text-slate-300">•</span>
              <span class={`text-xs ${latestNotification.type === 'error' ? 'text-rose-700/80' : 'text-slate-500'}`}>
                {new Date(latestNotification.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
            </div>

            <!-- Dismiss Button -->
            <button
              type="button"
              id="dismiss-ext-notification-btn"
              class={`p-1 rounded-lg transition-colors cursor-pointer shrink-0 ${
                latestNotification.type === 'error'
                  ? 'text-rose-400 hover:text-rose-700'
                  : 'text-slate-400 hover:text-slate-700'
              }`}
              title="Dismiss notification"
            >
              <X class="w-4 h-4" />
            </button>
          </div>

          <!-- Notification Title & Content -->
          <div class="space-y-1">
            <h3 class={`text-sm font-bold leading-snug ${
              latestNotification.type === 'error' ? 'text-rose-950' : 'text-slate-900'
            }`}>
              {latestNotification.title}
            </h3>
            <p class={`text-xs leading-relaxed font-normal ${
              latestNotification.type === 'error' ? 'text-rose-800' : 'text-slate-600'
            }`}>
              {latestNotification.message}
            </p>
          </div>

          <!-- Action Link -->
          {latestNotification.action_url && (
            <div class="pt-0.5">
              <a
                href={latestNotification.action_url}
                class={`inline-flex items-center gap-1.5 text-xs font-semibold hover:underline cursor-pointer ${
                  latestNotification.type === 'error'
                    ? 'text-rose-600 hover:text-rose-700'
                    : 'text-blue-600 hover:text-blue-700'
                }`}
              >
                <span>{latestNotification.action_label || 'View Details'}</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          )}
        </div>
      ) : (
        <div 
          id="extension-notification-empty-state"
          class="p-4 sm:p-5 rounded-2xl bg-[#f0f4f9] border-0 flex items-center justify-between gap-4 text-xs text-slate-600"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-slate-400 shrink-0 shadow-2xs">
              <Bell class="w-4 h-4 text-slate-500" />
            </div>
            <div class="min-w-0">
              <span class="font-semibold text-slate-800 block text-xs">No active alerts for this extension</span>
              <span class="text-[11px] text-slate-500 block truncate">
                Moderation decisions, policy updates, and audit notices for this package will appear here.
              </span>
            </div>
          </div>
          <span class="text-[11px] font-medium text-emerald-600 font-mono shrink-0 hidden sm:inline-flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>All clear</span>
          </span>
        </div>
      )}

      <!-- 4 KPI Metrics (Soft Shaded Borderless Grid) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="p-5 bg-[#f0f4f9] rounded-2xl border-0 space-y-1">
          <span class="text-xs text-slate-500 font-medium block">Total Downloads</span>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-extrabold text-slate-900 font-mono">
              {ext.downloadCount >= 1000 ? `${(ext.downloadCount / 1000).toFixed(1)}K` : ext.downloadCount.toLocaleString()}
            </span>
            {ext.downloadCount >= 50 ? (
              <span class="text-xs text-emerald-600 font-semibold font-mono">↑ 24.5%</span>
