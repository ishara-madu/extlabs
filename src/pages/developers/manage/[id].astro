          <!-- Delete Option -->
          <div class="bg-white p-5 rounded-xl shadow-2xs space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <Trash2 class="w-4 h-4 text-rose-600" />
                <span class="font-bold text-slate-900">Permanently Delete Extension</span>
              </div>
              <p class="text-slate-500 text-[11px] leading-relaxed">
                Submit a permanent removal request. If approved by administrators, this package, all release versions, user reviews, and listing assets will be completely erased.
              </p>

              {pendingDeleteReq ? (
                <div class="mt-3 p-3 bg-rose-50/70 border border-rose-200/60 rounded-lg space-y-1.5">
                  <div class="flex items-center gap-1.5 text-rose-800 font-semibold text-xs">
                    <Clock class="w-3.5 h-3.5 text-rose-600" />
                    <span>Permanent Deletion Pending Review</span>
                  </div>
                  <p class="text-slate-600 text-[11px]">
                    <strong class="font-medium text-slate-700">Reason submitted:</strong> &ldquo;{pendingDeleteReq.reason}&rdquo;
                  </p>
                  <span class="text-[10px] text-slate-400 block font-mono">
                    Submitted on {new Date(pendingDeleteReq.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>
              ) : null}
            </div>

            {!pendingDeleteReq && (
              <button
                type="button"
                id="open-delete-modal-btn"
                class="px-4 py-2 bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 hover:border-rose-300 font-semibold rounded-xl transition-colors cursor-pointer inline-flex items-center justify-center gap-2 shadow-2xs self-start"
              >
                <Trash2 class="w-3.5 h-3.5 text-rose-600" />
                <span>Request Deletion</span>
              </button>
            )}
          </div>
        </div>
      </section>

    </main>

    <!-- Lifecycle Request Reason Modal (Clean HTML Dialog) -->
    <div id="lifecycle-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200 space-y-5">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2">
            <span id="lifecycle-modal-icon-container">
              <AlertTriangle class="w-4 h-4 text-slate-700" />
            </span>
            <h3 id="lifecycle-modal-title" class="font-bold text-slate-900 text-sm">Submit Request</h3>
          </div>
          <button type="button" id="close-lifecycle-modal-btn" class="text-slate-400 hover:text-slate-600 cursor-pointer p-1">
            <X class="w-4 h-4" />
          </button>
        </div>

        <p id="lifecycle-modal-desc" class="text-xs text-slate-500 leading-relaxed">
          Please provide a detailed explanation for administrators.
        </p>

        <form id="lifecycle-request-form" class="space-y-4">
          <input type="hidden" id="lifecycle-request-type" value="unpublish" />
          <input type="hidden" id="lifecycle-extension-id" value={ext.id} />
          <div>
            <label for="lifecycle-reason-input" class="block text-xs font-semibold text-slate-700 mb-1.5">
              Reason for Request <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="lifecycle-reason-input"
              rows="4"
              required
              minlength="10"
              placeholder="e.g. Taking down temporarily to resolve backend security vulnerability..."
              class="w-full text-xs p-3 border border-slate-200 rounded-xl focus:outline-none focus:border-slate-400 resize-none placeholder:text-slate-400"
            ></textarea>
            <span class="text-[11px] text-slate-400 mt-1 block">Minimum 10 characters required.</span>
          </div>

          <div id="lifecycle-modal-error" class="hidden p-2.5 bg-rose-50 text-rose-700 text-xs rounded-lg border border-rose-200"></div>

          <div class="flex items-center justify-end gap-2.5 pt-2">
            <button
              type="button"
              id="cancel-lifecycle-btn"
              class="px-3.5 py-2 text-xs font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="submit-lifecycle-btn"
              class="px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl transition-colors cursor-pointer inline-flex items-center gap-1.5"
            >
              <Send class="w-3.5 h-3.5" />
              <span id="submit-lifecycle-btn-text">Submit to Admin</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- ApexCharts Client-Side Initialization & Interactive Scripts -->
    <script>
      import ApexCharts from 'apexcharts';

      document.addEventListener('DOMContentLoaded', () => {
        // 1. ApexCharts Data Sets (7d, 30d, 90d, 1y)
        const datasets = {
          '7d': {
            dates: ['Aug 25', 'Aug 26', 'Aug 27', 'Aug 28', 'Aug 29', 'Aug 30', 'Aug 31'],
            installs: [2150, 2240, 2410, 2680, 2750, 2890, 2980]
          },
          '30d': {
            dates: [
              'Aug 01', 'Aug 04', 'Aug 07', 'Aug 10', 'Aug 13', 
              'Aug 16', 'Aug 19', 'Aug 22', 'Aug 25', 'Aug 28', 'Aug 31'
            ],
            installs: [1120, 1350, 1480, 1580, 1690, 1880, 2120, 2380, 2540, 2680, 2980]
          },
          '90d': {
            dates: ['Jun W1', 'Jun W3', 'Jul W1', 'Jul W3', 'Aug W1', 'Aug W3', 'Aug W4'],
            installs: [4800, 6200, 7900, 9400, 12100, 15800, 18400]
          },
          '1y': {
            dates: ['Sep', 'Nov', 'Jan', 'Mar', 'May', 'Jul', 'Aug'],
            installs: [2400, 4800, 8900, 15200, 26000, 41000, 54200]
          }
        };

        const chartElement = document.getElementById('downloads-apexchart');
        let chart: ApexCharts | null = null;

        if (chartElement) {
          const options: ApexCharts.ApexOptions = {
            series: [{
              name: 'Verified Installs',
              data: datasets['30d'].installs
            }],
            chart: {
              type: 'area',
              height: 280,
              toolbar: { show: false },
              zoom: { enabled: false },
              fontFamily: 'Inter, sans-serif'
            },
            colors: ['#2563eb'],
            dataLabels: { enabled: false },
            stroke: {
              curve: 'smooth',
              width: 2.5
            },
            fill: {
              type: 'gradient',
              gradient: {
                shadeIntensity: 1,
                opacityFrom: 0.25,
                opacityTo: 0.02,
                stops: [0, 95, 100]
              }
            },
            xaxis: {
              categories: datasets['30d'].dates,
              axisBorder: { show: false },
              axisTicks: { show: false },
              labels: {
                style: {
                  colors: '#94a3b8',
                  fontSize: '11px',
                  fontFamily: 'monospace'
                }
              }
            },
            yaxis: {
              labels: {
                style: {
                  colors: '#94a3b8',
                  fontSize: '11px',
                  fontFamily: 'monospace'
                },
                formatter: (val) => val >= 1000 ? `${(val / 1000).toFixed(1)}k` : `${val}`
              }
            },
            grid: {
              borderColor: '#f1f5f9',
              strokeDashArray: 3,
              xaxis: { lines: { show: false } },
              yaxis: { lines: { show: true } }
            },
            tooltip: {
              theme: 'light',
              x: { show: true },
              y: {
                formatter: (val) => `${val.toLocaleString()} installs`
              }
            },
            markers: {
              size: 4,
              colors: ['#ffffff'],
              strokeColors: '#2563eb',
              strokeWidth: 2,
              hover: { size: 6 }
            }
          };

          chart = new ApexCharts(chartElement, options);
          chart.render();
        }

        // 2. Chart Range Buttons Filter Handler
        const rangeBtns = document.querySelectorAll('.chart-range-btn');
        if (chartElement && rangeBtns.length > 0) {
          rangeBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
              const range = (btn.getAttribute('data-range') || '30d') as keyof typeof datasets;
              
              rangeBtns.forEach((b) => {
                b.classList.remove('bg-slate-900', 'text-white', 'font-semibold', 'shadow-2xs');
                b.classList.add('text-slate-600');
              });
              btn.classList.add('bg-slate-900', 'text-white', 'font-semibold', 'shadow-2xs');
              btn.classList.remove('text-slate-600');

              if (chart && datasets[range]) {
                chart.updateOptions({
                  xaxis: { categories: datasets[range].dates },
                  series: [{ name: 'Verified Installs', data: datasets[range].installs }]
                });
              }
            });
          });
        }

        // 3. Copy Monetag URL
        const copyBtn = document.getElementById('copy-monetag-btn');
        const urlInput = document.getElementById('view-monetag-url') as HTMLInputElement | null;
        const copyLabel = document.getElementById('copy-monetag-label');

        copyBtn?.addEventListener('click', () => {
          if (urlInput && urlInput.value) {
            navigator.clipboard.writeText(urlInput.value);
            if (copyLabel) {
              copyLabel.textContent = 'Copied!';
              setTimeout(() => { copyLabel.textContent = 'Copy'; }, 1800);
            }
          }
        });

        // 4. Dismiss Extension Notification Banner
        const dismissNotifBtn = document.getElementById('dismiss-ext-notification-btn');
        const notifBanner = document.getElementById('extension-notification-banner');
        if (dismissNotifBtn && notifBanner) {
          dismissNotifBtn.addEventListener('click', async () => {
            const notifId = notifBanner.getAttribute('data-notification-id');
            notifBanner.classList.add('opacity-0');
            setTimeout(() => {
              notifBanner.outerHTML = `
                <div 
                  id="extension-notification-empty-state"
                  class="p-4 sm:p-5 rounded-2xl bg-[#f0f4f9] border-0 flex items-center justify-between gap-4 text-xs text-slate-600 transition-opacity duration-200"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8 h-8 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-slate-400 shrink-0 shadow-2xs">
                      <svg class="w-4 h-4 text-slate-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    </div>
                    <div class="min-w-0">
                      <span class="font-semibold text-slate-800 block text-xs">No active alerts for this extension</span>
                      <span class="text-[11px] text-slate-500 block truncate">
                        Moderation decisions, policy updates, and audit notices for this package will appear here.
                      </span>
                    </div>
                  </div>
                  <span class="text-[11px] font-medium text-emerald-600 font-mono shrink-0 hidden sm:inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>All clear</span>
                  </span>
                </div>
              `;
            }, 200);

            if (notifId) {
              try {
                await fetch('/api/developers/notifications/action', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'delete', notificationId: notifId })
                });
              } catch (e) {
                console.error('Failed to delete notification:', e);
              }
            }
          });
        }

        // 5. Lifecycle Request Modal (Unpublish & Delete)
        const lifecycleModal = document.getElementById('lifecycle-modal');
        const openUnpublishBtn = document.getElementById('open-unpublish-modal-btn');
        const openDeleteBtn = document.getElementById('open-delete-modal-btn');
        const closeLifecycleBtn = document.getElementById('close-lifecycle-modal-btn');
        const cancelLifecycleBtn = document.getElementById('cancel-lifecycle-btn');
        const lifecycleForm = document.getElementById('lifecycle-request-form') as HTMLFormElement | null;
        const lifecycleTypeInput = document.getElementById('lifecycle-request-type') as HTMLInputElement | null;
        const lifecycleExtIdInput = document.getElementById('lifecycle-extension-id') as HTMLInputElement | null;
        const lifecycleReasonInput = document.getElementById('lifecycle-reason-input') as HTMLTextAreaElement | null;
        const lifecycleModalTitle = document.getElementById('lifecycle-modal-title');
        const lifecycleModalDesc = document.getElementById('lifecycle-modal-desc');
        const lifecycleModalError = document.getElementById('lifecycle-modal-error');
        const submitLifecycleBtn = document.getElementById('submit-lifecycle-btn') as HTMLButtonElement | null;
        const submitLifecycleBtnText = document.getElementById('submit-lifecycle-btn-text');

        function openModal(type: 'unpublish' | 'delete') {
          if (!lifecycleModal) return;
          if (lifecycleTypeInput) lifecycleTypeInput.value = type;
          if (lifecycleReasonInput) {
            lifecycleReasonInput.value = '';
            lifecycleReasonInput.placeholder = type === 'unpublish'
              ? 'e.g. Taking down temporarily to resolve backend security patch...'
              : 'e.g. Project deprecated in favor of our new cloud app...';
          }
          if (lifecycleModalError) {
            lifecycleModalError.textContent = '';
            lifecycleModalError.classList.add('hidden');
          }

          if (type === 'unpublish') {
            if (lifecycleModalTitle) lifecycleModalTitle.textContent = 'Request Unpublish';
            if (lifecycleModalDesc) {
              lifecycleModalDesc.textContent = 'Please explain why you want to unpublish this extension from the store. Administrators will review your request.';
            }
          } else {
            if (lifecycleModalTitle) lifecycleModalTitle.textContent = 'Request Permanent Deletion';
            if (lifecycleModalDesc) {
              lifecycleModalDesc.textContent = 'Warning: Deleting an extension completely removes all versions, reviews, and data. Please state your reason clearly for administrative review.';
            }
          }

          lifecycleModal.classList.remove('hidden');
          setTimeout(() => lifecycleReasonInput?.focus(), 100);
        }

        function closeModal() {
          if (lifecycleModal) lifecycleModal.classList.add('hidden');
        }

        openUnpublishBtn?.addEventListener('click', () => openModal('unpublish'));
        openDeleteBtn?.addEventListener('click', () => openModal('delete'));
        closeLifecycleBtn?.addEventListener('click', closeModal);
        cancelLifecycleBtn?.addEventListener('click', closeModal);

        lifecycleForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const type = lifecycleTypeInput?.value;
          const extId = lifecycleExtIdInput?.value;
          const reason = lifecycleReasonInput?.value?.trim() || '';

          if (reason.length < 10) {
            if (lifecycleModalError) {
              lifecycleModalError.textContent = 'Reason must be at least 10 characters.';
              lifecycleModalError.classList.remove('hidden');
            }
            return;
          }

          if (submitLifecycleBtn) submitLifecycleBtn.disabled = true;
          if (submitLifecycleBtnText) submitLifecycleBtnText.textContent = 'Submitting...';

          try {
            const res = await fetch('/api/developers/extensions/request-lifecycle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                extensionId: extId,
                requestType: type,
                reason,
              }),
            });

            const data = await res.json() as any;

            if (!res.ok || !data.success) {
              if (lifecycleModalError) {
                lifecycleModalError.textContent = data.error || 'Failed to submit request.';
                lifecycleModalError.classList.remove('hidden');
              }
              if (submitLifecycleBtn) submitLifecycleBtn.disabled = false;
              if (submitLifecycleBtnText) submitLifecycleBtnText.textContent = 'Submit to Admin';
              return;
            }

            // Success: reload to show pending notice
            window.location.reload();
          } catch (err: any) {
            if (lifecycleModalError) {
              lifecycleModalError.textContent = err.message || 'Network error occurred.';
              lifecycleModalError.classList.remove('hidden');
            }
            if (submitLifecycleBtn) submitLifecycleBtn.disabled = false;
            if (submitLifecycleBtnText) submitLifecycleBtnText.textContent = 'Submit to Admin';
          }
        });
      });
    </script>

  </body>
</html>
