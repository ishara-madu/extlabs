---
// src/pages/developers/manage/[id].astro
import "../../../styles/global.css";
import DeveloperNavbar from "../../../components/DeveloperNavbar.astro";
import Footer from "../../../components/Footer.astro";
import { 
  ArrowLeft, 
  ExternalLink, 
  Save, 
  Star, 
  Box, 
  Eye
} from '@lucide/astro';
import { EXTENSIONS, getExtensionWithDefaults } from "../../../data/extensions";

export function getStaticPaths() {
  return EXTENSIONS.map((item) => ({
    params: { id: item.id },
    props: { rawExtension: item },
  }));
}

interface Props {
  rawExtension: (typeof EXTENSIONS)[0];
}

const { rawExtension } = Astro.props;
const ext = getExtensionWithDefaults(rawExtension);

// Mock 30-day analytics data points for minimal SVG Chart
const chartData = [
  { day: "Aug 01", installs: 1200, height: "45%" },
  { day: "Aug 04", installs: 1450, height: "55%" },
  { day: "Aug 08", installs: 1800, height: "65%" },
  { day: "Aug 12", installs: 1600, height: "58%" },
  { day: "Aug 16", installs: 2100, height: "78%" },
  { day: "Aug 20", installs: 2400, height: "88%" },
  { day: "Aug 24", installs: 2900, height: "98%" },
  { day: "Aug 28", installs: 2750, height: "92%" },
  { day: "Aug 31", installs: 2850, height: "95%" }
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Manage {ext.name} — ExtLabs Developer Console</title>
    <meta name="description" content="Manage extension configuration, update Monetag Direct Links, and monitor 30-day install analytics." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          var isAuth = localStorage.getItem('extlabs_dev_session');
          if (!isAuth) {
            window.location.href = '/developers/login?auth_required=true';
          }
        }
      })();
    </script>

    <!-- Dedicated Developer Console Navbar -->
    <DeveloperNavbar />

    <!-- Main Manage View Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-8">
      
      <!-- Top Breadcrumb & Header Controls -->
      <div class="space-y-4">
        
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors">
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>Developer Console</span>
          </a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-500">Extensions</span>
          <span class="text-slate-300">/</span>
          <span class="text-slate-900 font-medium truncate max-w-xs">{ext.name}</span>
        </div>

        <!-- Extension Title Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 bg-white rounded-xl border border-slate-200 shadow-2xs">
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-2xs">
              <Box class="w-6 h-6 text-white" />
            </div>

            <div class="space-y-0.5">
              <div class="flex items-center gap-2.5 flex-wrap">
                <h1 class="text-lg font-bold text-slate-900 tracking-tight">
                  {ext.name}
                </h1>
                <span class="px-2 py-0.5 text-[10px] font-semibold text-slate-700 bg-slate-100 border border-slate-200 rounded">
                  Production
                </span>
                <span class="font-mono text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  v{ext.version || '2.4.1'}
                </span>
              </div>
              
              <p class="text-xs text-slate-500">
                Package: <span class="font-mono text-slate-600">io.extlabs.{ext.id.replace(/-/g, '')}</span> • Manifest V3 Verified
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <a
              href={`/extension/${ext.id}`}
              target="_blank"
              class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium rounded-lg border border-slate-200 inline-flex items-center gap-1.5 transition-colors shadow-2xs"
            >
              <Eye class="w-3.5 h-3.5 text-slate-400" />
              <span>View Store Listing</span>
            </a>

            <button
              type="button"
              id="save-all-btn"
              class="px-4 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg inline-flex items-center gap-1.5 cursor-pointer transition-colors shadow-2xs"
            >
              <Save class="w-3.5 h-3.5 text-white" />
              <span>Save Changes</span>
            </button>
          </div>

        </div>

      </div>

      <!-- SECTION 1: 30-Day Performance & Install Analytics Chart (Minimalist SVG) -->
      <section class="p-6 sm:p-7 bg-white rounded-xl border border-slate-200 shadow-2xs space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div class="space-y-0.5">
            <h2 class="text-sm font-bold text-slate-900">
              30-Day Install & Acquisition Performance
            </h2>
            <p class="text-xs text-slate-500">
              Daily verified downloads and Monetag ad tab triggers.
            </p>
          </div>

          <div class="flex items-center gap-4 text-xs font-mono">
            <div>
              <span class="text-slate-400 block text-[10px]">Total Installs</span>
              <span class="font-bold text-slate-900 text-sm">54,200</span>
            </div>
            <div class="h-6 w-px bg-slate-200"></div>
            <div>
              <span class="text-slate-400 block text-[10px]">Ad Tab Triggers</span>
              <span class="font-bold text-slate-900 text-sm">54,200</span>
            </div>
            <div class="h-6 w-px bg-slate-200"></div>
            <div>
              <span class="text-slate-400 block text-[10px]">Avg Rating</span>
              <span class="font-bold text-amber-600 text-sm">4.90 ★</span>
            </div>
          </div>
        </div>

        <!-- Minimalist CSS/SVG Bar Chart Strip -->
        <div class="space-y-2">
          <div class="h-44 w-full flex items-end justify-between gap-2 sm:gap-4 pt-6 px-2 bg-slate-50/60 rounded-xl border border-slate-100">
            {chartData.map((item) => (
              <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end group">
                <div class="text-[10px] font-mono text-slate-400 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                  {item.installs}
                </div>
                <div 
                  class="w-full max-w-[28px] bg-slate-900 group-hover:bg-blue-600 rounded-t transition-colors cursor-pointer"
                  style={`height: ${item.height}`}
                  title={`${item.day}: ${item.installs} installs`}
                ></div>
                <span class="text-[10px] text-slate-400 font-mono pb-1">{item.day.split(' ')[1]}</span>
              </div>
            ))}
          </div>
          <div class="flex items-center justify-between text-[11px] text-slate-400 px-2">
            <span>Aug 01, 2026</span>
            <span class="text-emerald-600 font-mono font-medium">↑ +24.5% vs previous 30 days</span>
            <span>Aug 31, 2026</span>
          </div>
        </div>

      </section>

      <!-- SECTION 2: Monetag Direct Link & Monetization Setup -->
      <section class="p-6 sm:p-7 bg-white rounded-xl border border-slate-200 shadow-2xs space-y-6">
        
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900">
            Monetag Direct Link Configuration
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            100% of the ad revenue generated when users download this extension is credited directly to your Monetag publisher account.
          </p>
        </div>

        <div class="space-y-4 max-w-3xl">
          
          <div class="space-y-1.5">
            <label for="monetag-direct-url" class="block text-xs font-semibold text-slate-700">
              Active Monetag Direct Link URL:
            </label>
            <div class="flex items-center gap-2">
              <input
                id="monetag-direct-url"
                type="url"
                value={`https://monetag.com/direct/${ext.id.replace(/-/g, '_')}_live_8912`}
                class="flex-1 px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 text-slate-900 font-mono rounded-lg focus:bg-white focus:border-blue-400 focus:outline-none"
              />
              <button
                type="button"
                id="test-monetag-link-btn"
                class="px-3.5 py-2 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg inline-flex items-center gap-1.5 transition-colors cursor-pointer shrink-0"
              >
                <span>Test Link</span>
                <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
              </button>
            </div>
            <span class="text-[11px] text-slate-400 block">
              Direct Link generated from <a href="https://monetag.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 font-medium underline">Monetag Publisher Dashboard</a>.
            </span>
          </div>

          <!-- CPM Reference Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 space-y-1 text-xs">
              <span class="text-slate-500 block text-[11px]">Tier-1 Traffic (US, UK, EU)</span>
              <span class="font-bold font-mono text-slate-900 text-sm">~$8.50 CPM</span>
            </div>

            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 space-y-1 text-xs">
              <span class="text-slate-500 block text-[11px]">Tier-2 Traffic (LATAM, ME)</span>
              <span class="font-bold font-mono text-slate-900 text-sm">~$3.20 CPM</span>
            </div>

            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 space-y-1 text-xs">
              <span class="text-slate-500 block text-[11px]">Platform Fee / Revenue Share</span>
              <span class="font-bold font-mono text-slate-900 text-sm">0% Cut (100% Direct)</span>
            </div>
          </div>

        </div>

      </section>

      <!-- SECTION 3: Extension Metadata & GitHub Release Sync -->
      <section class="p-6 sm:p-7 bg-white rounded-xl border border-slate-200 shadow-2xs space-y-6">
        
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900">
            Extension Details & GitHub Release Sync
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Manage your extension title, tagline, categories, and connected GitHub repository releases.
          </p>
        </div>

        <form id="edit-details-form" class="space-y-4 max-w-3xl">
          
          <!-- GitHub Repo -->
          <div class="space-y-1.5">
            <label for="edit-github-repo" class="block text-xs font-semibold text-slate-700">
              GitHub Repository (Release Package Sync)
            </label>
            <input
              id="edit-github-repo"
              type="text"
              value={`https://github.com/neural-labs/${ext.id}`}
              class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-slate-400 focus:outline-none font-mono"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Name -->
            <div class="space-y-1.5">
              <label for="edit-ext-name" class="block text-xs font-semibold text-slate-700">
                Extension Name
              </label>
              <input
                id="edit-ext-name"
                type="text"
                value={ext.name}
                class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-slate-400 focus:outline-none"
              />
            </div>

            <!-- Category -->
            <div class="space-y-1.5">
              <label for="edit-ext-category" class="block text-xs font-semibold text-slate-700">
                Primary Category
              </label>
              <select
                id="edit-ext-category"
                class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-slate-400 focus:outline-none cursor-pointer"
              >
                <option value="ai" selected={ext.category.includes('AI')}>AI & Machine Learning</option>
                <option value="dev" selected={ext.category.includes('Dev')}>Developer Tools</option>
                <option value="productivity" selected={ext.category.includes('Productivity')}>Productivity</option>
                <option value="privacy" selected={ext.category.includes('Privacy')}>Privacy & Security</option>
                <option value="utilities" selected={ext.category.includes('Utilities')}>Workflow & Utilities</option>
              </select>
            </div>
          </div>

          <!-- Tagline -->
          <div class="space-y-1.5">
            <label for="edit-ext-tagline" class="block text-xs font-semibold text-slate-700">
              Tagline (Search Summary)
            </label>
            <input
              id="edit-ext-tagline"
              type="text"
              value={ext.tagline}
              class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-slate-400 focus:outline-none"
            />
          </div>

          <!-- Description -->
          <div class="space-y-1.5">
            <label for="edit-ext-desc" class="block text-xs font-semibold text-slate-700">
              Overview & Key Features
            </label>
            <textarea
              id="edit-ext-desc"
              rows="4"
              class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-slate-400 focus:outline-none leading-relaxed"
            >{ext.description}</textarea>
          </div>

          <div class="pt-2 flex items-center justify-end">
            <button
              type="submit"
              class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
            >
              <Save class="w-3.5 h-3.5 text-white" />
              <span>Save Configuration</span>
            </button>
          </div>

        </form>

      </section>

    </main>

    <!-- Footer -->
    <Footer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const testBtn = document.getElementById('test-monetag-link-btn');
        const urlInput = document.getElementById('monetag-direct-url') as HTMLInputElement | null;
        const saveAllBtn = document.getElementById('save-all-btn');
        const editForm = document.getElementById('edit-details-form');

        if (testBtn && urlInput) {
          testBtn.addEventListener('click', () => {
            if (urlInput.value) {
              window.open(urlInput.value, '_blank');
            }
          });
        }

        function handleSave(e?: Event) {
          if (e) e.preventDefault();
          alert('Configuration and Monetag Direct Link successfully saved in real-time!');
        }

        if (saveAllBtn) saveAllBtn.addEventListener('click', () => handleSave());
        if (editForm) editForm.addEventListener('submit', (e) => handleSave(e));
      });
    </script>

  </body>
</html>
