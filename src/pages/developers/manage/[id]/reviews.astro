---
// src/pages/developers/manage/[id]/reviews.astro
import "../../../../styles/global.css";
import DeveloperNavbar from "../../../../components/DeveloperNavbar.astro";
import Footer from "../../../../components/Footer.astro";
import { 
  ArrowLeft, 
  ExternalLink, 
  Star, 
  Box, 
  MessageSquare, 
  Send, 
  CornerDownRight, 
  CheckCircle2, 
  Search,
  Check,
  Eye
} from '@lucide/astro';

import { 
  getDb, 
  getDeveloperByUserIdOrSlug, 
  getDeveloperExtensionDetail,
  getExtensionReviews,
  getExtensionRatingBreakdown,
  type ManageExtensionDetail
} from "../../../../lib/db";
import { getSessionUser } from "../../../../lib/auth";

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/developers/dashboard', 302);
}

// 1. Database Connection & Authentication
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

let developer = null;
let dbExtension: ManageExtensionDetail | null = null;
let dbReviews: any[] = [];
let dbBreakdown = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };

if (db) {
  try {
    if (user) {
      developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
    }
    dbExtension = await getDeveloperExtensionDetail(db, id, developer?.id);
    if (dbExtension) {
      const [reviews, breakdown] = await Promise.all([
        getExtensionReviews(db, dbExtension.id),
        getExtensionRatingBreakdown(db, dbExtension.id),
      ]);
      dbReviews = reviews;
      dbBreakdown = breakdown;
    }
  } catch (err) {
    console.error("Database error fetching extension for reviews:", err);
  }
}

if (!dbExtension) {
  return Astro.redirect('/developers/dashboard', 302);
}

// Normalize extension detail
const rawReviewCount = typeof dbExtension.review_count === 'number'
  ? dbExtension.review_count
  : (typeof (dbExtension as any).reviews_count === 'number' ? (dbExtension as any).reviews_count : dbReviews.length);

const rawRating = rawReviewCount > 0 && typeof dbExtension.rating === 'number'
  ? dbExtension.rating
  : (dbReviews.length > 0 ? (dbReviews.reduce((sum, r) => sum + r.rating, 0) / dbReviews.length) : 0);

const ext = {
  id: dbExtension.id || id,
  name: dbExtension.name || 'Untitled Extension',
  version: dbExtension.version_name || dbExtension.current_version || '1.0.0',
  downloadCount: typeof dbExtension.download_count === 'number' 
    ? dbExtension.download_count 
    : 0,
  rating: rawRating,
  reviewCount: rawReviewCount,
  category: dbExtension.category || 'Productivity',
  tagline: dbExtension.tagline || dbExtension.short_description || '',
  iconUrl: dbExtension.icon_url || '/icons/extension-placeholder.avif',
  status: dbExtension.status || 'Production'
};

// Real Rating distribution data from Cloudflare D1
const ratingsBreakdown = ([5, 4, 3, 2, 1] as const).map(stars => {
  const count = dbBreakdown[stars] || 0;
  const percentage = rawReviewCount > 0 ? Math.round((count / rawReviewCount) * 100) : 0;
  return { stars, percentage, count };
});

// Verified reviews list
const reviewsList = dbReviews.map((r) => ({
  id: r.id,
  user: r.author || 'Verified User',
  avatar: r.avatarUrl || '/icons/github-profile-placeholder.avif',
  rating: r.rating,
  date: r.date || 'Recently',
  title: r.title || '',
  content: r.comment || '',
  verified: true,
  developerReply: null as { date: string; text: string } | null
}));
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ratings & User Reviews — {ext.name} — ExtLabs</title>
    <meta name="description" content={`Manage user feedback, view rating analytics, and publish official developer responses for ${ext.name}.`} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true';
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Dedicated Developer Console Navbar -->
    <DeveloperNavbar />

    <!-- Main Reviews View Container (Soft Shaded Borderless Google Console Theme: bg-[#f0f4f9]) -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-6">
      
      <!-- Top Breadcrumb & Page Header -->
      <div class="space-y-4">
        
        <!-- Breadcrumb Navigation -->
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors font-medium">
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>Developer Console</span>
          </a>
          <span class="text-slate-300">/</span>
          <a href={`/developers/manage/${ext.id}`} class="hover:text-blue-600 transition-colors">
            {ext.name}
          </a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-900 font-medium">Ratings & Reviews</span>
        </div>

        <!-- Header Card (Soft Shaded Borderless Card) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-6 bg-[#f0f4f9] rounded-2xl border-0 shadow-2xs">
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center shrink-0 shadow-2xs">
              <Box class="w-6 h-6 text-white" />
            </div>

            <div class="space-y-0.5">
              <div class="flex items-center gap-2.5 flex-wrap">
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                  User Ratings & Reviews
                </h1>
                <span class="px-2 py-0.5 text-[10px] font-semibold text-slate-700 bg-white/80 rounded-full shadow-2xs">
                  {ext.name}
                </span>
                <span class="font-mono text-[11px] text-slate-600 bg-white/80 px-2 py-0.5 rounded-full shadow-2xs">
                  v{ext.version || '2.4.1'}
                </span>
              </div>
              
              <p class="text-xs text-slate-500">
                Monitor verified feedback and interact directly with users by publishing official developer replies.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 shrink-0">
            <a
              href={`/developers/manage/${ext.id}`}
              class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium rounded-xl inline-flex items-center gap-1.5 transition-colors shadow-2xs cursor-pointer"
            >
              <ArrowLeft class="w-3.5 h-3.5 text-slate-500" />
              <span>Back to Overview</span>
            </a>

            <a
              href={`/extension/${ext.id}`}
              target="_blank"
              class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium rounded-xl inline-flex items-center gap-1.5 transition-colors shadow-2xs cursor-pointer"
            >
              <Eye class="w-3.5 h-3.5 text-white" />
              <span>Store Listing</span>
            </a>
          </div>

        </div>

      </div>

      <!-- RATINGS SUMMARY SCORE BANNER (Soft Shaded Borderless Card) -->
      <section class="p-6 sm:p-7 bg-[#f0f4f9] rounded-2xl border-0 space-y-5">
        
        <div class="flex items-center justify-between border-b border-slate-200/60 pb-3">
          <div class="space-y-0.5">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              Rating Overview & Response Telemetry
            </h2>
            <p class="text-xs text-slate-500">Aggregated feedback across all verified Chrome & Chromium installations.</p>
          </div>
          <span class="text-xs font-mono font-medium text-slate-700 bg-white/80 px-2.5 py-0.5 rounded-full">
            {ext.reviewCount > 0 ? `${ext.rating.toFixed(2)} / 5.0` : 'No reviews yet'}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
          
          <!-- Column 1: Big Score Badge -->
          <div class="flex flex-col items-center justify-center p-5 bg-white rounded-xl shadow-2xs text-center space-y-1">
            <span class="text-4xl font-black text-slate-900 font-mono">
              {ext.rating > 0 ? ext.rating.toFixed(2) : '—'}
            </span>
            <div class="flex items-center gap-1 text-amber-500 py-1">
              {[1, 2, 3, 4, 5].map((s) => (
                <Star class={`w-4 h-4 ${s <= Math.round(ext.rating) && ext.rating > 0 ? 'fill-amber-500 text-amber-500' : 'text-slate-200 fill-slate-200'}`} />
              ))}
            </div>
            <span class="text-xs text-slate-500 font-mono">
              {ext.reviewCount > 0 ? `${ext.reviewCount.toLocaleString()} verified reviews` : 'No reviews yet'}
            </span>
          </div>

          <!-- Column 2: Star Breakdown Progress Bars -->
          <div class="space-y-2 text-xs bg-white p-4.5 rounded-xl shadow-2xs">
            {ratingsBreakdown.map((row) => (
              <div class="flex items-center gap-2.5">
                <span class="text-[11px] font-mono font-semibold text-slate-600 w-5">{row.stars}★</span>
                <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
                  <div
                    class="h-full bg-amber-500 rounded-full"
                    style={`width: ${row.percentage}%`}
                  ></div>
                </div>
                <span class="text-[11px] font-mono text-slate-500 w-9 text-right">{row.percentage}%</span>
              </div>
            ))}
          </div>

          <!-- Column 3: Verified Rating Distribution Stats -->
          <div class="space-y-3 bg-white p-4.5 rounded-xl shadow-2xs text-xs">
            <div class="flex items-center justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">5-Star Ratings:</span>
              <span class="font-bold text-slate-900 font-mono">{dbBreakdown[5] || 0}</span>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">4-Star Ratings:</span>
              <span class="font-bold text-slate-900 font-mono">{dbBreakdown[4] || 0}</span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-slate-500">1-3 Star Ratings:</span>
              <span class="font-bold text-slate-900 font-mono">{(dbBreakdown[1] || 0) + (dbBreakdown[2] || 0) + (dbBreakdown[3] || 0)}</span>
            </div>
          </div>

        </div>

      </section>

      <!-- REVIEWS FEED & REPLY STREAM (Soft Shaded Borderless Container) -->
      <section class="space-y-4">
        
        <!-- Filter Controls Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 bg-[#f0f4f9] rounded-xl border-0">
          
          <!-- Rating Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 text-xs font-medium">
            <button
              type="button"
              class="filter-pill-btn px-3 py-1.5 bg-slate-900 text-white rounded-lg shadow-2xs transition-colors cursor-pointer"
              data-filter="all"
            >
              All ({reviewsList.length})
            </button>
            <button
              type="button"
              class="filter-pill-btn px-3 py-1.5 bg-white text-slate-700 hover:bg-slate-100 rounded-lg shadow-2xs transition-colors cursor-pointer"
              data-filter="5"
            >
              5 Stars ({dbBreakdown[5] || 0})
            </button>
            <button
              type="button"
              class="filter-pill-btn px-3 py-1.5 bg-white text-slate-700 hover:bg-slate-100 rounded-lg shadow-2xs transition-colors cursor-pointer"
              data-filter="4"
            >
              4 Stars ({dbBreakdown[4] || 0})
            </button>
          </div>

          <!-- Search Input -->
          <div class="relative w-full sm:w-64">
            <Search class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              id="review-search-input"
              type="text"
              placeholder="Search user reviews..."
              class="w-full pl-8 pr-3 py-1.5 bg-white text-xs border border-slate-200/80 rounded-lg focus:border-slate-400 focus:outline-none placeholder-slate-400 shadow-2xs"
            />
          </div>

        </div>

        <!-- Reviews Stream List -->
        {reviewsList.length === 0 ? (
          <div class="p-12 bg-white rounded-2xl border border-slate-200 text-center space-y-3">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 mx-auto">
              <MessageSquare class="w-6 h-6 text-slate-500" />
            </div>
            <div class="space-y-1 max-w-sm mx-auto">
              <h4 class="text-sm font-bold text-slate-800">No Reviews Submitted Yet</h4>
              <p class="text-xs text-slate-500 leading-relaxed">
                When users rate or leave verified feedback on this extension from the store directory, their reviews will appear here.
              </p>
            </div>
          </div>
        ) : (
          <div class="space-y-4" id="reviews-list-container">
            {reviewsList.map((rev) => (
              <div
                class="p-5 sm:p-6 bg-[#f0f4f9] rounded-2xl border-0 space-y-3.5 text-xs review-card"
                data-rating={rev.rating}
                data-replied={rev.developerReply ? "true" : "false"}
                data-text={rev.content.toLowerCase()}
                data-user={rev.user.toLowerCase()}
              >
                <!-- Reviewer Info & Star Header -->
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <div class="flex items-center gap-3">
                    <img
                      src={rev.avatar}
                      alt={rev.user}
                      class="w-9 h-9 rounded-full object-cover border-2 border-white shadow-2xs shrink-0"
                    />
                    <div class="space-y-0.5">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-slate-900 text-sm">{rev.user}</span>
                        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
                          <CheckCircle2 class="w-3 h-3 text-emerald-600" />
                          <span>Verified Review</span>
                        </span>
                      </div>
                      <span class="text-[11px] text-slate-400 font-mono">{rev.date}</span>
                    </div>
                  </div>

                  <!-- Star Icons -->
                  <div class="flex items-center gap-1 text-amber-500 bg-white px-2.5 py-1 rounded-full shadow-2xs">
                    {Array.from({ length: rev.rating }).map(() => (
                      <Star class="w-3.5 h-3.5 fill-amber-500" />
                    ))}
                  </div>
                </div>

                {rev.title && (
                  <h4 class="text-xs font-bold text-slate-900">{rev.title}</h4>
                )}

                <!-- Review Comment Text -->
                <p class="text-slate-800 leading-relaxed text-[13px] font-normal pt-1">
                  "{rev.content}"
                </p>

                <!-- Existing Developer Reply Box (If already answered) -->
                {rev.developerReply && (
                  <div class="p-4 bg-white rounded-xl border-l-4 border-blue-600 shadow-2xs space-y-1.5 mt-2">
                    <div class="flex items-center justify-between text-xs">
                      <div class="flex items-center gap-1.5 font-bold text-slate-900">
                        <CornerDownRight class="w-3.5 h-3.5 text-blue-600" />
                        <span>{developer?.display_name || 'Developer'} (Official Developer Response)</span>
                      </div>
                      <span class="text-slate-400 font-mono text-[11px]">{rev.developerReply.date}</span>
                    </div>
                    <p class="text-slate-600 text-xs leading-relaxed pl-5">
                      {rev.developerReply.text}
                    </p>
                  </div>
                )}

                <!-- Reply Action or Inline Reply Form (If unreplied) -->
                {!rev.developerReply && (
                  <div class="reply-container pt-1">
                    <button
                      type="button"
                      class="trigger-reply-btn px-3.5 py-1.5 bg-white hover:bg-slate-50 text-blue-600 hover:text-blue-700 border border-blue-200 rounded-xl font-semibold inline-flex items-center gap-1.5 cursor-pointer shadow-2xs transition-colors"
                      data-id={rev.id}
                    >
                      <CornerDownRight class="w-3.5 h-3.5 text-blue-600" />
                      <span>Reply as Developer</span>
                    </button>

                    <!-- Inline Reply Form (Hidden by default) -->
                    <div class="reply-form hidden mt-3 space-y-2.5 bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
                      <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold text-slate-800">
                          Official Developer Response:
                        </label>
                        <span class="text-[10px] text-slate-400">Publicly visible on store listing</span>
                      </div>

                      <textarea
                        rows="3"
                        placeholder={`Reply to ${rev.user} regarding their feedback...`}
                        class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-400 focus:outline-none leading-relaxed"
                      ></textarea>

                      <div class="flex items-center justify-between pt-1">
                        <span class="text-[11px] text-slate-400">Logged in as @{developer?.slug || user?.username || 'developer'}</span>
                        
                        <div class="flex items-center gap-2">
                          <button
                            type="button"
                            class="cancel-reply-btn px-3.5 py-1.5 text-slate-600 hover:bg-slate-100 rounded-lg font-medium cursor-pointer text-xs transition-colors"
                          >
                            Cancel
                          </button>
                          <button
                            type="button"
                            class="submit-reply-btn px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold cursor-pointer text-xs inline-flex items-center gap-1.5 shadow-2xs transition-colors"
                            data-id={rev.id}
                          >
                            <Send class="w-3 h-3 text-white" />
                            <span>Publish Reply</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

              </div>
            ))}
          </div>
        )}

      </section>

    </main>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Filtering & Reply Submission Scripts -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Filter Pills Handler
        const filterBtns = document.querySelectorAll('.filter-pill-btn');
        const reviewCards = document.querySelectorAll('.review-card');

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const filter = btn.getAttribute('data-filter') || 'all';

            filterBtns.forEach((b) => {
              b.classList.remove('bg-slate-900', 'text-white');
              b.classList.add('bg-white', 'text-slate-700');
            });
            btn.classList.add('bg-slate-900', 'text-white');
            btn.classList.remove('bg-white', 'text-slate-700');

            reviewCards.forEach((card) => {
              const rating = card.getAttribute('data-rating');
              const replied = card.getAttribute('data-replied');

              if (filter === 'all') {
                card.classList.remove('hidden');
              } else if (filter === 'unreplied') {
                card.classList.toggle('hidden', replied === 'true');
              } else {
                card.classList.toggle('hidden', rating !== filter);
              }
            });
          });
        });

        // 2. Search Handler
        const searchInput = document.getElementById('review-search-input') as HTMLInputElement | null;
        searchInput?.addEventListener('input', (e) => {
          const query = (searchInput.value || '').toLowerCase().trim();
          reviewCards.forEach((card) => {
            const text = card.getAttribute('data-text') || '';
            const user = card.getAttribute('data-user') || '';
            const matches = text.includes(query) || user.includes(query);
            card.classList.toggle('hidden', !matches);
          });
        });

        // 3. Inline Developer Reply Buttons
        const triggerBtns = document.querySelectorAll('.trigger-reply-btn');
        triggerBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const container = btn.closest('.reply-container');
            const form = container?.querySelector('.reply-form');
            btn.classList.add('hidden');
            form?.classList.remove('hidden');
          });
        });

        const cancelBtns = document.querySelectorAll('.cancel-reply-btn');
        cancelBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const container = btn.closest('.reply-container');
            const form = container?.querySelector('.reply-form');
            const trigger = container?.querySelector('.trigger-reply-btn');
            form?.classList.add('hidden');
            trigger?.classList.remove('hidden');
          });
        });

        const submitBtns = document.querySelectorAll('.submit-reply-btn');
        submitBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const container = btn.closest('.reply-container');
            const textarea = container?.querySelector('textarea');
            const replyText = textarea?.value.trim();

            if (replyText) {
              if (container) {
                container.innerHTML = `
                  <div class="p-4 bg-white rounded-xl border-l-4 border-blue-600 shadow-2xs space-y-1.5 mt-2">
                    <div class="flex items-center justify-between text-xs">
                      <div class="flex items-center gap-1.5 font-bold text-slate-900">
                        <span class="text-blue-600">↳</span>
                        <span>Official Developer Response</span>
                      </div>
                      <span class="text-slate-400 font-mono text-[11px]">Just now</span>
                    </div>
                    <p class="text-slate-600 text-xs leading-relaxed pl-5">
                      ${replyText}
                    </p>
                  </div>
                `;
              }
              alert('Your official developer reply has been published successfully!');
            }
          });
        });
      });
    </script>

  </body>
</html>
