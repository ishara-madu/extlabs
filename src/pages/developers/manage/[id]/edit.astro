---
// src/pages/developers/manage/[id]/edit.astro
import "../../../../styles/global.css";
import DeveloperNavbar from "../../../../components/DeveloperNavbar.astro";
import Footer from "../../../../components/Footer.astro";
import ExtensionEditor from "../../../../components/ExtensionEditor.astro";
import { ArrowLeft } from '@lucide/astro';
import { EXTENSIONS, getExtensionWithDefaults } from "../../../../data/extensions";
import { 
  getDb, 
  getDeveloperByUserIdOrSlug, 
  getDeveloperExtensionDetail,
  type ManageExtensionDetail
} from "../../../../lib/db";
import { getSessionUser } from "../../../../lib/auth";

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/developers/dashboard', 302);
}

// 1. Database Connection & Authentication
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

let developer = null;
let dbExtension: ManageExtensionDetail | null = null;

if (db) {
  try {
    if (user) {
      developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
    }
    dbExtension = await getDeveloperExtensionDetail(db, id, developer?.id);
  } catch (err) {
    console.error("Database error fetching extension for edit:", err);
  }
}

// Fallback to static catalog if record not in D1 (e.g. offline dev or seed testing)
const rawExtension = EXTENSIONS.find((item) => item.id === id || item.slug === id);

if (!dbExtension && !rawExtension) {
  return Astro.redirect('/developers/dashboard', 302);
}

const fallbackExt = rawExtension ? getExtensionWithDefaults(rawExtension) : null;

// Normalize extension detail
let parsedScreenshots: string[] = [];
if (dbExtension?.screenshots) {
  try {
    const s = typeof dbExtension.screenshots === 'string' ? JSON.parse(dbExtension.screenshots) : dbExtension.screenshots;
    if (Array.isArray(s)) parsedScreenshots = s;
  } catch {}
}
if (!parsedScreenshots.length && fallbackExt?.screenshots) {
  parsedScreenshots = fallbackExt.screenshots;
}

// Normalize features
let parsedFeatures = undefined;
if (dbExtension?.features) {
  try {
    const f = typeof dbExtension.features === 'string' ? JSON.parse(dbExtension.features) : dbExtension.features;
    if (Array.isArray(f) && f.length > 0) parsedFeatures = f;
  } catch {}
}
if (!parsedFeatures && fallbackExt?.features) {
  parsedFeatures = fallbackExt.features;
}

// Normalize workflow
let parsedWorkflow = undefined;
if (dbExtension?.workflow) {
  try {
    const w = typeof dbExtension.workflow === 'string' ? JSON.parse(dbExtension.workflow) : dbExtension.workflow;
    if (Array.isArray(w) && w.length > 0) parsedWorkflow = w;
  } catch {}
}
if (!parsedWorkflow && fallbackExt?.howItWorks) {
  parsedWorkflow = fallbackExt.howItWorks;
}

// Normalize comparison
let parsedComparison = undefined;
if (dbExtension?.comparison) {
  try {
    const c = typeof dbExtension.comparison === 'string' ? JSON.parse(dbExtension.comparison) : dbExtension.comparison;
    if (Array.isArray(c) && c.length > 0) parsedComparison = c;
  } catch {}
}
if (!parsedComparison && fallbackExt?.comparison) {
  parsedComparison = fallbackExt.comparison;
}

const ext = {
  id: dbExtension?.id || fallbackExt?.id || id,
  slug: dbExtension?.slug || fallbackExt?.slug || id,
  name: dbExtension?.name || fallbackExt?.name || 'Untitled Extension',
  version: dbExtension?.version_name || dbExtension?.current_version || fallbackExt?.version || '1.0.0',
  category: dbExtension?.category || fallbackExt?.category || 'Productivity',
  tagline: dbExtension?.short_description || fallbackExt?.tagline || fallbackExt?.shortDescription || '',
  description: dbExtension?.full_description || fallbackExt?.description || '',
  githubUrl: dbExtension?.source_repo_url || fallbackExt?.githubRepo || (user?.username ? `https://github.com/${user.username}/${id}` : ''),
  downloadUrl: dbExtension?.zip_download_url || dbExtension?.crx_download_url || fallbackExt?.downloadUrl || '',
  supportEmail: dbExtension?.support_email || user?.email || '',
  developerWebsite: developer?.website || (user?.username ? `https://github.com/${user.username}` : ''),
  docsUrl: dbExtension?.docs_url || '',
  monetagUrl: dbExtension?.monetag_direct_link || (fallbackExt?.monetagDirectLink) || '',
  frequency: "24h",
  iconUrl: dbExtension?.icon_url || fallbackExt?.iconUrl || '',
  promoTileUrl: dbExtension?.header_image_url || (fallbackExt as any)?.promoTileUrl || '',
  screenshots: parsedScreenshots.length > 0 ? parsedScreenshots : undefined,
  youtubeVideoUrl: dbExtension?.youtube_video_url || (fallbackExt as any)?.youtubeVideoUrl || '',
  features: parsedFeatures,
  workflow: parsedWorkflow,
  comparison: parsedComparison,
  status: dbExtension?.status || 'Production'
};
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Edit {ext.name} — ExtLabs Developer Console</title>
    <meta name="description" content={`Edit configuration and metadata for ${ext.name}.`} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true';
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Top Developer Navbar -->
    <DeveloperNavbar />

    <!-- Main Edit Workspace -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-8">
      
      <!-- Top Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors font-medium">
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Developer Console</span>
        </a>
        <span class="text-slate-300">/</span>
        <a href={`/developers/manage/${ext.slug || ext.id}`} class="hover:text-blue-600 transition-colors">
          {ext.name}
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">Edit Details</span>
      </div>

      <!-- Unified Editor Component (Prefilled with extension data) -->
      <ExtensionEditor 
        isEdit={true} 
        initialData={{
          id: ext.id,
          slug: ext.slug,
          name: ext.name,
          version: ext.version,
          category: ext.category,
          tagline: ext.tagline,
          description: ext.description,
          githubUrl: ext.githubUrl,
          downloadUrl: ext.downloadUrl,
          supportEmail: ext.supportEmail,
          developerWebsite: ext.developerWebsite,
          docsUrl: ext.docsUrl,
          monetagUrl: ext.monetagUrl,
          frequency: ext.frequency,
          iconUrl: ext.iconUrl,
          promoTileUrl: ext.promoTileUrl,
          status: ext.status
        }}
      />

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
