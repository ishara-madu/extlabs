---
// src/pages/developers/manage/[id]/edit.astro
import "../../../../styles/global.css";
import DeveloperNavbar from "../../../../components/DeveloperNavbar.astro";
import Footer from "../../../../components/Footer.astro";
import ExtensionEditor from "../../../../components/ExtensionEditor.astro";
import { ArrowLeft } from '@lucide/astro';
import { 
  getDb, 
  getDeveloperByUserIdOrSlug, 
  getDeveloperExtensionDetail,
  type ManageExtensionDetail
} from "../../../../lib/db";
import { getSessionUser } from "../../../../lib/auth";

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/developers/dashboard', 302);
}

// 1. Database Connection & Authentication
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

if (!user) {
  return Astro.redirect(`/developers/login?auth_required=true&redirect=${encodeURIComponent(`/developers/manage/${id}/edit`)}`, 302);
}

let developer = null;
let dbExtension: ManageExtensionDetail | null = null;

if (db) {
  try {
    if (user) {
      developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
    }
    dbExtension = await getDeveloperExtensionDetail(db, id, developer?.id);
  } catch (err) {
    console.error("Database error fetching extension for edit:", err);
  }
}

if (!dbExtension) {
  return Astro.redirect('/developers/dashboard', 302);
}

// Parse and merge any pending staged draft_data so developer edits their latest draft
let stagedDraft: any = null;
if (dbExtension.draft_data) {
  try {
    stagedDraft = typeof dbExtension.draft_data === 'string' ? JSON.parse(dbExtension.draft_data) : dbExtension.draft_data;
  } catch {}
}

const hasUnpublishedDraft = Boolean(stagedDraft && dbExtension.status === 'published');

// Normalize extension detail
const rawScreenshots = stagedDraft?.screenshots !== undefined ? stagedDraft.screenshots : dbExtension.screenshots;
let parsedScreenshots: string[] = [];
if (rawScreenshots) {
  try {
    const s = typeof rawScreenshots === 'string' ? JSON.parse(rawScreenshots) : rawScreenshots;
    if (Array.isArray(s)) parsedScreenshots = s;
  } catch {}
}

// Normalize features
const rawFeatures = stagedDraft?.features !== undefined ? stagedDraft.features : dbExtension.features;
let parsedFeatures = undefined;
if (rawFeatures) {
  try {
    const f = typeof rawFeatures === 'string' ? JSON.parse(rawFeatures) : rawFeatures;
    if (Array.isArray(f) && f.length > 0) parsedFeatures = f;
  } catch {}
}

// Normalize workflow
const rawWorkflow = stagedDraft?.workflow !== undefined ? stagedDraft.workflow : dbExtension.workflow;
let parsedWorkflow = undefined;
if (rawWorkflow) {
  try {
    const w = typeof rawWorkflow === 'string' ? JSON.parse(rawWorkflow) : rawWorkflow;
    if (Array.isArray(w) && w.length > 0) parsedWorkflow = w;
  } catch {}
}

// Normalize comparison
const rawComparison = stagedDraft?.comparison !== undefined ? stagedDraft.comparison : dbExtension.comparison;
let parsedComparison = undefined;
if (rawComparison) {
  try {
    const c = typeof rawComparison === 'string' ? JSON.parse(rawComparison) : rawComparison;
    if (Array.isArray(c) && c.length > 0) parsedComparison = c;
  } catch {}
}

// Normalize faqs
const rawFaqs = stagedDraft?.faqs !== undefined ? stagedDraft.faqs : dbExtension.faqs;
let parsedFaqs = undefined;
if (rawFaqs) {
  try {
    const f = typeof rawFaqs === 'string' ? JSON.parse(rawFaqs) : rawFaqs;
    if (Array.isArray(f) && f.length > 0) parsedFaqs = f;
  } catch {}
}

// Normalize supported browsers
const rawBrowsers = stagedDraft?.supported_browsers !== undefined ? stagedDraft.supported_browsers : dbExtension.supported_browsers;
let parsedBrowsers = undefined;
if (rawBrowsers) {
  try {
    const b = typeof rawBrowsers === 'string' ? JSON.parse(rawBrowsers) : rawBrowsers;
    if (Array.isArray(b) && b.length > 0) parsedBrowsers = b;
  } catch {}
}

const ext = {
  id: dbExtension.id || id,
  slug: dbExtension.slug || id,
  name: stagedDraft?.name ?? dbExtension.name ?? 'Untitled Extension',
  version: stagedDraft?.current_version ?? dbExtension.version_name ?? dbExtension.current_version ?? '1.0.0',
  category: stagedDraft?.category ?? dbExtension.category ?? 'Productivity',
  tagline: stagedDraft?.short_description ?? dbExtension.short_description ?? '',
  description: stagedDraft?.full_description ?? dbExtension.full_description ?? '',
  githubUrl: stagedDraft?.source_repo_url ?? dbExtension.source_repo_url ?? '',
  downloadUrl: stagedDraft?.zip_download_url !== undefined ? stagedDraft.zip_download_url : (dbExtension.zip_download_url || dbExtension.crx_download_url || ''),
  supportEmail: stagedDraft?.support_email ?? dbExtension.support_email ?? user?.email ?? '',
  developerWebsite: stagedDraft?.developer_website ?? dbExtension.developer_website ?? developer?.website ?? '',
  docsUrl: stagedDraft?.docs_url !== undefined ? stagedDraft.docs_url : (dbExtension.docs_url || ''),
  monetagUrl: stagedDraft?.monetag_direct_link ?? dbExtension.monetag_direct_link ?? developer?.default_monetag_url ?? '',
  frequency: stagedDraft?.ad_frequency ?? dbExtension.ad_frequency ?? developer?.default_frequency ?? "24h",
  manifestVersion: stagedDraft?.manifest_version ?? dbExtension.manifest_version ?? "v3",
  license: stagedDraft?.license ?? dbExtension.license ?? "MIT",
  supportedBrowsers: parsedBrowsers,
  privacyPolicyUrl: stagedDraft?.privacy_policy_url !== undefined ? stagedDraft.privacy_policy_url : (dbExtension.privacy_policy_url || ''),
  faqs: parsedFaqs,
  iconUrl: stagedDraft?.icon_url ?? dbExtension.icon_url ?? '',
  promoTileUrl: stagedDraft?.header_image_url ?? dbExtension.header_image_url ?? '',
  screenshots: parsedScreenshots.length > 0 ? parsedScreenshots : undefined,
  youtubeVideoUrl: stagedDraft?.youtube_video_url !== undefined ? stagedDraft.youtube_video_url : (dbExtension.youtube_video_url || ''),
  features: parsedFeatures,
  workflow: parsedWorkflow,
  comparison: parsedComparison,
  status: dbExtension.status === 'draft' ? 'Draft' : 'Production',
};
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Edit {ext.name} — ExtLabs Developer Console</title>
    <meta name="description" content={`Edit configuration and metadata for ${ext.name}.`} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true&redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Top Developer Navbar -->
    <DeveloperNavbar />

    <!-- Main Edit Workspace -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-6">
      
      <!-- Top Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors font-medium">
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Developer Console</span>
        </a>
        <span class="text-slate-300">/</span>
        <a href={`/developers/manage/${ext.slug || ext.id}`} class="hover:text-blue-600 transition-colors">
          {ext.name}
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">Edit Details</span>
      </div>

      <!-- Unpublished Draft Staging Indicator -->
      {hasUnpublishedDraft && (
        <div class="p-3.5 bg-blue-50/60 border border-blue-200/80 rounded-lg text-xs text-blue-900 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0"></span>
            <span><strong>Unpublished draft edits active.</strong> Store visitors see your live published listing until you click "Save & Publish Changes".</span>
          </div>
          <a href={`/extension/${ext.slug || ext.id}`} target="_blank" class="text-blue-700 hover:text-blue-900 font-medium underline shrink-0">
            View Live Listing &rarr;
          </a>
        </div>
      )}

      <!-- Unified Editor Component (Prefilled with extension data) -->
      <ExtensionEditor 
        isEdit={true} 
        initialData={{
          id: ext.id,
          slug: ext.slug,
          name: ext.name,
          version: ext.version,
          category: ext.category,
          tagline: ext.tagline,
          description: ext.description,
          githubUrl: ext.githubUrl,
          downloadUrl: ext.downloadUrl,
          supportEmail: ext.supportEmail,
          developerWebsite: ext.developerWebsite,
          docsUrl: ext.docsUrl,
          monetagUrl: ext.monetagUrl,
          frequency: ext.frequency,
          manifestVersion: ext.manifestVersion,
          license: ext.license,
          supportedBrowsers: ext.supportedBrowsers,
          privacyPolicyUrl: ext.privacyPolicyUrl,
          faqs: ext.faqs,
          iconUrl: ext.iconUrl,
          promoTileUrl: ext.promoTileUrl,
          screenshots: ext.screenshots,
          youtubeVideoUrl: ext.youtubeVideoUrl,
          features: ext.features,
          workflow: ext.workflow,
          comparison: ext.comparison,
          status: ext.status
        }}
      />

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
