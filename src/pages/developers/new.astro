// src/pages/developers/new.astro
export const prerender = false;
import "../../styles/global.css";
import DeveloperNavbar from "../../components/DeveloperNavbar.astro";
import Footer from "../../components/Footer.astro";
import ExtensionEditor from "../../components/ExtensionEditor.astro";
import { ArrowLeft } from '@lucide/astro';
import { getDb, getDeveloperByUserIdOrSlug } from "../../lib/db";
import { getSessionUser } from "../../lib/auth";

// Server-side Authentication & Developer Profile
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

if (!user) {
  return Astro.redirect('/developers/login?auth_required=true', 302);
}

let developer = null;
if (db && user) {
  try {
    developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
  } catch {}
}

const defaultDevWebsite = developer?.website || (user?.username ? `https://github.com/${user.username}` : '');
const defaultSupportEmail = user?.email || '';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Create New Extension — ExtLabs Developer Console</title>
    <meta name="description" content="Submit and publish a new browser extension to ExtLabs store directory." />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true';
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Top Developer Navbar -->
    <DeveloperNavbar />

    <!-- Main Submission Workspace -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-8">
      
      <!-- Top Breadcrumb -->
      <div>
        <a
          href="/developers/dashboard"
          class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-900 transition-colors font-medium"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Back to Console Dashboard</span>
        </a>
      </div>

      <!-- Unified Editor Component (Empty with smart placeholders) -->
      <ExtensionEditor isEdit={false} />

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
