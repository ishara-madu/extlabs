---
// src/pages/developers/new.astro
export const prerender = false;
import "../../styles/global.css";
import DeveloperNavbar from "../../components/DeveloperNavbar.astro";
import Footer from "../../components/Footer.astro";
import ExtensionEditor from "../../components/ExtensionEditor.astro";
import { ArrowLeft } from '@lucide/astro';
import { getDb, getDeveloperByUserIdOrSlug, getPlatformSetting } from "../../lib/db";
import { getSessionUser } from "../../lib/auth";
import { AlertCircle } from '@lucide/astro';

// Server-side Authentication & Developer Profile
const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

if (!user) {
  return Astro.redirect('/developers/login?auth_required=true&redirect=/developers/new', 302);
}

// Strictly prevent edge or browser caching of extension submission console
Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');
Astro.response.headers.set('Vary', 'Cookie');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

let developer = null;
let submissionsOpen = true;
if (db) {
  try {
    submissionsOpen = (await getPlatformSetting(db, 'submissions_open')) !== 'false';
  } catch {}
  if (user) {
    try {
      developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
    } catch {}
  }
}

const defaultDevWebsite = developer?.website || '';
const defaultSupportEmail = user?.email || '';
const defaultMonetagUrl = developer?.default_monetag_url || '';
const defaultFrequency = developer?.default_frequency || "24h";
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Create New Extension — ExtLabs Developer Console</title>
    <meta name="description" content="Submit and publish a new browser extension to ExtLabs store directory." />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true&redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Top Developer Navbar -->
    <DeveloperNavbar />

    <!-- Main Submission Workspace -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-8">
      
      <!-- Top Breadcrumb -->
      <div>
        <a
          href="/developers/dashboard"
          class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-900 transition-colors font-medium"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Back to Console Dashboard</span>
        </a>
      </div>

      { !submissionsOpen && (
        <div class="p-4 bg-amber-50/50 border border-amber-200/80 rounded-xl text-amber-900 text-xs flex items-start gap-3">
          <AlertCircle class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
          <div class="space-y-1">
            <span class="font-semibold block">Submissions Temporarily Paused</span>
            <p class="text-amber-700 leading-relaxed">
              Platform administrators have temporarily closed new package submissions for scheduled maintenance or queue processing. You can draft extensions, but submitting will be enabled once the review queue opens.
            </p>
          </div>
        </div>
      )}

      <!-- Unified Editor Component (Pre-filled with authenticated developer support defaults & Monetag settings) -->
      <ExtensionEditor 
        isEdit={false} 
        initialData={{
          supportEmail: defaultSupportEmail,
          developerWebsite: defaultDevWebsite,
          monetagUrl: defaultMonetagUrl,
          frequency: defaultFrequency
        }}
      />

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
