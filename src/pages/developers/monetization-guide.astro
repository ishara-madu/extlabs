    </main>

    <Footer />

    <script>
      document.querySelectorAll<HTMLDetailsElement>('details.faq-card').forEach((detail) => {
        detail.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (target && !target.closest('summary')) {
