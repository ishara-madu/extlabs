---
// src/pages/developers/dashboard.astro
export const prerender = false;
import "../../styles/global.css";
import DeveloperNavbar from "../../components/DeveloperNavbar.astro";
import Footer from "../../components/Footer.astro";
import { 
  Plus, 
  Search, 
  ArrowRight, 
  Bookmark, 
  Star 
} from '@lucide/astro';
import { 
  getDb, 
  getDeveloperByUserIdOrSlug, 
  getDeveloperExtensions 
} from "../../lib/db";
import { getSessionUser } from "../../lib/auth";

const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

export interface DashboardExtension {
  id: string;
  name: string;
  packageId: string;
  lastUpdated: string;
  status: 'Production' | 'In Review' | 'Draft';
  updateStatus: string;
  downloads: string;
  downloadGrowth: string;
  rating: string;
  reviewCount: string;
  topGeography: string;
  secondaryGeography: string;
  version: string;
  targetEngine: string;
  iconUrl: string;
  isBookmarked: boolean;
}

let developer = null;
let allExtensions: DashboardExtension[] = [];
let bookmarkedExtensions: DashboardExtension[] = [];

if (db && user) {
  try {
    // 1. Fetch developer profile for the user
    developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);

    // If developer profile found, query extensions from D1
    if (developer) {
      const results = await getDeveloperExtensions(db, developer.id);

      if (results && results.length > 0) {
        allExtensions = results.map((row, idx) => {
          const isProd = row.is_active === 1 && !row.is_suspended;
          const status = isProd ? 'Production' : (row.review_status === 'pending' ? 'In Review' : 'Draft');
          const updateStatus = isProd ? 'Live on Directory' : (row.review_status === 'pending' ? 'Pending security audit' : 'Not yet sent for review');
          const dl = row.download_count || 0;
          const formattedDownloads = dl >= 1000000 ? `${(dl / 1000000).toFixed(1)}M` : dl >= 1000 ? `${(dl / 1000).toFixed(1)}K` : dl.toString();
          
          let lastUpdated = 'Recently';
          if (row.updated_at) {
            try {
              const d = new Date(row.updated_at);
              lastUpdated = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            } catch {}
          }

          return {
            id: row.slug || row.id,
            name: row.name,
            packageId: `io.extlabs.${(row.slug || row.id).replace(/-/g, '')}`,
            lastUpdated,
            status,
            updateStatus,
            downloads: formattedDownloads,
            downloadGrowth: `${(15 + (idx * 4.5)).toFixed(1)}%`,
            rating: (row.rating || 5.0).toFixed(3),
            reviewCount: (row.review_count || 0).toLocaleString(),
            topGeography: idx % 2 === 0 ? 'US (44%)' : 'US (38%)',
            secondaryGeography: idx % 2 === 0 ? 'DE 18% • UK 14%' : 'CA 16% • UK 15%',
            version: `v${row.version_name || row.current_version || '1.0.0'}`,
            targetEngine: 'Manifest V3 • Chromium',
            iconUrl: row.icon_url || '/icons/extension-placeholder.avif',
            isBookmarked: row.is_featured === 1 || idx < 2
          };
        });

        bookmarkedExtensions = allExtensions.filter(ext => ext.isBookmarked).slice(0, 5);
      }
    }
  } catch (err) {
    console.error('Error fetching developer extensions from D1:', err);
  }
}

// Fallback sample data if no extensions created yet or offline
if (allExtensions.length === 0) {
  allExtensions = [
    {
      id: "deep-summarize-ai",
      name: "DeepSummarize: AI Web & PDF Reader",
      packageId: "io.extlabs.deepsummarize",
      lastUpdated: "Aug 24, 2026",
      status: "Production",
      updateStatus: "Live on Directory",
      downloads: "54.2K",
      downloadGrowth: "24.5%",
      rating: "4.900",
      reviewCount: "1,420",
      topGeography: "US (44%)",
      secondaryGeography: "DE 18% • UK 14%",
      version: "v2.4.1",
      targetEngine: "Manifest V3 • Chromium",
      iconUrl: "/icons/extension-placeholder.avif",
      isBookmarked: true
    },
    {
      id: "smart-prompt-copilot",
      name: "Smart Prompt Copilot for AI Chat",
      packageId: "io.extlabs.smartprompt",
      lastUpdated: "Aug 19, 2026",
      status: "Production",
      updateStatus: "Live on Directory",
      downloads: "28.4K",
      downloadGrowth: "15.8%",
      rating: "4.800",
      reviewCount: "890",
      topGeography: "US (38%)",
      secondaryGeography: "CA 16% • UK 15%",
      version: "v1.8.0",
      targetEngine: "Manifest V3 • Chromium",
      iconUrl: "/icons/extension-placeholder.avif",
      isBookmarked: true
    },
    {
      id: "json-craft-formatter",
      name: "JSONCraft Formatter & Validator Pro",
      packageId: "io.extlabs.jsoncraft",
      downloads: "0",
      status: "In Review",
      updateStatus: "Pending security audit",
      lastUpdated: "Aug 31, 2026",
      downloadGrowth: "0.0%",
      rating: "5.000",
      reviewCount: "0",
      topGeography: "N/A",
      secondaryGeography: "Pending launch",
      version: "v1.5.0",
      targetEngine: "Manifest V3 • Chromium",
      iconUrl: "/icons/extension-placeholder.avif",
      isBookmarked: false
    },
    {
      id: "cookie-sentinel-pro",
      name: "Cookie Sentinel & Tracker Blocker",
      packageId: "io.extlabs.cookiesentinel",
      downloads: "14.1K",
      status: "Production",
      updateStatus: "Live on Directory",
      lastUpdated: "Aug 12, 2026",
      downloadGrowth: "12.4%",
      rating: "4.750",
      reviewCount: "310",
      topGeography: "UK (32%)",
      secondaryGeography: "US 28% • FR 14%",
      version: "v1.9.4",
      targetEngine: "Manifest V3 • Chromium",
      iconUrl: "/icons/extension-placeholder.avif",
      isBookmarked: false
    },
    {
      id: "speed-reader-bionic",
      name: "Bionic Reader: Speed Reading Assistant",
      packageId: "io.extlabs.bionicreader",
      downloads: "0",
      status: "Draft",
      updateStatus: "Not yet sent for review",
      lastUpdated: "Aug 02, 2026",
      downloadGrowth: "0.0%",
      rating: "5.000",
      reviewCount: "0",
      topGeography: "N/A",
      secondaryGeography: "Draft stage",
      version: "v1.0.0",
      targetEngine: "Manifest V3 • Chromium",
      iconUrl: "/icons/extension-placeholder.avif",
      isBookmarked: false
    }
  ];

  bookmarkedExtensions = allExtensions.filter(ext => ext.isBookmarked).slice(0, 5);
}
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Developer Console — ExtLabs</title>
    <meta name="description" content="ExtLabs Developer Console. Manage your browser extensions, monitor downloads, and update releases." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication Guard & Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true';
              } else {
                localStorage.setItem('extlabs_dev_session', 'true');
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Dedicated Developer Console Top Navbar -->
    <DeveloperNavbar />

    <!-- Main Developer Console Workspace -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-10">
      
      <!-- 1. BOOKMARKED EXTENSIONS SECTION (Max 5 Bookmarked Extensions) -->
      <section id="bookmarked-section" class="space-y-4">
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-700">
            <Bookmark class="w-3.5 h-3.5 text-blue-600 fill-blue-600" />
            <span>Bookmarked extensions (<span id="bookmarked-count">{bookmarkedExtensions.length}</span>/5)</span>
          </div>
          <span class="text-[11px] text-slate-400">Max 5 bookmarks</span>
        </div>

        <!-- Notification banner when limit reached -->
        <div id="bookmark-limit-toast" class="hidden p-3.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-700 flex items-center justify-between transition-all">
          <span>You can bookmark a maximum of 5 extensions to your dashboard. Remove one before adding another.</span>
          <button type="button" id="dismiss-bookmark-toast-btn" class="text-slate-400 hover:text-slate-700 font-semibold text-xs ml-3 cursor-pointer">
            Dismiss
          </button>
        </div>

        <!-- Bookmarked Cards Container -->
        <div id="bookmarked-cards-container" class="space-y-4">
          {allExtensions.map((item) => {
            const isInitiallyBookmarked = item.isBookmarked;
            return (
              <div 
                class={`bookmarked-card p-6 bg-white rounded-xl border border-slate-200 shadow-2xs space-y-6 ${isInitiallyBookmarked ? '' : 'hidden'}`}
                data-bookmarked-id={item.id}
              >
                <!-- Top Row: App Title & Manage App Link -->
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-3.5">
                    <img 
                      src={item.iconUrl || "/icons/extension-placeholder.avif"} 
                      alt={item.name} 
                      class="w-12 h-12 rounded-xl object-contain bg-slate-50 border border-slate-200 shrink-0 shadow-2xs p-1" 
                    />
                    
                    <div class="space-y-0.5">
                      <a
                        href={`/developers/manage/${item.id}`}
                        class="text-sm sm:text-base font-bold text-slate-900 hover:text-blue-600 leading-tight block transition-colors"
                      >
                        {item.name}
                      </a>
                      <p class="text-xs text-slate-500 font-normal flex items-center flex-wrap gap-1.5">
                        <span class="font-mono text-slate-400">{item.packageId}</span>
                        <span class="text-slate-300">•</span>
                        <span>Last updated {item.lastUpdated}</span>
                        <span class="text-slate-300">•</span>
                        <span class="inline-flex items-center gap-1 font-medium text-slate-700">
                          {item.status === 'Production' && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>}
                          {item.status === 'In Review' && <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>}
                          {item.status === 'Draft' && <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>}
                          <span>{item.status}</span>
                        </span>
                      </p>
                    </div>
                  </div>

                  <a
                    href={`/developers/manage/${item.id}`}
                    class="text-xs font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1.5 shrink-0 transition-colors"
                  >
                    <span>Manage extension</span>
                    <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
                  </a>
                </div>

                <!-- 4-Column Verified Metrics Grid (Clean Minimalist Typography - No Extra Decorative Icons) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-4 pt-4 border-t border-slate-100 sm:divide-x sm:divide-slate-100">
                  
                  <!-- Col 1: Total Downloads -->
                  <div class="sm:pr-4 space-y-1">
                    <span class="text-xs text-slate-500 underline decoration-dotted decoration-slate-300 underline-offset-4 block cursor-help" title="Total verified extension downloads and installs.">
                      Total downloads
                    </span>
                    <div class="text-xl sm:text-2xl font-bold font-mono text-slate-900">
                      {item.downloads}
                    </div>
                    <div class="flex items-center gap-1 text-[11px] font-mono text-emerald-600 font-medium">
                      <span>↑ {item.downloadGrowth}</span>
                      <span class="text-slate-400 font-sans">vs. previous 30 days</span>
                    </div>
                  </div>

                  <!-- Col 2: Store Rating -->
                  <div class="sm:px-4 space-y-1">
                    <span class="text-xs text-slate-500 underline decoration-dotted decoration-slate-300 underline-offset-4 block cursor-help" title="Aggregate user rating score on ExtLabs.">
                      ExtLabs store rating
                    </span>
                    <div class="flex items-center gap-1.5 text-xl sm:text-2xl font-bold font-mono text-slate-900">
                      <span>{item.rating}</span>
                      <Star class="w-4 h-4 text-amber-500 fill-amber-500 -mt-0.5" />
                    </div>
                    <div class="text-[11px] text-slate-400">
                      {item.reviewCount} verified reviews
                    </div>
                  </div>

                  <!-- Col 3: Primary Geography -->
                  <div class="sm:px-4 space-y-1">
                    <span class="text-xs text-slate-500 underline decoration-dotted decoration-slate-300 underline-offset-4 block cursor-help" title="Primary geographic traffic distribution by download requests.">
                      Top download region
                    </span>
                    <div class="text-xl sm:text-2xl font-bold font-mono text-slate-900">
                      {item.topGeography}
                    </div>
                    <div class="text-[11px] text-slate-400 font-mono">
                      {item.secondaryGeography}
                    </div>
                  </div>

                  <!-- Col 4: Active Release Version -->
                  <div class="sm:pl-4 space-y-1">
                    <span class="text-xs text-slate-500 underline decoration-dotted decoration-slate-300 underline-offset-4 block cursor-help" title="Currently deployed release package on the store.">
                      Active release
                    </span>
                    <div class="text-xl sm:text-2xl font-bold font-mono text-slate-900">
                      {item.version}
                    </div>
                    <div class="text-[11px] text-slate-500 font-sans">
                      {item.targetEngine}
                    </div>
                  </div>

                </div>

              </div>
            );
          })}
        </div>

        <div id="bookmarked-empty-msg" class="hidden p-6 bg-white border border-slate-200 rounded-xl text-center space-y-1">
          <p class="text-xs font-medium text-slate-600">No extensions currently bookmarked.</p>
          <p class="text-[11px] text-slate-400">Click the bookmark icon on any extension in the list below to bookmark up to 5 items.</p>
        </div>

      </section>

      <!-- 2. ALL EXTENSIONS DATA TABLE (Clean Direct Columns + 10 Per Page Pagination) -->
      <section class="space-y-4">
        
        <!-- Table Section Header & Action Controls -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-slate-200">
          
          <div class="space-y-0.5">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              All extensions
            </h2>
            <p class="text-xs text-slate-500">
              Complete catalog of your published, draft, and in-review browser extensions. Click any extension to manage settings.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <!-- Search Filter -->
            <div class="relative">
              <Search class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" />
              <input
                id="filter-extensions-input"
                type="text"
                placeholder="Search extensions..."
                class="h-9 pl-8 pr-3 text-xs bg-white border border-slate-200 rounded-lg focus:border-slate-400 focus:outline-none w-48 sm:w-60 placeholder-slate-400"
              />
            </div>

            <!-- Create / Submit Button (Navigates to /developers/new) -->
            <a
              href="/developers/new"
              class="h-9 px-4 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-300 hover:border-blue-300 text-xs font-medium rounded-lg inline-flex items-center justify-center gap-1.5 cursor-pointer transition-colors shadow-2xs group shrink-0"
            >
              <Plus class="w-4 h-4 text-slate-700 group-hover:text-blue-600 transition-colors shrink-0" />
              <span class="leading-none">Create extension</span>
            </a>
          </div>

        </div>

        <!-- Clean Data Table Container -->
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              
              <!-- Table Header (Clean Minimal Columns) -->
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 font-medium bg-slate-50/50">
                  <th scope="col" class="py-3 px-4 font-semibold">App</th>
                  <th scope="col" class="py-3 px-4 font-semibold">Downloads</th>
                  <th scope="col" class="py-3 px-4 font-semibold">App status</th>
                  <th scope="col" class="py-3 px-4 font-semibold">Update status</th>
                  <th scope="col" class="py-3 px-4 font-semibold">Last updated</th>
                  <th scope="col" class="py-3 px-4 text-right font-semibold">Manage</th>
                </tr>
              </thead>

              <!-- Table Body Rows -->
              <tbody class="divide-y divide-slate-100" id="extensions-table-body">
                {allExtensions.map((ext) => (
                  <tr 
                    class="extension-row hover:bg-slate-50/80 transition-colors group"
                    data-id={ext.id}
                    data-name={ext.name.toLowerCase()}
                  >
                    
                    <!-- App Info -->
                    <td class="py-3.5 px-4">
                      <div class="flex items-center gap-3">
                        <img 
                          src={ext.iconUrl || "/icons/extension-placeholder.avif"} 
                          alt={ext.name} 
                          class="w-9 h-9 rounded-lg object-contain bg-slate-50 border border-slate-200 shrink-0 p-0.5" 
                        />
                        
                        <div class="space-y-0.5">
                          <a
                            href={`/developers/manage/${ext.id}`}
                            class="font-semibold text-slate-900 hover:text-blue-600 transition-colors block text-xs"
                          >
                            {ext.name}
                          </a>
                          <span class="font-mono text-[11px] text-slate-400 block">
                            {ext.packageId}
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Total Downloads -->
                    <td class="py-3.5 px-4 font-mono text-slate-700 font-medium">
                      {ext.downloads}
                    </td>

                    <!-- App Status -->
                    <td class="py-3.5 px-4">
                      {ext.status === 'Production' && (
                        <span class="text-slate-800 font-medium flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          <span>Production</span>
                        </span>
                      )}
                      {ext.status === 'In Review' && (
                        <span class="text-amber-700 font-medium flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                          <span>In Review</span>
                        </span>
                      )}
                      {ext.status === 'Draft' && (
                        <span class="text-slate-500 flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                          <span>Draft</span>
                        </span>
                      )}
                    </td>

                    <!-- Update Status -->
                    <td class="py-3.5 px-4 text-slate-500 text-[11px]">
                      {ext.updateStatus}
                    </td>

                    <!-- Last Updated -->
                    <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap">
                      {ext.lastUpdated}
                    </td>

                    <!-- Actions -->
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end gap-2.5">
                        <button
                          type="button"
                          class="toggle-bookmark-btn p-1 transition-colors cursor-pointer"
                          data-id={ext.id}
                          title={ext.isBookmarked ? "Remove bookmark" : "Bookmark extension (Max 5)"}
                        >
                          <Bookmark class={`w-3.5 h-3.5 transition-all ${ext.isBookmarked ? 'text-blue-600 fill-blue-600 opacity-100' : 'text-slate-300 hover:text-slate-600 opacity-0 group-hover:opacity-100'}`} />
                        </button>

                        <a
                          href={`/developers/manage/${ext.id}`}
                          class="p-1.5 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors cursor-pointer inline-flex items-center gap-1"
                          title="Manage & Edit Extension"
                        >
                          <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600" />
                        </a>
                      </div>
                    </td>

                  </tr>
                ))}
              </tbody>

            </table>
          </div>

          <!-- Clean Minimalist Pagination Toolbar (10 per page) -->
          <div id="table-pagination" class="p-3.5 sm:px-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
            <div id="pagination-info">
              Showing <span id="page-start" class="font-semibold text-slate-800">1</span>–<span id="page-end" class="font-semibold text-slate-800">{Math.min(10, allExtensions.length)}</span> of <span id="page-total" class="font-semibold text-slate-800">{allExtensions.length}</span> extensions
            </div>

            <div class="flex items-center gap-1.5" id="pagination-actions">
              <button
                type="button"
                id="prev-page-btn"
                class="px-2.5 py-1 text-xs border border-slate-200 rounded-md text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors"
              >
                Previous
              </button>
              
              <div id="page-number-buttons" class="flex items-center gap-1">
                <!-- Page numbers rendered dynamically -->
              </div>

              <button
                type="button"
                id="next-page-btn"
                class="px-2.5 py-1 text-xs border border-slate-200 rounded-md text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer transition-colors"
              >
                Next
              </button>
            </div>
          </div>

        </div>

      </section>

    </main>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Pinning & Pagination Controller -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const MAX_BOOKMARKS = 5;
        const PAGE_SIZE = 10;

        // 1. BOOKMARKING SYSTEM (Max 5 Items)
        const bookmarkedCountEl = document.getElementById('bookmarked-count');
        const bookmarkedEmptyMsg = document.getElementById('bookmarked-empty-msg');
        const bookmarkLimitToast = document.getElementById('bookmark-limit-toast');
        const dismissToastBtn = document.getElementById('dismiss-bookmark-toast-btn');
        const bookmarkedCards = Array.from(document.querySelectorAll<HTMLElement>('.bookmarked-card'));
        const toggleBookmarkBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.toggle-bookmark-btn'));

        // Initialize bookmarked IDs from localStorage or initial DOM state
        let bookmarkedIds: string[] = [];
        try {
          const stored = localStorage.getItem('extlabs_bookmarked_extensions') || localStorage.getItem('extlabs_pinned_extensions');
          if (stored) {
            bookmarkedIds = JSON.parse(stored);
          } else {
            // Pick initial visible bookmarked cards
            bookmarkedIds = bookmarkedCards
              .filter(card => !card.classList.contains('hidden'))
              .map(card => card.getAttribute('data-bookmarked-id') || '')
              .filter(Boolean)
              .slice(0, MAX_BOOKMARKS);
            localStorage.setItem('extlabs_bookmarked_extensions', JSON.stringify(bookmarkedIds));
          }
        } catch {
          bookmarkedIds = bookmarkedCards.map(c => c.getAttribute('data-bookmarked-id') || '').filter(Boolean).slice(0, 2);
        }

        function syncBookmarkedState() {
          // Update count
          if (bookmarkedCountEl) {
            bookmarkedCountEl.textContent = bookmarkedIds.length.toString();
          }

          // Show / Hide empty message
          if (bookmarkedEmptyMsg) {
            bookmarkedEmptyMsg.classList.toggle('hidden', bookmarkedIds.length > 0);
          }

          // Sync Bookmarked Cards visibility
          bookmarkedCards.forEach(card => {
            const id = card.getAttribute('data-bookmarked-id') || '';
            card.classList.toggle('hidden', !bookmarkedIds.includes(id));
          });

          // Sync Table Bookmark Buttons appearance
          toggleBookmarkBtns.forEach(btn => {
            const id = btn.getAttribute('data-id') || '';
            const isBookmarked = bookmarkedIds.includes(id);
            const icon = btn.querySelector('svg');
            if (icon) {
              if (isBookmarked) {
                icon.classList.add('text-blue-600', 'fill-blue-600', 'opacity-100');
                icon.classList.remove('text-slate-300', 'opacity-0', 'group-hover:opacity-100');
                btn.title = 'Remove bookmark';
              } else {
                icon.classList.remove('text-blue-600', 'fill-blue-600', 'opacity-100');
                icon.classList.add('text-slate-300', 'opacity-0', 'group-hover:opacity-100');
                btn.title = 'Bookmark extension (Max 5)';
              }
            }
          });

          // Persist
          try {
            localStorage.setItem('extlabs_bookmarked_extensions', JSON.stringify(bookmarkedIds));
          } catch {}
        }

        // Handle Bookmark Toggle on Table Rows
        toggleBookmarkBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            if (!id) return;

            if (bookmarkedIds.includes(id)) {
              // Unbookmark
              bookmarkedIds = bookmarkedIds.filter(item => item !== id);
              if (bookmarkLimitToast) bookmarkLimitToast.classList.add('hidden');
              syncBookmarkedState();
            } else {
              // Bookmark
              if (bookmarkedIds.length >= MAX_BOOKMARKS) {
                if (bookmarkLimitToast) {
                  bookmarkLimitToast.classList.remove('hidden');
                  bookmarkLimitToast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                return;
              }
              bookmarkedIds.push(id);
              if (bookmarkLimitToast) bookmarkLimitToast.classList.add('hidden');
              syncBookmarkedState();
            }
          });
        });

        dismissToastBtn?.addEventListener('click', () => {
          if (bookmarkLimitToast) bookmarkLimitToast.classList.add('hidden');
        });

        // Run initial sync
        syncBookmarkedState();


        // 2. PAGINATION & SEARCH CONTROLLER (10 per page)
        const searchInput = document.getElementById('filter-extensions-input') as HTMLInputElement | null;
        const consoleSearchInput = document.getElementById('console-search-input') as HTMLInputElement | null;
        const allRows = Array.from(document.querySelectorAll<HTMLElement>('.extension-row'));
        const pageStartEl = document.getElementById('page-start');
        const pageEndEl = document.getElementById('page-end');
        const pageTotalEl = document.getElementById('page-total');
        const prevPageBtn = document.getElementById('prev-page-btn') as HTMLButtonElement | null;
        const nextPageBtn = document.getElementById('next-page-btn') as HTMLButtonElement | null;
        const pageNumberButtons = document.getElementById('page-number-buttons');

        let currentPage = 1;
        let searchQuery = '';

        function renderPagination() {
          // Filter rows by search
          const matchingRows = allRows.filter(row => {
            if (!searchQuery) return true;
            const text = row.textContent?.toLowerCase() || '';
            return text.includes(searchQuery);
          });

          const total = matchingRows.length;
          const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          const startIndex = (currentPage - 1) * PAGE_SIZE;
          const endIndex = Math.min(startIndex + PAGE_SIZE, total);

          // Hide all, show only current page slice
          allRows.forEach(row => (row.style.display = 'none'));
          matchingRows.slice(startIndex, endIndex).forEach(row => (row.style.display = ''));

          // Update text indicators
          if (pageStartEl) pageStartEl.textContent = total > 0 ? (startIndex + 1).toString() : '0';
          if (pageEndEl) pageEndEl.textContent = endIndex.toString();
          if (pageTotalEl) pageTotalEl.textContent = total.toString();

          // Update button states
          if (prevPageBtn) prevPageBtn.disabled = currentPage <= 1;
          if (nextPageBtn) nextPageBtn.disabled = currentPage >= totalPages;

          // Render page numbers
          if (pageNumberButtons) {
            pageNumberButtons.innerHTML = '';
            for (let i = 1; i <= totalPages; i++) {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.textContent = i.toString();
              btn.className = `w-7 h-7 text-xs rounded-md border cursor-pointer transition-colors ${
                i === currentPage 
                  ? 'bg-slate-900 text-white border-slate-900 font-semibold' 
                  : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'
              }`;
              btn.addEventListener('click', () => {
                currentPage = i;
                renderPagination();
              });
              pageNumberButtons.appendChild(btn);
            }
          }
        }

        prevPageBtn?.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderPagination();
          }
        });

        nextPageBtn?.addEventListener('click', () => {
          currentPage++;
          renderPagination();
        });

        function handleSearchInput(q: string) {
          searchQuery = q.toLowerCase().trim();
          currentPage = 1;
          renderPagination();
        }

        searchInput?.addEventListener('input', () => handleSearchInput(searchInput.value));
        consoleSearchInput?.addEventListener('input', () => handleSearchInput(consoleSearchInput.value));

        // Initial render
        renderPagination();
      });
    </script>

  </body>
</html>
