---
// src/pages/developers/settings.astro
export const prerender = false;
import "../../styles/global.css";
import DeveloperNavbar from "../../components/DeveloperNavbar.astro";
import Footer from "../../components/Footer.astro";
import { getDb, getDeveloperByUserIdOrSlug, type DbDeveloper } from "../../lib/db";
import { getSessionUser } from "../../lib/auth";
import { 
  ShieldCheck, 
  ArrowLeft,
  Save,
  Copy,
  Check,
  ChevronDown,
  RefreshCw,
  ExternalLink
} from '@lucide/astro';

const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

let developer: DbDeveloper | null = null;
if (db && user) {
  try {
    developer = await getDeveloperByUserIdOrSlug(db, user.id, user.username);
  } catch (err) {
    console.error("Error fetching developer profile in settings:", err);
  }
}

// Studio / Developer Name: ONLY normal GitHub name (username is not used here)
const devName = developer?.display_name || user?.name || user?.username || "Developer";
// GitHub Handle (Linked): Username with @
const devHandleRaw = developer?.slug || user?.username || "developer";
const devHandle = `@${devHandleRaw}`;
const devGithubProfileUrl = `https://github.com/${devHandleRaw}`;
// Public Support Email
const devEmail = user?.email || "";

// Website / Portfolio URL:
// 1. If user has a website saved in D1 (and not the old dummy seed), use it.
// 2. Otherwise, check GitHub profile API for user website (blog).
// 3. Fallback strictly to GitHub profile URL (always available since auth is via GitHub).
let devWebsite = developer?.website?.trim() || "";

if (!devWebsite || devWebsite === devGithubProfileUrl || devWebsite === "https://extlabs.io") {
  if (devHandleRaw && devHandleRaw !== "developer") {
    try {
      const ghRes = await fetch(`https://api.github.com/users/${devHandleRaw}`, {
        headers: {
          'User-Agent': 'ExtLabs-Directory',
          'Accept': 'application/vnd.github+json'
        }
      });
      if (ghRes.ok) {
        const ghData = (await ghRes.json()) as any;
        const blogUrl = ghData?.blog?.trim();
        if (blogUrl) {
          devWebsite = (blogUrl.startsWith('http://') || blogUrl.startsWith('https://'))
            ? blogUrl
            : `https://${blogUrl}`;
        }
      }
    } catch (e) {
      // Fallback
    }
  }
}

if (!devWebsite || devWebsite === "https://extlabs.io") {
  devWebsite = devGithubProfileUrl;
}

// Avatar URL
const devAvatar = developer?.avatar_url || user?.avatar_url || "/icons/github-profile-placeholder.avif";
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Developer Settings — ExtLabs</title>
    <meta name="description" content="Manage your ExtLabs developer profile, default Monetag links, GitHub release webhooks, and API access tokens." />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Client-side Authentication & Profile Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          fetch('/api/auth/me')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (!data.authenticated) {
                localStorage.removeItem('extlabs_dev_session');
                window.location.href = '/developers/login?auth_required=true';
              } else if (data.user) {
                localStorage.setItem('extlabs_dev_session', 'true');
                var u = data.user;
                // Studio / Developer Name: ONLY normal GitHub name
                var nameEl = document.getElementById('dev-name');
                if (nameEl && u.name) nameEl.value = u.name;
                var dispName = document.getElementById('dev-profile-display-name');
                if (dispName && u.name) dispName.textContent = u.name;

                // GitHub Handle (Linked): Username with @
                var handleEl = document.getElementById('dev-handle');
                if (handleEl && u.username) handleEl.value = '@' + u.username;
                var handleLink = document.getElementById('dev-handle-link');
                if (handleLink && u.username) handleLink.href = 'https://github.com/' + u.username;
                var ghLink = document.getElementById('dev-profile-github-link');
                if (ghLink && u.username) {
                  ghLink.href = 'https://github.com/' + u.username;
                  ghLink.textContent = '@' + u.username;
                }

                // Public Support Email
                var emailEl = document.getElementById('dev-email');
                if (emailEl && u.email) emailEl.value = u.email;

                // Website / Portfolio URL: If user has a website in GitHub profile, use it; else fallback to GitHub profile
                var webEl = document.getElementById('dev-website');
                if (webEl) {
                  var savedProfile = null;
                  try {
                    savedProfile = JSON.parse(localStorage.getItem('extlabs_dev_profile') || '{}');
                  } catch (e) {}

                  if (savedProfile && savedProfile.website && savedProfile.website !== 'https://extlabs.io') {
                    webEl.value = savedProfile.website;
                  } else if (u.website && u.website !== ('https://github.com/' + u.username) && u.website !== 'https://extlabs.io') {
                    webEl.value = u.website;
                  } else {
                    fetch('https://api.github.com/users/' + u.username)
                      .then(function(res) { return res.json(); })
                      .then(function(ghData) {
                        if (ghData && ghData.blog && ghData.blog.trim()) {
                          var blog = ghData.blog.trim();
                          var formatted = (blog.startsWith('http://') || blog.startsWith('https://')) ? blog : 'https://' + blog;
                          webEl.value = formatted;
                        } else if (!webEl.value || webEl.value === 'https://extlabs.io') {
                          webEl.value = 'https://github.com/' + u.username;
                        }
                      })
                      .catch(function() {
                        if (!webEl.value || webEl.value === 'https://extlabs.io') {
                          webEl.value = 'https://github.com/' + u.username;
                        }
                      });
                  }
                }

                // Avatar
                var avEl = document.getElementById('dev-profile-avatar');
                if (avEl && u.avatarUrl) avEl.src = u.avatarUrl;
              }
            })
            .catch(function() {});
        }
      })();
    </script>

    <!-- Top Developer Navbar -->
    <DeveloperNavbar />

    <!-- Settings Main Container -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-6 sm:px-8 py-8 space-y-8">
      
      <!-- Top Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/developers/dashboard" class="hover:text-blue-600 inline-flex items-center gap-1 transition-colors font-medium">
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Developer Console</span>
        </a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">Settings</span>
      </div>

      <!-- Page Header -->
      <div class="space-y-1">
        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Developer Profile & Defaults
        </h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Manage your verified studio credentials, automated Monetag monetization streams, and webhook delivery endpoints.
        </p>
      </div>

      <form id="settings-form" class="space-y-10">
        
        <!-- 1. STUDIO / DEVELOPER PROFILE (Synchronized with GitHub) -->
        <section class="space-y-6">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              Developer Profile Information
            </h2>
            <p class="text-xs text-slate-500">
              Identity details publicly displayed on your extension store listings.
            </p>
          </div>

          <!-- Avatar & Header Strip -->
          <div class="flex items-center gap-4 p-4 bg-[#f0f4f9] rounded-2xl">
            <img
              id="dev-profile-avatar"
              src={devAvatar}
              alt="Developer Avatar"
              class="w-12 h-12 rounded-full border border-white shadow-2xs object-cover bg-white"
            />
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span id="dev-profile-display-name" class="text-xs sm:text-sm font-bold text-slate-900">{devName}</span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-medium bg-blue-50 text-blue-700 border border-blue-200 rounded-full">
                  <ShieldCheck class="w-3 h-3 text-blue-600" />
                  <span>GitHub Verified</span>
                </span>
              </div>
              <p class="text-xs text-slate-400 font-mono">
                Avatar and authentication linked with GitHub <a id="dev-profile-github-link" href={devGithubProfileUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">{devHandle}</a>
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Studio Name: Normal GitHub Name ONLY -->
            <div class="space-y-1.5">
              <label for="dev-name" class="block text-xs font-semibold text-slate-700">
                Studio / Developer Name
              </label>
              <input
                id="dev-name"
                type="text"
                value={devName}
                placeholder="Developer Name"
                class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-slate-400 focus:outline-none text-slate-900 font-medium"
              />
            </div>

            <!-- GitHub Handle (Linked) -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="dev-handle" class="block text-xs font-semibold text-slate-700">
                  GitHub Handle (Linked)
                </label>
                <a
                  id="dev-handle-link"
                  href={devGithubProfileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] text-blue-600 hover:underline inline-flex items-center gap-0.5"
                >
                  <span>View GitHub</span>
                  <ExternalLink class="w-2.5 h-2.5" />
                </a>
              </div>
              <input
                id="dev-handle"
                type="text"
                value={devHandle}
                readonly
                class="w-full px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-600 font-mono cursor-not-allowed"
              />
            </div>

            <!-- Support Email -->
            <div class="space-y-1.5">
              <label for="dev-email" class="block text-xs font-semibold text-slate-700">
                Public Support Email
              </label>
              <input
                id="dev-email"
                type="email"
                value={devEmail}
                placeholder="support@example.com"
                class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-slate-400 focus:outline-none text-slate-900 font-mono"
              />
            </div>

            <!-- Developer Website -->
            <div class="space-y-1.5">
              <label for="dev-website" class="block text-xs font-semibold text-slate-700">
                Website / Portfolio URL
              </label>
              <input
                id="dev-website"
                type="url"
                value={devWebsite}
                placeholder="https://github.com/..."
                class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-slate-400 focus:outline-none text-slate-900 font-mono"
              />
            </div>
          </div>
        </section>

        <hr class="border-slate-200" />

        <!-- 2. MONETAG MONETIZATION DEFAULTS (With Custom Dropdown) -->
        <section class="space-y-6">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              Monetag Monetization Defaults
            </h2>
            <p class="text-xs text-slate-500">
              Configure your default Direct Link URL to automatically populate when submitting new extensions.
            </p>
          </div>

          <div class="space-y-5">
            <!-- Default Direct Link Input -->
            <div class="space-y-1.5">
              <label for="default-monetag-url" class="block text-xs font-semibold text-slate-700">
                Default Monetag Direct Link URL
              </label>
              <div class="flex gap-2">
                <input
                  id="default-monetag-url"
                  type="url"
                  value={developer?.default_monetag_url || "https://monetag.com/direct/54829103"}
                  placeholder="https://monetag.com/direct/your-publisher-link"
                  class="flex-1 px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono font-medium"
                />
                <button
                  type="button"
                  id="test-direct-link-btn"
                  class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer shrink-0"
                >
                  Test Link
                </button>
              </div>
              <p class="text-[11px] text-slate-400">
                New extensions created in your console will automatically inherit this direct link.
              </p>
            </div>

            <!-- Custom Clean Dropdown for Trigger Frequency -->
            <div class="space-y-1.5 relative" id="freq-dropdown-container">
              <label class="block text-xs font-semibold text-slate-700">
                Default Ad Tab Trigger Frequency
              </label>
              
              <!-- Hidden input to hold selected value -->
              <input type="hidden" id="default-frequency-input" name="default_frequency" value="24h" />

              <!-- Custom Trigger Button -->
              <button
                type="button"
                id="freq-dropdown-btn"
                class="w-full sm:w-96 px-3.5 py-2 text-xs bg-white hover:bg-slate-50 border border-slate-200 focus:border-slate-400 rounded-lg text-slate-800 flex items-center justify-between transition-colors cursor-pointer"
              >
                <div class="flex items-center gap-2 overflow-hidden">
                  <span id="freq-selected-label" class="font-medium text-slate-900 truncate">
                    Once every 24 hours per user (Recommended)
                  </span>
                </div>
                <ChevronDown class="w-3.5 h-3.5 text-slate-400 freq-chevron transition-transform duration-200 shrink-0 ml-2" />
              </button>

              <!-- Custom Dropdown Menu -->
              <div
                id="freq-dropdown-menu"
                class="hidden absolute left-0 mt-1.5 w-full sm:w-96 bg-white rounded-xl border border-slate-200 shadow-xl z-20 overflow-hidden divide-y divide-slate-100"
              >
                <!-- Option 1: On Every Download -->
                <div
                  class="freq-option p-3 hover:bg-slate-50 cursor-pointer transition-colors flex items-start justify-between gap-3"
                  data-value="download"
                  data-label="On every extension download (Max Monetization)"
                >
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-bold text-slate-900">On every download event</span>
                      <span class="px-1.5 py-0.2 text-[10px] font-semibold bg-emerald-100 text-emerald-700 rounded-full">Max Monetization</span>
                    </div>
                    <p class="text-[11px] text-slate-500 leading-snug">
                      Triggers the direct link tab each time a user downloads or updates the extension package.
                    </p>
                  </div>
                  <Check class="w-4 h-4 text-blue-600 freq-check shrink-0 mt-0.5 hidden" />
                </div>

                <!-- Option 2: Once every 24 hours -->
                <div
                  class="freq-option p-3 hover:bg-slate-50 cursor-pointer transition-colors flex items-start justify-between gap-3 bg-blue-50/40"
                  data-value="24h"
                  data-label="Once every 24 hours per user (Recommended)"
                >
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-bold text-slate-900">Once every 24 hours</span>
                      <span class="px-1.5 py-0.2 text-[10px] font-semibold bg-blue-100 text-blue-700 rounded-full">Recommended</span>
                    </div>
                    <p class="text-[11px] text-slate-500 leading-snug">
                      Opens direct link stream once per day on first active interaction. Best user retention.
                    </p>
                  </div>
                  <Check class="w-4 h-4 text-blue-600 freq-check shrink-0 mt-0.5" />
                </div>

                <!-- Option 3: Twice every 24 hours -->
                <div
                  class="freq-option p-3 hover:bg-slate-50 cursor-pointer transition-colors flex items-start justify-between gap-3"
                  data-value="12h"
                  data-label="Twice every 24 hours (12h cooldown)"
                >
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-bold text-slate-900">Twice every 24 hours</span>
                      <span class="text-[10px] text-slate-400 font-mono">12h cooldown</span>
                    </div>
                    <p class="text-[11px] text-slate-500 leading-snug">
                      Balanced frequency for high-frequency productivity tools with frequent tab switching.
                    </p>
                  </div>
                  <Check class="w-4 h-4 text-blue-600 freq-check shrink-0 mt-0.5 hidden" />
                </div>

                <!-- Option 4: Once per session -->
                <div
                  class="freq-option p-3 hover:bg-slate-50 cursor-pointer transition-colors flex items-start justify-between gap-3"
                  data-value="session"
                  data-label="Once per browser session startup"
                >
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5">
                      <span class="text-xs font-bold text-slate-900">Once per browser session</span>
                    </div>
                    <p class="text-[11px] text-slate-500 leading-snug">
                      Triggers only once when the user launches their browser window.
                    </p>
                  </div>
                  <Check class="w-4 h-4 text-blue-600 freq-check shrink-0 mt-0.5 hidden" />
                </div>
              </div>

            </div>
          </div>
        </section>

        <hr class="border-slate-200" />

        <!-- 3. NOTIFICATION PREFERENCES -->
        <section class="space-y-6">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              Notification & Alert Preferences
            </h2>
            <p class="text-xs text-slate-500">
              Select which events trigger in-console notifications and alerts.
            </p>
          </div>

          <div class="space-y-3.5 text-xs">
            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" checked class="mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
              <div class="space-y-0.5">
                <span class="font-medium text-slate-800">New User Reviews & Feedback</span>
                <p class="text-slate-500 text-[11px]">Notify when a verified user submits a review or rating on your extensions.</p>
              </div>
            </label>

            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" checked class="mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
              <div class="space-y-0.5">
                <span class="font-medium text-slate-800">Automated Manifest V3 Security Audits</span>
                <p class="text-slate-500 text-[11px]">Instant alert when a release passes or requires permission adjustment.</p>
              </div>
            </label>

            <label class="flex items-start gap-2.5 cursor-pointer">
              <input type="checkbox" checked class="mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
              <div class="space-y-0.5">
                <span class="font-medium text-slate-800">Download Milestones</span>
                <p class="text-slate-500 text-[11px]">Receive celebrations on reaching 10K, 50K, and 100K active download thresholds.</p>
              </div>
            </label>
          </div>
        </section>

        <!-- Save Button Action Bar (Directly below Notification Settings) -->
        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-200">
          <a
            href="/developers/dashboard"
            class="px-4 py-2 text-xs font-medium text-slate-600 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer"
          >
            Cancel
          </a>

          <button
            type="submit"
            id="save-settings-btn"
            class="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium rounded-lg transition-colors cursor-pointer shadow-2xs inline-flex items-center gap-1.5"
          >
            <Save class="w-3.5 h-3.5 text-white" />
            <span>Save settings</span>
          </button>
        </div>

        <hr class="border-slate-200" />

        <!-- 4. GITHUB RELEASE WEBHOOKS & AUTO-SYNC -->
        <section class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <h2 class="text-base font-bold text-slate-900 tracking-tight">
                GitHub Release Webhooks
              </h2>
              <p class="text-xs text-slate-500">
                Automatically sync and publish directory updates whenever you release a new tag on GitHub.
              </p>
            </div>

            <!-- Generate / Rotate Webhook Secret Button -->
            <button
              type="button"
              id="generate-new-webhook-secret-btn"
              class="px-3.5 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-300 hover:border-blue-300 rounded-lg text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto group"
            >
              <RefreshCw class="w-3.5 h-3.5 text-slate-500 group-hover:text-blue-600 transition-transform group-hover:rotate-180 duration-300" />
              <span>Rotate webhook secret</span>
            </button>
          </div>

          <div class="space-y-4">
            <!-- Webhook URL -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">
                Payload URL (Add this to your GitHub repository webhooks)
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  readonly
                  value="https://extlabs.io/api/v1/webhooks/github-release"
                  class="flex-1 px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg font-mono text-slate-700 cursor-text"
                />
                <button
                  type="button"
                  class="copy-token-btn px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0"
                  data-copy="https://extlabs.io/api/v1/webhooks/github-release"
                >
                  <Copy class="w-3.5 h-3.5 text-slate-500" />
                  <span>Copy</span>
                </button>
              </div>
            </div>

            <!-- Secret Key (With Reveal & Copy) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">
                Webhook Secret Key
              </label>
              <div class="flex items-center gap-2">
                <input
                  id="webhook-secret-input"
                  type="password"
                  readonly
                  value="whsec_extlabs_98f1274bc9a14820a3"
                  class="flex-1 px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg font-mono text-slate-700 cursor-text"
                />
                <button
                  type="button"
                  id="toggle-webhook-secret-btn"
                  class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer shrink-0"
                >
                  Reveal
                </button>
                <button
                  type="button"
                  id="copy-webhook-secret-btn"
                  class="copy-token-btn px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0"
                  data-copy="whsec_extlabs_98f1274bc9a14820a3"
                >
                  <Copy class="w-3.5 h-3.5 text-slate-500" />
                  <span>Copy</span>
                </button>
              </div>
            </div>

            <!-- Auto-publish Checkbox -->
            <label class="flex items-start gap-2.5 pt-1 cursor-pointer">
              <input
                type="checkbox"
                checked
                class="mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
              />
              <div class="space-y-0.5 text-xs">
                <span class="font-medium text-slate-800">Auto-publish verified releases</span>
                <p class="text-slate-500 text-[11px]">
                  Automatically deploy updates to ExtLabs once GitHub release passes automated Manifest V3 security validation.
                </p>
              </div>
            </label>
          </div>
        </section>

        <hr class="border-slate-200" />

        <!-- 5. API & CLI ACCESS TOKENS (With Generate New Key Button) -->
        <section class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1">
              <h2 class="text-base font-bold text-slate-900 tracking-tight">
                Personal API Access Token
              </h2>
              <p class="text-xs text-slate-500">
                Use this token in GitHub Actions CI or CLI to publish extension updates programmatically.
              </p>
            </div>

            <!-- Generate New Key Button -->
            <button
              type="button"
              id="generate-new-token-btn"
              class="px-3.5 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 border border-slate-300 hover:border-blue-300 rounded-lg text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0 self-start sm:self-auto group"
            >
              <RefreshCw class="w-3.5 h-3.5 text-slate-500 group-hover:text-blue-600 transition-transform group-hover:rotate-180 duration-300" />
              <span>Generate new key</span>
            </button>
          </div>

          <div class="space-y-3.5">
            <div class="flex items-center gap-2">
              <input
                id="api-token-input"
                type="password"
                readonly
                value="extlabs_pat_live_920485918237192038"
                class="flex-1 px-3.5 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg font-mono text-slate-700 cursor-text"
              />
              <button
                type="button"
                id="toggle-token-btn"
                class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer shrink-0"
              >
                Reveal
              </button>
              <button
                type="button"
                id="copy-api-token-btn"
                class="copy-token-btn px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-medium transition-colors cursor-pointer inline-flex items-center gap-1.5 shrink-0"
                data-copy="extlabs_pat_live_920485918237192038"
              >
                <Copy class="w-3.5 h-3.5 text-slate-500" />
                <span>Copy</span>
              </button>
            </div>

            <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg space-y-1">
              <span class="text-[11px] font-semibold text-slate-700 block font-mono">Terminal / CI deployment command:</span>
              <code class="text-[11px] font-mono text-slate-600 block">
                pnpm dlx extlabs deploy --package=extension.zip --token=extlabs_pat_...
              </code>
            </div>
          </div>
        </section>

        <hr class="border-slate-200" />

        <!-- 6. DANGER ZONE -->
        <section class="space-y-4">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-red-900 tracking-tight">
              Danger Zone
            </h2>
            <p class="text-xs text-slate-500">
              Irreversible actions related to your developer account and authentication.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-lg bg-red-50/40 border border-red-200/80">
            <div class="space-y-0.5">
              <span class="text-xs font-bold text-slate-900 block">Unlink GitHub Account</span>
              <p class="text-[11px] text-slate-500">
                Disconnects OAuth. You will need to re-authenticate with GitHub to access the developer console.
              </p>
            </div>
            <button
              type="button"
              onclick="alert('To unlink your GitHub account, please contact support@extlabs.io')"
              class="px-3.5 py-1.5 bg-white hover:bg-red-50 text-red-700 border border-red-200 rounded-lg text-xs font-medium transition-colors cursor-pointer shrink-0"
            >
              Unlink account
            </button>
          </div>
        </section>

      </form>

    </main>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Custom Dropdown, Token Generator, and Copy Scripts -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Custom Trigger Frequency Dropdown Controller
        const freqBtn = document.getElementById('freq-dropdown-btn');
        const freqMenu = document.getElementById('freq-dropdown-menu');
        const freqLabel = document.getElementById('freq-selected-label');
        const freqInput = document.getElementById('default-frequency-input') as HTMLInputElement | null;
        const freqChevron = document.querySelector('.freq-chevron');
        const freqOptions = document.querySelectorAll('.freq-option');

        if (freqBtn && freqMenu) {
          freqBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = freqMenu.classList.contains('hidden');
            freqMenu.classList.toggle('hidden');
            if (freqChevron) {
              freqChevron.classList.toggle('rotate-180', isHidden);
            }
          });

          freqOptions.forEach((option) => {
            option.addEventListener('click', (e) => {
              e.stopPropagation();
              const val = option.getAttribute('data-value') || '';
              const label = option.getAttribute('data-label') || '';

              if (freqInput) freqInput.value = val;
              if (freqLabel) freqLabel.textContent = label;

              // Update active highlight and checkmarks
              freqOptions.forEach((opt) => {
                opt.classList.remove('bg-blue-50/40');
                opt.querySelector('.freq-check')?.classList.add('hidden');
              });
              option.classList.add('bg-blue-50/40');
              option.querySelector('.freq-check')?.classList.remove('hidden');

              // Close dropdown
              freqMenu.classList.add('hidden');
              if (freqChevron) freqChevron.classList.remove('rotate-180');
            });
          });

          document.addEventListener('click', () => {
            freqMenu.classList.add('hidden');
            if (freqChevron) freqChevron.classList.remove('rotate-180');
          });
        }

        // 2. Generate New Token Handler
        const genBtn = document.getElementById('generate-new-token-btn');
        const tokenInput = document.getElementById('api-token-input') as HTMLInputElement | null;
        const copyTokenBtn = document.getElementById('copy-api-token-btn');

        if (genBtn && tokenInput) {
          genBtn.addEventListener('click', () => {
            const randomHex = Array.from(crypto.getRandomValues(new Uint8Array(12)))
              .map(b => b.toString(16).padStart(2, '0'))
              .join('');
            const newToken = `extlabs_pat_live_${randomHex}`;
            tokenInput.value = newToken;
            if (copyTokenBtn) {
              copyTokenBtn.setAttribute('data-copy', newToken);
            }
            alert('New API Access Token generated successfully! Make sure to copy it for your CI/CD pipelines.');
          });
        }

        // 3. Toggle Token Visibility (Reveal / Hide)
        const toggleTokenBtn = document.getElementById('toggle-token-btn');
        if (toggleTokenBtn && tokenInput) {
          toggleTokenBtn.addEventListener('click', () => {
            if (tokenInput.type === 'password') {
              tokenInput.type = 'text';
              toggleTokenBtn.textContent = 'Hide';
            } else {
              tokenInput.type = 'password';
              toggleTokenBtn.textContent = 'Reveal';
            }
          });
        }

        // 4. Rotate Webhook Secret Handler
        const rotateWebhookBtn = document.getElementById('generate-new-webhook-secret-btn');
        const webhookSecretInput = document.getElementById('webhook-secret-input') as HTMLInputElement | null;
        const copyWebhookBtn = document.getElementById('copy-webhook-secret-btn');

        if (rotateWebhookBtn && webhookSecretInput) {
          rotateWebhookBtn.addEventListener('click', () => {
            const randomHex = Array.from(crypto.getRandomValues(new Uint8Array(12)))
              .map(b => b.toString(16).padStart(2, '0'))
              .join('');
            const newSecret = `whsec_extlabs_${randomHex}`;
            webhookSecretInput.value = newSecret;
            if (copyWebhookBtn) {
              copyWebhookBtn.setAttribute('data-copy', newSecret);
            }
            alert('New GitHub Webhook Secret generated successfully! Please update this secret in your GitHub repository Webhook settings.');
          });
        }

        // 5. Toggle Webhook Secret Visibility (Reveal / Hide)
        const toggleWebhookSecretBtn = document.getElementById('toggle-webhook-secret-btn');
        if (toggleWebhookSecretBtn && webhookSecretInput) {
          toggleWebhookSecretBtn.addEventListener('click', () => {
            if (webhookSecretInput.type === 'password') {
              webhookSecretInput.type = 'text';
              toggleWebhookSecretBtn.textContent = 'Hide';
            } else {
              webhookSecretInput.type = 'password';
              toggleWebhookSecretBtn.textContent = 'Reveal';
            }
          });
        }

        // 6. Copy Token & Secret Buttons
        const copyBtns = document.querySelectorAll('.copy-token-btn');
        copyBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const copyText = btn.getAttribute('data-copy') || '';
            if (copyText) {
              navigator.clipboard.writeText(copyText);
              const label = btn.querySelector('span');
              if (label) {
                const prev = label.textContent;
                label.textContent = 'Copied!';
                setTimeout(() => {
                  label.textContent = prev;
                }, 1800);
              }
            }
          });
        });

        // 5. Test Direct Link Button
        const testBtn = document.getElementById('test-direct-link-btn');
        if (testBtn) {
          testBtn.addEventListener('click', () => {
            const urlInput = document.getElementById('default-monetag-url') as HTMLInputElement | null;
            if (urlInput && urlInput.value) {
              alert('Testing direct link endpoint... Status: HTTP 200 OK. Connection verified!');
            }
          });
        }

        // 6. Save Settings Form & Persist Profile to LocalStorage & D1
        const form = document.getElementById('settings-form');
        if (form) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const nameInput = document.getElementById('dev-name') as HTMLInputElement | null;
            const emailInput = document.getElementById('dev-email') as HTMLInputElement | null;
            const websiteInput = document.getElementById('dev-website') as HTMLInputElement | null;
            const monetagInput = document.getElementById('default-monetag-url') as HTMLInputElement | null;
            const freqInput = document.getElementById('default-frequency-input') as HTMLInputElement | null;
            
            const profileData = {
              name: nameInput?.value || 'Developer',
              email: emailInput?.value || '',
              website: websiteInput?.value || '',
              defaultMonetagUrl: monetagInput?.value?.trim() || '',
              defaultFrequency: freqInput?.value?.trim() || '24h'
            };
            localStorage.setItem('extlabs_dev_profile', JSON.stringify(profileData));
            if (profileData.defaultMonetagUrl) {
              localStorage.setItem('extlabs_default_monetag_url', profileData.defaultMonetagUrl);
            }

            try {
              const res = await fetch('/api/developers/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(profileData)
              });
              const data = await res.json();
              if (data.website && websiteInput) {
                websiteInput.value = data.website;
                profileData.website = data.website;
                localStorage.setItem('extlabs_dev_profile', JSON.stringify(profileData));
              }
            } catch (err) {}

            alert('Developer profile & settings saved successfully!');
          });
        }
      });
    </script>

  </body>
</html>
