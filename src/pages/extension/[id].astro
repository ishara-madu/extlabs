    {isAdmin && (
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const staffApproveBtn = document.getElementById('staff-approve-btn');
          const staffRejectBtn = document.getElementById('staff-reject-btn');

          if (staffApproveBtn) {
            staffApproveBtn.addEventListener('click', async () => {
              const extId = staffApproveBtn.getAttribute('data-id');
              const extName = staffApproveBtn.getAttribute('data-name');
              if (!extId) return;

              staffApproveBtn.disabled = true;
              staffApproveBtn.textContent = 'Approving...';

              try {
                const res = await fetch('/api/admin/extensions/review', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ extensionId: extId, action: 'approve' })
                });
                const data = await res.json();
                if (data.success) {
                  alert(`✓ Extension "${extName}" approved and published to ExtLabs Directory!`);
                  window.location.reload();
                } else {
                  alert(data.error || 'Failed to approve extension.');
                  staffApproveBtn.disabled = false;
                  staffApproveBtn.textContent = 'Approve & Publish';
                }
              } catch (err) {
                alert('Network error while communicating with server.');
                staffApproveBtn.disabled = false;
                staffApproveBtn.textContent = 'Approve & Publish';
              }
            });
          }

          if (staffRejectBtn) {
            staffRejectBtn.addEventListener('click', async () => {
              const extId = staffRejectBtn.getAttribute('data-id');
              const extName = staffRejectBtn.getAttribute('data-name');
              if (!extId) return;

              const reason = prompt(`Enter rejection reason for "${extName}":`, 'Package did not satisfy ExtLabs security or quality guidelines.');
              if (reason === null) return;

              staffRejectBtn.disabled = true;
              staffRejectBtn.textContent = 'Rejecting...';

              try {
                const res = await fetch('/api/admin/extensions/review', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ extensionId: extId, action: 'reject', reason: reason.trim() || 'Guidelines not met' })
                });
                const data = await res.json();
                if (data.success) {
                  alert(`✗ Extension "${extName}" rejected.`);
                  window.location.href = '/admin/pending-review';
                } else {
                  alert(data.error || 'Failed to reject extension.');
                  staffRejectBtn.disabled = false;
                  staffRejectBtn.textContent = 'Reject';
                }
              } catch (err) {
                alert('Network error while communicating with server.');
                staffRejectBtn.disabled = false;
                staffRejectBtn.textContent = 'Reject';
              }
            });
          }
        });
      </script>
    )}
