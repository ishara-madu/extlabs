---
export const prerender = false;

import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ExtensionCard from "../../components/ExtensionCard.astro";
import BrowserIcon from "../../components/BrowserIcon.astro";
import VerifiedBadge from "../../components/VerifiedBadge.astro";
import { getDb, getStoreExtensionByIdOrSlug, getStoreExtensionsByCategory, getUserReviewForExtension, getDeveloperByUserIdOrSlug } from "../../lib/db";
import { getReviewerUser, getSessionUser } from "../../lib/auth";
import { Star, BadgeCheck, ShieldCheck, Download, ExternalLink, AlertTriangle, Check, X, ChevronDown, ChevronLeft, ChevronRight, ArrowRight, HelpCircle, CheckCircle2, Mail, Image as ImageIcon, PenLine, Trash2, Terminal, Copy } from '@lucide/astro';
import { Image } from 'astro:assets';
import { marked } from 'marked';

const requestedId = Astro.params.id || '';
const db = getDb();

// Check if visiting user is the developer author or an authorized admin
let currentDeveloper = null;
let isAdmin = false;
if (db) {
  try {
    const sessionUser = await getSessionUser(db, Astro.request);
    if (sessionUser) {
      isAdmin = ['super_admin', 'moderator', 'security_auditor'].includes(sessionUser.role);
      currentDeveloper = await getDeveloperByUserIdOrSlug(db, sessionUser.id, sessionUser.username);
    }
  } catch {}
}

const rawExtension = await getStoreExtensionByIdOrSlug(db, requestedId, {
  allowDraftForDeveloperId: currentDeveloper?.id,
  allowAdminPreview: isAdmin,
});

if (!rawExtension) {
  return Astro.redirect('/');
}

const ext = rawExtension;
const isAuthor = Boolean(currentDeveloper && ext.developerId && currentDeveloper.id === ext.developerId);
const isPublishedLive = ext.status === 'published' && ext.isActive !== false && !ext.isSuspended;
const isDraftPreview = !isPublishedLive;

// Optimize: Only query DB for reviewer session if session cookie is present
const hasSessionCookie = Boolean(Astro.request.headers.get('Cookie')?.includes('extlabs_user_session='));
const currentUser = (db && hasSessionCookie) ? await getReviewerUser(db, Astro.request) : null;
const userReview = currentUser && db ? await getUserReviewForExtension(db, ext.id, currentUser.id) : null;

// Edge CDN Caching: Unauthenticated traffic served directly from Cloudflare Edge for 7 days (0 DB queries)
// Note: Draft previews, staff sessions, and author views are never cached by edge CDN
if (!currentUser && !isAdmin && !isAuthor && isPublishedLive) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=604800, stale-while-revalidate=86400');
  Astro.response.headers.set('Vary', 'Cookie');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store, must-revalidate');
}

const categoryExtensions = await getStoreExtensionsByCategory(db, ext.category);
const relatedExtensions = categoryExtensions.filter(e => e.id !== ext.id && e.id !== rawExtension.id).slice(0, 3);

const screenshotsList: string[] = Array.isArray(ext.screenshots) && ext.screenshots.length > 0 ? ext.screenshots : [];
const hasRating = (typeof ext.rating === 'number' && ext.rating > 0) || ext.reviewCount > 0;
const isNew = (() => {
  const dateStr = ext.createdDate || ext.updatedDate;
  if (!dateStr) return true;
  const d = new Date(dateStr).getTime();
  if (isNaN(d)) return true;
  const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;
  return (Date.now() - d) < thirtyDaysMs;
})();
const otherReviews = ext.reviews
  ? ext.reviews.filter(r => !currentUser || (r.userId !== currentUser.id && r.id !== userReview?.id))
  : [];
const hasReviews = Boolean((ext.reviews && ext.reviews.length > 0) || userReview);
const hasFaqs = Boolean(ext.faqs && ext.faqs.length > 0);
const showRatingsAndReviews = true;

const browserNameMap: Record<string, { id: string; name: string }> = {
  chrome: { id: 'chrome', name: 'Google Chrome' },
  brave: { id: 'brave', name: 'Brave' },
  edge: { id: 'edge', name: 'Microsoft Edge' },
  firefox: { id: 'firefox', name: 'Firefox' },
  arc: { id: 'arc', name: 'Arc' },
  opera: { id: 'opera', name: 'Opera' },
  safari: { id: 'safari', name: 'Safari' },
  vivaldi: { id: 'vivaldi', name: 'Vivaldi' },
};

const supportedBrowsersList = (Array.isArray(ext.supportedBrowsers) && ext.supportedBrowsers.length > 0)
  ? ext.supportedBrowsers.map((b: string) => browserNameMap[b.toLowerCase()] || { id: b.toLowerCase(), name: b })
  : [
      { id: 'chrome', name: 'Google Chrome' },
      { id: 'brave', name: 'Brave' },
      { id: 'edge', name: 'Microsoft Edge' },
      { id: 'firefox', name: 'Firefox' },
      { id: 'arc', name: 'Arc' },
      { id: 'opera', name: 'Opera' },
    ];

// Clean markdown for meta description
function stripMarkdown(md: string): string {
  if (!md) return '';
  return md
    .replace(/^#+\s+/gm, '')
    .replace(/(\*\*|__)(.*?)\1/g, '$2')
    .replace(/(\*|_)(.*?)\1/g, '$2')
    .replace(/`{1,3}[^`\n]+`{1,3}/g, '')
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
    .replace(/^[-*+]\s+/gm, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// Downgrade markdown headings to prevent duplicate h1 tags on page
function downgradeMarkdownHeadings(md: string): string {
  if (!md) return '';
  return md.replace(/^(#{1,4})\s+/gm, (match, hashes) => '##' + hashes + ' ');
}

// Deterministic vibrant background color for user initial avatar
function getAvatarBgColor(str?: string | null): string {
  const bgColors = [
    'bg-blue-600 text-white',
    'bg-emerald-600 text-white',
    'bg-violet-600 text-white',
    'bg-amber-600 text-white',
    'bg-rose-600 text-white',
    'bg-indigo-600 text-white',
    'bg-teal-600 text-white',
    'bg-purple-600 text-white',
    'bg-cyan-600 text-white',
  ];
  if (!str) return bgColors[0];
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return bgColors[Math.abs(hash) % bgColors.length];
}

// Extract clean uppercase initial letter
function getAvatarInitial(name?: string | null, email?: string | null, username?: string | null): string {
  const str = (name || username || email || 'U').trim();
  return str.charAt(0).toUpperCase() || 'U';
}

const cleanedOverview = stripMarkdown(ext.description || '');
const safeMarkdownDescription = downgradeMarkdownHeadings(ext.description || '');
const renderedOverviewHtml = safeMarkdownDescription ? await marked.parse(safeMarkdownDescription, { breaks: true, gfm: true }) : '';

const canonicalSlug = ext.slug || ext.id;
const canonicalUrl = `https://extlabs.io/extension/${canonicalSlug}`;

// Smart title: stays under 60-65 chars for Google SERP display limits
const pageTitle = ext.name.length > 42
  ? `${ext.name} | ExtLabs`
  : `${ext.name} — Free Browser Extension | ExtLabs`;

const metaDescription = (() => {
  if (ext.tagline && ext.tagline.length >= 50 && ext.tagline.length <= 155) {
    return ext.tagline.endsWith('.') ? ext.tagline : `${ext.tagline}.`;
  }
  if (ext.tagline && cleanedOverview) {
    const combined = `${ext.tagline} — ${cleanedOverview}`;
    if (combined.length <= 155) return combined;
    return combined.slice(0, 152).trim() + '...';
  }
  if (cleanedOverview) {
    if (cleanedOverview.length <= 155) return cleanedOverview;
    return cleanedOverview.slice(0, 152).trim() + '...';
  }
  return `Download ${ext.name} browser extension for Chrome, Edge, and Brave. Free direct package download verified safe on ExtLabs.`;
})();

const ogImageUrl = ext.headerImageUrl || screenshotsList[0] || ext.iconUrl || 'https://extlabs.io/favicon.svg';

// JSON-LD Schema.org Structured Data for SEO
const jsonLdGraph: any[] = [
  {
    "@type": "SoftwareApplication",
    "name": ext.name,
    "url": canonicalUrl,
    "image": ext.iconUrl || ogImageUrl,
    ...(screenshotsList.length > 0 ? { "screenshot": screenshotsList } : {}),
    ...(ext.downloadUrl && ext.downloadUrl !== '#' ? { "downloadUrl": ext.downloadUrl } : {}),
    "operatingSystem": "Chromium Browsers (Google Chrome, Microsoft Edge, Brave, Opera, Vivaldi)",
    "applicationCategory": "BrowserExtension",
    "applicationSubCategory": ext.categoryLabel || "Utilities",
    "softwareRequirements": "Google Chrome, Microsoft Edge, Brave, or Chromium-based browsers",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    ...(ext.reviewCount > 0 ? {
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": ext.rating.toFixed(1),
        "reviewCount": ext.reviewCount,
        "bestRating": "5",
        "worstRating": "1"
      }
    } : {}),
    "author": {
      "@type": "Organization",
      "name": ext.developer,
      ...(ext.developerSupport?.website ? { "url": ext.developerSupport.website } : {})
    },
    "softwareVersion": ext.version,
    "fileSize": ext.size,
    "dateModified": ext.updatedDate,
    "description": metaDescription
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://extlabs.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": ext.categoryLabel || "Extensions",
        "item": `https://extlabs.io/category/${ext.category || 'tools'}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": ext.name,
        "item": canonicalUrl
      }
    ]
  }
];

if (hasFaqs && ext.faqs) {
  jsonLdGraph.push({
    "@type": "FAQPage",
    "mainEntity": ext.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

if (Array.isArray(ext.howItWorks) && ext.howItWorks.length > 0) {
  jsonLdGraph.push({
    "@type": "HowTo",
    "name": `How to install and use ${ext.name}`,
    "step": ext.howItWorks.map((w: any, idx: number) => ({
      "@type": "HowToStep",
      "position": idx + 1,
      "name": w.title || `Step ${idx + 1}`,
      "itemListElement": [{
        "@type": "HowToDirection",
        "text": w.description || ''
      }]
    }))
  });
}

const jsonLdSchema = {
  "@context": "https://schema.org",
  "@graph": jsonLdGraph
};
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Resource Hints for Third-Party CDNs -->
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />

    <!-- Robots Meta Tag -->
    {isPublishedLive ? (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <!-- Primary SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={`${ext.tags.join(', ')}, ${ext.categoryLabel}, browser extension, chrome extension`} />
    <meta name="author" content={ext.developer} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${ext.name} preview`} />
    <meta property="og:site_name" content="ExtLabs" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@extlabs_io" />
    <meta property="twitter:creator" content="@extlabs_io" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    {isAdmin && isPublishedLive && (
      <div class="bg-slate-900 text-white border-b border-slate-800 px-6 py-2.5 text-xs shadow-xs">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="font-semibold text-emerald-400 uppercase tracking-wider text-[11px] font-mono">Staff Mode</span>
            <span class="text-slate-400 hidden sm:inline">•</span>
            <span class="text-slate-300">
              This extension is <strong class="text-emerald-300 font-semibold">Published &amp; Live</strong> on the public store directory.
            </span>
          </div>
          <div class="flex items-center gap-2.5 shrink-0" id="staff-admin-bar-actions">
            {ext.downloadUrl && ext.downloadUrl !== '#' && (
              <a
                href={ext.downloadUrl}
                target="_blank"
                download
                aria-label="Download Package (.zip)"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <Download class="w-3.5 h-3.5 text-slate-400" />
                <span>Download Package (.zip)</span>
              </a>
            )}
            {isAuthor ? (
              <a
                href={`/developers/manage/${ext.slug || ext.id}`}
                aria-label="Manage Extension"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>Manage Extension</span>
              </a>
            ) : (
              <a
                href="/admin/directory"
                aria-label="Live Directory"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <span>Live Directory</span>
              </a>
            )}
            <a
              href="/admin/pending-review"
              aria-label="Review Queue"
              class="px-2.5 py-1.5 text-slate-400 hover:text-white transition-colors text-xs inline-flex items-center gap-1"
            >
              <span>Review Queue</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>
    )}

    {isAuthor && !isAdmin && isPublishedLive && (
      <div class="bg-slate-900 text-white border-b border-slate-800 px-6 py-2.5 text-xs shadow-xs">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="text-slate-300">
              You are viewing your published extension on the store.
            </span>
          </div>
          <div class="flex items-center gap-2.5 shrink-0">
            <a
              href={`/developers/manage/${ext.slug || ext.id}`}
              aria-label="Manage Extension Console"
              class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
            >
              <span>Manage Extension Console</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>
    )}

    {isAdmin && !isPublishedLive && (
      <div class="bg-slate-900 text-white border-b border-slate-800 px-6 py-3 text-xs shadow-md">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class={`w-2 h-2 rounded-full ${ext.status === 'rejected' ? 'bg-rose-500' : ext.status === 'pending_review' ? 'bg-amber-400' : 'bg-slate-400'}`}></span>
            <span class={`font-semibold uppercase tracking-wider text-[11px] font-mono ${ext.status === 'rejected' ? 'text-rose-400' : ext.status === 'pending_review' ? 'text-amber-400' : 'text-slate-300'}`}>Staff Review Mode</span>
            <span class="text-slate-400 hidden sm:inline">•</span>
            <span class="text-slate-300">
              This extension is <strong class={ext.status === 'rejected' ? 'text-rose-300' : ext.status === 'pending_review' ? 'text-amber-300' : 'text-slate-200'}>{ext.status === 'pending_review' ? 'Pending Admin Approval' : (ext.status === 'rejected' ? 'Rejected' : 'Draft (Unpublished)')}</strong> and hidden from public store visitors.
            </span>
          </div>
          <div class="flex items-center gap-2.5 shrink-0" id="staff-admin-bar-actions">
            {ext.downloadUrl && ext.downloadUrl !== '#' && (
              <a
                href={ext.downloadUrl}
                target="_blank"
                download
                aria-label="Download Package (.zip)"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 text-xs font-medium inline-flex items-center gap-1.5 transition-colors"
              >
                <Download class="w-3.5 h-3.5 text-slate-400" />
                <span>Download Package (.zip)</span>
              </a>
            )}
            <button
              type="button"
              id="staff-approve-btn"
              data-id={ext.dbId || ext.id}
              data-name={ext.name}
              class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg transition-colors cursor-pointer text-xs"
            >
              Approve & Publish
            </button>
            {ext.status !== 'rejected' && (
              <button
                type="button"
                id="staff-reject-btn"
                data-id={ext.dbId || ext.id}
                data-name={ext.name}
                class="px-3 py-1.5 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 border border-rose-500/40 font-semibold rounded-lg transition-colors cursor-pointer text-xs"
              >
                Reject
              </button>
            )}
            <a
              href="/admin/pending-review"
              aria-label="Review Queue"
              class="px-2.5 py-1.5 text-slate-400 hover:text-white transition-colors text-xs inline-flex items-center gap-1"
            >
              <span>Review Queue</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>
    )}

    {isDraftPreview && !isAdmin && (
      <div class="bg-amber-50/90 border-b border-amber-200/80 px-6 py-2.5 text-xs text-amber-900">
        <div class="max-w-7xl mx-auto w-full flex items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <span class="font-semibold">
              {ext.status === 'pending_review' ? 'Submission In Review' : ext.status === 'rejected' ? 'Submission Rejected' : 'Draft Preview'}
            </span>
            <span class="text-amber-700 hidden sm:inline">
              — {ext.status === 'pending_review' 
                ? 'This extension is under review by ExtLabs administrators and not yet visible to public visitors.'
                : ext.status === 'rejected'
                ? 'This submission was rejected by moderation review. Please update and resubmit.'
                : 'This extension is currently in draft status and is not visible to public store visitors.'}
            </span>
          </div>
          <a href={`/developers/manage/${ext.slug || ext.id}/edit`} class="font-medium text-amber-900 hover:text-amber-950 underline shrink-0">
            Return to Editor &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- Main Content Area (Minimalist HyperUI & daisyUI Structure) -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 space-y-12">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <a href="/categories" class="hover:text-slate-900 transition-colors">Categories</a>
        <span class="text-slate-300">/</span>
        <a href={`/category/${ext.category}`} class="hover:text-slate-900 transition-colors">{ext.categoryLabel}</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium truncate max-w-xs">{ext.name}</span>
      </nav>

      <!-- 1. Header Section (Minimalist, Crisp Typography, Zero Card Boxing) -->
      <section class="space-y-4 pb-6 border-b border-slate-200">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          
          <!-- Left Info Block with Icon -->
          <div class="flex items-start gap-4 sm:gap-5 max-w-3xl">
            <Image
              src={ext.iconUrl || "/icons/extension-placeholder.avif"}
              alt={ext.name}
              width={80}
              height={80}
              loading="eager"
              class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-contain bg-white border border-slate-200/90 shadow-2xs p-1.5 shrink-0"
            />
            <div class="space-y-3">
              <div class="flex items-center gap-2 flex-wrap">
                <a
                  href={`/category/${ext.category}`}
                  class="text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 px-2.5 py-0.5 rounded transition-colors"
                >
                  {ext.categoryLabel}
                </a>

                <span class="text-xs text-slate-500 flex items-center gap-1">
                  <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
                  <span>Verified Safe</span>
                </span>
              </div>

              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight flex items-center gap-2">
                <span>{ext.name}</span>
                {ext.isVerified && (
                  <VerifiedBadge class="w-5 h-5 shrink-0 inline" />
                )}
              </h1>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {ext.tagline || cleanedOverview || ext.description}
              </p>

              <!-- Metrics -->
              <div class="flex items-center gap-3 text-xs text-slate-500 flex-wrap pt-0.5">
                {ext.reviewCount > 0 && ext.rating > 0 ? (
                  <>
                    <div class="flex items-center gap-1 font-semibold text-slate-800">
                      <Star class="w-3.5 h-3.5 text-amber-500 fill-amber-500" />
                      <span>{ext.rating.toFixed(1)}</span>
                      {showRatingsAndReviews ? (
                        <a href="#reviews-section" class="text-slate-500 hover:text-slate-900 underline font-normal">
                          ({ext.reviewCount.toLocaleString()})
                        </a>
                      ) : (
                        <span>({ext.reviewCount.toLocaleString()})</span>
                      )}
                    </div>
                    <span class="text-slate-300">•</span>
                  </>
                ) : (
                  <>
                    <div class="flex items-center gap-1.5">
                      {isNew ? (
                        <span class="font-semibold text-blue-600">New Release</span>
                      ) : (
                        <span class="font-mono text-slate-400">v{ext.version}</span>
                      )}
                      <span class="text-slate-300">•</span>
                      <a href="#reviews-section" class="text-slate-500 hover:text-slate-900 underline font-normal">
                        Be the first to review
                      </a>
                    </div>
                    <span class="text-slate-300">•</span>
                  </>
                )}

                {ext.userCount ? (
                  <>
                    <span>{ext.userCount}</span>
                    <span class="text-slate-300">•</span>
                  </>
                ) : null}

                <span>By {ext.developerSupport?.website ? (
                  <a
                    href={ext.developerSupport.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-800 hover:text-blue-600 font-medium hover:underline"
                  >
                    {ext.developer}
                  </a>
                ) : (
                  <strong class="text-slate-800 font-medium">{ext.developer}</strong>
                )}</span>
              </div>
            </div>
          </div>

          <!-- Right Action CTA Button -->
          <div class="space-y-1.5 shrink-0 flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-end">
            <button
              type="button"
              id="detail-download-btn"
              data-ext-id={ext.dbId || ext.id}
              data-ext-name={ext.name}
              data-ext-version={ext.version}
              data-ext-developer={ext.developer}
              data-has-monetag={ext.monetagUrl ? 'true' : 'false'}
              data-ad-frequency={ext.adFrequency || '24h'}
              data-download-url={ext.downloadUrl}
              data-manifest-version={ext.manifestVersion || 'v3'}
              class="w-full sm:w-auto px-6 py-3 bg-slate-900 hover:bg-black text-white text-xs sm:text-sm font-medium rounded-lg flex items-center justify-center gap-2 cursor-pointer transition-colors"
            >
              <Download class="w-4 h-4" />
              <span>Add to Browser</span>
            </button>

            <div class="flex flex-col items-center lg:items-end gap-1">
              <span class="text-[11px] text-slate-400 text-center lg:text-right">
                Free • Direct Package Download
              </span>
              <a
                href="/how-to-install"
                class="inline-flex items-center gap-1 text-[11px] text-slate-500 hover:text-blue-600 transition-colors"
              >
                <HelpCircle class="w-3 h-3 text-slate-400" />
                <span>How to install (.zip)?</span>
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- 2. Media Showcase: Direct Store Showcase Screenshots & Video Player -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            {ext.youtubeVideoId ? (
              <>
                <button
                  type="button"
                  id="tab-screenshot-btn"
                  class="media-tab-btn px-3 py-1 rounded text-xs font-medium bg-slate-900 text-white cursor-pointer transition-colors"
                >
                  Screenshots {screenshotsList.length > 0 ? `(${screenshotsList.length})` : ''}
                </button>
                <button
                  type="button"
                  id="tab-video-btn"
                  class="media-tab-btn px-3 py-1 rounded text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors"
                >
                  Video Demo
                </button>
              </>
            ) : (
              <span class="text-xs font-semibold text-slate-900">
                Store Showcase Screenshots
              </span>
            )}
          </div>

          <div class="flex items-center gap-2">
            {screenshotsList.length > 1 && (
              <span id="screenshot-counter" class="text-xs text-slate-500 font-mono">
                1 / {screenshotsList.length}
              </span>
            )}
            <span id="media-preview-badge" class="hidden sm:inline-block text-[11px] text-slate-400 font-mono">
              Showcase Preview
            </span>
          </div>
        </div>

        <!-- Media View 1: Store Showcase Screenshots Gallery (Never Promotional Shelf Banner) -->
        <div id="media-screenshot-view" class="space-y-3">
          {screenshotsList.length > 0 ? (
            <>
              <!-- Main Screenshot Frame -->
              <div class="w-full aspect-video rounded-xl overflow-hidden bg-slate-950 border border-slate-200 relative group flex items-center justify-center">
                <Image
                  id="main-screenshot-img"
                  src={screenshotsList[0]}
                  alt={`${ext.name} Store Screenshot 1`}
                  width={1280}
                  height={720}
                  class="w-full h-full object-contain select-none"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />

                {screenshotsList.length > 1 && (
                  <>
                    <button
                      type="button"
                      id="prev-screenshot-btn"
                      class="absolute left-3 top-1/2 -translate-y-1/2 p-2 rounded-lg bg-slate-900/75 hover:bg-slate-900 text-white cursor-pointer transition-colors shadow-sm focus:outline-none"
                      aria-label="Previous screenshot"
                    >
                      <ChevronLeft class="w-5 h-5" />
                    </button>
                    <button
                      type="button"
                      id="next-screenshot-btn"
                      class="absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-lg bg-slate-900/75 hover:bg-slate-900 text-white cursor-pointer transition-colors shadow-sm focus:outline-none"
                      aria-label="Next screenshot"
                    >
                      <ChevronRight class="w-5 h-5" />
                    </button>
                  </>
                )}
              </div>

              <!-- Thumbnails Selector Row -->
              {screenshotsList.length > 1 && (
                <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-0.5">
                  {screenshotsList.map((shot, idx) => (
                    <button
                      type="button"
                      class={`screenshot-thumb-btn shrink-0 w-20 sm:w-24 aspect-video rounded-lg overflow-hidden border cursor-pointer transition-all ${
                        idx === 0
                          ? 'border-slate-900 ring-1 ring-slate-900 opacity-100'
                          : 'border-slate-200 opacity-60 hover:opacity-100 hover:border-slate-400'
                      }`}
                      data-index={idx}
                      data-src={shot}
                      aria-label={`View screenshot ${idx + 1}`}
                    >
                      <Image
                        src={shot}
                        alt={`Thumbnail ${idx + 1}`}
                        width={96}
                        height={54}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="w-full aspect-video rounded-xl overflow-hidden bg-slate-100 border border-slate-200 flex flex-col items-center justify-center text-slate-400 p-6 text-center space-y-2">
              <ImageIcon class="w-8 h-8 text-slate-300" />
              <span class="text-xs font-medium text-slate-500">No store showcase screenshots available</span>
            </div>
          )}
        </div>

        <!-- Media View 2: YouTube Video Player Embed -->
        {ext.youtubeVideoId && (
          <div id="media-video-view" class="hidden w-full aspect-video rounded-xl overflow-hidden bg-slate-950 border border-slate-200 relative">
            <iframe
              id="youtube-iframe"
              class="w-full h-full"
              data-src={`https://www.youtube-nocookie.com/embed/${ext.youtubeVideoId}?rel=0&modestbranding=1`}
              title={`${ext.name} Video Demo`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}
      </section>

      <!-- 3. Top 2-Column Section (Content Left + Clean Specs Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column (8 Cols): Overview, Core Features & Internal Workflow (Open Layout) -->
        <div class="lg:col-span-8 space-y-10">
          
          <!-- Overview -->
          <section class="space-y-3">
            <h2 class="text-base font-bold text-slate-900 tracking-tight border-b border-slate-200 pb-2">
              Overview
            </h2>
            <div
              class="overview-markdown-content text-xs sm:text-sm text-slate-700 leading-relaxed"
              set:html={renderedOverviewHtml}
            />
          </section>

          <!-- Core Features (Open Typographic Grid - Only if features exist) -->
          {ext.features && ext.features.length > 0 && (
            <section class="space-y-4">
              <h2 class="text-base font-bold text-slate-900 tracking-tight border-b border-slate-200 pb-2">
                Features & Capabilities
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                {ext.features.map((feat) => (
                  <div class="space-y-1">
                    <h3 class="text-xs font-semibold text-slate-900 flex items-center gap-1.5" aria-label={feat.title || 'Feature'}>
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                      <span>{feat.title}</span>
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed pl-3">
                      {feat.description}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Internal Execution Flow (Only if workflow exists) -->
          {ext.howItWorks && ext.howItWorks.length > 0 && (
            <section class="space-y-4">
              <div class="border-b border-slate-200 pb-2">
                <h2 class="text-base font-bold text-slate-900 tracking-tight">
                  Internal Execution Workflow
                </h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {ext.howItWorks.map((step) => (
                  <div class="space-y-1.5">
                    <span class="text-[11px] font-mono font-medium text-slate-400">Stage 0{step.step}</span>
                    <h3 class="text-xs font-semibold text-slate-900" aria-label={step.title || 'Workflow Stage'}>
                      {step.title}
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                      {step.description}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

        </div>

        <!-- Right Column (4 Cols): HyperUI Definition List Specs -->
        <aside class="lg:col-span-4 sticky top-6 self-start">
          
          <div class="rounded-lg border border-slate-200 bg-white p-5 space-y-5">
            
            <!-- Specs -->
            <div class="space-y-3">
              <h2 class="text-xs font-semibold text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2" aria-label="Specifications">
                Specifications
              </h2>

              <dl class="divide-y divide-slate-100 text-xs">
                {ext.version && (
                  <div class="flex items-center justify-between py-1.5">
                    <dt class="text-slate-500">Version</dt>
                    <dd class="font-mono text-slate-800 font-medium">{ext.version}</dd>
                  </div>
                )}

                {ext.size && (
                  <div class="flex items-center justify-between py-1.5">
                    <dt class="text-slate-500">Size</dt>
                    <dd class="font-mono text-slate-800">{ext.size}</dd>
                  </div>
                )}

                {ext.updatedDate && (
                  <div class="flex items-center justify-between py-1.5">
                    <dt class="text-slate-500">Updated</dt>
                    <dd class="text-slate-700">{ext.updatedDate}</dd>
                  </div>
                )}

                <div class="flex items-center justify-between py-1.5">
                  <dt class="text-slate-500">Standard</dt>
                  <dd class="text-slate-800 font-medium">Manifest {ext.manifestVersion ? ext.manifestVersion.toUpperCase() : 'V3'}</dd>
                </div>

                <div class="flex items-center justify-between py-1.5">
                  <dt class="text-slate-500">License</dt>
                  <dd class="text-slate-700 font-medium">{ext.license || 'MIT'}</dd>
                </div>
              </dl>
            </div>

            <!-- Supported Browsers -->
            <div class="pt-3 border-t border-slate-100 space-y-2">
              <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Supported Browsers</span>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-700 font-medium">
                {supportedBrowsersList.map((b) => (
                  <span class="inline-flex items-center gap-1.5 py-0.5">
                    <BrowserIcon browser={b.id} class="w-3.5 h-3.5 shrink-0" />
                    <span>{b.name}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Permissions -->
            {ext.permissions && ext.permissions.length > 0 && (
              <div class="pt-3 border-t border-slate-100 space-y-2">
                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Permissions</span>
                <div class="flex flex-wrap gap-1">
                  {ext.permissions.map((perm) => (
                    <span class="text-[11px] font-mono bg-slate-50 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
                      {perm}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Developer & Source -->
            {ext.developerSupport && (ext.developerSupport.website || ext.developerSupport.github) && (
              <div class="pt-3 border-t border-slate-100 space-y-2 text-xs">
                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Developer & Source</span>
                
                <div class="space-y-1 text-slate-600">
                  {ext.developerSupport.website && (
                    <a
                      href={ext.developerSupport.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between hover:text-slate-900 py-1 transition-colors"
                    >
                      <span>Developer Website</span>
                      <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
                    </a>
                  )}

                  {ext.developerSupport.github && (
                    <a
                      href={ext.developerSupport.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between hover:text-slate-900 py-1 transition-colors"
                    >
                      <span>Source Repository (GitHub)</span>
                      <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
                    </a>
                  )}
                </div>
              </div>
            )}

            <!-- Help & Support -->
            {ext.developerSupport && (ext.developerSupport.docsUrl || ext.developerSupport.supportUrl || ext.developerSupport.email) && (
              <div class="pt-3 border-t border-slate-100 space-y-2 text-xs">
                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Help & Support</span>
                
                <div class="space-y-1 text-slate-600">
                  {(ext.developerSupport.docsUrl || ext.developerSupport.supportUrl) && (
                    <a
                      href={ext.developerSupport.docsUrl || ext.developerSupport.supportUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between hover:text-slate-900 py-1 transition-colors"
                    >
                      <span>Documentation & Guides</span>
                      <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
                    </a>
                  )}

                  {ext.developerSupport.email && (
                    <a
                      href={`mailto:${ext.developerSupport.email}`}
                      class="flex items-center justify-between hover:text-slate-900 py-1 transition-colors"
                    >
                      <span>Support Center Email</span>
                      <Mail class="w-3.5 h-3.5 text-slate-400" />
                    </a>
                  )}
                </div>
              </div>
            )}

            <!-- Legal & Safety -->
            <div class="pt-3 border-t border-slate-100 space-y-2 text-xs">
              <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Legal & Safety</span>
              
              <div class="space-y-1 text-slate-600">
                {ext.developerSupport?.privacyPolicy && (
                  <a
                    href={ext.developerSupport.privacyPolicy}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-between hover:text-slate-900 py-1 transition-colors"
                  >
                    <span>Privacy Policy</span>
                    <ExternalLink class="w-3.5 h-3.5 text-slate-400" />
                  </a>
                )}

                <!-- Report Button -->
                <div class="pt-1">
                  <button
                    type="button"
                    id="report-abuse-btn"
                    class="text-xs text-rose-600 hover:text-rose-700 font-medium flex items-center gap-1 cursor-pointer"
                  >
                    <AlertTriangle class="w-3 h-3" />
                    <span>Report issue</span>
                  </button>
                </div>
              </div>
            </div>

          </div>

        </aside>

      </div>

      <!-- 4. HyperUI Minimalist Comparison Table -->
      {ext.comparison && ext.comparison.length > 0 && (
        <section class="space-y-4 pt-4 border-t border-slate-200">
          <div class="border-b border-slate-200 pb-2">
            <h2 class="text-base font-bold text-slate-900 tracking-tight">
              Comparison Overview
            </h2>
            <p class="text-xs text-slate-500">Key architectural differences compared to generic extensions.</p>
          </div>

          <!-- HyperUI Clean Table -->
          <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="min-w-full divide-y-2 divide-slate-200 text-xs">
              <thead class="bg-slate-50 text-left">
                <tr>
                  <th class="px-4 py-3 font-semibold text-slate-900 w-1/4">Capability & Metric</th>
                  <th class="px-4 py-3 font-semibold text-slate-900 bg-slate-100/60 w-3/8 border-x border-slate-200">
                    {ext.name} (ExtLabs)
                  </th>
                  <th class="px-4 py-3 font-medium text-slate-500 w-3/8">
                    Traditional / Other Tools
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {ext.comparison.map((row) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="px-4 py-3 font-medium text-slate-800 align-top">
                      {row.feature}
                    </td>
                    <td class="px-4 py-3 text-slate-900 bg-slate-50/30 border-x border-slate-200 align-top leading-relaxed">
                      <div class="flex items-start gap-1.5">
                        <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                        <span>{row.current}</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-slate-500 align-top leading-relaxed">
                      <div class="flex items-start gap-1.5">
                        <span class="text-slate-400 font-bold shrink-0 mt-0.5">✕</span>
                        <span>{row.others}</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- 5. Ratings & Reviews / FAQs -->
      {(showRatingsAndReviews || hasFaqs) && (
        <div class={`grid grid-cols-1 ${showRatingsAndReviews && hasFaqs ? 'lg:grid-cols-12 gap-10' : 'max-w-3xl gap-8'} items-start pt-4 border-t border-slate-200`}>
          
          <!-- Reviews Column -->
          {showRatingsAndReviews && (
            <section id="reviews-section" class={`${hasFaqs ? 'lg:col-span-6' : 'w-full'} space-y-5`}>
              <div class="border-b border-slate-200 pb-2">
                <h2 class="text-base font-bold text-slate-900 tracking-tight">
                  Ratings & Reviews
                </h2>
                <p class="text-xs text-slate-500">Feedback from active users.</p>
              </div>

              <!-- Score & Distribution -->
              {ext.reviewCount > 0 ? (
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                  <div class="sm:col-span-4 text-center sm:text-left space-y-0.5">
                    <span class="text-3xl font-bold text-slate-900 font-mono">
                      {ext.rating.toFixed(1)}
                    </span>
                    <div class="flex items-center justify-center sm:justify-start gap-1 text-amber-500">
                      {[1, 2, 3, 4, 5].map((s) => (
                        <Star class={`w-3.5 h-3.5 ${s <= Math.round(ext.rating) ? 'text-amber-500 fill-amber-500' : 'text-slate-200 fill-slate-200'}`} />
                      ))}
                    </div>
                    <span class="text-[11px] text-slate-400 block">
                      {ext.reviewCount.toLocaleString()} ratings
                    </span>
                  </div>

                  {ext.ratingBreakdown && (
                    <div class="sm:col-span-8 space-y-1 text-xs text-slate-500">
                      {[5, 4, 3, 2, 1].map((star) => {
                        const count = (ext.ratingBreakdown as any)[star] || 0;
                        const percent = ext.reviewCount > 0 ? Math.round((count / ext.reviewCount) * 100) : 0;

                        return (
                          <div class="flex items-center gap-2">
                            <span class="w-8  text-slate-600 text-[11px] inline-flex items-center gap-0.5">
                              <span class="w-2">{star}</span>
                              <Star class="w-2.5 h-2.5 text-slate-800 fill-slate-800 shrink-0" />
                            </span>
                            <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                              <div class="h-full bg-amber-400 rounded-full" style={`width: ${percent}%;`}></div>
                            </div>
                            <span class="w-7 text-right font-mono text-slate-400 text-[10px]">{percent}%</span>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              ) : (
                <div class="py-2 text-xs text-slate-500">
                  <p>No ratings yet. Be the first to share your experience with this extension.</p>
                </div>
              )}

              <!-- Rate & Review Action Row -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 bg-slate-50 border border-slate-200 rounded-lg">
                <div class="space-y-0.5">
                  <span class="text-xs font-semibold text-slate-800 block">
                    {userReview ? 'You rated this extension' : 'Have you used this extension?'}
                  </span>
                  <p class="text-[11px] text-slate-500">
                    {userReview 
                      ? `You gave it ${userReview.rating} star${userReview.rating > 1 ? 's' : ''}. You can update or delete your review anytime.`
                      : 'Share your genuine experience to help developers improve and users decide.'}
                  </p>
                </div>
                <button
                  type="button"
                  id="open-review-action-btn"
                  data-logged-in={currentUser ? 'true' : 'false'}
                  class="shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-medium rounded-lg bg-slate-900 hover:bg-slate-800 text-white transition-colors cursor-pointer"
                >
                  <PenLine class="w-3.5 h-3.5" />
                  <span>{userReview ? 'Edit Your Review' : 'Write a Review'}</span>
                </button>
              </div>

              <!-- User's Own Existing Review (if submitted) -->
              {userReview && (
                <div class="p-3.5 bg-slate-50/80 border border-slate-200 rounded-lg space-y-1.5">
                  <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                      <div class="w-5 h-5 rounded-full overflow-hidden flex items-center justify-center font-bold text-[10px] shrink-0">
                        {userReview.avatarUrl ? (
                          <>
                            <img
                              src={userReview.avatarUrl}
                              alt={userReview.author}
                              width="20"
                              height="20"
                              loading="lazy"
                              decoding="async"
                              referrerpolicy="no-referrer"
                              data-image-component="true"
                              class="w-full h-full object-cover rounded-full"
                              onerror="this.style.display='none'; const fb = this.nextElementSibling; if(fb){ fb.classList.remove('hidden'); fb.style.display='flex'; }"
                            />
                            <span class={`w-full h-full items-center justify-center hidden ${getAvatarBgColor(userReview.author)}`}>
                              {getAvatarInitial(userReview.author)}
                            </span>
                          </>
                        ) : (
                          <span class={`w-full h-full flex items-center justify-center ${getAvatarBgColor(userReview.author)}`}>
                            {getAvatarInitial(userReview.author)}
                          </span>
                        )}
                      </div>
                      <span class="font-semibold text-slate-900">{userReview.author}</span>
                      <span class="text-[10px] text-emerald-600 font-medium inline-flex items-center gap-0.5">
                        <BadgeCheck class="w-3 h-3 text-emerald-500" />
                        <span>Your Verified Review</span>
                      </span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-[11px] text-slate-400">{userReview.date}</span>
                      <button
                        type="button"
                        id="edit-own-review-link"
                        class="text-[11px] text-slate-600 hover:text-slate-900 font-medium cursor-pointer underline"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                  <div class="flex items-center gap-0.5 text-amber-500">
                    {[1, 2, 3, 4, 5].map((s) => (
                      <Star class={`w-3 h-3 ${s <= userReview.rating ? 'text-amber-500 fill-amber-500' : 'text-slate-200 fill-slate-200'}`} />
                    ))}
                  </div>
                  {userReview.title && (
                    <h4 class="text-xs font-semibold text-slate-800" aria-label={userReview.title}>{userReview.title}</h4>
                  )}
                  <p class="text-xs text-slate-600 leading-relaxed">
                    "{userReview.comment}"
                  </p>
                </div>
              )}

              <!-- Ratings Filter Buttons (if multiple reviews) -->
              {otherReviews.length > 2 && (
                <div class="flex items-center gap-1.5 flex-wrap pt-1">
                  <button
                    type="button"
                    data-filter-rating="all"
                    class="review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-900 text-white cursor-pointer transition-colors"
                  >
                    All
                  </button>
                  <button
                    type="button"
                    data-filter-rating="5"
                    class="review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer transition-colors inline-flex items-center gap-1"
                  >
                    <span>5</span>
                    <Star class="w-2.5 h-2.5 text-slate-800 fill-slate-800" />
                  </button>
                  <button
                    type="button"
                    data-filter-rating="4"
                    class="review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer transition-colors inline-flex items-center gap-1"
                  >
                    <span>4</span>
                    <Star class="w-2.5 h-2.5 text-slate-800 fill-slate-800" />
                  </button>
                  <button
                    type="button"
                    data-filter-rating="3"
                    class="review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer transition-colors inline-flex items-center gap-1"
                  >
                    <span>3</span>
                    <Star class="w-2.5 h-2.5 text-slate-800 fill-slate-800" />
                  </button>
                </div>
              )}

              <!-- Reviews List -->
              {otherReviews.length > 0 ? (
                <div id="reviews-list-container" class="divide-y divide-slate-100">
                  {otherReviews.map((rev, index) => (
                    <div
                      class={`review-entry py-3 space-y-1 ${index >= 3 ? 'hidden extra-review' : ''}`}
                      data-rating={rev.rating}
                    >
                      <div class="flex items-center justify-between text-xs">
                        <div class="flex items-center gap-1.5">
                          <div class="w-5 h-5 rounded-full overflow-hidden flex items-center justify-center font-bold text-[10px] shrink-0">
                            {rev.avatarUrl ? (
                              <>
                                <img
                                  src={rev.avatarUrl}
                                  alt={rev.author}
                                  width="20"
                                  height="20"
                                  loading="lazy"
                                  decoding="async"
                                  referrerpolicy="no-referrer"
                                  data-image-component="true"
                                  class="w-full h-full object-cover rounded-full"
                                  onerror="this.style.display='none'; const fb = this.nextElementSibling; if(fb){ fb.classList.remove('hidden'); fb.style.display='flex'; }"
                                />
                                <span class={`w-full h-full items-center justify-center hidden ${getAvatarBgColor(rev.author)}`}>
                                  {getAvatarInitial(rev.author)}
                                </span>
                              </>
                            ) : (
                              <span class={`w-full h-full flex items-center justify-center ${getAvatarBgColor(rev.author)}`}>
                                {getAvatarInitial(rev.author)}
                              </span>
                            )}
                          </div>
                          <span class="font-medium text-slate-900">{rev.author}</span>
                          {rev.verified && (
                            <span class="text-[10px] text-emerald-600 font-medium inline-flex items-center gap-0.5">
                              <BadgeCheck class="w-3 h-3 text-emerald-500" />
                              <span>Verified</span>
                            </span>
                          )}
                        </div>
                        <span class="text-[11px] text-slate-400">{rev.date}</span>
                      </div>

                      <div class="flex items-center gap-0.5 text-amber-500">
                        {[1, 2, 3, 4, 5].map((s) => (
                          <Star class={`w-3 h-3 ${s <= rev.rating ? 'text-amber-500 fill-amber-500' : 'text-slate-200 fill-slate-200'}`} />
                        ))}
                      </div>

                      {rev.title && (
                        <h4 class="text-xs font-semibold text-slate-800" aria-label={rev.title}>{rev.title}</h4>
                      )}

                      <p class="text-xs text-slate-600 leading-relaxed">
                        "{rev.comment}"
                      </p>
                    </div>
                  ))}
                </div>
              ) : !userReview ? (
                <div class="py-4 text-center text-xs text-slate-400">
                  <p>No written user reviews yet for this extension.</p>
                </div>
              ) : null}

              <!-- Show More / Show Fewer Reviews Toggle -->
              {otherReviews.length > 3 && (
                <div class="pt-1">
                  <button
                    type="button"
                    id="toggle-more-reviews-btn"
                    data-expanded="false"
                    data-extra-count={otherReviews.length - 3}
                    class="w-full py-2 text-xs font-medium text-slate-700 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg cursor-pointer transition-colors"
                  >
                    Show more reviews ({otherReviews.length - 3})
                  </button>
                </div>
              )}
            </section>
          )}

          <!-- FAQs Column -->
          {hasFaqs && ext.faqs && ext.faqs.length > 0 && (
            <section class={`${showRatingsAndReviews ? 'lg:col-span-6' : 'w-full'} space-y-4`}>
              <div class="border-b border-slate-200 pb-2">
                <h2 class="text-base font-bold text-slate-900 tracking-tight">
                  Frequently Asked Questions
                </h2>
                <p class="text-xs text-slate-500">Common questions about this extension.</p>
              </div>

              <div class="divide-y divide-slate-100">
                {ext.faqs.map((faq) => (
                  <details class="group py-3 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                    <summary class="flex items-center justify-between text-xs font-semibold text-slate-900 select-none">
                      <span>{faq.question}</span>
                      <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" />
                    </summary>
                    <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                      {faq.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )}

        </div>
      )}

      <!-- 6. Related Extensions Shelf -->
      {relatedExtensions.length > 0 && (
        <section class="space-y-4 pt-4 border-t border-slate-200">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-bold text-slate-900 tracking-tight">
                More in {ext.categoryLabel}
              </h2>
              <p class="text-xs text-slate-500">Related browser extensions.</p>
            </div>

            <a
              href={`/category/${ext.category}`}
              class="text-xs font-medium text-slate-700 hover:text-slate-900 flex items-center gap-1"
            >
              <span>View all</span>
              <ArrowRight class="w-3 h-3" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedExtensions.map((item) => (
              <ExtensionCard extension={item} />
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- Review Submission / Edit Modal -->
    <dialog id="review-modal" class="modal">
      <div class="modal-box max-w-lg p-5 bg-white rounded-xl border border-slate-200 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900" aria-label={userReview ? 'Edit Your Review' : 'Rate & Review'}>{userReview ? 'Edit Your Review' : 'Rate & Review'}</h3>
            <p class="text-xs text-slate-500">{ext.name}</p>
          </div>
          <button
            type="button"
            id="close-review-modal-btn"
            class="p-1 text-slate-400 hover:text-slate-700 rounded cursor-pointer"
            aria-label="Close dialog"
          >
            <X class="w-4 h-4" />
          </button>
        </div>

        <form id="extension-review-form" class="space-y-4">
          <input type="hidden" name="extensionId" value={ext.dbId || ext.id} />
          
          <!-- User Profile Info -->
          {currentUser && (
            <div class="flex items-center gap-2.5 text-xs text-slate-600 bg-slate-50 px-3 py-2 rounded-lg border border-slate-100">
              <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs">
                {currentUser.avatar_url ? (
                  <>
                    <img
                      src={currentUser.avatar_url}
                      alt={currentUser.name || currentUser.username || 'User'}
                      width="28"
                      height="28"
                      loading="eager"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      data-image-component="true"
                      class="w-full h-full object-cover rounded-full"
                      onerror="this.style.display='none'; const fb = this.nextElementSibling; if(fb){ fb.classList.remove('hidden'); fb.style.display='flex'; }"
                    />
                    <span
                      class={`w-full h-full items-center justify-center hidden ${getAvatarBgColor(currentUser.name || currentUser.username || currentUser.email)}`}
                    >
                      {getAvatarInitial(currentUser.name, currentUser.email, currentUser.username)}
                    </span>
                  </>
                ) : (
                  <span
                    class={`w-full h-full flex items-center justify-center ${getAvatarBgColor(currentUser.name || currentUser.username || currentUser.email)}`}
                  >
                    {getAvatarInitial(currentUser.name, currentUser.email, currentUser.username)}
                  </span>
                )}
              </div>
              <div class="flex flex-col min-w-0">
                <span class="truncate">Reviewing as <strong class="text-slate-900 font-semibold">{currentUser.name || currentUser.username}</strong></span>
                {currentUser.email && <span class="text-[11px] text-slate-400 truncate">{currentUser.email}</span>}
              </div>
            </div>
          )}

          <!-- Interactive Star Rating Selector -->
          <div class="space-y-1.5">
            <span class="block text-xs font-semibold text-slate-800">Your Rating <span class="text-rose-500">*</span></span>
            <div class="flex items-center gap-3">
              <div id="star-rating-selector" class="flex items-center gap-1" data-rating={userReview?.rating || 5}>
                {[1, 2, 3, 4, 5].map((starVal) => (
                  <button
                    type="button"
                    data-val={starVal}
                    class="star-choice-btn p-1 text-amber-500 hover:scale-110 transition-transform cursor-pointer"
                    aria-label={`${starVal} star`}
                  >
                    <Star class="w-6 h-6 fill-current pointer-events-none" />
                  </button>
                ))}
              </div>
              <span id="star-rating-label" class="text-xs font-semibold text-slate-700">
                {userReview ? `${userReview.rating} - ${['Poor', 'Fair', 'Good', 'Very Good', 'Excellent'][userReview.rating - 1]}` : '5 - Excellent'}
              </span>
            </div>
          </div>

          <!-- Review Title (Optional) -->
          <div class="space-y-1">
            <span class="block text-xs font-medium text-slate-700">
              Review Title <span class="text-slate-400 font-normal">(Optional)</span>
            </span>
            <input
              type="text"
              id="review-title-input"
              name="title"
              aria-label="Review Title (Optional)"
              maxlength="120"
              value={userReview?.title || ''}
              placeholder="e.g., Clean, fast, and indispensable for my workflow"
              class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-slate-400"
            />
          </div>

          <!-- Review Comment (Required) -->
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <span class="block text-xs font-medium text-slate-700">
                Your Feedback <span class="text-rose-500">*</span>
              </span>
              <span id="review-char-counter" class="text-[10px] text-slate-400 font-mono">0 / 2000</span>
            </div>
            <textarea
              id="review-comment-input"
              name="comment"
              aria-label="Your Feedback"
              rows="4"
              required
              maxlength="2000"
              placeholder="What worked well? What could be improved? Helpful feedback benefits both developers and users."
              class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-slate-400 leading-relaxed"
            >{userReview?.comment || ''}</textarea>
          </div>

          <!-- Error Alert Banner (Hidden by default) -->
          <div id="review-error-banner" class="hidden text-xs text-rose-700 bg-rose-50 border border-rose-200 p-2.5 rounded-lg"></div>

          <!-- Footer Buttons -->
          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <div>
              {userReview && (
                <button
                  type="button"
                  id="delete-review-btn"
                  class="inline-flex items-center gap-1 text-xs text-rose-600 hover:text-rose-700 font-medium cursor-pointer"
                >
                  <Trash2 class="w-3.5 h-3.5" />
                  <span>Delete</span>
                </button>
              )}
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="cancel-review-modal-btn"
                class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-800 cursor-pointer font-medium"
              >
                Cancel
              </button>
              <button
                type="submit"
                id="submit-review-form-btn"
                class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium rounded-lg cursor-pointer transition-colors"
              >
                {userReview ? 'Update Review' : 'Submit Review'}
              </button>
            </div>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Sign In to Review Modal (Strictly Google Only) -->
    <dialog id="review-auth-modal" class="modal">
      <div class="modal-box max-w-sm p-6 bg-white rounded-xl border border-slate-200 space-y-4 text-center">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
          <h3 class="text-sm font-bold text-slate-900 text-left" aria-label="Sign In with Google">Sign In with Google</h3>
          <button
            type="button"
            id="close-auth-modal-btn"
            class="p-1 text-slate-400 hover:text-slate-700 rounded cursor-pointer"
            aria-label="Close dialog"
          >
            <X class="w-4 h-4" />
          </button>
        </div>

        <p class="text-xs text-slate-600 text-left leading-relaxed">
          Sign in with your Google account to submit a verified rating for <strong>{ext.name}</strong>. Fast 1-click verification, no passwords required.
        </p>

        <div class="pt-1">
          <!-- Google Sign In Button -->
          <a
            href={`/api/auth/google?redirect=${encodeURIComponent(Astro.url.pathname + '#reviews-section')}`}
            aria-label="Continue with Google"
            class="flex items-center justify-center gap-3 w-full py-2.5 px-4 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-800 text-xs font-medium transition-colors shadow-2xs"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Continue with Google</span>
          </a>
        </div>

        <p class="text-[11px] text-slate-400 text-center pt-1">
          Google authentication verifies your review and prevents bot spam.
        </p>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Report Modal Dialog -->
    <dialog id="report-modal" class="modal">
      <div class="modal-box max-w-md p-5 bg-white rounded-lg border border-slate-200 space-y-3">
        <h3 class="text-sm font-bold text-slate-900" aria-label="Report Extension">Report Extension</h3>
        <p class="text-xs text-slate-500">
          Describe the issue with <strong>{ext.name}</strong>:
        </p>

        <form id="report-form" class="space-y-2.5">
          <select aria-label="Report reason" class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded focus:outline-none">
            <option>Malware / Security Concern</option>
            <option>Broken functionality</option>
            <option>Misleading description</option>
            <option>Copyright / Trademark</option>
            <option>Other issue</option>
          </select>

          <textarea
            rows="3"
            required
            aria-label="Report details"
            placeholder="Details..."
            class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded focus:outline-none leading-relaxed"
          ></textarea>

          <div class="flex items-center justify-end gap-2 pt-1">
            <button
              type="button"
              id="report-cancel-btn"
              class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium rounded cursor-pointer"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Post-Download Quick Install Modal (Clean Hybrid Architecture) -->
    <dialog id="post-download-modal" class="modal">
      <div class="modal-box max-w-lg p-0 bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-2xl">
        
        <!-- Modal Top Header: Clean, Typographic, No Boxed Pills -->
        <div class="p-5 bg-white border-b border-slate-100 flex items-start justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-600">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Download Initiated (.zip)</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-snug" aria-label="Install in 3 Quick Steps">
              Install in 3 Quick Steps
            </h3>
            <p class="text-xs text-slate-500 leading-normal">
              Activate <span class="font-medium text-slate-800">{ext.name}</span> in Chrome, Brave, Edge, or Opera
            </p>
          </div>

          <button
            type="button"
            id="close-post-download-modal"
            class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer shrink-0 mt-0.5"
            aria-label="Close dialog"
          >
            <X class="w-4 h-4" />
          </button>
        </div>

        <!-- Modal Body: High-Contrast Step Flow -->
        <div class="p-5 space-y-3 bg-[#fbfbfc]">

          <!-- Step 1: Extract Downloaded .ZIP (Crisp Light Card) -->
          <div class="p-3.5 bg-white border border-slate-200 rounded-xl shadow-2xs space-y-1.5">
            <div class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-mono font-bold text-[11px] flex items-center justify-center shrink-0">
                01
              </span>
              <h4 class="text-xs font-bold text-slate-900" aria-label="Extract the Downloaded .ZIP">
                Extract the Downloaded .ZIP
              </h4>
            </div>
            <p class="text-xs text-slate-600 pl-7.5 leading-relaxed">
              Open your Downloads folder and extract the zip archive into a permanent folder (e.g. Documents).
            </p>
          </div>

          <!-- Step 2: Open Extensions & Enable Developer Mode (Sleek Dark Slate-900 Hero Card from /how-to-install) -->
          <div class="p-4 bg-slate-900 border border-slate-800 rounded-xl text-white shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-5 h-5 rounded-md bg-slate-800 border border-slate-700 text-blue-400 font-mono font-bold text-[11px] flex items-center justify-center shrink-0">
                  02
                </span>
                <h4 class="text-xs font-bold text-white" aria-label="Open Extensions & Turn On Developer Mode">
                  Open Extensions & Turn On Developer Mode
                </h4>
              </div>
            </div>

            <p class="text-xs text-slate-300 pl-7.5 leading-relaxed">
              Paste this internal address into your browser address bar:
            </p>

            <!-- Address Bar Utility Box from /how-to-install -->
            <div class="ml-7.5 p-2 bg-slate-950 border border-slate-800 rounded-lg flex items-center justify-between gap-2 shadow-2xs">
              <div class="flex items-center gap-2 text-xs font-mono text-blue-400 font-semibold px-1.5 select-all truncate">
                <Terminal class="w-3.5 h-3.5 text-slate-400 shrink-0" />
                <span id="modal-ext-url">chrome://extensions</span>
              </div>
              <button
                type="button"
                id="modal-copy-ext-url-btn"
                class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium rounded-md border border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer shrink-0"
              >
                <Copy class="w-3 h-3 text-slate-400" id="modal-copy-icon" />
                <span id="modal-copy-btn-text">Copy URL</span>
              </button>
            </div>

            <!-- Action Highlight -->
            <div class="ml-7.5 pt-1 border-t border-slate-800/80 flex items-start gap-2 text-[11px] text-slate-300 leading-normal">
              <span class="text-emerald-400 font-bold shrink-0">Action:</span>
              <span>Toggle the <strong class="text-white">Developer mode</strong> switch in the top-right corner to reveal the action buttons.</span>
            </div>
          </div>

          <!-- Step 3: Click 'Load Unpacked' (Crisp Light Card) -->
          <div class="p-3.5 bg-white border border-slate-200 rounded-xl shadow-2xs space-y-1.5">
            <div class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-mono font-bold text-[11px] flex items-center justify-center shrink-0">
                03
              </span>
              <h4 class="text-xs font-bold text-slate-900" aria-label="Click 'Load Unpacked' & Select Folder">
                Click 'Load Unpacked' & Select Folder
              </h4>
            </div>
            <p class="text-xs text-slate-600 pl-7.5 leading-relaxed">
              Click the <strong class="text-slate-900 font-semibold">Load unpacked</strong> button on the extensions bar, select your unzipped folder (the one with <code class="text-[11px] px-1 py-0.5 bg-slate-100 border border-slate-200 rounded text-slate-800 font-mono">manifest.json</code>), and you're done!
            </p>
          </div>

          <!-- Direct Download Fallback Bar -->
          {ext.downloadUrl && ext.downloadUrl !== '#' && (
            <div class="px-3.5 py-2 bg-slate-100/70 border border-slate-200/80 rounded-xl flex items-center justify-between text-xs">
              <span class="text-slate-600 text-[11px]">Didn't start downloading?</span>
              <a
                id="modal-fallback-download-btn"
                data-ext-id={ext.dbId || ext.id}
                href={ext.downloadUrl}
                download
                aria-label="Download .zip directly"
                class="text-blue-600 hover:text-blue-700 hover:underline font-semibold inline-flex items-center gap-1 cursor-pointer text-[11px]"
              >
                <span>Download .zip directly</span>
                <Download class="w-3 h-3" />
              </a>
            </div>
          )}

          <!-- Footer Action & Guide Link -->
          <div class="pt-3 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <a
              href="/how-to-install"
              target="_blank"
              aria-label="View full guide with visual screenshots"
              class="text-slate-600 hover:text-blue-600 font-medium inline-flex items-center gap-1 transition-colors"
            >
              <span>View full guide with visual screenshots</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>

            <button
              type="button"
              id="modal-got-it-btn"
              class="w-full sm:w-auto px-5 py-2 bg-slate-900 hover:bg-black text-white font-medium rounded-lg shadow-2xs cursor-pointer transition-colors"
            >
              Done, I Got It
            </button>
          </div>

        </div>
      </div>

      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Minimalist Toast Notification -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="toast"
        class="hidden bg-slate-900 text-white text-xs py-2.5 px-4 rounded-lg border border-slate-800 flex items-center gap-2"
      >
        <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
        <span id="toast-message">Notification message</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Client-Side Interactivity Script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Media Tab Switcher (Screenshot vs YouTube Video)
        const tabScreenshot = document.getElementById('tab-screenshot-btn');
        const tabVideo = document.getElementById('tab-video-btn');
        const viewScreenshot = document.getElementById('media-screenshot-view');
        const viewVideo = document.getElementById('media-video-view');
        const counter = document.getElementById('screenshot-counter');
        const previewBadge = document.getElementById('media-preview-badge');

        if (tabScreenshot && tabVideo && viewScreenshot && viewVideo) {
          tabScreenshot.addEventListener('click', () => {
            tabScreenshot.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-slate-900 text-white cursor-pointer transition-colors';
            tabVideo.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors';
            viewScreenshot.classList.remove('hidden');
            viewVideo.classList.add('hidden');
            if (counter) counter.classList.remove('hidden');
            if (previewBadge) previewBadge.textContent = 'Showcase Preview';
          });

          tabVideo.addEventListener('click', () => {
            tabVideo.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-slate-900 text-white cursor-pointer transition-colors';
            tabScreenshot.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors';
            viewVideo.classList.remove('hidden');
            viewScreenshot.classList.add('hidden');
            if (counter) counter.classList.add('hidden');
            if (previewBadge) previewBadge.textContent = 'YouTube Video';

            // Lazy-load YouTube iframe on-demand only when tab is activated
            const ytIframe = document.getElementById('youtube-iframe') as HTMLIFrameElement | null;
            if (ytIframe && !ytIframe.src && ytIframe.dataset.src) {
              ytIframe.src = ytIframe.dataset.src;
            }
          });
        }

        // Store Showcase Screenshots Gallery Switcher
        const mainImg = document.getElementById('main-screenshot-img') as HTMLImageElement | null;
        const prevBtn = document.getElementById('prev-screenshot-btn');
        const nextBtn = document.getElementById('next-screenshot-btn');
        const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.screenshot-thumb-btn');

        if (mainImg && thumbBtns.length > 1) {
          let currentIndex = 0;
          const total = thumbBtns.length;

          function setScreenshot(index: number) {
            currentIndex = (index + total) % total;
            const targetBtn = thumbBtns[currentIndex];
            if (!targetBtn) return;
            const newSrc = targetBtn.getAttribute('data-src');
            if (newSrc && mainImg) {
              mainImg.src = newSrc;
            }

            // Update active styles on thumbnails
            thumbBtns.forEach((btn, i) => {
              if (i === currentIndex) {
                btn.className = 'screenshot-thumb-btn shrink-0 w-20 sm:w-24 aspect-video rounded-lg overflow-hidden border cursor-pointer transition-all border-slate-900 ring-1 ring-slate-900 opacity-100';
              } else {
                btn.className = 'screenshot-thumb-btn shrink-0 w-20 sm:w-24 aspect-video rounded-lg overflow-hidden border cursor-pointer transition-all border-slate-200 opacity-60 hover:opacity-100 hover:border-slate-400';
              }
            });

            // Update counter
            if (counter) {
              counter.textContent = `${currentIndex + 1} / ${total}`;
            }
          }

          thumbBtns.forEach((btn, idx) => {
            btn.addEventListener('click', () => setScreenshot(idx));
          });

          if (prevBtn) {
            prevBtn.addEventListener('click', () => setScreenshot(currentIndex - 1));
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', () => setScreenshot(currentIndex + 1));
          }
        }

        // Toast Helper
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');
        let toastTimeout: number | null = null;

        function showToast(message: string) {
          if (toastTimeout) window.clearTimeout(toastTimeout);
          if (toast && toastMsg) {
            toastMsg.textContent = message;
            toast.classList.remove('hidden');
            toastTimeout = window.setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }

        // Non-blocking telemetry dispatcher (accumulates in 5-minute server memory buffer)
        function sendTelemetry(extId, type) {
          if (!extId || !type) return;

          const payload = JSON.stringify({ extensionId: extId, type: type });
          if (typeof navigator.sendBeacon === 'function') {
            const blob = new Blob([payload], { type: 'application/json' });
            navigator.sendBeacon('/api/telemetry', blob);
          } else {
            fetch('/api/telemetry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true
            }).catch(() => {});
          }
        }

        // Dual-Action Download CTA Button
        const downloadBtn = document.getElementById('detail-download-btn');
        if (downloadBtn) {
          const extId = downloadBtn.getAttribute('data-ext-id') || 'ext';
          
          // Track page visit on load (accumulated in 5-minute server buffer)
          if (extId) {
            sendTelemetry(extId, 'page_visit');
          }

          downloadBtn.addEventListener('click', () => {
            const extName = downloadBtn.getAttribute('data-ext-name') || 'extension';
            const extVersion = downloadBtn.getAttribute('data-ext-version') || '1.0.0';
            const hasMonetag = downloadBtn.getAttribute('data-has-monetag') === 'true';
            const adFrequency = downloadBtn.getAttribute('data-ad-frequency') || '24h';
            const realDownloadUrl = downloadBtn.getAttribute('data-download-url');

            // 1. Check Ad Trigger Frequency & Cooldown Rules
            let canTriggerAd = true;
            const now = Date.now();
            const lastTriggerKey = `extlabs_ad_last_${extId}`;
            const sessionTriggerKey = `extlabs_ad_session_${extId}`;

            if (adFrequency === '24h') {
              const lastTime = Number(localStorage.getItem(lastTriggerKey) || 0);
              if (lastTime && (now - lastTime) < 24 * 60 * 60 * 1000) {
                canTriggerAd = false;
              }
            } else if (adFrequency === '12h') {
              const lastTime = Number(localStorage.getItem(lastTriggerKey) || 0);
              if (lastTime && (now - lastTime) < 12 * 60 * 60 * 1000) {
                canTriggerAd = false;
              }
            } else if (adFrequency === 'session') {
              if (sessionStorage.getItem(sessionTriggerKey) === 'true') {
                canTriggerAd = false;
              }
            }
            // 'download' frequency triggers on every package download event

            if (canTriggerAd) {
              // 2. Dual-Action Monetization: 5:1 pacing split
              let adClickCount = Number(localStorage.getItem('extlabs_ad_split_count') || 0) + 1;
              localStorage.setItem('extlabs_ad_split_count', String(adClickCount));

              const isPlatformAd = (adClickCount % 6 === 0);

              // Only trigger if it's the platform ad OR developer has configured Monetag
              if (isPlatformAd || hasMonetag) {
                // Record timestamp to enforce frequency cooldown
                localStorage.setItem(lastTriggerKey, String(now));
                sessionStorage.setItem(sessionTriggerKey, 'true');

                // Open first-party cloaked redirector (prevents client ad blockers from matching ad domains)
                const adRedirectUrl = `/api/ad/go?extId=${encodeURIComponent(extId)}&p=${isPlatformAd ? '1' : '0'}`;
                window.open(adRedirectUrl, '_blank', 'noopener,noreferrer');
              }
            }

            // 3. Trigger real extension package download on the same page (no second tab)
            if (realDownloadUrl && realDownloadUrl !== '#' && realDownloadUrl.startsWith('http')) {
              const a = document.createElement('a');
              a.href = realDownloadUrl;
              const cleanFilename = realDownloadUrl.split('/').pop()?.split('?')[0] || `${extId}-v${extVersion}.zip`;
              a.setAttribute('download', cleanFilename);
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);

              // 4. Track download on every click (buffered in server memory)
              sendTelemetry(extId, 'download');

              // 4. Update button state
              downloadBtn.innerHTML = `
                <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>Downloaded</span>
              `;
              downloadBtn.className = 'w-full sm:w-auto px-6 py-3 bg-emerald-700 text-white text-xs sm:text-sm font-medium rounded-lg flex items-center justify-center gap-2 cursor-pointer transition-colors';

              showToast(`Downloading ${extName}. Follow the install guide below if needed.`);

              // 5. Open Post-Download Install Quick Guide Modal
              const postDownloadModal = document.getElementById('post-download-modal') as HTMLDialogElement | null;
              if (postDownloadModal && typeof postDownloadModal.showModal === 'function') {
                postDownloadModal.showModal();
              }
            } else {
              showToast(`Direct download package is not yet published for ${extName}.`);
            }
          });
        }

        // Post-Download Modal Event Handlers
        const postDownloadModal = document.getElementById('post-download-modal') as HTMLDialogElement | null;
        const closePostModalBtn = document.getElementById('close-post-download-modal');
        const gotItPostModalBtn = document.getElementById('modal-got-it-btn');
        const modalCopyBtn = document.getElementById('modal-copy-ext-url-btn');
        const modalCopyBtnText = document.getElementById('modal-copy-btn-text');
        const modalUrlEl = document.getElementById('modal-ext-url');
        const modalFallbackBtn = document.getElementById('modal-fallback-download-btn');

        // Auto-detect browser for modal-ext-url (Edge, Brave, Opera, Chrome)
        if (modalUrlEl) {
          try {
            const ua = navigator.userAgent;
            if (ua.includes('Edg/')) {
              modalUrlEl.textContent = 'edge://extensions';
            } else if (ua.includes('OPR/') || ua.includes('Opera/')) {
              modalUrlEl.textContent = 'opera://extensions';
            } else if ((navigator as any).brave && typeof (navigator as any).brave.isBrave === 'function') {
              modalUrlEl.textContent = 'brave://extensions';
            }
          } catch {}
        }

        if (modalFallbackBtn) {
          modalFallbackBtn.addEventListener('click', () => {
            const extId = modalFallbackBtn.getAttribute('data-ext-id');
            if (extId) sendTelemetry(extId, 'download');
          });
        }

        if (closePostModalBtn && postDownloadModal) {
          closePostModalBtn.addEventListener('click', () => postDownloadModal.close());
        }
        if (gotItPostModalBtn && postDownloadModal) {
          gotItPostModalBtn.addEventListener('click', () => postDownloadModal.close());
        }
        if (modalCopyBtn && modalUrlEl) {
          modalCopyBtn.addEventListener('click', async () => {
            const url = modalUrlEl.textContent?.trim() || 'chrome://extensions';
            const btnLabel = modalCopyBtnText || modalCopyBtn;
            try {
              await navigator.clipboard.writeText(url);
              btnLabel.textContent = 'Copied!';
            } catch {
              btnLabel.textContent = 'Failed to copy';
            } finally {
              setTimeout(() => {
                btnLabel.textContent = 'Copy URL';
              }, 2000);
            }
          });
        }

        // Ratings & Reviews Interactive Submission & Modal Handlers
        const openReviewActionBtn = document.getElementById('open-review-action-btn');
        const editOwnReviewLink = document.getElementById('edit-own-review-link');
        const reviewModal = document.getElementById('review-modal') as HTMLDialogElement | null;
        const reviewAuthModal = document.getElementById('review-auth-modal') as HTMLDialogElement | null;
        const closeReviewModalBtn = document.getElementById('close-review-modal-btn');
        const cancelReviewModalBtn = document.getElementById('cancel-review-modal-btn');
        const closeAuthModalBtn = document.getElementById('close-auth-modal-btn');

        function handleOpenReview() {
          const isLoggedIn = openReviewActionBtn?.getAttribute('data-logged-in') === 'true';
          if (!isLoggedIn) {
            if (reviewAuthModal && typeof reviewAuthModal.showModal === 'function') {
              reviewAuthModal.showModal();
            }
          } else {
            if (reviewModal && typeof reviewModal.showModal === 'function') {
              reviewModal.showModal();
            }
          }
        }

        if (openReviewActionBtn) {
          openReviewActionBtn.addEventListener('click', handleOpenReview);
        }
        if (editOwnReviewLink) {
          editOwnReviewLink.addEventListener('click', () => {
            if (reviewModal && typeof reviewModal.showModal === 'function') {
              reviewModal.showModal();
            }
          });
        }

        if (closeReviewModalBtn && reviewModal) {
          closeReviewModalBtn.addEventListener('click', () => reviewModal.close());
        }
        if (cancelReviewModalBtn && reviewModal) {
          cancelReviewModalBtn.addEventListener('click', () => reviewModal.close());
        }
        if (closeAuthModalBtn && reviewAuthModal) {
          closeAuthModalBtn.addEventListener('click', () => reviewAuthModal.close());
        }

        // Interactive Star Rating Selector Logic
        const starChoiceBtns = document.querySelectorAll<HTMLButtonElement>('.star-choice-btn');
        const starRatingSelector = document.getElementById('star-rating-selector');
        const starRatingLabel = document.getElementById('star-rating-label');
        const ratingLabels: Record<number, string> = {
          1: '1 - Poor',
          2: '2 - Fair',
          3: '3 - Good',
          4: '4 - Very Good',
          5: '5 - Excellent',
        };

        let selectedRating = Number(starRatingSelector?.getAttribute('data-rating') || 5);

        function updateStarVisuals(ratingValue: number) {
          starChoiceBtns.forEach((btn) => {
            const val = Number(btn.getAttribute('data-val') || 0);
            if (val <= ratingValue) {
              btn.className = 'star-choice-btn p-1 text-amber-500 hover:scale-110 transition-transform cursor-pointer';
            } else {
              btn.className = 'star-choice-btn p-1 text-slate-200 hover:scale-110 transition-transform cursor-pointer';
            }
          });
          if (starRatingLabel) {
            starRatingLabel.textContent = ratingLabels[ratingValue] || `${ratingValue} Stars`;
          }
        }

        // Initialize star visuals
        updateStarVisuals(selectedRating);

        starChoiceBtns.forEach((btn) => {
          btn.addEventListener('mouseenter', () => {
            const val = Number(btn.getAttribute('data-val') || 5);
            updateStarVisuals(val);
          });

          btn.addEventListener('mouseleave', () => {
            updateStarVisuals(selectedRating);
          });

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const val = Number(btn.getAttribute('data-val') || 5);
            selectedRating = val;
            if (starRatingSelector) {
              starRatingSelector.setAttribute('data-rating', String(selectedRating));
            }
            updateStarVisuals(selectedRating);
          });
        });

        // Character counter for comment input
        const commentInput = document.getElementById('review-comment-input') as HTMLTextAreaElement | null;
        const charCounter = document.getElementById('review-char-counter');
        if (commentInput && charCounter) {
          charCounter.textContent = `${commentInput.value.length} / 2000`;
          commentInput.addEventListener('input', () => {
            charCounter.textContent = `${commentInput.value.length} / 2000`;
          });
        }

        // Review Form Submit Handler
        const extensionReviewForm = document.getElementById('extension-review-form') as HTMLFormElement | null;
        const submitReviewFormBtn = document.getElementById('submit-review-form-btn') as HTMLButtonElement | null;
        const reviewErrorBanner = document.getElementById('review-error-banner');

        if (extensionReviewForm && submitReviewFormBtn) {
          extensionReviewForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (reviewErrorBanner) {
              reviewErrorBanner.classList.add('hidden');
              reviewErrorBanner.textContent = '';
            }

            const formData = new FormData(extensionReviewForm);
            const extensionId = formData.get('extensionId') as string;
            const title = (formData.get('title') as string) || '';
            const comment = (formData.get('comment') as string) || '';

            if (!comment.trim() || comment.trim().length < 3) {
              if (reviewErrorBanner) {
                reviewErrorBanner.textContent = 'Please write at least 3 characters in your feedback.';
                reviewErrorBanner.classList.remove('hidden');
              }
              return;
            }

            submitReviewFormBtn.disabled = true;
            const originalBtnText = submitReviewFormBtn.textContent;
            submitReviewFormBtn.textContent = 'Submitting...';

            try {
              const res = await fetch('/api/extensions/review', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  extensionId,
                  rating: selectedRating,
                  title: title.trim(),
                  comment: comment.trim(),
                }),
              });

              const data = (await res.json()) as { success?: boolean; error?: string };
              if (!res.ok || !data.success) {
                throw new Error(data.error || 'Failed to submit review.');
              }

              if (reviewModal) {
                reviewModal.close();
              }
              showToast('Review submitted successfully!');
              setTimeout(() => {
                window.location.reload();
              }, 600);
            } catch (err: any) {
              if (reviewErrorBanner) {
                reviewErrorBanner.textContent = err.message || 'An error occurred while saving your review.';
                reviewErrorBanner.classList.remove('hidden');
              }
            } finally {
              submitReviewFormBtn.disabled = false;
              submitReviewFormBtn.textContent = originalBtnText;
            }
          });
        }

        // Delete Review Handler
        const deleteReviewBtn = document.getElementById('delete-review-btn') as HTMLButtonElement | null;
        if (deleteReviewBtn && extensionReviewForm) {
          deleteReviewBtn.addEventListener('click', async () => {
            if (!confirm('Are you sure you want to delete your review?')) {
              return;
            }

            const formData = new FormData(extensionReviewForm);
            const extensionId = formData.get('extensionId') as string;

            deleteReviewBtn.disabled = true;
            deleteReviewBtn.textContent = 'Deleting...';

            try {
              const res = await fetch('/api/extensions/review', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ extensionId }),
              });

              const data = (await res.json()) as { success?: boolean; error?: string };
              if (!res.ok || !data.success) {
                throw new Error(data.error || 'Failed to delete review.');
              }

              if (reviewModal) {
                reviewModal.close();
              }
              showToast('Review removed.');
              setTimeout(() => {
                window.location.reload();
              }, 600);
            } catch (err: any) {
              alert(err.message || 'Failed to delete review.');
              deleteReviewBtn.disabled = false;
              deleteReviewBtn.textContent = 'Delete';
            }
          });
        }

        // Ratings Filter & Show More Reviews Handler
        const filterButtons = document.querySelectorAll('.review-filter-btn');
        const reviewEntries = document.querySelectorAll('.review-entry');
        const toggleMoreBtn = document.getElementById('toggle-more-reviews-btn');
        let currentRatingFilter = 'all';
        let isExpanded = false;

        function applyReviewFilter() {
          let visibleCount = 0;
          reviewEntries.forEach((entry) => {
            const entryRating = entry.getAttribute('data-rating') || '';
            const matchesRating = currentRatingFilter === 'all' || entryRating === currentRatingFilter;

            if (!matchesRating) {
              entry.classList.add('hidden');
            } else {
              visibleCount++;
              if (currentRatingFilter === 'all' && !isExpanded && visibleCount > 3) {
                entry.classList.add('hidden');
              } else {
                entry.classList.remove('hidden');
              }
            }
          });

          if (toggleMoreBtn) {
            if (currentRatingFilter !== 'all' || reviewEntries.length <= 3) {
              toggleMoreBtn.classList.add('hidden');
            } else {
              toggleMoreBtn.classList.remove('hidden');
              const extraCount = toggleMoreBtn.getAttribute('data-extra-count') || '0';
              toggleMoreBtn.textContent = isExpanded ? 'Show fewer reviews' : `Show more reviews (${extraCount})`;
            }
          }
        }

        filterButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const rating = btn.getAttribute('data-filter-rating') || 'all';
            currentRatingFilter = rating;

            filterButtons.forEach((b) => {
              b.className = 'review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer transition-colors';
            });
            btn.className = 'review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-900 text-white cursor-pointer transition-colors';

            applyReviewFilter();
          });
        });

        if (toggleMoreBtn) {
          toggleMoreBtn.addEventListener('click', () => {
            isExpanded = !isExpanded;
            applyReviewFilter();
          });
        }

        // Report Modal Handlers
        const reportBtn = document.getElementById('report-abuse-btn');
        const reportModal = document.getElementById('report-modal') as HTMLDialogElement | null;
        const reportCancel = document.getElementById('report-cancel-btn');
        const reportForm = document.getElementById('report-form');

        if (reportBtn && reportModal) {
          reportBtn.addEventListener('click', () => reportModal.showModal());
        }
        if (reportCancel && reportModal) {
          reportCancel.addEventListener('click', () => reportModal.close());
        }
        if (reportForm && reportModal) {
          reportForm.addEventListener('submit', (e) => {
            e.preventDefault();
            reportModal.close();
            showToast('Report submitted.');
          });
        }
      });
    </script>

    <style is:global>
