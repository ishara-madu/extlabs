          </div>

        </div>
      </div>

      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Minimalist Toast Notification -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="toast"
        class="hidden bg-slate-900 text-white text-xs py-2.5 px-4 rounded-lg border border-slate-800 flex items-center gap-2"
      >
        <Check class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
        <span id="toast-message">Notification message</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Client-Side Interactivity Script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Media Tab Switcher (Screenshot vs YouTube Video)
        const tabScreenshot = document.getElementById('tab-screenshot-btn');
        const tabVideo = document.getElementById('tab-video-btn');
        const viewScreenshot = document.getElementById('media-screenshot-view');
        const viewVideo = document.getElementById('media-video-view');
        const counter = document.getElementById('screenshot-counter');
        const previewBadge = document.getElementById('media-preview-badge');

        if (tabScreenshot && tabVideo && viewScreenshot && viewVideo) {
          tabScreenshot.addEventListener('click', () => {
            tabScreenshot.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-slate-900 text-white cursor-pointer transition-colors';
            tabVideo.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors';
            viewScreenshot.classList.remove('hidden');
            viewVideo.classList.add('hidden');
            if (counter) counter.classList.remove('hidden');
            if (previewBadge) previewBadge.textContent = 'Showcase Preview';
          });

          tabVideo.addEventListener('click', () => {
            tabVideo.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-slate-900 text-white cursor-pointer transition-colors';
            tabScreenshot.className = 'media-tab-btn px-3 py-1 rounded text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors';
            viewVideo.classList.remove('hidden');
            viewScreenshot.classList.add('hidden');
            if (counter) counter.classList.add('hidden');
            if (previewBadge) previewBadge.textContent = 'YouTube Video';
          });
        }

        // Store Showcase Screenshots Gallery Switcher
        const mainImg = document.getElementById('main-screenshot-img') as HTMLImageElement | null;
        const prevBtn = document.getElementById('prev-screenshot-btn');
        const nextBtn = document.getElementById('next-screenshot-btn');
        const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.screenshot-thumb-btn');

        if (mainImg && thumbBtns.length > 1) {
          let currentIndex = 0;
          const total = thumbBtns.length;

          function setScreenshot(index: number) {
            currentIndex = (index + total) % total;
            const targetBtn = thumbBtns[currentIndex];
            if (!targetBtn) return;
            const newSrc = targetBtn.getAttribute('data-src');
            if (newSrc && mainImg) {
              mainImg.src = newSrc;
            }

            // Update active styles on thumbnails
            thumbBtns.forEach((btn, i) => {
              if (i === currentIndex) {
                btn.className = 'screenshot-thumb-btn shrink-0 w-20 sm:w-24 aspect-video rounded-lg overflow-hidden border cursor-pointer transition-all border-slate-900 ring-1 ring-slate-900 opacity-100';
              } else {
                btn.className = 'screenshot-thumb-btn shrink-0 w-20 sm:w-24 aspect-video rounded-lg overflow-hidden border cursor-pointer transition-all border-slate-200 opacity-60 hover:opacity-100 hover:border-slate-400';
              }
            });

            // Update counter
            if (counter) {
              counter.textContent = `${currentIndex + 1} / ${total}`;
            }
          }

          thumbBtns.forEach((btn, idx) => {
            btn.addEventListener('click', () => setScreenshot(idx));
          });

          if (prevBtn) {
            prevBtn.addEventListener('click', () => setScreenshot(currentIndex - 1));
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', () => setScreenshot(currentIndex + 1));
          }
        }

        // Toast Helper
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');
        let toastTimeout: number | null = null;

        function showToast(message: string) {
          if (toastTimeout) window.clearTimeout(toastTimeout);
          if (toast && toastMsg) {
            toastMsg.textContent = message;
            toast.classList.remove('hidden');
            toastTimeout = window.setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }

        // Dual-Action Download CTA Button
        const downloadBtn = document.getElementById('detail-download-btn');
        if (downloadBtn) {
          downloadBtn.addEventListener('click', () => {
            const extName = downloadBtn.getAttribute('data-ext-name') || 'extension';
            const extId = downloadBtn.getAttribute('data-ext-id') || 'ext';
            const extVersion = downloadBtn.getAttribute('data-ext-version') || '1.0.0';
            const extDeveloper = downloadBtn.getAttribute('data-ext-developer') || 'Developer';
            const extManifest = downloadBtn.getAttribute('data-manifest-version') || 'v3';
            const monetagUrl = downloadBtn.getAttribute('data-monetag-url') || 'https://monetag.com';
            const realDownloadUrl = downloadBtn.getAttribute('data-download-url');

            // 1. Open Monetag Direct Link in a new tab (Generates revenue for developer) if configured
            if (monetagUrl && monetagUrl !== '#' && monetagUrl.startsWith('http')) {
              window.open(monetagUrl, '_blank', 'noopener,noreferrer');
            }

            // 2. Trigger real extension package download
            if (realDownloadUrl && realDownloadUrl !== '#' && realDownloadUrl.startsWith('http')) {
              const a = document.createElement('a');
              a.href = realDownloadUrl;
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
              const cleanFilename = realDownloadUrl.split('/').pop()?.split('?')[0] || `${extId}-v${extVersion}.zip`;
              a.setAttribute('download', cleanFilename);
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
            } else {
              // Fallback package generation if no direct link configured
              const dummyPackage = `Package: ${extName}\nVersion: ${extVersion}\nDeveloper: ${extDeveloper}\nManifest: Manifest ${extManifest.toUpperCase()} Compliant\nVerified by: ExtLabs Directory`;
              const blob = new Blob([dummyPackage], { type: 'application/zip' });
              const downloadUrl = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = downloadUrl;
              a.download = `${extId}-v${extVersion}.zip`;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              URL.revokeObjectURL(downloadUrl);
            }

            // 3. Update button state
            downloadBtn.innerHTML = `
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Downloaded</span>
            `;
            downloadBtn.className = 'w-full sm:w-auto px-6 py-3 bg-emerald-700 text-white text-xs sm:text-sm font-medium rounded-lg flex items-center justify-center gap-2 cursor-pointer transition-colors';

            showToast(`Downloading ${extName}. Follow the install guide below if needed.`);

            // 4. Open Post-Download Install Quick Guide Modal
            const postDownloadModal = document.getElementById('post-download-modal') as HTMLDialogElement | null;
            if (postDownloadModal && typeof postDownloadModal.showModal === 'function') {
              postDownloadModal.showModal();
            }
          });
        }

        // Post-Download Modal Event Handlers
        const postDownloadModal = document.getElementById('post-download-modal') as HTMLDialogElement | null;
        const closePostModalBtn = document.getElementById('close-post-download-modal');
        const gotItPostModalBtn = document.getElementById('modal-got-it-btn');
        const modalCopyBtn = document.getElementById('modal-copy-ext-url-btn');
        const modalUrlEl = document.getElementById('modal-ext-url');

        if (closePostModalBtn && postDownloadModal) {
          closePostModalBtn.addEventListener('click', () => postDownloadModal.close());
        }
        if (gotItPostModalBtn && postDownloadModal) {
          gotItPostModalBtn.addEventListener('click', () => postDownloadModal.close());
        }
        if (modalCopyBtn && modalUrlEl) {
          modalCopyBtn.addEventListener('click', async () => {
            const url = modalUrlEl.textContent || 'chrome://extensions';
            try {
              await navigator.clipboard.writeText(url);
              modalCopyBtn.textContent = 'Copied!';
              setTimeout(() => {
                modalCopyBtn.textContent = 'Copy';
              }, 2000);
            } catch {
              modalCopyBtn.textContent = 'Copied!';
              setTimeout(() => {
                modalCopyBtn.textContent = 'Copy';
              }, 2000);
            }
          });
        }

        // Write Review Toggle & Submission
        const openReviewBtn = document.getElementById('open-review-form-btn');
        const reviewForm = document.getElementById('write-review-form');

        if (openReviewBtn && reviewForm) {
          openReviewBtn.addEventListener('click', () => {
            reviewForm.classList.toggle('hidden');
          });

          reviewForm.addEventListener('submit', (e) => {
            e.preventDefault();
            reviewForm.classList.add('hidden');
            showToast('Review submitted.');
          });
        }

        // Ratings Filter & Show More Reviews Handler
        const filterButtons = document.querySelectorAll('.review-filter-btn');
        const reviewEntries = document.querySelectorAll('.review-entry');
        const toggleMoreBtn = document.getElementById('toggle-more-reviews-btn');
        let currentRatingFilter = 'all';
        let isExpanded = false;

        function applyReviewFilter() {
          let visibleCount = 0;
          reviewEntries.forEach((entry) => {
            const entryRating = entry.getAttribute('data-rating') || '';
            const matchesRating = currentRatingFilter === 'all' || entryRating === currentRatingFilter;

            if (!matchesRating) {
              entry.classList.add('hidden');
            } else {
              visibleCount++;
              if (currentRatingFilter === 'all' && !isExpanded && visibleCount > 3) {
                entry.classList.add('hidden');
              } else {
                entry.classList.remove('hidden');
              }
            }
          });

          if (toggleMoreBtn) {
            if (currentRatingFilter !== 'all' || reviewEntries.length <= 3) {
              toggleMoreBtn.classList.add('hidden');
            } else {
              toggleMoreBtn.classList.remove('hidden');
              const extraCount = toggleMoreBtn.getAttribute('data-extra-count') || '0';
              toggleMoreBtn.textContent = isExpanded ? 'Show fewer reviews' : `Show more reviews (${extraCount})`;
            }
          }
        }

        filterButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const rating = btn.getAttribute('data-filter-rating') || 'all';
            currentRatingFilter = rating;

            filterButtons.forEach((b) => {
              b.className = 'review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 cursor-pointer transition-colors';
            });
            btn.className = 'review-filter-btn px-2.5 py-1 text-[11px] font-medium rounded-md bg-slate-900 text-white cursor-pointer transition-colors';

            applyReviewFilter();
          });
        });

        if (toggleMoreBtn) {
          toggleMoreBtn.addEventListener('click', () => {
            isExpanded = !isExpanded;
            applyReviewFilter();
          });
        }

        // Report Modal Handlers
        const reportBtn = document.getElementById('report-abuse-btn');
        const reportModal = document.getElementById('report-modal') as HTMLDialogElement | null;
        const reportCancel = document.getElementById('report-cancel-btn');
        const reportForm = document.getElementById('report-form');

        if (reportBtn && reportModal) {
          reportBtn.addEventListener('click', () => reportModal.showModal());
        }
        if (reportCancel && reportModal) {
          reportCancel.addEventListener('click', () => reportModal.close());
        }
        if (reportForm && reportModal) {
          reportForm.addEventListener('submit', (e) => {
            e.preventDefault();
            reportModal.close();
            showToast('Report submitted.');
          });
        }
      });
    </script>
  </body>
</html>
