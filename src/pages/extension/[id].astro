                            <span class="text-[10px] text-emerald-600 font-medium inline-flex items-center gap-0.5">
                              <BadgeCheck class="w-3 h-3 text-emerald-500" />
                              <span>Verified</span>
                            </span>
                          )}
                        </div>
                        <span class="text-[11px] text-slate-400">{rev.date}</span>
                      </div>

                      <div class="flex items-center gap-0.5 text-amber-500">
                        {[1, 2, 3, 4, 5].map((s) => (
                          <Star class={`w-3 h-3 ${s <= rev.rating ? 'text-amber-500 fill-amber-500' : 'text-slate-200 fill-slate-200'}`} />
                        ))}
                      </div>

                      <p class="text-xs text-slate-600 leading-relaxed">
                        "{rev.comment}"
                      </p>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="py-4 text-center text-xs text-slate-400">
                  <p>No written user reviews yet for this extension.</p>
                </div>
              )}

              <!-- Show More / Show Fewer Reviews Toggle -->
              {hasReviews && ext.reviews && ext.reviews.length > 3 && (
                <div class="pt-1">
                  <button
                    type="button"
                    id="toggle-more-reviews-btn"
                    data-expanded="false"
                    data-extra-count={ext.reviews.length - 3}
                    class="w-full py-2 text-xs font-medium text-slate-700 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg cursor-pointer transition-colors"
                  >
                    Show more reviews ({ext.reviews.length - 3})
                  </button>
                </div>
              )}
            </section>
          )}

          <!-- FAQs Column -->
          {hasFaqs && ext.faqs && ext.faqs.length > 0 && (
            <section class={`${showRatingsAndReviews ? 'lg:col-span-6' : 'w-full'} space-y-4`}>
              <div class="border-b border-slate-200 pb-2">
                <h2 class="text-base font-bold text-slate-900 tracking-tight">
                  Frequently Asked Questions
                </h2>
                <p class="text-xs text-slate-500">Common questions about this extension.</p>
              </div>

              <div class="divide-y divide-slate-100">
                {ext.faqs.map((faq) => (
                  <details class="group py-3 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                    <summary class="flex items-center justify-between text-xs font-semibold text-slate-900 select-none">
                      <span>{faq.question}</span>
                      <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" />
                    </summary>
                    <p class="mt-2 text-xs text-slate-600 leading-relaxed">
                      {faq.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )}

        </div>
      )}

      <!-- 6. Related Extensions Shelf -->
      {relatedExtensions.length > 0 && (
        <section class="space-y-4 pt-4 border-t border-slate-200">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-bold text-slate-900 tracking-tight">
                More in {ext.categoryLabel}
              </h2>
              <p class="text-xs text-slate-500">Related browser extensions.</p>
            </div>

            <a
              href={`/category/${ext.category}`}
              class="text-xs font-medium text-slate-700 hover:text-slate-900 flex items-center gap-1"
            >
              <span>View all</span>
              <ArrowRight class="w-3 h-3" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedExtensions.map((item) => (
              <ExtensionCard extension={item} />
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- Report Modal Dialog -->
    <dialog id="report-modal" class="modal">
      <div class="modal-box max-w-md p-5 bg-white rounded-lg border border-slate-200 space-y-3">
        <h3 class="text-sm font-bold text-slate-900">Report Extension</h3>
        <p class="text-xs text-slate-500">
          Describe the issue with <strong>{ext.name}</strong>:
        </p>

        <form id="report-form" class="space-y-2.5">
          <select class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded focus:outline-none">
            <option>Malware / Security Concern</option>
            <option>Broken functionality</option>
            <option>Misleading description</option>
            <option>Copyright / Trademark</option>
            <option>Other issue</option>
          </select>

          <textarea
            rows="3"
            required
            placeholder="Details..."
            class="w-full px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded focus:outline-none leading-relaxed"
          ></textarea>

          <div class="flex items-center justify-end gap-2 pt-1">
            <button
              type="button"
              id="report-cancel-btn"
              class="px-3 py-1.5 text-xs text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium rounded cursor-pointer"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <!-- Post-Download Quick Install Modal (Hybrid Flow) -->
    <dialog id="post-download-modal" class="modal">
      <div class="modal-box max-w-lg p-0 bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-xl">
        
        <!-- Modal Top Header in Soft #f0f4f9 Palette -->
        <div class="p-5 bg-[#f0f4f9] border-b border-slate-200/80 flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-white border border-slate-200/80 flex items-center justify-center text-emerald-600 shadow-2xs shrink-0">
              <CheckCircle2 class="w-5 h-5" />
            </div>
            <div>
              <div class="inline-flex items-center gap-1.5 bg-white border border-slate-200/80 rounded-full px-2.5 py-0.5 shadow-2xs mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-[11px] font-semibold text-slate-700">Download Started</span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 leading-tight">
                How to Install {ext.name}
              </h3>
            </div>
          </div>

          <button
            type="button"
            id="close-post-download-modal"
            class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-white/80 transition-colors cursor-pointer"
            aria-label="Close dialog"
          >
            <X class="w-4 h-4" />
          </button>
        </div>

        <!-- Modal Body: 3 Quick Steps -->
        <div class="p-5 space-y-4">
          <p class="text-xs text-slate-600 leading-relaxed">
            Follow these 3 quick steps to activate your extension in Chrome, Brave, Edge, or Opera:
          </p>

          <div class="space-y-2.5">
            <!-- Step 1: Unzip -->
            <div class="p-3.5 bg-[#f0f4f9] border border-slate-200/90 rounded-xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-slate-200 text-blue-600 font-mono font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mt-0.5">
                1
              </span>
              <div class="space-y-0.5 flex-1">
                <h4 class="text-xs font-bold text-slate-900">Extract Downloaded .ZIP</h4>
                <p class="text-[11px] text-slate-600 leading-relaxed">
                  Open your Downloads folder and extract the zip file to a permanent folder.
                </p>
              </div>
            </div>

            <!-- Step 2: Open Extensions & Enable Developer Mode -->
            <div class="p-3.5 bg-[#f0f4f9] border border-slate-200/90 rounded-xl space-y-2">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-white border border-slate-200 text-blue-600 font-mono font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mt-0.5">
                  2
                </span>
                <div class="space-y-0.5 flex-1">
                  <h4 class="text-xs font-bold text-slate-900">Open Extensions & Enable Developer Mode</h4>
                  <p class="text-[11px] text-slate-600 leading-relaxed">
                    Paste the URL below into your address bar and turn ON the <strong>Developer mode</strong> toggle at the top right.
                  </p>
                </div>
              </div>

              <!-- Quick URL Copy row inside step 2 -->
              <div class="ml-9 p-2 bg-white border border-slate-200 rounded-lg flex items-center justify-between gap-2 shadow-2xs">
                <span class="text-xs font-mono text-blue-700 font-semibold truncate select-all" id="modal-ext-url">chrome://extensions</span>
                <button
                  type="button"
                  id="modal-copy-ext-url-btn"
                  class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-medium rounded border border-slate-200 cursor-pointer shrink-0 transition-colors"
                >
                  Copy
                </button>
              </div>
            </div>

            <!-- Step 3: Load Unpacked -->
            <div class="p-3.5 bg-[#f0f4f9] border border-slate-200/90 rounded-xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-white border border-slate-200 text-blue-600 font-mono font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs mt-0.5">
                3
              </span>
              <div class="space-y-0.5 flex-1">
                <h4 class="text-xs font-bold text-slate-900">Click 'Load Unpacked'</h4>
                <p class="text-[11px] text-slate-600 leading-relaxed">
                  Click the <strong>Load unpacked</strong> button and choose your extracted folder. The extension is now active!
                </p>
              </div>
            </div>
          </div>

          <!-- Direct Download Fallback -->
          {ext.downloadUrl && ext.downloadUrl !== '#' && (
            <div class="px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between text-xs">
              <span class="text-slate-600">Download didn't start automatically?</span>
              <a
                href={ext.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:underline font-semibold inline-flex items-center gap-1"
              >
                <span>Download package directly</span>
                <Download class="w-3 h-3" />
              </a>
            </div>
          )}

          <!-- Footer action & link to full guide -->
          <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <a
              href="/how-to-install"
              target="_blank"
              class="text-blue-600 hover:underline font-medium inline-flex items-center gap-1"
            >
              <span>Need screenshots & step-by-step visuals?</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>

            <button
              type="button"
              id="modal-got-it-btn"
              class="w-full sm:w-auto px-4 py-2 bg-slate-900 hover:bg-black text-white font-medium rounded-lg shadow-2xs cursor-pointer transition-colors"
