---
// src/pages/search.astro
export const prerender = false;

import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ExtensionCard from "../components/ExtensionCard.astro";
import { CATEGORIES } from "../data/extensions";
import { getDb, searchStoreExtensions } from "../lib/db";
import { Search, SlidersHorizontal, X, ArrowRight, Sparkles, Box } from '@lucide/astro';

const url = new URL(Astro.request.url);
const queryParam = (url.searchParams.get('q') || '').trim();
const categoryParam = (url.searchParams.get('category') || '').trim();
const sortParam = (url.searchParams.get('sort') || 'popular').trim();

const db = getDb();
const extensions = await searchStoreExtensions(db, {
  query: queryParam,
  category: categoryParam,
  sort: sortParam,
});

const currentCategory = CATEGORIES.find(c => c.id === categoryParam);

// Set Edge CDN caching: 60s browser, 5m edge, stale-while-revalidate 10m
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=600');
Astro.response.headers.set('Vary', 'Cookie');

// Build helper URL for category/sort switches preserving search query
function buildSearchUrl(newCategory?: string, newSort?: string, clearQuery?: boolean) {
  const params = new URLSearchParams();
  const q = clearQuery ? '' : queryParam;
  const cat = newCategory !== undefined ? newCategory : categoryParam;
  const s = newSort !== undefined ? newSort : sortParam;

  if (q) params.set('q', q);
  if (cat && cat !== 'all') params.set('category', cat);
  if (s && s !== 'popular') params.set('sort', s);

  const qs = params.toString();
  return qs ? `/search?${qs}` : '/search';
}

const pageTitle = queryParam
  ? `Search: "${queryParam}" — ExtLabs Store`
  : currentCategory
  ? `${currentCategory.label} Extensions — ExtLabs Store`
  : `Search Extensions — ExtLabs Store`;

const pageDescription = queryParam
  ? `Browse browser extension search results for "${queryParam}" on ExtLabs.`
  : `Search and explore verified Manifest V3 browser extensions on ExtLabs.`;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-8 sm:py-10 space-y-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <a href="/search" class={`hover:text-blue-600 transition-colors ${!queryParam && !categoryParam ? 'text-slate-900 font-medium' : ''}`}>Search</a>
        {currentCategory && (
          <>
            <span class="text-slate-300">/</span>
            <span class="text-slate-700 font-medium">{currentCategory.label}</span>
          </>
        )}
        {queryParam && (
          <>
            <span class="text-slate-300">/</span>
            <span class="text-slate-900 font-mono truncate max-w-[200px]">"{queryParam}"</span>
          </>
        )}
      </nav>

      <!-- Page Header Strip -->
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {queryParam ? (
            <span>
              Search results for <span class="text-blue-600">"{queryParam}"</span>
            </span>
          ) : currentCategory ? (
            <span>{currentCategory.label} Extensions</span>
          ) : (
            <span>Explore All Extensions</span>
          )}
        </h1>
        <p class="text-xs sm:text-sm text-slate-500">
          Showing <span class="font-semibold text-slate-800">{extensions.length}</span> {extensions.length === 1 ? 'extension' : 'extensions'}
          {queryParam ? ` matching "${queryParam}"` : ''}
          {currentCategory ? ` in ${currentCategory.label}` : ''}.
        </p>
      </div>

      <!-- Search Input & Sort Strip -->
      <section class="space-y-4">
        <form action="/search" method="GET" class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-3 sm:p-4 bg-white rounded-xl border border-slate-200/90 shadow-2xs">
          
          <!-- Query Input with Clear Button -->
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <Search class="w-4 h-4" />
            </div>
            <input
              type="search"
              name="q"
              value={queryParam}
              placeholder="Search extensions by name, tag, or description..."
              class="w-full pl-10 pr-10 py-2 text-xs bg-slate-50 hover:bg-slate-100/80 focus:bg-white text-slate-900 rounded-lg border border-slate-200 focus:border-slate-400 focus:outline-none placeholder-slate-400 transition-colors"
              autofocus={!queryParam}
            />
            {queryParam && (
              <a
                href={buildSearchUrl(undefined, undefined, true)}
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-700"
                title="Clear query"
                aria-label="Clear search input"
              >
                <X class="w-3.5 h-3.5" />
              </a>
            )}
          </div>

          <!-- Hidden category state to preserve on search submit -->
          {categoryParam && (
            <input type="hidden" name="category" value={categoryParam} />
          )}

          <!-- Sort Select Dropdown -->
          <div class="flex items-center gap-2.5 justify-end shrink-0 text-xs text-slate-500 pt-1 sm:pt-0 border-t sm:border-t-0 border-slate-100">
            <span class="text-xs font-medium text-slate-600 whitespace-nowrap">Sort by:</span>
            <select
              name="sort"
              class="px-3 py-2 text-xs font-medium text-slate-700 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-slate-400 cursor-pointer"
              onchange="this.form.submit()"
            >
              <option value="popular" selected={sortParam === 'popular'}>Most Popular</option>
              <option value="rating" selected={sortParam === 'rating'}>Highest Rated</option>
              <option value="newest" selected={sortParam === 'newest'}>Newest Release</option>
              <option value="name" selected={sortParam === 'name'}>Name (A-Z)</option>
            </select>

            <noscript>
              <button
                type="submit"
                class="px-3 py-2 bg-slate-800 text-white text-xs font-semibold rounded-lg"
              >
                Apply
              </button>
            </noscript>
          </div>
        </form>

        <!-- Category Filter Pill Strip -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
          <a
            href={buildSearchUrl('all')}
            class={`inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap border transition-colors ${
              !categoryParam || categoryParam === 'all'
                ? 'bg-slate-800 text-white border-slate-800 shadow-2xs'
                : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-900'
            }`}
          >
            <span>All Categories</span>
          </a>

          {CATEGORIES.map((cat) => {
            const isActive = categoryParam === cat.id;
            return (
              <a
                href={buildSearchUrl(cat.id)}
                class={`inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap border transition-colors ${
                  isActive
                    ? 'bg-slate-800 text-white border-slate-800 shadow-2xs'
                    : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-900'
                }`}
              >
                <span>{cat.label}</span>
              </a>
            );
          })}
        </div>
      </section>

      <!-- Active Filters Tag Strip -->
      {(queryParam || (categoryParam && categoryParam !== 'all') || (sortParam && sortParam !== 'popular')) && (
        <div class="flex items-center gap-2 text-xs text-slate-500 flex-wrap pt-1">
          <span class="text-[11px] font-medium text-slate-400">Active filters:</span>
          {queryParam && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-mono text-[11px]">
              <span>keyword: "{queryParam}"</span>
              <a href={buildSearchUrl(undefined, undefined, true)} class="hover:text-rose-600" aria-label="Remove keyword filter">
                <X class="w-3 h-3" />
              </a>
            </span>
          )}
          {currentCategory && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 text-[11px]">
              <span>category: {currentCategory.label}</span>
              <a href={buildSearchUrl('all')} class="hover:text-rose-600" aria-label="Remove category filter">
                <X class="w-3 h-3" />
              </a>
            </span>
          )}
          {sortParam && sortParam !== 'popular' && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 text-[11px]">
              <span>sort: {sortParam}</span>
              <a href={buildSearchUrl(undefined, 'popular')} class="hover:text-rose-600" aria-label="Reset sort">
                <X class="w-3 h-3" />
              </a>
            </span>
          )}
          <a
            href="/search"
            class="text-[11px] text-blue-600 hover:text-blue-700 font-medium hover:underline ml-1"
          >
            Reset all
          </a>
        </div>
      )}

      <!-- Results Grid / Empty State -->
      {extensions.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {extensions.map((ext) => (
            <ExtensionCard extension={ext} />
          ))}
        </div>
      ) : (
        <div class="py-16 sm:py-20 text-center border border-dashed border-slate-200/90 rounded-2xl p-8 bg-white space-y-4">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center">
            <Search class="w-6 h-6" />
          </div>
          
          <div class="space-y-1">
            <h3 class="text-sm sm:text-base font-bold text-slate-900">
              No extensions found
            </h3>
            <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
              {queryParam ? (
                <span>We couldn't find any extensions matching <strong class="text-slate-800">"{queryParam}"</strong>. Try checking for typos or searching broader keywords.</span>
              ) : (
                <span>No extensions found matching the selected filters.</span>
              )}
            </p>
          </div>

          <!-- Helpful suggestions & actions -->
          <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/search"
              class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition-colors shadow-2xs"
            >
              Clear Filters
            </a>
            <a
              href="/categories"
              class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-semibold rounded-lg transition-colors shadow-2xs"
            >
              Browse Categories
            </a>
          </div>

          <!-- Developer Callout -->
          <div class="pt-6 border-t border-slate-100 max-w-md mx-auto text-xs text-slate-500">
            <span>Are you a developer building an extension? </span>
            <a href="/developers/new" class="text-blue-600 hover:text-blue-700 font-semibold hover:underline inline-flex items-center gap-1">
              <span>Publish your tool</span>
              <ArrowRight class="w-3 h-3 inline" />
            </a>
          </div>
        </div>
      )}

    </main>

    <!-- Footer -->
    <Footer />

  </body>
</html>
