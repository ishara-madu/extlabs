---
// src/pages/admin/pending-review/index.astro
import "../../../styles/global.css";
import AdminNavbar from "../../../components/AdminNavbar.astro";
import Footer from "../../../components/Footer.astro";
import { PENDING_SUBMISSIONS } from "../../../data/pendingSubmissions";
import { EXTENSIONS } from "../../../data/extensions";
import { 
  ShieldCheck, 
  Check, 
  AlertTriangle, 
  Search, 
  ArrowRight, 
  RefreshCw, 
  BadgeCheck, 
  ExternalLink, 
  AlertCircle,
  Users,
  BarChart3,
  Settings,
  ChevronLeft,
  ChevronRight,
  Clock,
  Filter,
  Box,
  Key
} from '@lucide/astro';

const ITEMS_PER_PAGE = 20;
const totalSubmissions = PENDING_SUBMISSIONS.length;
const totalPages = Math.ceil(totalSubmissions / ITEMS_PER_PAGE);
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pending Review Queue — ExtLabs Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Admin Topbar -->
    <AdminNavbar />

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-8">
      
      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2">
            <span class="text-xs font-semibold text-blue-600 font-mono">
              Staff Portal • Review Queue
            </span>
            <span class="text-xs text-slate-400 font-medium">
              Human Moderation Workstation
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Pending Review Queue
          </h1>

          <p class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">
            Review and verify extension packages submitted by third-party publishers before approving them for directory release.
          </p>
        </div>

        <!-- Quick Telemetry & Status -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="text-right hidden sm:block">
            <span class="text-xs font-semibold text-slate-900 block font-mono">{totalSubmissions} Packages</span>
            <span class="text-[11px] text-amber-600 font-medium">Awaiting Action</span>
          </div>
          <button
            type="button"
            id="refresh-queue-btn"
            class="p-2.5 bg-white hover:bg-slate-50 text-slate-700 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
            title="Sync Queue"
            aria-label="Sync Queue"
          >
            <RefreshCw class="w-4 h-4 text-slate-500" id="queue-refresh-icon" />
          </button>
        </div>
      </div>

      <!-- Admin Navigation Submenu / Tabs -->
      <div class="border-b border-slate-200 -mt-4">
        <nav class="flex items-center gap-1 sm:gap-6 overflow-x-auto no-scrollbar text-xs sm:text-sm font-medium">
          <!-- 1. Moderation Hub -->
          <a
            href="/admin"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <ShieldCheck class="w-4 h-4 text-slate-400" />
            <span>Moderation Hub</span>
          </a>

          <!-- 2. Pending Review (Active) -->
          <a
            href="/admin/pending-review"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-slate-900 text-slate-900 font-semibold shrink-0"
          >
            <Clock class="w-4 h-4 text-slate-900" />
            <span>Pending Review</span>
            <span class="text-[11px] font-mono font-semibold text-amber-600">{totalSubmissions}</span>
          </a>

          <!-- 3. Live Directory -->
          <a
            href="/admin/directory"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Box class="w-4 h-4 text-slate-400" />
            <span>Live Directory</span>
            <span class="text-[11px] font-mono font-semibold text-emerald-600">{EXTENSIONS.length}</span>
          </a>

          <!-- 4. Developers -->
          <a
            href="/admin/developers"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Users class="w-4 h-4 text-slate-400" />
            <span>Developers</span>
          </a>

          <!-- 5. Statistics -->
          <a
            href="/admin/statistics"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <BarChart3 class="w-4 h-4 text-slate-400" />
            <span>Statistics</span>
          </a>

          <!-- 6. Reports -->
          <a
            href="/admin/reports"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <AlertCircle class="w-4 h-4 text-slate-400" />
            <span>Reports</span>
            <span class="text-[11px] font-mono font-semibold text-rose-600">2</span>
          </a>

          <!-- 7. Settings -->
          <a
            href="/admin/settings"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Settings class="w-4 h-4 text-slate-400" />
            <span>Settings</span>
          </a>

          <!-- 8. Admin Controls -->
          <a
            href="/admin/controls"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Key class="w-4 h-4 text-slate-400" />
            <span>Admin Controls</span>
            <span class="text-[11px] font-mono font-semibold text-blue-600">6</span>
          </a>
        </nav>
      </div>

      <!-- Search & Filters Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-slate-500 font-medium">Filter Status:</span>
          <button
            type="button"
            class="filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer"
            data-filter="all"
          >
            All ({totalSubmissions})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="clean"
          >
            Passed Scan ({PENDING_SUBMISSIONS.filter(s => s.auditStatus === 'clean').length})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="warning"
          >
            Requires Triage ({PENDING_SUBMISSIONS.filter(s => s.auditStatus !== 'clean').length})
          </button>
        </div>

        <!-- Search Box -->
        <div class="relative w-full sm:w-72">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <Search class="w-3.5 h-3.5" />
          </div>
          <input
            type="text"
            id="queue-search-input"
            placeholder="Search extension or developer..."
            class="w-full pl-8 pr-3 py-1.5 text-xs bg-white text-slate-900 rounded-lg border border-slate-200 focus:outline-none focus:border-slate-400 placeholder:text-slate-400"
          />
        </div>
      </div>

      <!-- Pending Submissions Data Table Container (Developer Console Style) -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-slate-200 text-slate-500 font-medium bg-slate-50/50">
                <th scope="col" class="py-3 px-4 font-semibold">Extension</th>
                <th scope="col" class="py-3 px-4 font-semibold">Publisher</th>
                <th scope="col" class="py-3 px-4 font-semibold">Category</th>
                <th scope="col" class="py-3 px-4 font-semibold">Security Audit</th>
                <th scope="col" class="py-3 px-4 font-semibold">Submitted</th>
                <th scope="col" class="py-3 px-4 text-right font-semibold">Review & Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="pending-table-body">
              {PENDING_SUBMISSIONS.map((item, index) => {
                const pageNumber = Math.floor(index / ITEMS_PER_PAGE) + 1;
                return (
                  <tr 
                    class={`pending-item-row hover:bg-slate-50/80 transition-colors group ${pageNumber > 1 ? 'hidden' : ''}`}
                    data-page={pageNumber}
                    data-status={item.auditStatus}
                    data-name={item.name.toLowerCase()}
                    data-dev={item.developer.toLowerCase()}
                    id={`queue-item-${item.id}`}
                  >
                    <!-- Extension Info -->
                    <td class="py-3.5 px-4">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-xs text-slate-700 shrink-0">
                          {item.name.charAt(0)}
                        </div>
                        <div class="space-y-0.5">
                          <a
                            href={`/extension/${item.id}`}
                            target="_blank"
                            class="font-semibold text-slate-900 hover:text-blue-600 transition-colors block text-xs"
                          >
                            {item.name}
                          </a>
                          <span class="font-mono text-[11px] text-slate-400 block">
                            {item.version} • {item.packageSize}
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Publisher -->
                    <td class="py-3.5 px-4 font-mono text-slate-600">
                      @{item.developer}
                    </td>

                    <!-- Category -->
                    <td class="py-3.5 px-4 text-slate-600 font-medium">
                      {item.category}
                    </td>

                    <!-- Security Audit Result -->
                    <td class="py-3.5 px-4">
                      {item.auditStatus === 'clean' ? (
                        <div class="inline-flex items-center gap-1.5 text-xs text-emerald-600 font-medium">
                          <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                          <span>{item.auditSummary}</span>
                        </div>
                      ) : (
                        <div class="inline-flex items-center gap-1.5 text-xs text-amber-600 font-medium">
                          <AlertTriangle class="w-3.5 h-3.5 text-amber-600 shrink-0" />
                          <span>{item.auditSummary}</span>
                        </div>
                      )}
                    </td>

                    <!-- Submitted Time -->
                    <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap text-xs">
                      {item.submittedAt}
                    </td>

                    <!-- Actions & Inspect Link -->
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button
                          type="button"
                          data-action="approve"
                          data-id={item.id}
                          data-name={item.name}
                          class="queue-action-btn px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold rounded-lg transition-colors cursor-pointer shadow-2xs"
                        >
                          Approve
                        </button>
                        <button
                          type="button"
                          data-action="reject"
                          data-id={item.id}
                          data-name={item.name}
                          class="queue-action-btn px-2.5 py-1 bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-[11px] font-medium rounded-lg border border-slate-200 hover:border-rose-200 transition-colors cursor-pointer"
                        >
                          Reject
                        </button>
                        <a
                          href={`/extension/${item.id}`}
                          target="_blank"
                          class="p-1.5 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors cursor-pointer inline-flex items-center gap-1"
                          title="Inspect full package & manifest details"
                        >
                          <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600" />
                        </a>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Minimalist Pagination Bar (HyperUI / Vanilla) -->
        <div class="py-3 px-4 bg-slate-50/50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
          <div id="pagination-info" class="font-normal">
            Showing <strong class="font-semibold text-slate-900" id="page-range-start">1</strong> to <strong class="font-semibold text-slate-900" id="page-range-end">20</strong> of <strong class="font-semibold text-slate-900">{totalSubmissions}</strong> submissions
          </div>

          <div class="inline-flex items-center gap-1">
            <button
              type="button"
              id="prev-page-btn"
              disabled
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <ChevronLeft class="w-3.5 h-3.5" />
              <span>Previous</span>
            </button>

            <div class="flex items-center gap-1" id="pagination-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                <button
                  type="button"
                  data-page-target={pageNum}
                  class={`page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors ${
                    pageNum === 1
                      ? 'bg-slate-900 text-white'
                      : 'bg-white hover:bg-slate-100 text-slate-700 border border-slate-200'
                  }`}
                >
                  {pageNum}
                </button>
              ))}
            </div>

            <button
              type="button"
              id="next-page-btn"
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <span>Next</span>
              <ChevronRight class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

      </div>

    </main>

    <!-- Minimalist Floating Admin Toast -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="queue-toast"
        class="hidden bg-slate-900 text-white text-xs py-2.5 px-4 rounded-xl border border-slate-800 flex items-center gap-2 shadow-xl"
      >
        <Check class="w-4 h-4 text-emerald-400 shrink-0" />
        <span id="queue-toast-text">Action completed successfully.</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Auth Guard
        const adminSession = localStorage.getItem('extlabs_admin_session');
        if (!adminSession) {
          window.location.href = '/admin/login';
          return;
        }

        // 2. State & Elements
        let currentPage = 1;
        const itemsPerPage = 20;
        const totalItems = 25;
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        const rows = Array.from(document.querySelectorAll('.pending-item-row'));
        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');
        const pageBtns = document.querySelectorAll('.page-number-btn');
        const rangeStart = document.getElementById('page-range-start');
        const rangeEnd = document.getElementById('page-range-end');
        const searchInput = document.getElementById('queue-search-input');
        const filterBtns = document.querySelectorAll('.filter-tab-btn');

        const toast = document.getElementById('queue-toast');
        const toastText = document.getElementById('queue-toast-text');
        let toastTimer = null;

        function showToast(msg) {
          if (toastTimer) clearTimeout(toastTimer);
          if (toast && toastText) {
            toastText.textContent = msg;
            toast.classList.remove('hidden');
            toastTimer = setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }

        // 3. Pagination Logic
        function updatePagination() {
          const visibleRows = rows.filter((r) => r.dataset.matched !== 'false');
          const startIdx = (currentPage - 1) * itemsPerPage;
          const endIdx = startIdx + itemsPerPage;

          visibleRows.forEach((row, i) => {
            if (i >= startIdx && i < endIdx) {
              row.classList.remove('hidden');
            } else {
              row.classList.add('hidden');
            }
          });

          // Update Range Text
          if (rangeStart && rangeEnd) {
            rangeStart.textContent = visibleRows.length > 0 ? (startIdx + 1).toString() : '0';
            rangeEnd.textContent = Math.min(endIdx, visibleRows.length).toString();
          }

          // Update Prev / Next Buttons
          if (prevBtn) prevBtn.disabled = currentPage <= 1;
          if (nextBtn) nextBtn.disabled = currentPage >= totalPages || visibleRows.length <= itemsPerPage;

          // Update Page Number Buttons
          pageBtns.forEach((btn) => {
            const pageTarget = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            if (pageTarget === currentPage) {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-slate-900 text-white';
            } else {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-white hover:bg-slate-100 text-slate-700 border border-slate-200';
            }
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              updatePagination();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (currentPage < totalPages) {
              currentPage++;
              updatePagination();
            }
          });
        }

        pageBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            currentPage = target;
            updatePagination();
          });
        });

        // 4. Search & Filter
        let activeStatus = 'all';

        function applyFilters() {
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          rows.forEach((row) => {
            const name = row.getAttribute('data-name') || '';
            const dev = row.getAttribute('data-dev') || '';
            const status = row.getAttribute('data-status') || '';

            const matchesQuery = !query || name.includes(query) || dev.includes(query);
            const matchesStatus =
              activeStatus === 'all' ||
              (activeStatus === 'clean' && status === 'clean') ||
              (activeStatus === 'warning' && status !== 'clean');

            if (matchesQuery && matchesStatus) {
              row.dataset.matched = 'true';
            } else {
              row.dataset.matched = 'false';
              row.classList.add('hidden');
            }
          });

          currentPage = 1;
          updatePagination();
        }

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => {
              b.className = 'filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer';
            });
            btn.className = 'filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer';
            activeStatus = btn.getAttribute('data-filter') || 'all';
            applyFilters();
          });
        });

        // 5. Action Buttons (Approve / Reject)
        const actionBtns = document.querySelectorAll('.queue-action-btn');
        actionBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const action = btn.getAttribute('data-action');
            const name = btn.getAttribute('data-name');
            const row = btn.closest('tr');

            if (action === 'approve') {
              if (row) {
                const actionCell = row.querySelector('td:last-child');
                if (actionCell) {
                  actionCell.innerHTML = `
                    <span class="text-xs font-semibold text-emerald-600">
                      Approved & Published
                    </span>
                  `;
                }
              }
              showToast(`Approved "${name}". Extension published to directory.`);
            } else if (action === 'reject') {
              if (row) {
                const actionCell = row.querySelector('td:last-child');
                if (actionCell) {
                  actionCell.innerHTML = `
                    <span class="text-xs font-semibold text-rose-600">
                      Rejected
                    </span>
                  `;
                }
              }
              showToast(`Rejected "${name}". Notification sent to developer.`);
            }
          });
        });

        // 6. Refresh Button Mock
        const refreshBtn = document.getElementById('refresh-queue-btn');
        const refreshIcon = document.getElementById('queue-refresh-icon');
        if (refreshBtn && refreshIcon) {
          refreshBtn.addEventListener('click', () => {
            refreshIcon.classList.add('animate-spin');
            setTimeout(() => {
              refreshIcon.classList.remove('animate-spin');
              showToast('Review queue synchronized with latest developer uploads.');
            }, 600);
          });
        }
      });
    </script>

  </body>
</html>
