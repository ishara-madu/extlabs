---
// src/pages/admin/login.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { 
  ShieldCheck, 
  ArrowLeft, 
  Check, 
  KeyRound, 
  AlertCircle 
} from '@lucide/astro';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Sign In — ExtLabs Security Gateway</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Authorized administrator and moderator access for ExtLabs extension review, security audits, and publisher moderation." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Auth Container -->
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-12 sm:py-16">
      
      <div class="w-full max-w-md space-y-6">
        
        <!-- Back Navigation -->
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-slate-900 transition-colors"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Back to Directory</span>
        </a>

        <!-- Main Admin Login Card -->
        <div class="bg-white rounded-2xl border border-slate-200/90 p-8 sm:p-10 shadow-2xs space-y-6">
          
          <!-- Card Header -->
          <div class="space-y-2 text-center">
            <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center mx-auto shadow-2xs">
              <KeyRound class="w-5 h-5 text-white" />
            </div>
            
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">
              Admin Console Sign In
            </h1>
            
            <p class="text-xs text-slate-500 leading-relaxed">
              Authenticate with your authorized GitHub organization account to access the ExtLabs Moderation Hub, review extensions, and manage directory security.
            </p>
          </div>

          <!-- Unauthenticated Warning Notice (Shown when redirected) -->
          <div id="auth-alert" class="hidden p-3 bg-amber-50 border border-amber-200 text-amber-900 rounded-lg text-xs flex items-center gap-2">
            <AlertCircle class="w-4 h-4 text-amber-600 shrink-0" />
            <span>Please sign in with your GitHub administrator account to access the Admin Console.</span>
          </div>

          <!-- Primary GitHub Auth Action -->
          <div class="space-y-3 pt-2">
            <a
              href="/api/auth/github?redirect=/admin"
              id="admin-github-login-btn"
              class="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold rounded-xl inline-flex items-center justify-center gap-2.5 cursor-pointer transition-colors shadow-2xs group"
            >
              <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>Continue with GitHub</span>
            </a>

            <div class="flex items-center justify-center gap-1.5 text-[11px] text-slate-400">
              <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" />
              <span>Staff & Moderator Access • Cryptographically Audited</span>
            </div>
          </div>

          <!-- Moderation Console Features List -->
          <div class="pt-4 border-t border-slate-100 space-y-2.5">
            <span class="text-[11px] font-semibold text-slate-700 block uppercase tracking-wider">
              Admin Console Capabilities:
            </span>
            
            <div class="space-y-2 text-xs text-slate-600">
              <div class="flex items-start gap-2">
                <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                <span>Review & verify newly submitted Manifest V3 extension packages.</span>
              </div>
              
              <div class="flex items-start gap-2">
                <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                <span>Live directory controls, suspension, and homepage promotions.</span>
              </div>

              <div class="flex items-start gap-2">
                <Check class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                <span>Automated static security scanning & user abuse report triage.</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Privacy & Staff Policy Footer -->
        <p class="text-center text-[11px] text-slate-400 leading-relaxed px-4">
          Access is restricted to authorized ExtLabs organization staff. All session activities and moderation actions are cryptographically logged.
        </p>

      </div>

    </main>

    <!-- Footer -->
    <Footer />

    <!-- GitHub Authentication Handler -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Check if redirected because unauthenticated
        const urlParams = new URLSearchParams(window.location.search);
        const authAlert = document.getElementById('auth-alert');
        if (urlParams.get('auth_required') === 'true' && authAlert) {
          authAlert.classList.remove('hidden');
        }

        const loginBtn = document.getElementById('admin-github-login-btn');
        if (loginBtn) {
          loginBtn.addEventListener('click', () => {
            loginBtn.innerHTML = `
              <svg class="animate-spin w-4 h-4 text-white" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>Connecting GitHub OAuth...</span>
            `;
            loginBtn.classList.add('pointer-events-none', 'opacity-80');

            // Set admin session and user data in localStorage
            localStorage.setItem('extlabs_admin_session', 'true');
            localStorage.setItem('extlabs_admin_user', JSON.stringify({
              name: 'Ishara Madhusanka',
              username: 'ishara-madu',
              role: 'Super Moderator',
              avatar: '/icons/github-profile-placeholder.avif'
            }));

            // Redirect to Admin Moderation Dashboard
            setTimeout(() => {
              window.location.href = '/admin';
            }, 500);
          });
        }
      });
    </script>
  </body>
</html>
