---
// src/pages/admin/developers/index.astro
export const prerender = false;
import "../../../styles/global.css";
import AdminNavbar from "../../../components/AdminNavbar.astro";
import Footer from "../../../components/Footer.astro";
import { DEVELOPERS_DATA } from "../../../data/developers";
import { EXTENSIONS } from "../../../data/extensions";
import { 
  ShieldCheck, 
  Check, 
  Search, 
  ArrowRight, 
  RefreshCw, 
  BadgeCheck, 
  ExternalLink, 
  AlertCircle,
  Users,
  BarChart3,
  Settings,
  ChevronLeft,
  ChevronRight,
  Clock,
  Box,
  Key
} from '@lucide/astro';

const ITEMS_PER_PAGE = 20;
const totalDevelopers = DEVELOPERS_DATA.length;
const totalPages = Math.max(1, Math.ceil(totalDevelopers / ITEMS_PER_PAGE));
const verifiedCount = DEVELOPERS_DATA.filter(d => d.status === 'verified').length;
const activeCount = DEVELOPERS_DATA.filter(d => d.status === 'active').length;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Publisher & Developer Directory — ExtLabs Admin</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Admin Topbar -->
    <AdminNavbar />

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-8">
      
      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2">
            <span class="text-xs font-semibold text-blue-600 font-mono">
              Staff Portal • Production
            </span>
            <span class="text-xs text-slate-400 font-medium">
              Publisher Directory
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Registered Publishers & Developers
          </h1>

          <p class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">
            Manage verified publisher accounts, audit organization identities, inspect active package distributions, and track developer performance metrics.
          </p>
        </div>

        <!-- Quick Telemetry & Status -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="text-right hidden sm:block">
            <span class="text-xs font-semibold text-slate-900 block font-mono">{totalDevelopers} Registered</span>
            <span class="text-[11px] text-blue-600 font-medium">{verifiedCount} Verified Partners</span>
          </div>
          <button
            type="button"
            id="refresh-devs-btn"
            class="p-2.5 bg-white hover:bg-slate-50 text-slate-700 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
            title="Sync Developers"
            aria-label="Sync Developers"
          >
            <RefreshCw class="w-4 h-4 text-slate-500" id="devs-refresh-icon" />
          </button>
        </div>
      </div>

      <!-- Admin Navigation Submenu / Tabs -->
      <div class="border-b border-slate-200 -mt-4">
        <nav class="flex items-center gap-1 sm:gap-6 overflow-x-auto no-scrollbar text-xs sm:text-sm font-medium">
          <!-- 1. Moderation Hub -->
          <a
            href="/admin"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <ShieldCheck class="w-4 h-4 text-slate-400" />
            <span>Moderation Hub</span>
          </a>

          <!-- 2. Pending Review -->
          <a
            href="/admin/pending-review"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Clock class="w-4 h-4 text-slate-400" />
            <span>Pending Review</span>
            <span class="text-[11px] font-mono font-semibold text-amber-600">25</span>
          </a>

          <!-- 3. Live Directory -->
          <a
            href="/admin/directory"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Box class="w-4 h-4 text-slate-400" />
            <span>Live Directory</span>
            <span class="text-[11px] font-mono font-semibold text-emerald-600">{EXTENSIONS.length}</span>
          </a>

          <!-- 4. Developers (Active) -->
          <a
            href="/admin/developers"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-slate-900 text-slate-900 font-semibold shrink-0"
          >
            <Users class="w-4 h-4 text-slate-900" />
            <span>Developers</span>
            <span class="text-[11px] font-mono font-semibold text-blue-600">{totalDevelopers}</span>
          </a>

          <!-- 5. Statistics -->
          <a
            href="/admin/statistics"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <BarChart3 class="w-4 h-4 text-slate-400" />
            <span>Statistics</span>
          </a>

          <!-- 6. Reports -->
          <a
            href="/admin/reports"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <AlertCircle class="w-4 h-4 text-slate-400" />
            <span>Reports</span>
            <span class="text-[11px] font-mono font-semibold text-rose-600">2</span>
          </a>

          <!-- 7. Settings -->
          <a
            href="/admin/settings"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Settings class="w-4 h-4 text-slate-400" />
            <span>Settings</span>
          </a>

          <!-- 8. Admin Controls -->
          <a
            href="/admin/controls"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Key class="w-4 h-4 text-slate-400" />
            <span>Admin Controls</span>
            <span class="text-[11px] font-mono font-semibold text-blue-600">6</span>
          </a>
        </nav>
      </div>

      <!-- Search & Filters Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-slate-500 font-medium">Filter Status:</span>
          <button
            type="button"
            class="filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer"
            data-filter="all"
          >
            All ({totalDevelopers})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="verified"
          >
            Verified ({verifiedCount})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="active"
          >
            Active ({activeCount})
          </button>
        </div>

        <!-- Search Box -->
        <div class="relative w-full sm:w-72">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <Search class="w-3.5 h-3.5" />
          </div>
          <input
            type="text"
            id="devs-search-input"
            placeholder="Search developer or @handle..."
            class="w-full pl-8 pr-3 py-1.5 text-xs bg-white text-slate-900 rounded-lg border border-slate-200 focus:outline-none focus:border-slate-400 placeholder:text-slate-400"
          />
        </div>
      </div>

      <!-- Developers Data Table Container -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 text-slate-500 font-medium bg-slate-50/50">
                <th scope="col" class="py-3 px-4 sm:px-6 font-semibold">Developer / Publisher</th>
                <th scope="col" class="py-3 px-4 font-semibold">Active Extensions</th>
                <th scope="col" class="py-3 px-4 font-semibold">Total Installs</th>
                <th scope="col" class="py-3 px-4 font-semibold">Primary Focus</th>
                <th scope="col" class="py-3 px-4 font-semibold">Account State</th>
                <th scope="col" class="py-3 px-4 font-semibold">Member Since</th>
                <th scope="col" class="py-3 px-4 sm:px-6 text-right font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="developers-table-body">
              {DEVELOPERS_DATA.map((dev, index) => {
                const pageNumber = Math.floor(index / ITEMS_PER_PAGE) + 1;
                return (
                  <tr 
                    class={`developer-item-row hover:bg-slate-50/70 transition-colors ${pageNumber > 1 ? 'hidden' : ''}`}
                    data-page={pageNumber}
                    data-name={dev.name.toLowerCase()}
                    data-username={dev.username.toLowerCase()}
                    data-status={dev.status}
                    id={`dev-row-${dev.id}`}
                  >
                    <!-- Developer Info -->
                    <td class="py-3.5 px-4 sm:px-6">
                      <div class="flex items-center gap-3">
                        <img 
                          src={dev.avatar} 
                          alt={dev.name} 
                          class="w-8 h-8 rounded-full border border-slate-200 object-cover shrink-0" 
                        />
                        <div>
                          <div class="font-bold text-slate-900 leading-tight">
                            {dev.name}
                          </div>
                          <div class="flex items-center gap-1 text-[11px] text-slate-400 font-mono">
                            <span>@{dev.username}</span>
                            <span>•</span>
                            <a
                              href={dev.githubUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-blue-600 hover:underline inline-flex items-center gap-0.5"
                            >
                              <span>GitHub</span>
                              <ExternalLink class="w-2.5 h-2.5" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Published Extensions Count -->
                    <td class="py-3.5 px-4 font-mono font-medium text-slate-700">
                      {dev.extensionsCount} {dev.extensionsCount === 1 ? 'Package' : 'Packages'}
                    </td>

                    <!-- Total Installs -->
                    <td class="py-3.5 px-4 font-mono font-medium text-slate-700">
                      {dev.totalDownloads}
                    </td>

                    <!-- Primary Focus -->
                    <td class="py-3.5 px-4 text-slate-600 font-medium">
                      {dev.primaryCategory}
                    </td>

                    <!-- Account State (Strictly typographic, no pill borders per AGENTS.md) -->
                    <td class="py-3.5 px-4">
                      {dev.status === 'verified' && (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600">
                          <BadgeCheck class="w-3.5 h-3.5 text-blue-600" />
                          <span>Verified Partner</span>
                        </span>
                      )}
                      {dev.status === 'active' && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          <span>Active Publisher</span>
                        </span>
                      )}
                      {dev.status === 'pending' && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                          <span>Under Review</span>
                        </span>
                      )}
                    </td>

                    <!-- Member Since -->
                    <td class="py-3.5 px-4 text-slate-500 text-[11px] whitespace-nowrap">
                      {dev.joinedDate}
                    </td>

                    <!-- Action Button (Button only, inner page deliberately omitted per user instructions) -->
                    <td class="py-3.5 px-4 sm:px-6 text-right">
                      <a
                        href="#"
                        class="px-2.5 py-1 bg-white hover:bg-slate-50 text-blue-600 text-[11px] font-semibold rounded-lg border border-slate-200 hover:border-blue-200 transition-colors inline-flex items-center gap-1 shadow-2xs cursor-pointer"
                        title={`Manage ${dev.name}`}
                      >
                        <span>Manage</span>
                        <ArrowRight class="w-3 h-3" />
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Minimalist Pagination Bar -->
        <div class="py-3 px-4 bg-slate-50/50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
          <div id="pagination-info" class="font-normal">
            Showing <strong class="font-semibold text-slate-900" id="page-range-start">1</strong> to <strong class="font-semibold text-slate-900" id="page-range-end">{Math.min(ITEMS_PER_PAGE, totalDevelopers)}</strong> of <strong class="font-semibold text-slate-900">{totalDevelopers}</strong> publishers
          </div>

          <div class="inline-flex items-center gap-1">
            <button
              type="button"
              id="prev-page-btn"
              disabled
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <ChevronLeft class="w-3.5 h-3.5" />
              <span>Previous</span>
            </button>

            <div class="flex items-center gap-1" id="pagination-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                <button
                  type="button"
                  data-page-target={pageNum}
                  class={`page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors ${
                    pageNum === 1
                      ? 'bg-slate-900 text-white'
                      : 'bg-white hover:bg-slate-100 text-slate-700 border border-slate-200'
                  }`}
                >
                  {pageNum}
                </button>
              ))}
            </div>

            <button
              type="button"
              id="next-page-btn"
              disabled={totalPages <= 1}
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <span>Next</span>
              <ChevronRight class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

      </div>

    </main>

    <!-- Minimalist Floating Admin Toast -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="devs-toast"
        class="hidden bg-slate-900 text-white text-xs py-2.5 px-4 rounded-xl border border-slate-800 flex items-center gap-2 shadow-xl"
      >
        <Check class="w-4 h-4 text-emerald-400 shrink-0" />
        <span id="devs-toast-text">Action completed successfully.</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Auth Guard
        const adminSession = localStorage.getItem('extlabs_admin_session');
        if (!adminSession) {
          window.location.href = '/admin/login';
          return;
        }

        // 2. State & Elements
        let currentPage = 1;
        const itemsPerPage = 20;

        const rows = Array.from(document.querySelectorAll('.developer-item-row'));
        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');
        const pageBtns = document.querySelectorAll('.page-number-btn');
        const rangeStart = document.getElementById('page-range-start');
        const rangeEnd = document.getElementById('page-range-end');
        const searchInput = document.getElementById('devs-search-input');
        const filterBtns = document.querySelectorAll('.filter-tab-btn');

        const toast = document.getElementById('devs-toast');
        const toastText = document.getElementById('devs-toast-text');
        let toastTimer = null;

        function showToast(msg) {
          if (toastTimer) clearTimeout(toastTimer);
          if (toast && toastText) {
            toastText.textContent = msg;
            toast.classList.remove('hidden');
            toastTimer = setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }

        // 3. Pagination Logic
        function updatePagination() {
          const visibleRows = rows.filter((r) => r.dataset.matched !== 'false');
          const totalPages = Math.max(1, Math.ceil(visibleRows.length / itemsPerPage));
          
          if (currentPage > totalPages) currentPage = totalPages;
          
          const startIdx = (currentPage - 1) * itemsPerPage;
          const endIdx = startIdx + itemsPerPage;

          visibleRows.forEach((row, i) => {
            if (i >= startIdx && i < endIdx) {
              row.classList.remove('hidden');
            } else {
              row.classList.add('hidden');
            }
          });

          // Update Range Text
          if (rangeStart && rangeEnd) {
            rangeStart.textContent = visibleRows.length > 0 ? (startIdx + 1).toString() : '0';
            rangeEnd.textContent = Math.min(endIdx, visibleRows.length).toString();
          }

          // Update Prev / Next Buttons
          if (prevBtn) prevBtn.disabled = currentPage <= 1;
          if (nextBtn) nextBtn.disabled = currentPage >= totalPages || visibleRows.length <= itemsPerPage;

          // Update Page Number Buttons
          pageBtns.forEach((btn) => {
            const pageTarget = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            if (pageTarget === currentPage) {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-slate-900 text-white';
            } else {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-white hover:bg-slate-100 text-slate-700 border border-slate-200';
            }
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              updatePagination();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            currentPage++;
            updatePagination();
          });
        }

        pageBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            currentPage = target;
            updatePagination();
          });
        });

        // 4. Search & Filter
        let activeFilter = 'all';

        function applyFilters() {
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          rows.forEach((row) => {
            const name = row.getAttribute('data-name') || '';
            const username = row.getAttribute('data-username') || '';
            const status = row.getAttribute('data-status') || '';

            const matchesQuery = !query || name.includes(query) || username.includes(query);
            const matchesFilter =
              activeFilter === 'all' ||
              (activeFilter === 'verified' && status === 'verified') ||
              (activeFilter === 'active' && status === 'active');

            if (matchesQuery && matchesFilter) {
              row.dataset.matched = 'true';
            } else {
              row.dataset.matched = 'false';
              row.classList.add('hidden');
            }
          });

          currentPage = 1;
          updatePagination();
        }

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => {
              b.className = 'filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer';
            });
            btn.className = 'filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer';
            activeFilter = btn.getAttribute('data-filter') || 'all';
            applyFilters();
          });
        });

        // 5. Refresh Button Mock
        const refreshBtn = document.getElementById('refresh-devs-btn');
        const refreshIcon = document.getElementById('devs-refresh-icon');
        if (refreshBtn && refreshIcon) {
          refreshBtn.addEventListener('click', () => {
            refreshIcon.classList.add('animate-spin');
            setTimeout(() => {
              refreshIcon.classList.remove('animate-spin');
              showToast('Publisher directory synchronized with organization records.');
            }, 600);
          });
        }
      });
    </script>

  </body>
</html>
