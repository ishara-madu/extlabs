---
// src/pages/admin/directory/index.astro
import "../../../styles/global.css";
import AdminNavbar from "../../../components/AdminNavbar.astro";
import Footer from "../../../components/Footer.astro";
import { EXTENSIONS } from "../../../data/extensions";
import { 
  ShieldCheck, 
  Check, 
  Search, 
  Star, 
  ArrowRight, 
  RefreshCw, 
  BadgeCheck, 
  Sparkles, 
  ExternalLink, 
  AlertCircle,
  Users,
  BarChart3,
  Settings,
  ChevronLeft,
  ChevronRight,
  Clock,
  Box
} from '@lucide/astro';

const ITEMS_PER_PAGE = 20;
const totalExtensions = EXTENSIONS.length;
const totalPages = Math.max(1, Math.ceil(totalExtensions / ITEMS_PER_PAGE));
const featuredCount = EXTENSIONS.filter(e => e.featured).length;
const verifiedCount = EXTENSIONS.filter(e => e.isVerified).length;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Live Directory Management — ExtLabs Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Admin Topbar -->
    <AdminNavbar />

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-8">
      
      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2">
            <span class="text-xs font-semibold text-blue-600 font-mono">
              Staff Portal • Production
            </span>
            <span class="text-xs text-slate-400 font-medium">
              Live Store Inventory
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Live Directory Management
          </h1>

          <p class="text-xs sm:text-sm text-slate-500 max-w-2xl leading-relaxed">
            Manage all published extensions currently live on the ExtLabs directory. Control store state, toggle homepage features, and inspect active packages.
          </p>
        </div>

        <!-- Quick Telemetry & Status -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="text-right hidden sm:block">
            <span class="text-xs font-semibold text-slate-900 block font-mono">{totalExtensions} Active</span>
            <span class="text-[11px] text-emerald-600 font-medium">100% Operational</span>
          </div>
          <button
            type="button"
            id="refresh-dir-btn"
            class="p-2.5 bg-white hover:bg-slate-50 text-slate-700 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-center transition-colors cursor-pointer shadow-2xs"
            title="Sync Inventory"
            aria-label="Sync Inventory"
          >
            <RefreshCw class="w-4 h-4 text-slate-500" id="dir-refresh-icon" />
          </button>
        </div>
      </div>

      <!-- Admin Navigation Submenu / Tabs -->
      <div class="border-b border-slate-200 -mt-4">
        <nav class="flex items-center gap-1 sm:gap-6 overflow-x-auto no-scrollbar text-xs sm:text-sm font-medium">
          <!-- 1. Moderation Hub -->
          <a
            href="/admin"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <ShieldCheck class="w-4 h-4 text-slate-400" />
            <span>Moderation Hub</span>
          </a>

          <!-- 2. Pending Review -->
          <a
            href="/admin/pending-review"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Clock class="w-4 h-4 text-slate-400" />
            <span>Pending Review</span>
            <span class="text-[11px] font-mono font-semibold text-amber-600">25</span>
          </a>

          <!-- 3. Live Directory (Active) -->
          <a
            href="/admin/directory"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-slate-900 text-slate-900 font-semibold shrink-0"
          >
            <Box class="w-4 h-4 text-slate-900" />
            <span>Live Directory</span>
            <span class="text-[11px] font-mono font-semibold text-emerald-600">{totalExtensions}</span>
          </a>

          <!-- 4. Developers -->
          <a
            href="/admin/developers"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Users class="w-4 h-4 text-slate-400" />
            <span>Developers</span>
          </a>

          <!-- 5. Statistics -->
          <a
            href="/admin/statistics"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <BarChart3 class="w-4 h-4 text-slate-400" />
            <span>Statistics</span>
          </a>

          <!-- 6. Reports -->
          <a
            href="/admin/reports"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <AlertCircle class="w-4 h-4 text-slate-400" />
            <span>Reports</span>
            <span class="text-[11px] font-mono font-semibold text-rose-600">2</span>
          </a>

          <!-- 7. Settings -->
          <a
            href="/developers/settings"
            class="flex items-center gap-2 py-3 px-1 border-b-2 border-transparent text-slate-500 hover:text-slate-900 hover:border-slate-300 transition-colors shrink-0"
          >
            <Settings class="w-4 h-4 text-slate-400" />
            <span>Settings</span>
          </a>
        </nav>
      </div>

      <!-- Search & Filters Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-slate-500 font-medium">Filter Store:</span>
          <button
            type="button"
            class="filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer"
            data-filter="all"
          >
            All Listings ({totalExtensions})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="featured"
          >
            Featured ({featuredCount})
          </button>
          <span class="text-slate-300">•</span>
          <button
            type="button"
            class="filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer"
            data-filter="verified"
          >
            Verified Only ({verifiedCount})
          </button>
        </div>

        <!-- Search Box -->
        <div class="relative w-full sm:w-72">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <Search class="w-3.5 h-3.5" />
          </div>
          <input
            type="text"
            id="dir-search-input"
            placeholder="Search published extensions..."
            class="w-full pl-8 pr-3 py-1.5 text-xs bg-white text-slate-900 rounded-lg border border-slate-200 focus:outline-none focus:border-slate-400 placeholder:text-slate-400"
          />
        </div>
      </div>

      <!-- Live Directory Table Container -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-slate-200 text-slate-500 font-medium bg-slate-50/50">
                <th scope="col" class="py-3 px-4 sm:px-6 font-semibold">Published Extension</th>
                <th scope="col" class="py-3 px-4 font-semibold">Downloads</th>
                <th scope="col" class="py-3 px-4 font-semibold">Rating</th>
                <th scope="col" class="py-3 px-4 font-semibold">Verification</th>
                <th scope="col" class="py-3 px-4 font-semibold">Store State</th>
                <th scope="col" class="py-3 px-4 sm:px-6 text-right font-semibold">Listing Controls</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="directory-table-body">
              {EXTENSIONS.map((ext, index) => {
                const pageNumber = Math.floor(index / ITEMS_PER_PAGE) + 1;
                return (
                  <tr 
                    class={`directory-item-row hover:bg-slate-50/70 transition-colors ${pageNumber > 1 ? 'hidden' : ''}`}
                    data-page={pageNumber}
                    data-name={ext.name.toLowerCase()}
                    data-featured={ext.featured ? 'true' : 'false'}
                    data-verified={ext.isVerified ? 'true' : 'false'}
                    id={`dir-row-${ext.id}`}
                  >
                    <!-- Extension Info -->
                    <td class="py-3.5 px-4 sm:px-6">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xs shrink-0">
                          {ext.name.charAt(0)}
                        </div>
                        <div>
                          <a
                            href={`/extension/${ext.id}`}
                            target="_blank"
                            class="font-bold text-slate-900 hover:text-blue-600 transition-colors flex items-center gap-1 leading-tight"
                          >
                            <span>{ext.name}</span>
                            <ExternalLink class="w-3 h-3 text-slate-400" />
                          </a>
                          <span class="text-[11px] text-slate-400 font-mono">
                            v{ext.version} • {ext.categoryLabel}
                          </span>
                        </div>
                      </div>
                    </td>

                    <!-- Downloads -->
                    <td class="py-3.5 px-4 font-mono font-medium text-slate-700">
                      {ext.userCount}
                    </td>

                    <!-- Rating -->
                    <td class="py-3.5 px-4">
                      <div class="flex items-center gap-1 font-medium text-slate-700">
                        <Star class="w-3.5 h-3.5 text-amber-500 fill-amber-500" />
                        <span>{ext.rating.toFixed(1)}</span>
                      </div>
                    </td>

                    <!-- Verification (Pure text, no pill border) -->
                    <td class="py-3.5 px-4">
                      {ext.isVerified ? (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600">
                          <BadgeCheck class="w-3.5 h-3.5 text-blue-600" />
                          <span>Verified</span>
                        </span>
                      ) : (
                        <span class="text-xs text-slate-400">
                          Standard
                        </span>
                      )}
                    </td>

                    <!-- Store State (Pure text, no pill border) -->
                    <td class="py-3.5 px-4">
                      {ext.featured ? (
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 status-indicator">
                          <Sparkles class="w-3.5 h-3.5 text-emerald-600" />
                          <span>Featured</span>
                        </span>
                      ) : (
                        <span class="text-xs font-medium text-slate-500 status-indicator">
                          Live
                        </span>
                      )}
                    </td>

                    <!-- Controls -->
                    <td class="py-3.5 px-4 sm:px-6 text-right">
                      <div class="flex items-center justify-end gap-1.5">
                        <a
                          href={`/extension/${ext.id}`}
                          target="_blank"
                          class="px-2.5 py-1 bg-white hover:bg-slate-50 text-blue-600 text-[11px] font-semibold rounded-lg border border-slate-200 hover:border-blue-200 transition-colors inline-flex items-center gap-1 shadow-2xs"
                          title="Inspect extension page"
                        >
                          <span>Inspect</span>
                          <ArrowRight class="w-3 h-3" />
                        </a>
                        <button
                          type="button"
                          class="toggle-feature-btn px-2.5 py-1 bg-white hover:bg-slate-50 text-slate-700 text-[11px] font-medium rounded-lg border border-slate-200 transition-colors cursor-pointer shadow-2xs"
                          data-id={ext.id}
                        >
                          {ext.featured ? "Unfeature" : "Feature"}
                        </button>
                        <button
                          type="button"
                          class="suspend-btn px-2.5 py-1 bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-[11px] font-medium rounded-lg border border-slate-200 hover:border-rose-200 transition-colors cursor-pointer"
                          data-id={ext.id}
                          data-name={ext.name}
                        >
                          Suspend
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- Minimalist Pagination Bar (HyperUI / Vanilla) -->
        <div class="py-3 px-4 bg-slate-50/50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
          <div id="pagination-info" class="font-normal">
            Showing <strong class="font-semibold text-slate-900" id="page-range-start">1</strong> to <strong class="font-semibold text-slate-900" id="page-range-end">{Math.min(ITEMS_PER_PAGE, totalExtensions)}</strong> of <strong class="font-semibold text-slate-900">{totalExtensions}</strong> extensions
          </div>

          <div class="inline-flex items-center gap-1">
            <button
              type="button"
              id="prev-page-btn"
              disabled
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <ChevronLeft class="w-3.5 h-3.5" />
              <span>Previous</span>
            </button>

            <div class="flex items-center gap-1" id="pagination-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                <button
                  type="button"
                  data-page-target={pageNum}
                  class={`page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors ${
                    pageNum === 1
                      ? 'bg-slate-900 text-white'
                      : 'bg-white hover:bg-slate-100 text-slate-700 border border-slate-200'
                  }`}
                >
                  {pageNum}
                </button>
              ))}
            </div>

            <button
              type="button"
              id="next-page-btn"
              disabled={totalPages <= 1}
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-medium transition-colors inline-flex items-center gap-1 cursor-pointer"
            >
              <span>Next</span>
              <ChevronRight class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

      </div>

    </main>

    <!-- Minimalist Floating Admin Toast -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="dir-toast"
        class="hidden bg-slate-900 text-white text-xs py-2.5 px-4 rounded-xl border border-slate-800 flex items-center gap-2 shadow-xl"
      >
        <Check class="w-4 h-4 text-emerald-400 shrink-0" />
        <span id="dir-toast-text">Action completed successfully.</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Interactive Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Auth Guard
        const adminSession = localStorage.getItem('extlabs_admin_session');
        if (!adminSession) {
          window.location.href = '/admin/login';
          return;
        }

        // 2. State & Elements
        let currentPage = 1;
        const itemsPerPage = 20;

        const rows = Array.from(document.querySelectorAll('.directory-item-row'));
        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');
        const pageBtns = document.querySelectorAll('.page-number-btn');
        const rangeStart = document.getElementById('page-range-start');
        const rangeEnd = document.getElementById('page-range-end');
        const searchInput = document.getElementById('dir-search-input');
        const filterBtns = document.querySelectorAll('.filter-tab-btn');

        const toast = document.getElementById('dir-toast');
        const toastText = document.getElementById('dir-toast-text');
        let toastTimer = null;

        function showToast(msg) {
          if (toastTimer) clearTimeout(toastTimer);
          if (toast && toastText) {
            toastText.textContent = msg;
            toast.classList.remove('hidden');
            toastTimer = setTimeout(() => {
              toast.classList.add('hidden');
            }, 3000);
          }
        }

        // 3. Pagination Logic
        function updatePagination() {
          const visibleRows = rows.filter((r) => r.dataset.matched !== 'false');
          const totalPages = Math.max(1, Math.ceil(visibleRows.length / itemsPerPage));
          
          if (currentPage > totalPages) currentPage = totalPages;
          
          const startIdx = (currentPage - 1) * itemsPerPage;
          const endIdx = startIdx + itemsPerPage;

          visibleRows.forEach((row, i) => {
            if (i >= startIdx && i < endIdx) {
              row.classList.remove('hidden');
            } else {
              row.classList.add('hidden');
            }
          });

          // Update Range Text
          if (rangeStart && rangeEnd) {
            rangeStart.textContent = visibleRows.length > 0 ? (startIdx + 1).toString() : '0';
            rangeEnd.textContent = Math.min(endIdx, visibleRows.length).toString();
          }

          // Update Prev / Next Buttons
          if (prevBtn) prevBtn.disabled = currentPage <= 1;
          if (nextBtn) nextBtn.disabled = currentPage >= totalPages || visibleRows.length <= itemsPerPage;

          // Update Page Number Buttons
          pageBtns.forEach((btn) => {
            const pageTarget = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            if (pageTarget === currentPage) {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-slate-900 text-white';
            } else {
              btn.className = 'page-number-btn px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors bg-white hover:bg-slate-100 text-slate-700 border border-slate-200';
            }
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              updatePagination();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            currentPage++;
            updatePagination();
          });
        }

        pageBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = parseInt(btn.getAttribute('data-page-target') || '1', 10);
            currentPage = target;
            updatePagination();
          });
        });

        // 4. Search & Filter
        let activeFilter = 'all';

        function applyFilters() {
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          rows.forEach((row) => {
            const name = row.getAttribute('data-name') || '';
            const isFeatured = row.getAttribute('data-featured') === 'true';
            const isVerified = row.getAttribute('data-verified') === 'true';

            const matchesQuery = !query || name.includes(query);
            const matchesFilter =
              activeFilter === 'all' ||
              (activeFilter === 'featured' && isFeatured) ||
              (activeFilter === 'verified' && isVerified);

            if (matchesQuery && matchesFilter) {
              row.dataset.matched = 'true';
            } else {
              row.dataset.matched = 'false';
              row.classList.add('hidden');
            }
          });

          currentPage = 1;
          updatePagination();
        }

        if (searchInput) {
          searchInput.addEventListener('input', applyFilters);
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => {
              b.className = 'filter-tab-btn text-slate-500 hover:text-slate-900 cursor-pointer';
            });
            btn.className = 'filter-tab-btn font-semibold text-slate-900 underline underline-offset-4 cursor-pointer';
            activeFilter = btn.getAttribute('data-filter') || 'all';
            applyFilters();
          });
        });

        // 5. Feature Toggle & Suspend Actions
        const featureButtons = document.querySelectorAll('.toggle-feature-btn');
        featureButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const isFeatured = btn.textContent.trim() === 'Unfeature';
            btn.textContent = isFeatured ? 'Feature' : 'Unfeature';
            const row = btn.closest('tr');
            const indicator = row ? row.querySelector('.status-indicator') : null;
            if (indicator) {
              if (isFeatured) {
                indicator.className = 'text-xs font-medium text-slate-500 status-indicator';
                indicator.textContent = 'Live';
                if (row) row.setAttribute('data-featured', 'false');
                showToast('Listing removed from Featured shelf.');
              } else {
                indicator.className = 'inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 status-indicator';
                indicator.innerHTML = '<span>Featured</span>';
                if (row) row.setAttribute('data-featured', 'true');
                showToast('Listing promoted to Featured shelf.');
              }
            }
          });
        });

        const suspendButtons = document.querySelectorAll('.suspend-btn');
        suspendButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const name = btn.getAttribute('data-name');
            const row = btn.closest('tr');
            if (btn.textContent.trim() === 'Suspend') {
              btn.textContent = 'Restore';
              btn.classList.add('bg-slate-900', 'text-white');
              btn.classList.remove('text-slate-600');
              if (row) row.classList.add('opacity-50');
              showToast(`Suspended "${name}" from Live Directory.`);
            } else {
              btn.textContent = 'Suspend';
              btn.classList.remove('bg-slate-900', 'text-white');
              btn.classList.add('text-slate-600');
              if (row) row.classList.remove('opacity-50');
              showToast(`Restored "${name}" to Live Directory.`);
            }
          });
        });

        // 6. Refresh Button Mock
        const refreshBtn = document.getElementById('refresh-dir-btn');
        const refreshIcon = document.getElementById('dir-refresh-icon');
        if (refreshBtn && refreshIcon) {
          refreshBtn.addEventListener('click', () => {
            refreshIcon.classList.add('animate-spin');
            setTimeout(() => {
              refreshIcon.classList.remove('animate-spin');
              showToast('Live store inventory synchronized with CDN nodes.');
            }, 600);
          });
        }
      });
    </script>

  </body>
</html>
