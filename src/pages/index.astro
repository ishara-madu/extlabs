---
export const prerender = false;

import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import CategoryBar from "../components/CategoryBar.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import ExtensionCard from "../components/ExtensionCard.astro";
import Footer from "../components/Footer.astro";
import { CATEGORIES } from "../data/extensions";
import { getDb, getStoreExtensions } from "../lib/db";
import { ArrowRight, Check } from '@lucide/astro';

const db = getDb();
const allStoreExtensions = await getStoreExtensions(db);

const featuredExtensions = allStoreExtensions.filter(ext => ext.featured);
const devExtensions = allStoreExtensions.filter(ext => ext.category === 'dev');
const aiAndProdExtensions = allStoreExtensions.filter(ext => ext.category === 'ai' || ext.category === 'productivity');
const privacyAndUtilExtensions = allStoreExtensions.filter(ext => ext.category === 'privacy' || ext.category === 'utilities');

const categoryCounts: Record<string, number> = {};
for (const ext of allStoreExtensions) {
  categoryCounts[ext.category] = (categoryCounts[ext.category] || 0) + 1;
}

// 7-day Edge CDN Caching: Serves home page in 5ms with 0 D1 reads
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=604800, stale-while-revalidate=86400');
Astro.response.headers.set('Vary', 'Cookie');

let eagerCount = 0;
const getCardLoadingProps = () => {
  if (eagerCount < 4) {
    const isFirst = eagerCount === 0;
    eagerCount++;
    return {
      loading: 'eager' as const,
      fetchpriority: isFirst ? ('high' as const) : ('auto' as const),
    };
  }
  return {
    loading: 'lazy' as const,
    fetchpriority: 'auto' as const,
  };
};

const lcpCandidateImageUrl = featuredExtensions[0]?.headerImageUrl || devExtensions[0]?.headerImageUrl || allStoreExtensions[0]?.headerImageUrl;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>ExtLabs — Verified Browser Extensions Store for Chrome, Brave & Edge</title>
    <meta name="title" content="ExtLabs — Verified Browser Extensions Store for Chrome, Brave & Edge" />
    <meta name="description" content="Discover and download verified browser extensions, AI utilities, and developer tools for Chrome, Brave, and Edge. Free, fast, and verified safe on ExtLabs." />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://extlabs.store/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="ExtLabs" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ExtLabs — Verified Browser Extensions Store for Chrome, Brave & Edge" />
    <meta property="og:description" content="Discover and download verified browser extensions, AI utilities, and developer tools for Chrome, Brave, and Edge. Free, fast, and verified safe on ExtLabs." />
    <meta property="og:url" content="https://extlabs.store/" />
    <meta property="og:image" content="https://extlabs.store/og-image.jpeg" />
    <meta property="og:image:width" content="1376" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@extlabs_io" />
    <meta name="twitter:creator" content="@extlabs_io" />
    <meta name="twitter:title" content="ExtLabs — Verified Browser Extensions Store for Chrome, Brave & Edge" />
    <meta name="twitter:description" content="Discover and download verified browser extensions, AI utilities, and developer tools for Chrome, Brave, and Edge. Free, fast, and verified safe on ExtLabs." />
    <meta name="twitter:image" content="https://extlabs.store/og-image.jpeg" />

    <!-- High-Priority Font Preload for Zero FOIT / FOUT -->
    <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- LCP Hero Image Preload -->
    {lcpCandidateImageUrl && (
      <link rel="preload" as="image" href={lcpCandidateImageUrl} fetchpriority="high" />
    )}

    <!-- Resource Hints / Preconnects for CDN and LCP optimization -->
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />

    <!-- Schema.org JSON-LD Structured Data (WebSite + SearchAction + Organization + ItemList) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://extlabs.store/#website",
          "url": "https://extlabs.store/",
          "name": "ExtLabs",
          "description": "Discover verified browser extensions, AI utilities, and developer tools.",
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://extlabs.store/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://extlabs.store/#organization",
          "name": "ExtLabs",
          "url": "https://extlabs.store/",
          "logo": "https://extlabs.store/apple-touch-icon.png"
        },
        {
          "@type": "CollectionPage",
          "@id": "https://extlabs.store/#storefront",
          "url": "https://extlabs.store/",
          "name": "ExtLabs Extensions Storefront",
          "description": "Featured and editor-verified browser extensions and developer utilities.",
          "mainEntity": {
            "@type": "ItemList",
            "itemListElement": featuredExtensions.slice(0, 10).map((ext, idx) => ({
              "@type": "ListItem",
              "position": idx + 1,
              "name": ext.name,
              "url": `https://extlabs.store/extension/${ext.slug || ext.id}`
            }))
          }
        }
      ]
    })} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Category Pill Strip -->
    <CategoryBar categoryCounts={categoryCounts} />

    <!-- Main Content Area with generous breathing room -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-16">
      
      <!-- Accessible H1 for SEO, Screen Readers & Document Heading Outline -->
      <h1 class="sr-only">ExtLabs — Verified Browser Extensions, AI Utilities & Developer Tools Store</h1>

      <!-- Section 1: Featured Spotlight -->
      {featuredExtensions.length > 0 && (
        <section id="featured" class="shelf-section space-y-6 pt-6 border-t border-slate-200/60 first-of-type:border-t-0 first-of-type:pt-0">
          <div>
            <h2 class="text-base font-semibold text-slate-800 tracking-tight">
              Featured & Editors' Picks
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Top-rated extensions verified for performance and privacy.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredExtensions.map((ext) => (
              <FeaturedCard 
                extension={ext} 
                {...getCardLoadingProps()}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Section 2: Developer Tools -->
      {devExtensions.length > 0 && (
        <section id="dev-tools" class="shelf-section space-y-6 pt-6 border-t border-slate-200/60 first-of-type:border-t-0 first-of-type:pt-0">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-semibold text-slate-800 tracking-tight">
                Developer Tools
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Inspectors, API testers, and code utilities.</p>
            </div>
            <a
              href="/category/dev"
              class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer transition-colors"
            >
              <span>See all</span>
              <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {devExtensions.map((ext) => (
              <ExtensionCard extension={ext} {...getCardLoadingProps()} />
            ))}
          </div>
        </section>
      )}

      <!-- Section 3: AI & Productivity -->
      {aiAndProdExtensions.length > 0 && (
        <section id="ai-productivity" class="shelf-section space-y-6 pt-6 border-t border-slate-200/60 first-of-type:border-t-0 first-of-type:pt-0">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-semibold text-slate-800 tracking-tight">
                AI & Productivity
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Smart page summaries, notes, and task management.</p>
            </div>
            <a
              href="/category/ai"
              class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer transition-colors"
            >
              <span>See all</span>
              <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {aiAndProdExtensions.map((ext) => (
              <ExtensionCard extension={ext} {...getCardLoadingProps()} />
            ))}
          </div>
        </section>
      )}

      <!-- Section 4: Privacy & Security -->
      {privacyAndUtilExtensions.length > 0 && (
        <section id="privacy-utilities" class="shelf-section space-y-6 pt-6 border-t border-slate-200/60 first-of-type:border-t-0 first-of-type:pt-0">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-semibold text-slate-800 tracking-tight">
                Privacy & Security
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Ad blockers, passkeys, and memory savers.</p>
            </div>
            <a
              href="/category/privacy"
              class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 cursor-pointer transition-colors"
            >
              <span>See all</span>
              <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {privacyAndUtilExtensions.map((ext) => (
              <ExtensionCard extension={ext} {...getCardLoadingProps()} />
            ))}
          </div>
        </section>
      )}

      <!-- Section 5: Clean Developer Callout with Monetag Highlight -->
      <section id="developers" class="rounded-2xl bg-slate-900 p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-2xs text-white">
        <div class="space-y-2 text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2 text-xs text-slate-400">
            <span class="text-blue-400 font-semibold">ExtLabs Developer Hub</span>
            <span class="text-slate-600">•</span>
            <span class="text-slate-300">100% Creator Control</span>
          </div>
          <h2 class="text-lg sm:text-xl font-bold text-white tracking-tight">
            Publish your browser extension & reach global users
          </h2>
          <p class="text-xs text-slate-300 max-w-lg leading-relaxed">
            Distribute your browser extensions, track live developer telemetry, manage user reviews, and earn with zero platform fees.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/developers"
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl cursor-pointer shadow-2xs transition-colors"
          >
            Developer Portal
          </a>
          <a
            href="/developers/monetization-guide"
            class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition-colors"
          >
            Monetization Guide
          </a>
        </div>
      </section>

    </main>

    <!-- Minimalist Toast Notification -->
    <div class="fixed bottom-6 right-6 z-50">
      <div
        id="toast"
        class="hidden bg-slate-800 text-white text-xs py-2.5 px-4 rounded-xl shadow-lg border border-slate-700 flex items-center gap-2"
      >
        <Check class="w-4 h-4 text-emerald-400 shrink-0" />
        <span id="toast-message">Notification message</span>
      </div>
    </div>

    <!-- Footer -->
    <Footer />
  </body>
</html>
