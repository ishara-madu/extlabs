    <!-- Interactive Client Script (Zero Bloat Vanilla JS) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Browser Switcher Tabs
        const tabButtons = document.querySelectorAll('.browser-tab-btn');
        const activeUrlEl = document.getElementById('active-browser-url');
        const activeNotesEl = document.getElementById('active-browser-notes');
        const copyBtn = document.getElementById('copy-url-btn');
        const copyBtnText = document.getElementById('copy-btn-text');

        tabButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            // Update button styles
            tabButtons.forEach((b) => {
              b.classList.remove('bg-white', 'text-slate-900', 'shadow-2xs', 'font-semibold');
              b.classList.add('text-slate-600');
            });
            btn.classList.add('bg-white', 'text-slate-900', 'shadow-2xs', 'font-semibold');
            btn.classList.remove('text-slate-600');

            // Update URL and Notes
            const url = btn.getAttribute('data-browser-url') || 'chrome://extensions';
            const notes = btn.getAttribute('data-browser-notes') || '';
            if (activeUrlEl) activeUrlEl.textContent = url;
            if (activeNotesEl) activeNotesEl.textContent = notes;
          });
        });

        // 2. Copy URL Button
        if (copyBtn && activeUrlEl) {
          copyBtn.addEventListener('click', async () => {
            const urlToCopy = activeUrlEl.textContent || 'chrome://extensions';
            try {
              await navigator.clipboard.writeText(urlToCopy);
              if (copyBtnText) copyBtnText.textContent = 'Copied!';
              copyBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
              setTimeout(() => {
                if (copyBtnText) copyBtnText.textContent = 'Copy URL';
                copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
              }, 2000);
            } catch (err) {
              // Fallback
              const input = document.createElement('input');
              input.value = urlToCopy;
              document.body.appendChild(input);
              input.select();
              document.execCommand('copy');
              document.body.removeChild(input);
              if (copyBtnText) copyBtnText.textContent = 'Copied!';
              setTimeout(() => {
                if (copyBtnText) copyBtnText.textContent = 'Copy URL';
              }, 2000);
            }
          });
        }
      });
    </script>
