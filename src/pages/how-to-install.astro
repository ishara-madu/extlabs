---
// src/pages/how-to-install.astro
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { 
  Check, 
  ChevronDown, 
  ShieldCheck, 
  HelpCircle, 
  Copy, 
  Terminal, 
  Pin
} from '@lucide/astro';
import { Image } from 'astro:assets';

const siteUrl = "https://extlabs.io";
const pageUrl = `${siteUrl}/how-to-install`;
const pageTitle = "How to Install Browser Extensions (.zip) on Chrome, Brave & Edge — ExtLabs";
const pageDescription = "Complete step-by-step visual tutorial to installing downloaded .zip browser extensions in Google Chrome, Brave, Microsoft Edge, and Opera using Load Unpacked in Developer Mode.";
const ogImage = `${siteUrl}/images/how-to-install/step-1-extract-zip.avif`;

const browsers = [
  {
    id: 'chrome',
    name: 'Google Chrome',
    shortName: 'Chrome',
    url: 'chrome://extensions',
    notes: 'Default Chromium browser. Developer mode toggle is located in the top-right corner.'
  },
  {
    id: 'brave',
    name: 'Brave Browser',
    shortName: 'Brave',
    url: 'brave://extensions',
    notes: 'Built on Chromium. Supports all Chrome extensions with identical developer mode controls.'
  },
  {
    id: 'edge',
    name: 'Microsoft Edge',
    shortName: 'Edge',
    url: 'edge://extensions',
    notes: 'In Edge, you can also toggle "Developer mode" in the left sidebar menu.'
  },
  {
    id: 'opera',
    name: 'Opera / Vivaldi',
    shortName: 'Opera / Vivaldi',
    url: 'opera://extensions',
    notes: 'Navigate to extensions manager and enable Developer Mode switch on the top bar.'
  }
];

const installSteps = [
  {
    id: "step-1",
    num: "01",
    title: "Extract the Downloaded .ZIP Package",
    summary: "Unpack the archive so the browser can read the extension manifest and scripts.",
    image: "/images/how-to-install/step-1-extract-zip.avif",
    imageAlt: "Step 1: Locate downloaded ZIP file, extract it to a permanent folder and verify manifest.json",
    caption: "Figure 01: Extract the downloaded archive into a standard directory containing manifest.json.",
    details: [
      "Locate the downloaded `.zip` file in your system's Downloads folder.",
      "Right-click the file and select 'Extract All...' (Windows) or double-click to unzip (macOS).",
      "Ensure the extracted folder contains the `manifest.json` file and core assets directly inside it.",
      "Keep this extracted folder in a permanent directory (e.g. Documents or Tools) — do not delete it after installing."
    ],
    proTip: "If you move or delete the unzipped folder later, the browser will not be able to load the extension upon restart."
  },
  {
    id: "step-2",
    num: "02",
    title: "Open the Browser Extensions Manager",
    summary: "Navigate directly to your browser's internal extension management console.",
    image: "/images/how-to-install/step-2-open-extensions-page.avif",
    imageAlt: "Step 2: Enter chrome://extensions into the browser address bar to navigate to extensions manager",
    caption: "Figure 02: Enter the internal extensions URL directly into your browser address bar.",
    details: [
      "Click your browser's address bar at the top of any window.",
      "Type or paste the internal URL: chrome://extensions (or brave://extensions / edge://extensions).",
      "Press Enter to open the Extensions page.",
      "Alternatively, open the browser Menu (⋮ or ⋯) → Extensions → Manage Extensions."
    ],
    proTip: "Internal URLs cannot be opened via direct website links for security reasons; paste it directly into your address bar."
  },
  {
    id: "step-3",
    num: "03",
    title: "Turn ON 'Developer Mode'",
    summary: "Unlock the ability to sideload independent and verified unpacked packages.",
    image: "/images/how-to-install/step-3-enable-developer-mode.avif",
    imageAlt: "Step 3: Toggle on Developer mode switch in the top-right corner to reveal action buttons",
    caption: "Figure 03: Toggle Developer Mode in the top-right corner to reveal the action buttons.",
    details: [
      "Look at the top-right corner of the Extensions page (or left sidebar in Microsoft Edge).",
      "Locate the 'Developer mode' toggle switch.",
      "Click the toggle switch to turn it ON (it will turn blue or highlighted).",
      "Notice three action buttons appear on the top navigation bar: 'Load unpacked', 'Pack extension', and 'Update'."
    ],
    proTip: "Developer mode is completely safe when installing verified packages from ExtLabs. It does not compromise browser security."
  },
  {
    id: "step-4",
    num: "04",
    title: "Click 'Load Unpacked' & Select the Folder",
    summary: "Point your browser to the unzipped extension directory to complete installation.",
    image: "/images/how-to-install/step-4-load-unpacked-extension.avif",
    imageAlt: "Step 4: Click Load unpacked button and select the unzipped directory containing manifest.json",
    caption: "Figure 04: Click 'Load unpacked' and choose the folder containing manifest.json.",
    details: [
      "Click the 'Load unpacked' button located on the top action bar.",
      "In the file picker dialog that appears, navigate to and select the unzipped folder from Step 01.",
      "Click 'Select Folder' (or 'Open' on macOS).",
      "Your extension is immediately installed, activated, and ready to use — no browser restart required!"
    ],
    proTip: "Make sure to select the folder that contains `manifest.json`. Do not select the outer `.zip` file or a parent empty wrapper."
  }
];

const faqs = [
  {
    q: "Why do I need to enable 'Developer mode' to install these extensions?",
    a: "Corporate browser stores frequently restrict power tools, scrapers, bypass utilities, and indie developer helpers under ambiguous policies. Sideloading via Developer mode allows you to run verified, open-source packages directly without platform restrictions or corporate gatekeeping."
  },
  {
    q: "I get an error: 'Manifest file is missing or unreadable'. How do I fix this?",
    a: "This happens when the folder selected in 'Load unpacked' has a nested subfolder. When you extract a .zip, your operating system sometimes creates a folder inside another folder. Open the extracted folder, find the folder that directly contains the `manifest.json` file, and select that specific folder in the browser dialog."
  },
  {
    q: "Are unpacked extensions from ExtLabs safe to use?",
    a: "Yes. Every extension published on ExtLabs undergoes automated static code audits to ensure zero malicious injection, no obfuscated code, no crypto-miners, and strict adherence to client-side privacy standards. You can also view the open source repository for community verification."
  },
  {
    q: "How do I update an unpacked extension when a new version is released?",
    a: "Simply download the updated .zip from ExtLabs, extract its files, replace the old files inside your extension folder, and click the 'Reload' (🔄) button on the extension card in `chrome://extensions`."
  },
  {
    q: "Can I remove or uninstall an unpacked extension anytime?",
    a: "Yes. Navigate to `chrome://extensions`, find the extension card, and click 'Remove'. It will be instantly removed from your browser."
  }
];

// Schema.org JSON-LD structured data for Google Rich Results
const jsonLdSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Guides",
          "item": `${siteUrl}/guides`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "How to Install",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Install Browser Extensions from a .ZIP File",
      "description": "Step-by-step visual walkthrough showing how to extract and load unpacked browser extensions in Google Chrome, Brave, Microsoft Edge, and Opera using Developer Mode.",
      "image": ogImage,
      "totalTime": "PT1M",
      "estimatedCost": {
        "@type": "MonetaryAmount",
        "currency": "USD",
        "value": "0"
      },
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Google Chrome, Brave, Microsoft Edge, or Opera Browser"
        },
        {
          "@type": "HowToTool",
          "name": "Extracted Extension ZIP package containing manifest.json"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "ExtLabs .zip extension package"
        }
      ],
      "step": installSteps.map((step) => ({
        "@type": "HowToStep",
        "url": `${pageUrl}#${step.id}`,
        "name": step.title,
        "text": `${step.summary} ${step.details.join(" ")}`,
        "image": `${siteUrl}${step.image}`,
        "itemListElement": step.details.map((detail, dIdx) => ({
          "@type": "HowToDirection",
          "position": dIdx + 1,
          "text": detail
        }))
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="how to install chrome extension zip, load unpacked chrome extension, sideload extension, install brave extension zip, edge developer mode extension, install unpacked extension, extlabs tutorial" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1376" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:alt" content="How to Install Browser Extensions (.zip) Visual Guide" />
    <meta property="og:site_name" content="ExtLabs" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Container -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-6 sm:px-8 py-10 space-y-14">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-500">Guides</span>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">How to Install</span>
      </nav>

      <!-- 1. Header Area (Crisp & Typographic) -->
      <header class="space-y-4 border-b border-slate-200 pb-10">
        <div class="flex items-center gap-2 text-xs text-slate-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          <span class="text-slate-900 font-semibold">Installation Guide</span>
          <span class="text-slate-300">•</span>
          <span>4 Simple Steps</span>
          <span class="text-slate-300">•</span>
          <span>&lt; 60 Seconds</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          How to Install Browser Extensions (.zip)
        </h1>

        <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
          ExtLabs distributes lightweight, unpacked packages directly. Follow this simple 4-step walkthrough to extract and activate any extension in Google Chrome, Brave, Edge, or Opera.
        </p>

        <!-- Quick Summary Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 text-xs">
          <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Format</span>
            <span class="font-medium text-slate-800">Unpacked .ZIP</span>
          </div>
          <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Standard</span>
            <span class="font-medium text-slate-800">Chromium Native</span>
          </div>
          <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Security</span>
            <span class="font-medium text-emerald-600 flex items-center gap-1">
              <ShieldCheck class="w-3.5 h-3.5 text-emerald-600" /> 100% Virus-Free
            </span>
          </div>
          <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block">Permissions</span>
            <span class="font-medium text-slate-800">Client-Side Only</span>
          </div>
        </div>
      </header>

      <!-- 2. Interactive Browser Switcher & URL Utility Box -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-slate-900 tracking-tight">
              Select Your Browser
            </h2>
            <p class="text-xs text-slate-500">
              The installation workflow is identical across all Chromium browsers.
            </p>
          </div>

          <!-- Browser Selection Buttons -->
          <div class="inline-flex p-1 bg-slate-100 rounded-lg border border-slate-200" id="browser-tab-bar">
            {browsers.map((b, idx) => (
              <button
                type="button"
                data-browser-id={b.id}
                data-browser-url={b.url}
                data-browser-notes={b.notes}
                class={`browser-tab-btn px-3 py-1.5 text-xs font-medium rounded-md transition-colors cursor-pointer select-none ${
                  idx === 0
                    ? 'bg-white text-slate-900 shadow-2xs font-semibold'
                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/50'
                }`}
              >
                {b.shortName}
              </button>
            ))}
          </div>
        </div>

        <!-- Address Bar Utility Box -->
        <div class="p-5 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xs space-y-3.5 text-white">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="space-y-1.5">
              <span class="text-[11px] uppercase font-bold text-slate-400 tracking-wider block">
                Internal Extension URL
              </span>
              <div class="flex items-center gap-2 text-xs sm:text-sm font-mono text-blue-400 font-semibold bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-lg shadow-2xs w-fit">
                <Terminal class="w-4 h-4 text-slate-400 shrink-0" />
                <span id="active-browser-url">chrome://extensions</span>
              </div>
            </div>

            <button
              type="button"
              id="copy-url-btn"
              class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-lg border border-slate-700 flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 shadow-2xs"
            >
              <Copy class="w-3.5 h-3.5 text-slate-400" id="copy-icon" />
              <span id="copy-btn-text">Copy URL</span>
            </button>
          </div>

          <p id="active-browser-notes" class="text-xs text-slate-300 leading-relaxed border-t border-slate-800 pt-3">
            Default Chromium browser. Developer mode toggle is located in the top-right corner.
          </p>
        </div>
      </section>

      <!-- 3. The 4-Step Walkthrough with Verified High-Definition Screenshots -->
      <section class="space-y-12">
        <div class="space-y-1 border-b border-slate-200 pb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            Step-by-Step Installation Walkthrough
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Follow these 4 simple steps to install any ExtLabs package in under a minute.
          </p>
        </div>

        {installSteps.map((step, idx) => (
          <div id={step.id} class="space-y-6 pb-12 border-b border-slate-200 scroll-mt-20">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
                <span class="text-xs font-mono font-bold text-blue-600 tracking-wider">
                  Step {step.num}
                </span>
                <span class="text-slate-300">/</span>
                <h3 class="text-lg font-bold text-slate-900 tracking-tight">
                  {step.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-slate-500">
                {step.summary}
              </p>
            </div>

            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 pl-1 max-w-3xl">
              {step.details.map((item) => (
                <li class="flex items-start gap-2.5">
                  <Check class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>

            <!-- Verified Step Screenshot -->
            <figure class="space-y-2 pt-2">
              <div class="w-full aspect-[16/9] max-w-3xl bg-slate-950 rounded-xl border border-slate-200/90 overflow-hidden shadow-xs flex items-center justify-center">
                <Image 
                  src={step.image} 
                  alt={step.imageAlt}
                  width={1376}
                  height={768}
                  loading={idx === 0 ? "eager" : "lazy"}
                  class="w-full h-full object-contain"
                />
              </div>
              <figcaption class="text-[12px] text-slate-500 pl-1">
                {step.caption}
              </figcaption>
            </figure>

            <!-- Dark Note Style for Pro Tip -->
            <div class="p-4 bg-slate-900 rounded-xl text-white text-xs sm:text-sm flex items-start gap-2.5 max-w-3xl shadow-2xs">
              <span class="text-emerald-400 font-bold shrink-0">Pro-Tip:</span>
              <span class="text-slate-300 leading-relaxed">{step.proTip}</span>
            </div>
          </div>
        ))}
      </section>

      <!-- 4. Pinning Bonus Tip -->
      <section class="space-y-6">
        <div class="p-6 sm:p-7 bg-slate-900 rounded-2xl shadow-2xs space-y-4 text-white">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Pin class="w-4 h-4 text-blue-400" />
              <span class="text-xs font-bold text-slate-100">Toolbar Quick Access</span>
            </div>
            <span class="text-xs text-slate-400 font-medium">Recommended</span>
          </div>

          <h3 class="text-base font-bold text-white tracking-tight">
            Bonus Tip: Pin the Extension for 1-Click Access
          </h3>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl">
            Modern browsers automatically hide newly installed extensions inside the extensions menu. To keep your extension visible in your main browser toolbar:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-2xs space-y-1.5">
              <span class="text-xs font-mono font-bold text-blue-400">01. Puzzle Icon</span>
              <h4 class="text-xs font-bold text-slate-100">Click Extensions Menu</h4>
              <p class="text-[11px] text-slate-300 leading-relaxed">
                Click the small jigsaw puzzle piece icon (🧩) to the right of your address bar.
              </p>
            </div>

            <div class="p-4 bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-2xs space-y-1.5">
              <span class="text-xs font-mono font-bold text-blue-400">02. Find Extension</span>
              <h4 class="text-xs font-bold text-slate-100">Locate Your Utility</h4>
              <p class="text-[11px] text-slate-300 leading-relaxed">
                Scroll through the dropdown list to locate your freshly installed extension.
              </p>
            </div>

            <div class="p-4 bg-slate-800/90 rounded-xl border border-slate-700/80 shadow-2xs space-y-1.5">
              <span class="text-xs font-mono font-bold text-blue-400">03. Click Pin (📌)</span>
              <h4 class="text-xs font-bold text-slate-100">Pin to Toolbar</h4>
              <p class="text-[11px] text-slate-300 leading-relaxed">
                Click the pin icon. Its button turns blue and the extension icon remains permanently accessible!
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Common Troubleshooting & FAQs (Accordion) -->
      <section class="space-y-6 pt-4">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            Frequently Asked Questions & Troubleshooting
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Answers to common questions regarding unpacked extensions and developer mode.
          </p>
        </div>

        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {faqs.map((faq) => (
            <details class="group py-4 text-xs sm:text-sm cursor-pointer select-none">
              <summary class="flex items-center justify-between font-semibold text-slate-900 list-none group-hover:text-blue-600 transition-colors">
                <span class="flex items-center gap-2">
                  <HelpCircle class="w-4 h-4 text-slate-400 group-hover:text-blue-600 shrink-0" />
                  <span>{faq.q}</span>
                </span>
                <ChevronDown class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2" />
              </summary>
              <div class="pt-3 pl-6 text-slate-600 leading-relaxed text-xs sm:text-sm">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- 6. Bottom Clean CTA Strip -->
      <section class="p-8 bg-slate-900 rounded-2xl text-white flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left shadow-2xs">
        <div class="space-y-1">
          <h3 class="text-lg font-bold text-white tracking-tight">
            Ready to discover verified extensions?
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            Explore AI utilities, privacy suites, and developer power tools.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/"
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-2xs transition-colors"
          >
            Browse Store
          </a>
          <a
            href="/developers"
            class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition-colors"
          >
            Developer Hub
          </a>
        </div>
      </section>

    </main>

    <!-- Bottom Footer -->
    <Footer />

    <!-- Interactive Client Script (Zero Bloat Vanilla JS) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Browser Switcher Tabs
        const tabButtons = document.querySelectorAll('.browser-tab-btn');
        const activeUrlEl = document.getElementById('active-browser-url');
        const activeNotesEl = document.getElementById('active-browser-notes');
        const copyBtn = document.getElementById('copy-url-btn');
        const copyBtnText = document.getElementById('copy-btn-text');

        tabButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            // Update button styles
            tabButtons.forEach((b) => {
              b.classList.remove('bg-white', 'text-slate-900', 'shadow-2xs', 'font-semibold');
              b.classList.add('text-slate-600');
            });
            btn.classList.add('bg-white', 'text-slate-900', 'shadow-2xs', 'font-semibold');
            btn.classList.remove('text-slate-600');

            // Update URL and Notes
            const url = btn.getAttribute('data-browser-url') || 'chrome://extensions';
            const notes = btn.getAttribute('data-browser-notes') || '';
            if (activeUrlEl) activeUrlEl.textContent = url;
            if (activeNotesEl) activeNotesEl.textContent = notes;
          });
        });

        // 2. Copy URL Button
        if (copyBtn && activeUrlEl) {
          copyBtn.addEventListener('click', async () => {
            const urlToCopy = activeUrlEl.textContent || 'chrome://extensions';
            try {
              await navigator.clipboard.writeText(urlToCopy);
              if (copyBtnText) copyBtnText.textContent = 'Copied!';
              copyBtn.classList.add('bg-emerald-950', 'text-emerald-400', 'border-emerald-700');
              setTimeout(() => {
                if (copyBtnText) copyBtnText.textContent = 'Copy URL';
                copyBtn.classList.remove('bg-emerald-950', 'text-emerald-400', 'border-emerald-700');
              }, 2000);
            } catch (err) {
              // Fallback
              const input = document.createElement('input');
              input.value = urlToCopy;
              document.body.appendChild(input);
              input.select();
              document.execCommand('copy');
              document.body.removeChild(input);
              if (copyBtnText) copyBtnText.textContent = 'Copied!';
              copyBtn.classList.add('bg-emerald-950', 'text-emerald-400', 'border-emerald-700');
              setTimeout(() => {
                if (copyBtnText) copyBtnText.textContent = 'Copy URL';
                copyBtn.classList.remove('bg-emerald-950', 'text-emerald-400', 'border-emerald-700');
              }, 2000);
            }
          });
        }
      });
    </script>
  </body>
</html>
