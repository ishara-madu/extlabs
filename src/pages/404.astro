---
// src/pages/404.astro
export const prerender = false;

import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ArrowLeft, Search, Compass, HelpCircle } from '@lucide/astro';

Astro.response.status = 404;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>Page Not Found (404) — ExtLabs</title>
    <meta name="description" content="The page or browser extension you are looking for could not be found." />
    <meta name="robots" content="noindex, follow" />

    <!-- High-Priority Font Preload -->
    <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main 404 Container -->
    <main class="flex-1 flex flex-col items-center justify-center px-6 sm:px-8 py-20">
      <div class="max-w-md w-full text-center space-y-6">
        
        <!-- Status indicator -->
        <div class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span>
          <span class="font-mono text-xs font-semibold text-slate-500 uppercase tracking-widest">404 Error</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Page not found
        </h1>

        <p class="text-sm text-slate-600 leading-relaxed">
          The page or extension you are looking for doesn't exist, may have been relocated, or is temporarily unavailable.
        </p>

        <!-- Inline Quick Search -->
        <form action="/search" method="GET" class="pt-2">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <Search class="w-4 h-4" />
            </div>
            <input
              name="q"
              type="search"
              placeholder="Search extensions and categories..."
              class="w-full pl-10 pr-4 py-2.5 text-xs bg-white text-slate-900 rounded-lg border border-slate-200 focus:border-slate-400 focus:outline-none placeholder-slate-400 shadow-2xs"
            />
          </div>
        </form>

        <!-- Action Links -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors shadow-2xs"
          >
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>Back to Home</span>
          </a>

          <a
            href="/categories"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 hover:border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-2xs"
          >
            <Compass class="w-3.5 h-3.5 text-slate-500" />
            <span>Browse Categories</span>
          </a>

          <a
            href="/how-to-install"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 hover:border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-2xs"
          >
            <HelpCircle class="w-3.5 h-3.5 text-slate-500" />
            <span>Install Guide</span>
          </a>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
