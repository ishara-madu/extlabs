---
// src/pages/categories/index.astro
export const prerender = false;

import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { CATEGORIES } from "../../data/extensions";
import { getDb, getStoreExtensions } from "../../lib/db";
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';

const db = getDb();
const allStoreExtensions = await getStoreExtensions(db);
const visibleCategories = CATEGORIES;

// 7-day Edge CDN Caching: Serves categories directory in 5ms with 0 D1 reads
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=604800, stale-while-revalidate=86400');
Astro.response.headers.set('Vary', 'Cookie');
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>All Categories — ExtLabs Extension Store</title>
    <meta name="description" content="Browse verified browser extensions by category on ExtLabs." />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://extlabs.io/categories" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="ExtLabs" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="All Categories — ExtLabs Extension Store" />
    <meta property="og:description" content="Browse verified browser extensions by category on ExtLabs." />
    <meta property="og:url" content="https://extlabs.io/categories" />
    <meta property="og:image" content="https://extlabs.io/og-image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="All Categories — ExtLabs Extension Store" />
    <meta name="twitter:description" content="Browse verified browser extensions by category on ExtLabs." />
    <meta name="twitter:image" content="https://extlabs.io/og-image.png" />

    <!-- Resource Hints / Preconnects for CDN & LCP -->
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://extlabs.io/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Categories",
              "item": "https://extlabs.io/categories"
            }
          ]
        },
        {
          "@type": "CollectionPage",
          "@id": "https://extlabs.io/categories#webpage",
          "url": "https://extlabs.io/categories",
          "name": "All Categories — ExtLabs Extension Store",
          "description": "Browse verified browser extensions by category on ExtLabs."
        }
      ]
    })} />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Content Area with generous breathing room -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">Categories</span>
      </nav>

      <!-- Page Header -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
          <span>Extension Categories</span>
          <span class="text-slate-300 mx-1">•</span>
          <span class="text-xs text-slate-500 font-normal">
            {visibleCategories.length} Categories
          </span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 tracking-tight">
          Browse by Category
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl leading-relaxed">
          Find the right high-performance tools, developer utilities, and privacy extensions for your browser.
        </p>
      </div>

      <!-- Visual Categories Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {visibleCategories.map((cat, idx) => {
          const catExtensions = allStoreExtensions.filter(e => e.category === cat.id);
          const topExt = catExtensions.find(e => e.featured) || catExtensions[0];

          return (
            <a
              href={`/category/${cat.id}`}
              class="group flex flex-col justify-between bg-white rounded-2xl border border-slate-200 hover:border-slate-300 hover:shadow-xs overflow-hidden transition-all text-inherit no-underline"
            >
              <!-- Top Visual Graphic Banner -->
              <div class="w-full aspect-[16/9] overflow-hidden bg-slate-900 border-b border-slate-100 relative flex items-center justify-center">
                {cat.imageUrl ? (
                  <Image
                    src={cat.imageUrl}
                    alt={cat.label}
                    width={640}
                    height={360}
                    loading={idx < 3 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : 'auto'}
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                ) : cat.heroIllustrationSvg ? (
                  <Fragment set:html={cat.heroIllustrationSvg} />
                ) : (
                  <div class="text-center space-y-1 p-6">
                    <span class="text-xs font-bold text-white tracking-wider uppercase block">{cat.label}</span>
                    <span class="text-[10px] text-slate-400 font-mono block">Curated Domain</span>
                  </div>
                )}
                <div class="absolute top-3 right-3">
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-semibold text-white bg-slate-900/80 backdrop-blur-xs px-2.5 py-1 rounded-md border border-white/20">
                    <span class="w-1 h-1 rounded-full bg-blue-400"></span>
                    <span>Verified</span>
                  </span>
                </div>
              </div>

              <!-- Card Content -->
              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div>
                  <h2 class="text-lg font-bold text-slate-800 group-hover:text-blue-600 tracking-tight mb-1.5 flex items-center justify-between transition-colors">
                    <span>{cat.label}</span>
                    <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" />
                  </h2>

                  <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-2">
                    {cat.description}
                  </p>

                  <!-- Sub-tags -->
                  <div class="flex flex-wrap gap-1.5">
                    {cat.tags.slice(0, 3).map((tag) => (
                      <span class="text-[10px] font-medium text-slate-700 bg-slate-50 px-2.5 py-0.5 rounded-md border border-slate-200">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Bottom highlight sample -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                  {topExt ? (
                    <span class="text-[11px] text-slate-600 truncate max-w-[180px]">
                      Top: <strong class="text-slate-800 font-semibold">{topExt.name}</strong>
                    </span>
                  ) : (
                    <span class="text-[11px] text-slate-600 font-mono">
                      {catExtensions.length} listed
                    </span>
                  )}
                  <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:underline">
                    <span>Explore</span>
                    <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
