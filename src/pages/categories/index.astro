---
// src/pages/categories/index.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { EXTENSIONS, CATEGORIES } from "../../data/extensions";
import { ArrowRight } from '@lucide/astro';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>All Categories — ExtLabs Extension Store</title>
    <meta name="description" content="Browse verified browser extensions by category on ExtLabs." />
  </head>

  <body class="bg-[#fbfbfc] text-slate-800 antialiased min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Content Area with generous breathing room -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-8 lg:px-12 py-10 space-y-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-900 font-medium">Categories</span>
      </nav>

      <!-- Page Header -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2">
          <span class="text-[11px] font-semibold text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-md">
            Extension Categories
          </span>
          <span class="text-xs text-slate-500 font-medium">
            5 Curated Domains
          </span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 tracking-tight">
          Browse by Category
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 max-w-xl leading-relaxed">
          Find the right high-performance tools, developer utilities, and privacy extensions for your browser.
        </p>
      </div>

      <!-- Visual Categories Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {CATEGORIES.map((cat) => {
          const catExtensions = EXTENSIONS.filter(e => e.category === cat.id);
          const topExt = catExtensions[0];

          return (
            <a
              href={`/category/${cat.id}`}
              class="group flex flex-col justify-between bg-white rounded-2xl border border-slate-200 hover:border-slate-300 hover:shadow-xs overflow-hidden transition-all text-inherit no-underline"
            >
              <!-- Top Visual Graphic Banner -->
              <div class="w-full aspect-[16/9] overflow-hidden bg-slate-900 border-b border-slate-100 relative">
                <Fragment set:html={cat.heroIllustrationSvg} />
                <div class="absolute top-3 right-3">
                  <span class="text-[10px] font-semibold text-white bg-slate-900/80 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/20">
                    {cat.count} Extensions
                  </span>
                </div>
              </div>

              <!-- Card Content -->
              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div>
                  <h2 class="text-lg font-bold text-slate-800 group-hover:text-blue-600 tracking-tight mb-1.5 flex items-center justify-between transition-colors">
                    <span>{cat.label}</span>
                    <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition-all" />
                  </h2>

                  <p class="text-xs text-slate-500 leading-relaxed mb-4 line-clamp-2">
                    {cat.description}
                  </p>

                  <!-- Sub-tags -->
                  <div class="flex flex-wrap gap-1.5">
                    {cat.tags.slice(0, 3).map((tag) => (
                      <span class="text-[10px] font-medium text-slate-600 bg-slate-50 px-2.5 py-0.5 rounded-md border border-slate-100">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Bottom highlight sample -->
                {topExt && (
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                    <span class="text-[11px] text-slate-500 truncate max-w-[180px]">
                      Top: <strong class="text-slate-700 font-semibold">{topExt.name}</strong>
                    </span>
                    <span class="text-xs font-semibold text-blue-600 flex items-center gap-1 group-hover:underline">
                      <span>Explore</span>
                      <ArrowRight class="w-3.5 h-3.5 text-blue-600" />
                    </span>
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>

    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
