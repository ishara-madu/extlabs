---
// ExtensionModal.astro
---

<dialog id="extension-detail-modal" class="modal">
  <div class="modal-box max-w-2xl p-0 bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-xl">
    
    <!-- Top Visual Artwork Banner -->
    <div id="modal-banner-container" class="w-full aspect-[16/7] bg-slate-900 overflow-hidden relative border-b border-slate-100">
      <!-- Banner injected dynamically -->
    </div>

    <!-- Modal Header -->
    <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h3 id="modal-title" class="text-base font-semibold text-slate-800 leading-tight">
            Extension Title
          </h3>
          <span id="modal-verified-badge" class="inline-flex items-center text-blue-500">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.548 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.548 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z"/>
            </svg>
          </span>
          <span id="modal-category-badge" class="text-[10px] font-medium text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
            Category
          </span>
        </div>

        <p id="modal-developer" class="text-xs text-slate-500 mt-1">
          Offered by Developer
        </p>

        <div class="flex items-center gap-3 mt-2 text-xs text-slate-600">
          <div class="flex items-center gap-1 font-medium text-slate-700">
            <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 24 24">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span id="modal-rating">4.9</span>
            <span id="modal-reviews" class="text-slate-400 font-normal">(1,200 reviews)</span>
          </div>
          <span class="text-slate-300">•</span>
          <span id="modal-users">100,000+ users</span>
        </div>
      </div>

      <!-- Action & Close -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="modal-install-btn"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 cursor-pointer shadow-2xs"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Add to Browser</span>
        </button>

        <button
          type="button"
          id="modal-close-btn"
          class="p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-100 cursor-pointer"
          aria-label="Close dialog"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Modal Body -->
    <div class="p-6 overflow-y-auto max-h-[50vh] space-y-5 text-sm">
      
      <!-- Overview description -->
      <div>
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Overview</h4>
        <p id="modal-description" class="text-slate-700 leading-relaxed text-xs"></p>
      </div>

      <!-- Key Highlights -->
      <div>
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Highlights</h4>
        <ul id="modal-overview-list" class="space-y-1.5 text-xs text-slate-600 list-disc list-inside">
          <!-- Injected items -->
        </ul>
      </div>

      <!-- Minimal Meta Row -->
      <div class="grid grid-cols-3 gap-3 pt-4 border-t border-slate-100 text-xs">
        <div class="p-2.5 bg-slate-50/80 rounded-xl border border-slate-100">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Version</span>
          <span id="modal-version" class="font-medium text-slate-700">1.0.0</span>
        </div>
        <div class="p-2.5 bg-slate-50/80 rounded-xl border border-slate-100">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Updated</span>
          <span id="modal-updated" class="font-medium text-slate-700">Aug 2026</span>
        </div>
        <div class="p-2.5 bg-slate-50/80 rounded-xl border border-slate-100">
          <span class="text-[10px] uppercase font-semibold text-slate-400 block">Size</span>
          <span id="modal-size" class="font-medium text-slate-700">1.2 MB</span>
        </div>
      </div>

      <!-- Permissions -->
      <div>
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Permissions</h4>
        <div id="modal-permissions-list" class="flex flex-wrap gap-1.5">
          <!-- Permissions chips -->
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-slate-50/60 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span class="flex items-center gap-1.5 text-emerald-600">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="text-slate-600 text-xs">Verified Package • Manifest V3</span>
      </span>

      <button
        type="button"
        id="modal-footer-close"
        class="text-xs font-medium text-slate-600 hover:text-slate-900 px-3 py-1 rounded-md hover:bg-slate-100 cursor-pointer"
      >
        Close
      </button>
    </div>

  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
