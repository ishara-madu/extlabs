---
// src/components/BrowserIcon.astro
interface Props {
  browser: string;
  class?: string;
}

const { browser = '', class: className = 'w-3.5 h-3.5' } = Astro.props;
const key = browser.toLowerCase().trim();
---

{key === 'chrome' || key === 'google chrome' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <path fill="#EA4335" d="M12 2C7.3 2 3.3 5.2 2.3 9.5l4.3 7.5a5 5 0 0 1 5.4-8h9.5C20.6 5.3 16.7 2 12 2z"/>
    <path fill="#FBBC05" d="M21.5 12c0 4.7-3.2 8.7-7.6 9.7l4.3-7.5a5 5 0 0 0-2.2-7.2h5.2c.2 1.6.3 3.3.3 5z"/>
    <path fill="#34A853" d="M12 22a10 10 0 0 1-8.7-5l4.3-7.5a5 5 0 0 0 6.4 7.5L9.7 21.7c.7.2 1.5.3 2.3.3z"/>
    <circle cx="12" cy="12" r="4.5" fill="#FFFFFF"/>
    <circle cx="12" cy="12" r="3.5" fill="#1A73E8"/>
  </svg>
) : key === 'brave' || key === 'brave browser' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <path d="M12 2 4 4.5v6.2c0 5.4 3.4 10.4 8 11.3 4.6-.9 8-5.9 8-11.3V4.5L12 2z" fill="#FB542B"/>
    <path d="M8.5 7.5 12 9l3.5-1.5L14 12l2 2.5-4 1.5-4-1.5 2-2.5-1.5-4.5z" fill="#FFFFFF"/>
  </svg>
) : key === 'edge' || key === 'microsoft edge' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <path d="M21.8 15.8c-.5 3.5-3.6 6.2-7.3 6.2-4.1 0-7.5-3.3-7.5-7.4 0-4.5 3.8-7.6 8.3-7.6 1.8 0 3.3.6 4.5 1.6l-2.2 2.4c-.6-.6-1.4-1-2.3-1-2.4 0-4.3 1.9-4.3 4.3 0 2.5 1.9 4.3 4.3 4.3 2 0 3.5-1.2 4.1-2.9h-4.1v-3.1h7.2v3.2z" fill="#0078D7"/>
    <circle cx="14" cy="9" r="4" fill="#00C853" opacity="0.8"/>
  </svg>
) : key === 'firefox' || key === 'mozilla firefox' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9.5" fill="#2B3A42"/>
    <circle cx="12" cy="12" r="7.5" fill="#20123A"/>
    <path d="M12 2.5c4.7 0 8.6 3.4 9.3 7.8-.3-.2-.6-.4-1-.5-1.6-.5-3.2.3-3.8 1.9-.3.8-.3 1.7-.1 2.5.4 1.7 1.8 2.8 3.5 2.8.7 0 1.4-.2 2-.5-.9 3.4-4 5.9-7.7 5.9-4.7 0-8.5-3.8-8.5-8.5 0-1.8.6-3.5 1.6-4.9.4-.5.8-.9 1.3-1.3-.2.4-.3.9-.3 1.4 0 1.7 1.4 3.1 3.1 3.1.8 0 1.6-.3 2.2-.9.6-.6.9-1.4.9-2.2 0-.9-.4-1.8-1-2.4-.6-.6-1.5-1-2.5-1-1.3 0-2.4.6-3.1 1.6.9-2.8 3.5-4.8 6.6-4.8z" fill="#FF7139"/>
  </svg>
) : key === 'arc' || key === 'arc browser' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="20" height="20" x="2" y="2" rx="6" fill="#0E1525"/>
    <path d="M6 16V8a6 6 0 0 1 12 0v8" stroke="#FF5C5C" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="12" cy="13" r="2.5" fill="#4B7BFF"/>
  </svg>
) : key === 'opera' || key === 'opera / gx' || key === 'opera gx' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 16.5c-3 0-4.8-2.9-4.8-6.5S9 5.5 12 5.5s4.8 2.9 4.8 6.5-1.8 6.5-4.8 6.5z" fill="#FF1B2D"/>
  </svg>
) : key === 'safari' || key === 'apple safari' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="10" stroke="#007AFF" stroke-width="2" fill="#E8F2FF"/>
    <polygon points="12,4 15,12 8,10" fill="#FF3B30"/>
    <polygon points="12,20 9,12 16,14" fill="#007AFF"/>
    <circle cx="12" cy="12" r="1.5" fill="#FFFFFF"/>
  </svg>
) : key === 'vivaldi' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
    <rect width="20" height="20" x="2" y="2" rx="5" fill="#EF3939"/>
    <path d="M8 8l4 8 4-8" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
) : (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/>
    <line x1="2" y1="12" x2="22" y2="12"/>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
  </svg>
)}
