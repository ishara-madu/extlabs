---
// src/components/BrowserIcon.astro
import ChromeIcon from './browser-icons/ChromeIcon.astro';
import BraveIcon from './browser-icons/BraveIcon.astro';
import EdgeIcon from './browser-icons/EdgeIcon.astro';
import FirefoxIcon from './browser-icons/FirefoxIcon.astro';
import ArcIcon from './browser-icons/ArcIcon.astro';
import OperaIcon from './browser-icons/OperaIcon.astro';
import SafariIcon from './browser-icons/SafariIcon.astro';
import VivaldiIcon from './browser-icons/VivaldiIcon.astro';
import DefaultBrowserIcon from './browser-icons/DefaultBrowserIcon.astro';

interface Props {
  browser: string;
  class?: string;
}

const { browser = '', class: className = 'w-3.5 h-3.5' } = Astro.props;
const key = browser.toLowerCase().trim();
---

{key === 'chrome' || key === 'google chrome' ? (
  <ChromeIcon class={className} />
) : key === 'brave' || key === 'brave browser' ? (
  <BraveIcon class={className} />
) : key === 'edge' || key === 'microsoft edge' ? (
  <EdgeIcon class={className} />
) : key === 'firefox' || key === 'mozilla firefox' ? (
  <FirefoxIcon class={className} />
) : key === 'arc' || key === 'arc browser' ? (
  <ArcIcon class={className} />
) : key === 'opera' || key === 'opera / gx' || key === 'opera gx' ? (
  <OperaIcon class={className} />
) : key === 'safari' || key === 'apple safari' ? (
  <SafariIcon class={className} />
) : key === 'vivaldi' ? (
  <VivaldiIcon class={className} />
) : (
  <DefaultBrowserIcon class={className} />
)}
