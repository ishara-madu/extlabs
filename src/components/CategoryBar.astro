---
// CategoryBar.astro
import { CATEGORIES } from '../data/extensions';

interface Props {
  activeCategoryId?: string;
  categoryCounts?: Record<string, number>;
}

const { activeCategoryId, categoryCounts } = Astro.props;

// Filter out categories that have no extensions if counts are provided
const visibleCategories = CATEGORIES.filter(cat => 
  categoryCounts ? (categoryCounts[cat.id] ?? 0) > 0 : true
);
---

<div class="border-b border-slate-200/60 bg-white py-3.5">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between gap-4 overflow-x-auto no-scrollbar">
      <div class="flex items-center gap-2" id="category-pills-container">
        {visibleCategories.map((cat) => (
          <a
            href={`/category/${cat.id}`}
            class={`category-filter-btn inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap select-none border transition-colors ${
              activeCategoryId === cat.id
                ? 'bg-slate-800 text-white border-slate-800 shadow-2xs'
                : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-900'
            }`}
            data-category-filter={cat.id}
          >
            <span>{cat.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
