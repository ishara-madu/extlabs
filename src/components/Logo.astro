---
// src/components/Logo.astro
interface Props {
  class?: string;
  alt?: string;
}

const { class: className = "w-8 h-8", alt = "ExtLabs" } = Astro.props;
---

<img
  src="/favicon.svg"
  alt={alt}
  width="300"
  height="300"
  class={`${className} object-contain`}
  loading="eager"
  decoding="async"
/>
