---
// Footer.astro
import Logo from './Logo.astro';
---

<footer class="bg-slate-50 border-t border-slate-200 mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Tagline -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <Logo class="w-6 h-6 shrink-0" />
          <span class="text-sm font-bold text-slate-900 tracking-tight">ExtLabs</span>
        </div>

        <p class="text-xs text-slate-500 leading-relaxed">
          A minimalist extension hub for discovering fast, verified browser utilities built on open web standards.
        </p>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Categories</h3>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/category/ai" class="hover:text-slate-900 transition-colors">AI & Smart Tools</a></li>
          <li><a href="/category/dev" class="hover:text-slate-900 transition-colors">Developer & Power Tools</a></li>
          <li><a href="/category/productivity" class="hover:text-slate-900 transition-colors">Productivity & Workflow</a></li>
          <li class="pt-0.5"><a href="/categories" class="text-blue-600 hover:text-blue-700 font-medium inline-flex items-center gap-1 transition-colors">Browse All Categories &rarr;</a></li>
        </ul>
      </div>

      <!-- Developers -->
      <div>
        <h3 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Developers</h3>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/developers" class="hover:text-slate-900 transition-colors">Developer Portal</a></li>
          <li><a href="/developers/monetization-guide" class="hover:text-slate-900 transition-colors">Monetag Monetization</a></li>
          <li><a href="https://developer.chrome.com/docs/extensions/mv3/intro/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">Manifest V3 Docs</a></li>
        </ul>
      </div>

      <!-- Guides & Safety -->
      <div>
        <h3 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Safety & Guides</h3>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/how-to-install" class="hover:text-slate-900 transition-colors">How to Install (.zip)</a></li>
          <li><a href="/security" class="hover:text-slate-900 transition-colors">Security Verification</a></li>
          <li><a href="/privacy-policy" class="hover:text-slate-900 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="hover:text-slate-900 transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 ExtLabs. Minimalist extension store directory.</p>
      <div class="flex items-center gap-5">
        <span class="inline-flex items-center gap-1.5 text-slate-600 font-mono text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
          <span>Systems Operational</span>
        </span>
        <span class="text-slate-300">•</span>
        <a href="/privacy-policy" class="hover:text-slate-900 transition-colors">Privacy</a>
        <a href="/terms-of-service" class="hover:text-slate-900 transition-colors">Terms</a>
        <a href="/security" class="hover:text-slate-900 transition-colors">Security</a>
      </div>
    </div>
  </div>
</footer>
