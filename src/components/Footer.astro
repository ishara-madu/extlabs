---
// Footer.astro
import { Box } from '@lucide/astro';
---

<footer class="bg-slate-50 border-t border-slate-200 mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Tagline -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-slate-900 text-white flex items-center justify-center">
            <Box class="w-3.5 h-3.5 text-white" />
          </div>
          <span class="text-sm font-bold text-slate-900 tracking-tight">ExtLabs</span>
        </div>

        <p class="text-xs text-slate-500 leading-relaxed">
          A minimalist extension hub for discovering fast, verified browser utilities built on open web standards.
        </p>
      </div>

      <!-- Categories -->
      <div>
        <h4 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Categories</h4>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/category/ai" class="hover:text-slate-900 transition-colors">AI & Machine Learning</a></li>
          <li><a href="/category/dev" class="hover:text-slate-900 transition-colors">Developer Tools</a></li>
          <li><a href="/category/productivity" class="hover:text-slate-900 transition-colors">Productivity</a></li>
          <li><a href="/category/privacy" class="hover:text-slate-900 transition-colors">Privacy & Security</a></li>
          <li><a href="/category/utilities" class="hover:text-slate-900 transition-colors">Workflow & Tabs</a></li>
        </ul>
      </div>

      <!-- Developers -->
      <div>
        <h4 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Developers</h4>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/developers" class="hover:text-slate-900 transition-colors">Developer Portal</a></li>
          <li><a href="/developers" class="hover:text-slate-900 transition-colors">Monetag Monetization</a></li>
          <li><a href="https://developer.chrome.com/docs/extensions/mv3/intro/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">Manifest V3 Docs</a></li>
        </ul>
      </div>

      <!-- Guides & Safety -->
      <div>
        <h4 class="text-xs font-semibold text-slate-900 uppercase tracking-wider mb-3">Safety & Guides</h4>
        <ul class="space-y-2 text-xs text-slate-600">
          <li><a href="/how-to-install" class="hover:text-slate-900 transition-colors font-medium text-slate-800">How to Install (.zip)</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Security Verification</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Terms of Service</a></li>
          <li><a href="/admin/login" class="hover:text-slate-900 transition-colors">Admin Portal</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© 2026 ExtLabs. Minimalist extension store directory.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-700 transition-colors">Status</a>
        <a href="#" class="hover:text-slate-700 transition-colors">Privacy</a>
        <a href="#" class="hover:text-slate-700 transition-colors">Security</a>
      </div>
    </div>
  </div>
</footer>
