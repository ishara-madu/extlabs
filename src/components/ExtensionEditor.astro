---
// src/components/ExtensionEditor.astro
import { 
  ArrowLeft, 
  Save, 
  Box, 
  Zap, 
  ExternalLink, 
  Globe, 
  FileText, 
  Sparkles, 
  ShieldCheck, 
  Image as ImageIcon,
  Check,
  Bold,
  Italic,
  List,
  ListOrdered,
  Code,
  Quote,
  WrapText,
  Plus,
  Trash2,
  Cpu,
  Layers,
  Scale,
  HelpCircle,
  CheckCircle2,
  Lock,
  Compass,
  Mail,
  UploadCloud,
  Upload,
  Video,
  Play,
  FileImage,
  AlertCircle,
  X,
  ArrowRight,
  Search,
  ChevronDown
} from '@lucide/astro';

export interface FeatureData {
  title: string;
  description: string;
}

export interface WorkflowStageData {
  step?: number;
  title: string;
  description: string;
}

export interface ComparisonItem {
  feature: string;
  current: string;
  others: string;
}

export interface FAQItem {
  q: string;
  a: string;
}

interface ExtensionData {
  id?: string;
  slug?: string;
  name?: string;
  version?: string;
  category?: string;
  tagline?: string;
  description?: string;
  githubUrl?: string;
  downloadUrl?: string;
  docsUrl?: string;
  supportEmail?: string;
  developerWebsite?: string;
  monetagUrl?: string;
  frequency?: string;
  manifestVersion?: string;
  license?: string;
  supportedBrowsers?: string[];
  privacyPolicyUrl?: string;
  iconUrl?: string;
  promoTileUrl?: string;
  screenshots?: string[];
  youtubeVideoUrl?: string;
  screenshot1?: string;
  screenshot2?: string;
  features?: (FeatureData | string)[];
  workflow?: (WorkflowStageData | string)[];
  comparison?: ComparisonItem[];
  faqs?: FAQItem[];
  permissions?: string;
  status?: string;
}

interface Props {
  isEdit?: boolean;
  initialData?: ExtensionData;
}

const { isEdit = false, initialData = {} } = Astro.props;

// Normalize features into { title, description } format
const rawFeatures = initialData.features || [
  {
    title: "Instant 1-Click AI Summaries",
    description: "Extract concise bullet summaries and key takeaways from articles, PDFs, and docs in under 2 seconds."
  },
  {
    title: "YouTube Video Transcript Parsing",
    description: "Converts long video transcripts into high-signal takeaways with indexed timestamps."
  },
  {
    title: "Zero-Data Retention Architecture",
    description: "All parsing and summary embeddings occur locally with zero remote data storage."
  }
];

const normalizedFeatures: FeatureData[] = rawFeatures.map(item => {
  if (typeof item === 'string') {
    return { title: item, description: '' };
  }
  return item;
});

// Normalize workflow stages
const rawWorkflow = initialData.workflow || [
  {
    step: 1,
    title: "Local DOM & Content Parsing",
    description: "The background content script extracts readable article text and stripped DOM trees without telemetry."
  },
  {
    step: 2,
    title: "On-Device Inference & Chunking",
    description: "Long payloads are chunked and evaluated using privacy-preserving token pipelines."
  },
  {
    step: 3,
    title: "Clean Markdown Summary Projection",
    description: "The sidebar UI displays instant point-form summaries with one-click export controls."
  }
];

const normalizedWorkflow: WorkflowStageData[] = rawWorkflow.map((item, idx) => {
  if (typeof item === 'string') {
    return { step: idx + 1, title: item, description: '' };
  }
  return { step: item.step || (idx + 1), title: item.title, description: item.description };
});

// Normalize comparison table rows
const rawComparison: ComparisonItem[] = initialData.comparison || [
  { feature: "Privacy-Preserving On-Device Parsing", current: "Yes (Strict)", others: "No (Cloud Scraping)" },
  { feature: "Sub-Second Summary Generation", current: "Instant (<2s)", others: "Slow (8-15s)" },
  { feature: "Zero Tracking & Zero Cookies", current: "100% Offline", others: "Telemetry Injected" },
  { feature: "Direct Markdown & Notion Sync", current: "Native 1-Click", others: "Manual Copy-Paste" }
];

// Normalize FAQ entries
const rawFaqs: FAQItem[] = initialData.faqs || [
  {
    q: "Does this extension store or read my private web pages?",
    a: "No. All text parsing runs inside your Chromium sandboxed tab environment. No text or browsing history is ever transmitted to external servers."
  },
  {
    q: "What browsers are supported?",
    a: "Google Chrome, Brave, Arc, Microsoft Edge, and Opera (Manifest V3 Chromium standard)."
  },
  {
    q: "Is an OpenAI or Anthropic API key required?",
    a: "No API key is required out of the box. Users can optionally attach a personal key for custom enterprise model tuning."
  }
];

// Screenshots normalization
const initialScreenshots: string[] = initialData.screenshots || (initialData.screenshot1 && initialData.screenshot2 
  ? [initialData.screenshot1, initialData.screenshot2]
  : [
      "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&auto=format&fit=crop&q=80",
      "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&auto=format&fit=crop&q=80",
      "https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?w=800&auto=format&fit=crop&q=80"
    ]);

export interface SupportedBrowserOption {
  id: string;
  name: string;
  checkedByDefault: boolean;
}

const allAvailableBrowsers: SupportedBrowserOption[] = [
  { id: "chrome", name: "Chrome", checkedByDefault: true },
  { id: "brave", name: "Brave", checkedByDefault: true },
  { id: "edge", name: "Edge", checkedByDefault: true },
  { id: "firefox", name: "Firefox", checkedByDefault: true },
  { id: "arc", name: "Arc", checkedByDefault: true },
  { id: "opera", name: "Opera", checkedByDefault: true },
  { id: "safari", name: "Safari", checkedByDefault: false }
];

const data = {
  id: initialData.id || "",
  slug: initialData.slug || initialData.id || "",
  name: initialData.name || "",
  version: initialData.version || "1.0.0",
  category: initialData.category || "ai",
  tagline: initialData.tagline || "",
  description: initialData.description || "",
  githubUrl: initialData.githubUrl || "",
  downloadUrl: initialData.downloadUrl || "",
  docsUrl: initialData.docsUrl || "",
  supportEmail: initialData.supportEmail || "",
  developerWebsite: initialData.developerWebsite || "",
  monetagUrl: initialData.monetagUrl || "",
  frequency: initialData.frequency || "24h",
  manifestVersion: initialData.manifestVersion || "v3",
  license: initialData.license || "MIT",
  supportedBrowsers: initialData.supportedBrowsers || ["chrome", "brave", "edge", "firefox", "arc", "opera"],
  privacyPolicyUrl: initialData.privacyPolicyUrl || "",
  iconUrl: initialData.iconUrl || (isEdit ? "/icons/extension-placeholder.avif" : ""),
  promoTileUrl: initialData.promoTileUrl || "",
  screenshots: isEdit ? initialScreenshots : [],
  youtubeVideoUrl: initialData.youtubeVideoUrl || "",
  features: normalizedFeatures,
  workflow: normalizedWorkflow,
  comparison: rawComparison,
  faqs: rawFaqs,
  permissions: initialData.permissions || "activeTab, storage",
  status: initialData.status || "Production"
};
---

<!-- Extension Editor Workspace -->
<div class="space-y-6">

  <!-- Top Page Header & Main Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
    <div class="space-y-1">
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {isEdit ? `Edit: ${data.name || 'Details'}` : "Submit New Extension"}
        </h1>
        <span class={`text-xs font-semibold ${isEdit ? 'text-blue-600' : 'text-emerald-600'}`}>
          • {isEdit ? "Active Listing" : "Quick Draft"}
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500">
        {isEdit 
          ? "Manage your extension metadata, media assets, and connected Monetag direct stream." 
          : "Publish a new browser extension in under 60 seconds with our Smart Auto-Import."
        }
      </p>
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href={isEdit && data.id ? `/developers/manage/${data.id}` : "/developers/dashboard"}
        class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium rounded-lg border border-slate-300 transition-colors cursor-pointer"
      >
        Cancel
      </a>

      <button
        type="button"
        id="top-save-btn"
        class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
      >
        <Save class="w-3.5 h-3.5 text-white" />
        <span>{isEdit ? "Save Changes" : "Publish Extension"}</span>
      </button>
    </div>
  </div>

  <!-- 🌟 1-CLICK MAGIC GITHUB AUTO-IMPORT BAR (Frictionless Onboarding) -->
  <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-3 shadow-2xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-blue-600" />
          <span>Magic Auto-Fill from GitHub</span>
        </span>
        <span class="text-[11px] text-slate-500">Search and select any repository from your connected GitHub account to auto-populate your listing.</span>
      </div>
      <span id="magic-status-text" class="text-[11px] font-mono text-blue-600 font-medium hidden sm:block">
        Instant Manifest & Repo Sync
      </span>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <!-- Unified Searchable Repository Combobox -->
      <div class="relative flex-1" id="magic-combobox-wrapper">
        <div class="relative flex items-center">
          <div class="absolute left-3.5 pointer-events-none text-slate-400 flex items-center">
            <Search class="w-3.5 h-3.5" />
          </div>
          <input
            id="magic-github-input"
            type="text"
            autocomplete="off"
            value={data.githubUrl || ""}
            placeholder="Search or select from your GitHub repositories..."
            class="w-full pl-9 pr-9 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-400 focus:outline-none text-slate-900 font-mono shadow-2xs transition-colors"
          />
          <button
            type="button"
            id="magic-combobox-toggle"
            class="absolute right-2 p-1 text-slate-400 hover:text-slate-600 rounded-md transition-colors cursor-pointer"
            aria-label="Toggle repository list"
          >
            <ChevronDown id="magic-chevron-icon" class="w-3.5 h-3.5 transition-transform duration-200" />
          </button>
        </div>

        <!-- Custom Dropdown Menu matching ExtLabs theme -->
        <div
          id="magic-dropdown-menu"
          class="hidden absolute left-0 right-0 top-full mt-1.5 z-40 bg-white border border-slate-200 rounded-xl shadow-lg max-h-60 overflow-y-auto divide-y divide-slate-100"
        >
          <div id="magic-dropdown-loading" class="px-3.5 py-3 text-xs text-slate-500 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
            <span>Loading your GitHub repositories...</span>
          </div>
          <div id="magic-dropdown-list" class="divide-y divide-slate-100"></div>
        </div>
      </div>

      <button
        type="button"
        id="magic-import-btn"
        class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl inline-flex items-center justify-center gap-1.5 transition-colors cursor-pointer shrink-0 shadow-2xs"
      >
        <Sparkles class="w-3.5 h-3.5" />
        <span>Fetch & Auto-Fill</span>
      </button>
    </div>
  </div>

  <!-- 📑 4-TAB MINIMALIST NAVIGATION HEADER -->
  <div class="border-b border-slate-200">
    <nav class="flex items-center space-x-1 sm:space-x-4 overflow-x-auto no-scrollbar" aria-label="Editor Tabs">
      
      <!-- Tab 1: Essentials -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-blue-600 text-blue-600"
        data-tab="1"
      >
        <Box class="w-4 h-4" />
        <span>1. Basic & Source</span>
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 tab-dot"></span>
      </button>

      <!-- Tab 2: Visual Media -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="2"
      >
        <ImageIcon class="w-4 h-4" />
        <span>2. Visual Media</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

      <!-- Tab 3: Store Story & SEO -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="3"
      >
        <FileText class="w-4 h-4" />
        <span>3. Store Story & SEO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

      <!-- Tab 4: Monetization & Specs -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="4"
      >
        <Zap class="w-4 h-4" />
        <span>4. Monetization & Specs</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

    </nav>
  </div>

  <!-- Extension Editor Form Body -->
  <form id="extension-editor-form" data-is-edit={isEdit ? "true" : "false"} data-extension-id={data.id} data-extension-slug={data.slug}>

    <!-- ========================================================================= -->
    <!-- TAB PANE 1: ESSENTIALS & SOURCE CODE -->
    <!-- ========================================================================= -->
    <div id="tab-pane-1" class="tab-pane space-y-8">
      
      <!-- General Identity Section -->
      <section class="space-y-5">
        <div class="space-y-0.5">
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">
            Extension Identity & Category
          </h2>
          <p class="text-xs text-slate-500">
            Basic naming, unique slug, and store categorization.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Name -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-name-input" class="block text-xs font-semibold text-slate-700">
                Extension Display Name <span class="text-red-500">*</span>
              </label>
              <span id="name-char-counter" class="text-[10px] font-mono text-slate-400">
                {data.name.length} / 50
              </span>
            </div>
            <input
              id="ext-name-input"
              type="text"
              required
              maxlength="50"
              value={data.name}
              placeholder="e.g. Deep Summarize AI"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-medium"
            />
            <p id="err-ext-name" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Directory Slug -->
          <div class="space-y-1.5">
            <label for="ext-slug-input" class="block text-xs font-semibold text-slate-700">
              Directory URL Slug <span class="text-red-500">*</span>
            </label>
            <div class="flex items-center">
              <span class="px-3 py-2 text-xs bg-slate-50 border border-r-0 border-slate-200 rounded-l-lg text-slate-400 font-mono select-none">
                extlabs.io/extension/
              </span>
              <input
                id="ext-slug-input"
                type="text"
                required
                value={data.slug || data.id}
                placeholder="deep-summarize-ai"
                class="flex-1 px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-r-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
              />
            </div>
            <p id="err-ext-slug" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Category -->
          <div class="space-y-1.5">
            <label for="ext-category-input" class="block text-xs font-semibold text-slate-700">
              Primary Store Category <span class="text-red-500">*</span>
            </label>
            <select
              id="ext-category-input"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-800 cursor-pointer"
            >
              <option value="ai" selected={data.category === "ai" || data.category.toLowerCase().includes("ai")}>AI & Machine Learning</option>
              <option value="dev" selected={data.category === "dev" || data.category.toLowerCase().includes("dev")}>Developer Tools</option>
              <option value="productivity" selected={data.category === "productivity" || data.category.toLowerCase().includes("prod")}>Productivity</option>
              <option value="privacy" selected={data.category === "privacy" || data.category.toLowerCase().includes("priv")}>Privacy & Security</option>
              <option value="utilities" selected={data.category === "utilities" || data.category.toLowerCase().includes("util")}>Workflow & Utilities</option>
            </select>
            <p id="err-ext-category" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Version -->
          <div class="space-y-1.5">
            <label for="ext-version-input" class="block text-xs font-semibold text-slate-700">
              Release Version <span class="text-red-500">*</span>
            </label>
            <input
              id="ext-version-input"
              type="text"
              required
              value={data.version}
              placeholder="e.g. 1.0.0"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
            <p id="err-ext-version" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Tagline -->
          <div class="sm:col-span-2 space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-tagline-input" class="block text-xs font-semibold text-slate-700">
                Catchy Tagline <span class="text-red-500">*</span>
              </label>
              <span id="tagline-char-counter" class="text-[10px] font-mono text-slate-400">
                {data.tagline.length} / 120
              </span>
            </div>
            <input
              id="ext-tagline-input"
              type="text"
              required
              maxlength="120"
              value={data.tagline}
              placeholder="e.g. Instant AI summaries for research papers, articles, and video transcripts."
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900"
            />
            <p id="err-ext-tagline" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>
        </div>
      </section>

      <hr class="border-slate-200" />

      <!-- Package & Support Section -->
      <section class="space-y-5">
        <div class="space-y-0.5">
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">
            Repository, Package Source & Support
          </h2>
          <p class="text-xs text-slate-500">
            Source repository, release package asset, and developer support channels.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- GitHub Repo -->
          <div class="space-y-1.5">
            <label for="ext-github-input" class="block text-xs font-semibold text-slate-700">
              GitHub Repository URL <span class="text-red-500">*</span>
            </label>
            <input
              id="ext-github-input"
              type="url"
              required
              value={data.githubUrl}
              placeholder="https://github.com/your-username/your-extension"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
            <p id="err-ext-github" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Direct ZIP Asset -->
          <div class="space-y-1.5">
            <label for="ext-download-input" class="block text-xs font-semibold text-slate-700">
              Direct Package (.zip / .crx) Release Asset (Optional)
            </label>
            <input
              id="ext-download-input"
              type="url"
              value={data.downloadUrl}
              placeholder="https://github.com/your-username/repo/releases/latest/download/extension.zip"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Support Email -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-support-email-input" class="block text-xs font-semibold text-slate-700">
                Support Center Email <span class="text-red-500">*</span>
              </label>
              <span id="support-email-source-badge" class="text-[10px] font-mono text-blue-600 font-medium">
                {data.supportEmail ? 'Auto-filled from Settings' : 'Manual entry required'}
              </span>
            </div>
            <input
              id="ext-support-email-input"
              type="email"
              required
              value={data.supportEmail}
              placeholder="support@example.com"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
            <p id="err-ext-support-email" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Developer Website -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-dev-website-input" class="block text-xs font-semibold text-slate-700">
                Developer / Studio Website <span class="text-red-500">*</span>
              </label>
              <span id="dev-website-source-badge" class="text-[10px] font-mono text-blue-600 font-medium">
                {data.developerWebsite ? 'Auto-filled from Settings' : 'Manual entry required'}
              </span>
            </div>
            <input
              id="ext-dev-website-input"
              type="url"
              required
              value={data.developerWebsite}
              placeholder="https://github.com/..."
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
            <p id="err-ext-dev-website" class="hidden text-[11px] font-medium text-red-600"></p>
          </div>

          <!-- Docs URL -->
          <div class="sm:col-span-2 space-y-1.5">
            <label for="ext-docs-input" class="block text-xs font-semibold text-slate-700">
              Documentation / Product Homepage URL (Optional)
            </label>
            <input
              id="ext-docs-input"
              type="url"
              value={data.docsUrl}
              placeholder="https://github.com/your-username/your-repo#readme"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>
        </div>
      </section>

      <!-- Step Navigation Footer -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-200">
        <div id="tab1-save-status" class="text-xs text-slate-500 font-mono"></div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="tab1-save-btn"
