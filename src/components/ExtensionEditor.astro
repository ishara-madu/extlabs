        return;
      }

      const screenshotCards = screenshotsContainer?.querySelectorAll('.screenshot-card') || [];
      if (screenshotCards.length < MIN_SCREENSHOTS) {
        alert(`Please upload at least ${MIN_SCREENSHOTS} Store Showcase Screenshots in Tab 2.`);
        switchTab(2);
        return;
      }

      const nameVal = (document.getElementById('ext-name-input') as HTMLInputElement | null)?.value || 'Extension';
      alert(`🎉 "${nameVal}" has been successfully saved and published!`);
      window.location.href = '/developers/dashboard';
    });
  });
</script>
