      } else {
        let firstInvalidFaqInput: HTMLElement | null = null;
        let faqErrMsg = '';
        faqCards.forEach((card, idx) => {
          const qInput = card.querySelector('.faq-q-input') as HTMLInputElement | null;
          const aInput = card.querySelector('.faq-a-input') as HTMLTextAreaElement | null;
          const qVal = (qInput?.value || '').trim();
          const aVal = (aInput?.value || '').trim();
          const isQValid = qVal.length >= 10 && qVal.length <= 100;
          const isAValid = aVal.length >= 20 && aVal.length <= 300;

          if (qInput) {
            if (!isQValid) {
              qInput.classList.add('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
              qInput.classList.remove('border-slate-200', 'focus:border-blue-400');
              if (!firstInvalidFaqInput) firstInvalidFaqInput = qInput;
              if (!faqErrMsg) faqErrMsg = `FAQ #${idx + 1} question must be between 10 and 100 characters.`;
            } else {
              qInput.classList.remove('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
              qInput.classList.add('border-slate-200', 'focus:border-blue-400');
            }
          }

          if (aInput) {
            if (!isAValid) {
              aInput.classList.add('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
              aInput.classList.remove('border-slate-200', 'focus:border-blue-400');
              if (!firstInvalidFaqInput) firstInvalidFaqInput = aInput;
              if (!faqErrMsg) faqErrMsg = `FAQ #${idx + 1} answer must be between 20 and 300 characters.`;
            } else {
              aInput.classList.remove('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
              aInput.classList.add('border-slate-200', 'focus:border-blue-400');
            }
          }

          if (!isQValid || !isAValid) {
            vFaqs = false;
          }
        });

        if (errFaqs) {
          if (!vFaqs) {
            errFaqs.textContent = faqErrMsg || 'Please complete all FAQ entries according to character constraints.';
            errFaqs.classList.remove('hidden');
          } else {
            errFaqs.textContent = '';
            errFaqs.classList.add('hidden');
          }
        }
      }

      // 3. Supported Browsers (At least 1)
      const selectedBrowsers = form?.querySelectorAll('input[name="supported-browsers"]:checked') || [];
      const vBrowsers = selectedBrowsers.length > 0;
      if (errBrowsers) {
        if (!vBrowsers) {
          errBrowsers.textContent = 'Please select at least one supported browser.';
          errBrowsers.classList.remove('hidden');
        } else {
          errBrowsers.textContent = '';
          errBrowsers.classList.add('hidden');
        }
      }

      // 4. Privacy Policy URL (Optional, but if provided must be valid)
      const privacyVal = (privacyInput?.value || '').trim();
      const isPrivacyValid = !privacyVal || (privacyVal.length >= 8 && (privacyVal.startsWith('http://') || privacyVal.startsWith('https://')));
      const vPrivacy = validateInput(
        privacyInput,
        errPrivacy,
        isPrivacyValid,
        'Privacy policy URL must be a valid web address starting with http:// or https://.'
      );

      const allValid = vMonetag && vFaqs && vBrowsers && vPrivacy;

      if (!allValid) {
        if (tab4Status) {
          tab4Status.textContent = '⚠ Complete all required specifications above to proceed.';
          tab4Status.className = 'text-xs text-amber-600 font-medium';
        }
        if (focusFirst) {
          const list = [
            { ok: vMonetag, el: monetagInput },
            { ok: vFaqs, el: faqsContainer },
            { ok: vBrowsers, el: errBrowsers },
            { ok: vPrivacy, el: privacyInput },
          ];
          const firstBad = list.find(item => !item.ok)?.el;
          if (firstBad) {
            firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
            if (firstBad instanceof HTMLInputElement || firstBad instanceof HTMLTextAreaElement) {
              firstBad.focus();
            }
          }
        }
      } else {
        if (tab4Status && tab4Status.textContent.includes('⚠')) {
          tab4Status.textContent = '';
        }
      }

      return allValid;
    }

    // Live real-time re-validation on input & change
    [nameInput, slugInput, categoryInput, versionInput, taglineInput, githubInput, emailInput, websiteInput].forEach(inp => {
      inp?.addEventListener('input', () => validateTab1(false));
      inp?.addEventListener('change', () => validateTab1(false));
    });

    // Tab 4 Live real-time re-validation
    monetagInput?.addEventListener('input', () => {
      validateTab4(false);
      syncMonetagBadge();
    });
    monetagInput?.addEventListener('change', () => validateTab4(false));
    privacyInput?.addEventListener('input', () => validateTab4(false));
    privacyInput?.addEventListener('change', () => validateTab4(false));
    freqInput?.addEventListener('change', () => validateTab4(false));
    manifestInput?.addEventListener('change', () => validateTab4(false));
    licenseInput?.addEventListener('change', () => validateTab4(false));
    document.querySelectorAll('input[name="supported-browsers"]').forEach(cb => {
      cb.addEventListener('change', () => validateTab4(false));
    });

    // Auto-generate slug from name if new extension
    let isSlugManuallyEdited = false;
    slugInput?.addEventListener('input', () => {
      isSlugManuallyEdited = true;
    });

    const isEditMode = form?.getAttribute('data-is-edit') === 'true';
    if (!isEditMode && nameInput && slugInput) {
      nameInput.addEventListener('input', () => {
        if (!isSlugManuallyEdited && slugInput && nameInput) {
          slugInput.value = nameInput.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }
      });
    }

    // Save Basic & Source to Cloudflare D1
    async function saveBasicToDb(silent = false): Promise<boolean> {
      if (!validateTab1(true)) {
        return false;
      }

      let currentExtId = form?.getAttribute('data-extension-id') || '';
      const currentIsEdit = form?.getAttribute('data-is-edit') === 'true';

      const payload = {
        isEdit: currentIsEdit,
        id: currentExtId || undefined,
        name: nameInput?.value.trim() || '',
        slug: slugInput?.value.trim().toLowerCase() || '',
        category: categoryInput?.value.trim() || 'productivity',
        version: versionInput?.value.trim() || '1.0.0',
        tagline: taglineInput?.value.trim() || '',
        githubUrl: githubInput?.value.trim() || '',
        downloadUrl: downloadInput?.value.trim() || null,
        supportEmail: emailInput?.value.trim() || '',
        developerWebsite: websiteInput?.value.trim() || '',
        docsUrl: docsInput?.value.trim() || null,
      };

      if (tab1Status) {
        tab1Status.textContent = 'Saving to database...';
        tab1Status.className = 'text-xs text-blue-600 font-mono';
      }

      const originalSaveHtml = topSaveBtn ? topSaveBtn.innerHTML : '';
      if (topSaveBtn && !silent) {
        topSaveBtn.setAttribute('disabled', 'true');
        topSaveBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-white inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <span>Saving...</span>
        `;
      }

      try {
        const res = await fetch('/api/developers/extensions/save-basic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          if (data.error && data.error.includes('slug') && slugInput) {
            validateInput(slugInput, errSlug, false, data.error);
            slugInput.focus();
          }
          if (tab1Status) {
            tab1Status.textContent = `Error: ${data.error || 'Failed to save'}`;
            tab1Status.className = 'text-xs text-red-600 font-medium';
          }
          if (!silent) {
            alert(data.error || 'Failed to save extension to database.');
          }
          return false;
        }

        // Store returned ID and slug on the form
        if (data.id) {
          form?.setAttribute('data-extension-id', data.id);
          currentExtId = data.id;
        }
        if (data.slug) {
          form?.setAttribute('data-extension-slug', data.slug);
        }
        form?.setAttribute('data-is-edit', 'true');

        if (tab1Status) {
          tab1Status.textContent = '✓ Saved to ExtLabs database';
          tab1Status.className = 'text-xs text-emerald-600 font-mono';
        }

        if (!silent && topSaveBtn) {
          topSaveBtn.innerHTML = `<span>✓ Saved to Database!</span>`;
          setTimeout(() => {
            topSaveBtn.innerHTML = originalSaveHtml;
            topSaveBtn.removeAttribute('disabled');
          }, 2000);
        }

        // If newly created and manually saved, update location to the edit URL
        if (!currentIsEdit && !silent) {
          window.location.href = `/developers/manage/${data.slug}/edit?saved=true`;
        }

        return true;
      } catch (err: any) {
        console.error('Error saving to D1:', err);
        if (tab1Status) {
          tab1Status.textContent = 'Network error saving to database.';
          tab1Status.className = 'text-xs text-red-600 font-medium';
        }
        if (!silent) {
          alert('Network or database error while saving.');
        }
        return false;
      } finally {
        if (topSaveBtn && !silent && topSaveBtn.hasAttribute('disabled')) {
          topSaveBtn.removeAttribute('disabled');
          topSaveBtn.innerHTML = originalSaveHtml;
        }
      }
    }

