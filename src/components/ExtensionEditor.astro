    // 4. Overview Description & Markdown Toolbar
    function updateCharCount() {
      if (!descTextarea || !charCounter || !statusBadge) return;
      const len = descTextarea.value.length;
      charCounter.textContent = `${len.toLocaleString()} / 2,500 characters (Min: 100)`;

      if (len === 0) {
        charCounter.className = 'text-[11px] font-mono font-medium text-slate-500';
        statusBadge.textContent = 'Min 100 characters needed';
        statusBadge.className = 'font-medium text-amber-600';
      } else if (len < 100) {
        charCounter.className = 'text-[11px] font-mono font-medium text-amber-600';
        statusBadge.textContent = `Need ${100 - len} more chars`;
        statusBadge.className = 'font-medium text-amber-600';
      } else if (len > 2500) {
        charCounter.className = 'text-[11px] font-mono font-bold text-red-600';
        statusBadge.textContent = `Exceeded by ${len - 2500} chars`;
        statusBadge.className = 'font-bold text-red-600';
      } else {
        charCounter.className = 'text-[11px] font-mono font-medium text-emerald-600';
        statusBadge.textContent = '✓ Optimal length for SEO';
        statusBadge.className = 'font-medium text-emerald-600';
      }
    }

    descTextarea?.addEventListener('input', () => {
      updateCharCount();
      validateTab3(false);
    });
    updateCharCount();

    formatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!descTextarea) return;
        const action = btn.getAttribute('data-action');
        const start = descTextarea.selectionStart;
        const end = descTextarea.selectionEnd;
        const val = descTextarea.value;
        const selected = val.substring(start, end);

        let replacement = '';
        switch (action) {
          case 'bold':
            replacement = selected ? `**${selected}**` : `**bold text**`;
            break;
          case 'italic':
            replacement = selected ? `*${selected}*` : `*italic text*`;
            break;
          case 'bullet':
            replacement = selected ? `\n- ${selected}` : `\n- Bullet point item`;
            break;
          case 'numbered':
            replacement = selected ? `\n1. ${selected}` : `\n1. Numbered item`;
            break;
          case 'paragraph':
            replacement = `\n\n`;
            break;
          case 'quote':
            replacement = selected ? `\n> ${selected}` : `\n> Highlighted quote or feature note`;
            break;
          case 'code':
            replacement = selected ? `\`${selected}\`` : `\`code\``;
            break;
        }

        descTextarea.setRangeText(replacement, start, end, 'end');
        descTextarea.focus();
        updateCharCount();
        validateTab3(false);
      });
    });

