        tab4SaveBtn.setAttribute('disabled', 'true');
        tab4SaveBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-slate-700 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <span>Saving...</span>
        `;
      }
      if (publishBtn && publish) {
        publishBtn.setAttribute('disabled', 'true');
        publishBtn.innerHTML = `
          <svg class="animate-spin w-3.5 h-3.5 text-white inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <span>Publishing...</span>
        `;
      }

      try {
        const res = await fetch('/api/developers/extensions/save-specs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(specsPayload),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          if (tab4Status) {
            tab4Status.textContent = `Error: ${data.error || 'Failed to save specs'}`;
            tab4Status.className = 'text-xs text-red-600 font-medium';
          }
          if (!silent) {
            alert(data.error || 'Failed to save specifications to database.');
          }
          return false;
        }

        if (tab4Status) {
          tab4Status.textContent = publish ? '✓ Submitted to Directory' : '✓ Saved to ExtLabs database';
          tab4Status.className = 'text-xs text-emerald-600 font-mono';
        }

        if (publish) {
          alert(`🎉 Extension "${nameInput?.value || 'Untitled'}" has been published and submitted to ExtLabs Directory successfully!`);
          window.location.href = `/developers/manage/${currentSlug || currentExtId}?published=true`;
          return true;
        }

        if (!silent) {
          if (topSaveBtn) {
            topSaveBtn.innerHTML = `<span>✓ Saved to Database!</span>`;
            setTimeout(() => {
              topSaveBtn.innerHTML = originalSaveHtml;
              topSaveBtn.removeAttribute('disabled');
            }, 2000);
          }
          if (tab4SaveBtn) {
            tab4SaveBtn.innerHTML = `<span>✓ Saved to Database!</span>`;
            setTimeout(() => {
              tab4SaveBtn.innerHTML = originalTab4SaveHtml;
              tab4SaveBtn.removeAttribute('disabled');
            }, 2000);
          }
        }

        return true;
      } catch (err: any) {
        console.error('Error saving specs to D1:', err);
        if (tab4Status) {
          tab4Status.textContent = 'Network error saving specs to database.';
          tab4Status.className = 'text-xs text-red-600 font-medium';
        }
        if (!silent) {
          alert('Network or database error while saving specifications.');
        }
        return false;
      } finally {
        if (topSaveBtn && !silent && topSaveBtn.hasAttribute('disabled')) {
          topSaveBtn.removeAttribute('disabled');
          topSaveBtn.innerHTML = originalSaveHtml;
        }
        if (tab4SaveBtn && !silent && tab4SaveBtn.hasAttribute('disabled')) {
          tab4SaveBtn.removeAttribute('disabled');
          tab4SaveBtn.innerHTML = originalTab4SaveHtml;
        }
        if (publishBtn && publish && publishBtn.hasAttribute('disabled')) {
          publishBtn.removeAttribute('disabled');
          publishBtn.innerHTML = originalPublishHtml;
        }
      }
    }

    // Top Save Button triggers save for active tab
    topSaveBtn?.addEventListener('click', async () => {
      const activeTab = getCurrentActiveTab();
      if (activeTab === 4) {
        await saveSpecsToDb(false, false);
      } else if (activeTab === 3) {
        await saveStoryToDb(false);
      } else if (activeTab === 2) {
        await saveMediaToDb(false);
      } else {
        await saveBasicToDb(false);
      }
    });

    // Tab 1 footer save draft button
    tab1SaveBtn?.addEventListener('click', async () => {
      await saveBasicToDb(false);
    });

    // Tab 2 footer save draft button
    tab2SaveBtn?.addEventListener('click', async () => {
      await saveMediaToDb(false);
    });

    // Tab 3 footer save draft button
    tab3SaveBtn?.addEventListener('click', async () => {
      await saveStoryToDb(false);
    });

    // Tab 4 footer save draft button
    tab4SaveBtn?.addEventListener('click', async () => {
      await saveSpecsToDb(false, false);
    });

    // 1. Tab Switching Logic with Guard
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    const nextTabBtns = document.querySelectorAll('.next-tab-btn');
    const prevTabBtns = document.querySelectorAll('.prev-tab-btn');

    function getCurrentActiveTab(): number {
      const currentActivePane = document.querySelector('.tab-pane:not(.hidden)');
      return currentActivePane ? parseInt(currentActivePane.id.replace('tab-pane-', ''), 10) : 1;
    }

    function switchTab(targetIndex: number) {
      tabBtns.forEach((btn) => {
        const tabIdx = parseInt(btn.getAttribute('data-tab') || '1', 10);
        const dot = btn.querySelector('.tab-dot');
        if (tabIdx === targetIndex) {
          btn.className = 'tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-blue-600 text-blue-600';
          if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-blue-600 tab-dot';
        } else {
          btn.className = 'tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800';
          if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-transparent tab-dot';
        }
      });

      tabPanes.forEach((pane) => {
        const paneId = pane.id;
        if (paneId === `tab-pane-${targetIndex}`) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });

      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    async function trySwitchTab(targetIndex: number) {
      const currentIdx = getCurrentActiveTab();

      // Guard 1: Cannot leave Tab 1 forward to 2, 3, or 4 if mandatory fields are incomplete
      if (currentIdx === 1 && targetIndex > 1) {
        const isValid = validateTab1(true);
        if (!isValid) return; // Strictly block!
        // Save basic in background to persist progress
        const saved = await saveBasicToDb(true);
        if (!saved) return; // Stop if D1 save failed (e.g. duplicate slug)
      }

      // Guard 2: Cannot leave Tab 2 forward to 3 or 4 if visual media is incomplete
      if (currentIdx === 2 && targetIndex > 2) {
        const isValid = validateTab2(true);
        if (!isValid) return; // Strictly block!
        // Save visual media in background to persist progress
        const saved = await saveMediaToDb(true);
        if (!saved) return; // Stop if D1 media save failed
      }

      // Guard 3: Cannot leave Tab 3 forward to 4 if store story & SEO is incomplete
      if (currentIdx === 3 && targetIndex > 3) {
        const isValid = validateTab3(true);
        if (!isValid) return; // Strictly block!
        // Save store story in background to persist progress
        const saved = await saveStoryToDb(true);
        if (!saved) return; // Stop if D1 story save failed
      }

      // Guard 4: Attempting to jump from Tab 1 directly to 3 or 4 without Tab 2
      if (currentIdx === 1 && targetIndex > 2) {
        const isTab2Valid = validateTab2(true);
        if (!isTab2Valid) {
          switchTab(2);
          return;
        }
      }

      // Guard 5: Attempting to jump from Tab 1 or 2 directly to 4 without Tab 3
      if (currentIdx < 3 && targetIndex > 3) {
        const isTab3Valid = validateTab3(true);
        if (!isTab3Valid) {
          switchTab(3);
          return;
        }
      }

      switchTab(targetIndex);
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-tab') || '1', 10);
        trySwitchTab(idx);
      });
    });

    nextTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextIdx = parseInt(btn.getAttribute('data-next') || '1', 10);
        trySwitchTab(nextIdx);
      });
    });

    prevTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const prevIdx = parseInt(btn.getAttribute('data-prev') || '1', 10);
        switchTab(prevIdx);
      });
    });

    // 2. 🌟 MAGIC GITHUB AUTO-IMPORT ACTION (Unified Searchable Combobox)
    const comboboxWrapper = document.getElementById('magic-combobox-wrapper');
    const magicInput = document.getElementById('magic-github-input') as HTMLInputElement | null;
    const toggleBtn = document.getElementById('magic-combobox-toggle');
    const chevronIcon = document.getElementById('magic-chevron-icon');
    const dropdownMenu = document.getElementById('magic-dropdown-menu');
    const dropdownList = document.getElementById('magic-dropdown-list');
    const dropdownLoading = document.getElementById('magic-dropdown-loading');
    const magicBtn = document.getElementById('magic-import-btn') as HTMLButtonElement | null;
    const magicStatus = document.getElementById('magic-status-text');

    let userRepos: any[] = [];
    let connectedUsername = '';

    function openDropdown() {
      if (dropdownMenu) dropdownMenu.classList.remove('hidden');
      if (chevronIcon) chevronIcon.classList.add('rotate-180');
    }

    function closeDropdown() {
      if (dropdownMenu) dropdownMenu.classList.add('hidden');
      if (chevronIcon) chevronIcon.classList.remove('rotate-180');
    }

    function renderDropdown(reposToRender: any[]) {
      if (!dropdownList) return;

      if (reposToRender.length === 0) {
        dropdownList.innerHTML = `
          <div class="px-4 py-3 text-center text-xs text-slate-400">
            ${connectedUsername ? `No matching repositories found in @${connectedUsername}` : 'No repositories found.'}
          </div>
        `;
        return;
      }

      dropdownList.innerHTML = reposToRender
        .map(
          (r: any) => `
          <div class="magic-repo-item px-3.5 py-2.5 hover:bg-slate-50 cursor-pointer transition-colors" data-url="${r.url}">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-slate-800 font-mono flex items-center gap-1.5 truncate">
                <span class="text-blue-600 font-bold">${r.name}</span>
                ${r.isPrivate ? '<span class="text-[10px] text-slate-400">🔒</span>' : ''}
              </span>
              <span class="text-[10px] font-mono text-slate-400 shrink-0">@${connectedUsername || r.fullName.split('/')[0]}</span>
            </div>
            ${r.description ? `<p class="text-[11px] text-slate-500 truncate mt-0.5">${r.description}</p>` : ''}
          </div>
        `
        )
        .join('');

      // Add click handlers for each repository item
      dropdownList.querySelectorAll('.magic-repo-item').forEach((el) => {
        el.addEventListener('click', () => {
          const repoUrl = el.getAttribute('data-url');
          if (repoUrl && magicInput) {
            magicInput.value = repoUrl;
            magicInput.dispatchEvent(new Event('input'));
          }
          closeDropdown();
        });
      });
    }

    // Load developer's GitHub repositories asynchronously
    fetch('/api/developers/github/repos')
      .then((r) => r.json())
      .then((data) => {
        if (dropdownLoading) dropdownLoading.classList.add('hidden');
        if (data.success) {
          connectedUsername = (data.username || '').toLowerCase();
          userRepos = Array.isArray(data.repos) ? data.repos : [];
          renderDropdown(userRepos);
        } else if (dropdownList) {
          dropdownList.innerHTML = `<div class="px-4 py-3 text-center text-xs text-slate-400">Please connect your GitHub account to load repositories.</div>`;
        }
      })
      .catch(() => {
        if (dropdownLoading) dropdownLoading.classList.add('hidden');
        if (dropdownList) {
          dropdownList.innerHTML = `<div class="px-4 py-3 text-center text-xs text-slate-400">Could not load repositories.</div>`;
        }
      });

    // Toggle dropdown on button click
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (dropdownMenu?.classList.contains('hidden')) {
        renderDropdown(userRepos);
        openDropdown();
      } else {
        closeDropdown();
      }
    });

    // Open dropdown and filter when input is focused or typed
    magicInput?.addEventListener('focus', () => {
      if (userRepos.length > 0) {
        filterAndRender();
        openDropdown();
      }
    });

    magicInput?.addEventListener('input', () => {
      filterAndRender();
      openDropdown();
    });

    function filterAndRender() {
      const q = (magicInput?.value || '').trim().toLowerCase();
      if (!q) {
        renderDropdown(userRepos);
        return;
      }

      // If user typed a full URL, check ownership
      if (q.includes('github.com/')) {
        const parts = q.replace(/^https?:\/\/github\.com\//i, '').split('/');
        const owner = parts[0]?.toLowerCase();
        if (connectedUsername && owner && owner !== connectedUsername) {
          if (dropdownList) {
            dropdownList.innerHTML = `
              <div class="px-4 py-3 text-xs text-amber-700 bg-amber-50/70 border-b border-amber-100 font-medium">
                ⚠️ Account Restriction: You can only import repositories from your connected account (@${connectedUsername}).
              </div>
            `;
          }
          return;
        }
      }

      const cleanQuery = q.replace(/^https?:\/\/github\.com\//i, '').replace(/^[a-z0-9_-]+\//i, '');
      const filtered = userRepos.filter(
        (r) =>
          r.name.toLowerCase().includes(cleanQuery) ||
          r.fullName.toLowerCase().includes(cleanQuery) ||
          (r.description && r.description.toLowerCase().includes(cleanQuery))
      );

      renderDropdown(filtered);
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (comboboxWrapper && !comboboxWrapper.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Trigger Fetch & Auto-Fill from backend endpoint
    magicBtn?.addEventListener('click', async () => {
      const url = magicInput?.value.trim() || '';
      if (!url || !url.includes('github.com')) {
        alert('Please select or enter a valid GitHub repository URL (e.g. https://github.com/username/extension-repo)');
        magicInput?.focus();
        return;
      }

      // Security check: Only allow repositories belonging to the connected GitHub user
      const pathParts = url.replace(/^https?:\/\/github\.com\//i, '').replace(/^\/+/, '').split('/');
      const typedOwner = pathParts[0]?.toLowerCase();
      if (connectedUsername && typedOwner && typedOwner !== connectedUsername) {
        alert(`Access Denied: You can only import repositories belonging to your own connected GitHub account (@${connectedUsername}).`);
        magicInput?.focus();
        return;
      }

      // Visual feedback loading
      const originalText = magicBtn.innerHTML;
      magicBtn.innerHTML = `<span>Fetching...</span>`;
      magicBtn.disabled = true;

      if (magicStatus) {
        magicStatus.textContent = 'Syncing manifest & repository...';
        magicStatus.className = 'text-[11px] font-mono text-blue-600 font-medium hidden sm:block';
      }

      try {
        const res = await fetch('/api/developers/github/fetch-repo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ repoUrl: url }),
        });

        const json = await res.json();
        if (!json.success || !json.data) {
          throw new Error(json.error || 'Failed to fetch repository details.');
        }

        const d = json.data;

        // 1. Basic & Source (Tab 1)
        const nameInput = document.getElementById('ext-name-input') as HTMLInputElement | null;
        const slugInput = document.getElementById('ext-slug-input') as HTMLInputElement | null;
        const categoryInput = document.getElementById('ext-category-input') as HTMLSelectElement | null;
        const versionInput = document.getElementById('ext-version-input') as HTMLInputElement | null;
        const taglineInput = document.getElementById('ext-tagline-input') as HTMLInputElement | null;
        const githubInput = document.getElementById('ext-github-input') as HTMLInputElement | null;
        const downloadInput = document.getElementById('ext-download-input') as HTMLInputElement | null;
        const emailInput = document.getElementById('ext-support-email-input') as HTMLInputElement | null;
        const websiteInput = document.getElementById('ext-dev-website-input') as HTMLInputElement | null;
        const docsInput = document.getElementById('ext-docs-input') as HTMLInputElement | null;

        if (nameInput && d.name) {
          nameInput.value = d.name;
          nameInput.dispatchEvent(new Event('input'));
        }
        if (slugInput && d.slug) {
          slugInput.value = d.slug;
          slugInput.dispatchEvent(new Event('input'));
        }
        if (categoryInput && d.category) {
          categoryInput.value = d.category;
          categoryInput.dispatchEvent(new Event('change'));
        }
        if (versionInput && d.version) {
          versionInput.value = d.version;
          versionInput.dispatchEvent(new Event('input'));
        }
        if (taglineInput && d.tagline) {
          taglineInput.value = d.tagline;
          taglineInput.dispatchEvent(new Event('input'));
        }
        if (githubInput && d.githubUrl) {
          githubInput.value = d.githubUrl;
          githubInput.dispatchEvent(new Event('input'));
        }
        if (downloadInput && d.downloadUrl) {
          downloadInput.value = d.downloadUrl;
          downloadInput.dispatchEvent(new Event('input'));
        }
        if (emailInput && d.supportEmail && (!emailInput.value || emailInput.value.includes('@user.'))) {
          emailInput.value = d.supportEmail;
          emailInput.dispatchEvent(new Event('input'));
        }
        if (websiteInput && d.developerWebsite) {
          websiteInput.value = d.developerWebsite;
          websiteInput.dispatchEvent(new Event('input'));
        }
        if (docsInput && d.docsUrl) {
          docsInput.value = d.docsUrl;
          docsInput.dispatchEvent(new Event('input'));
        }

        // 2. Story & Overview (Tab 2)
        const descInput = document.getElementById('ext-desc-input') as HTMLTextAreaElement | null;
        if (descInput && d.description) {
          descInput.value = d.description;
          descInput.dispatchEvent(new Event('input'));
        }

        // Auto-fill Feature Highlights
        if (Array.isArray(d.features)) {
          const featCards = document.querySelectorAll('#features-list-container .feature-card');
          d.features.forEach((feat: any, idx: number) => {
            if (featCards[idx]) {
              const tIn = featCards[idx].querySelector('.feature-title-input') as HTMLInputElement | null;
              const dIn = featCards[idx].querySelector('.feature-desc-input') as HTMLInputElement | null;
              if (tIn && feat.title) {
                tIn.value = feat.title;
                tIn.dispatchEvent(new Event('input'));
              }
              if (dIn && feat.description) {
                dIn.value = feat.description;
                dIn.dispatchEvent(new Event('input'));
              }
            }
          });
        }

        // Auto-fill Workflow Stages
        if (Array.isArray(d.workflow)) {
          const wfCards = document.querySelectorAll('#workflow-list-container .workflow-card');
          d.workflow.forEach((wf: any, idx: number) => {
            if (wfCards[idx]) {
              const tIn = wfCards[idx].querySelector('.workflow-title-input') as HTMLInputElement | null;
              const dIn = wfCards[idx].querySelector('.workflow-desc-input') as HTMLInputElement | null;
              if (tIn && wf.title) {
                tIn.value = wf.title;
                tIn.dispatchEvent(new Event('input'));
              }
              if (dIn && wf.description) {
                dIn.value = wf.description;
                dIn.dispatchEvent(new Event('input'));
              }
            }
          });
        }

        // 3. Media & Icon (Tab 3)
        if (d.iconUrl) {
          const iconVal = document.getElementById('ext-icon-url-val') as HTMLInputElement | null;
          const iconPreviewImg = document.getElementById('ext-icon-preview-img') as HTMLImageElement | null;
          const iconPreviewPlaceholder = document.getElementById('ext-icon-placeholder');
          if (iconVal) iconVal.value = d.iconUrl;
          if (iconPreviewImg) {
            iconPreviewImg.src = d.iconUrl;
            iconPreviewImg.classList.remove('hidden');
          }
          if (iconPreviewPlaceholder) {
            iconPreviewPlaceholder.classList.add('hidden');
          }
        }

        // 4. Specs & Compliance (Tab 4)
        const manifestInput = document.getElementById('ext-manifest-input') as HTMLSelectElement | null;
        const licenseInput = document.getElementById('ext-license-input') as HTMLInputElement | null;
        const privacyInput = document.getElementById('ext-privacy-input') as HTMLInputElement | null;

        if (manifestInput && d.manifestVersion) {
          manifestInput.value = d.manifestVersion;
          manifestInput.dispatchEvent(new Event('change'));
        }
        if (licenseInput && d.license) {
          licenseInput.value = d.license;
          licenseInput.dispatchEvent(new Event('input'));
        }
        if (privacyInput && (!privacyInput.value || privacyInput.value.length < 5)) {
          privacyInput.value = `${d.githubUrl}#privacy`;
          privacyInput.dispatchEvent(new Event('input'));
        }

        // Auto-fill FAQs
        if (Array.isArray(d.faqs)) {
          const faqCards = document.querySelectorAll('#faqs-list-container .faq-card');
          d.faqs.forEach((faq: any, idx: number) => {
            if (faqCards[idx]) {
              const qIn = faqCards[idx].querySelector('.faq-q-input') as HTMLInputElement | null;
              const aIn = faqCards[idx].querySelector('.faq-a-input') as HTMLInputElement | null;
              if (qIn && faq.q) {
                qIn.value = faq.q;
                qIn.dispatchEvent(new Event('input'));
              }
              if (aIn && faq.a) {
                aIn.value = faq.a;
                aIn.dispatchEvent(new Event('input'));
              }
            }
          });
        }

        magicBtn.innerHTML = `<span>✓ Auto-Filled!</span>`;
        if (magicStatus) {
          const syncSource = d.hasManifest && d.hasReadme ? 'Manifest & README' : d.hasManifest ? 'Manifest V3' : 'GitHub Repository';
          magicStatus.textContent = `✓ Synced with ${syncSource}`;
          magicStatus.className = 'text-[11px] font-mono text-emerald-600 font-semibold hidden sm:block';
        }

        setTimeout(() => {
          magicBtn.innerHTML = originalText;
          magicBtn.disabled = false;
        }, 2500);
      } catch (err: any) {
        console.error('Magic auto-fill failed:', err);
        alert(`Auto-fill error: ${err.message || 'Could not fetch repository.'}`);
        magicBtn.innerHTML = originalText;
        magicBtn.disabled = false;
        if (magicStatus) {
          magicStatus.textContent = 'Sync failed. Check repository URL.';
          magicStatus.className = 'text-[11px] font-mono text-red-600 font-medium hidden sm:block';
        }
      }
    });

    // 3. Tagline & Name Counters
    const nameCounter = document.getElementById('name-char-counter');
    const taglineCounter = document.getElementById('tagline-char-counter');

    nameInput?.addEventListener('input', () => {
      if (nameCounter && nameInput) {
        nameCounter.textContent = `${nameInput.value.length} / 50`;
      }
    });

    taglineInput?.addEventListener('input', () => {
      if (taglineCounter && taglineInput) {
        taglineCounter.textContent = `${taglineInput.value.length} / 120`;
      }
    });

    // Support Center Email & Developer Website
    const emailBadge = document.getElementById('support-email-source-badge');
    const websiteBadge = document.getElementById('dev-website-source-badge');

    const savedSettings = localStorage.getItem('extlabs_dev_profile');
    const savedMonetag = localStorage.getItem('extlabs_default_monetag_url');

    if (savedSettings) {
      try {
        const profile = JSON.parse(savedSettings);
        if (emailInput && (!emailInput.value || emailInput.value === 'support@neurallabs.dev') && profile.email) {
          emailInput.value = profile.email;
        }
        if (websiteInput && (!websiteInput.value || websiteInput.value === 'https://neurallabs.dev') && profile.website) {
          websiteInput.value = profile.website;
        }
        if (monetagInput && (!monetagInput.value || (!isEditMode && monetagInput.value === 'https://monetag.com/direct/54829103')) && profile.defaultMonetagUrl) {
          monetagInput.value = profile.defaultMonetagUrl;
        }
        if (freqInput && profile.defaultFrequency && !isEditMode) {
          freqInput.value = profile.defaultFrequency;
        }
      } catch (e) {}
    }

    if (savedMonetag && monetagInput && (!monetagInput.value || (!isEditMode && monetagInput.value === 'https://monetag.com/direct/54829103'))) {
      monetagInput.value = savedMonetag;
    }

    // Auto-fill from authenticated developer profile if still unpopulated
    fetch('/api/auth/me')
      .then((res) => res.json())
      .then((data) => {
        if (data && data.authenticated && data.user) {
          if (websiteInput && (!websiteInput.value || websiteInput.value === 'https://neurallabs.dev')) {
            if (data.user.website) {
              websiteInput.value = data.user.website;
              syncSupportBadges();
            }
