        monetagUrl: (monetagInput?.value || '').trim(),
        frequency: freqInput?.value || '24h',
        manifestVersion: manifestInput?.value || 'v3',
        license: licenseInput?.value || 'MIT',
        supportedBrowsers,
        privacyPolicyUrl: (privacyInput?.value || '').trim(),
        publish,
      };

      if (tab4Status) {
