---
// src/components/ExtensionEditor.astro
import { 
  ArrowLeft, 
  Save, 
  Box, 
  Zap, 
  ExternalLink, 
  Globe, 
  FileText, 
  Sparkles, 
  ShieldCheck, 
  Image as ImageIcon,
  Check,
  Bold,
  Italic,
  List,
  ListOrdered,
  Code,
  Quote,
  WrapText,
  Plus,
  Trash2,
  Cpu,
  Layers,
  Scale,
  HelpCircle,
  CheckCircle2,
  Lock,
  Compass,
  Mail,
  UploadCloud,
  Upload,
  Video,
  Play,
  FileImage,
  AlertCircle,
  X,
  ArrowRight
} from '@lucide/astro';

export interface FeatureData {
  title: string;
  description: string;
}

export interface WorkflowStageData {
  step?: number;
  title: string;
  description: string;
}

export interface ComparisonItem {
  feature: string;
  current: string;
  others: string;
}

export interface FAQItem {
  q: string;
  a: string;
}

interface ExtensionData {
  id?: string;
  name?: string;
  version?: string;
  category?: string;
  tagline?: string;
  description?: string;
  githubUrl?: string;
  downloadUrl?: string;
  docsUrl?: string;
  supportEmail?: string;
  developerWebsite?: string;
  monetagUrl?: string;
  frequency?: string;
  manifestVersion?: string;
  license?: string;
  supportedBrowsers?: string[];
  privacyPolicyUrl?: string;
  iconUrl?: string;
  promoTileUrl?: string;
  screenshots?: string[];
  youtubeVideoUrl?: string;
  screenshot1?: string;
  screenshot2?: string;
  features?: (FeatureData | string)[];
  workflow?: (WorkflowStageData | string)[];
  comparison?: ComparisonItem[];
  faqs?: FAQItem[];
  permissions?: string;
  status?: string;
}

interface Props {
  isEdit?: boolean;
  initialData?: ExtensionData;
}

const { isEdit = false, initialData = {} } = Astro.props;

// Normalize features into { title, description } format
const rawFeatures = initialData.features || [
  {
    title: "Instant 1-Click AI Summaries",
    description: "Extract concise bullet summaries and key takeaways from articles, PDFs, and docs in under 2 seconds."
  },
  {
    title: "YouTube Video Transcript Parsing",
    description: "Automatically extracts video timestamps and generates time-stamped TL;DR outlines without watching the entire video."
  },
  {
    title: "100% Client-Side Privacy",
    description: "Operates fully with local Manifest V3 background workers with zero user data logging and private API key support."
  }
];

const normalizedFeatures: FeatureData[] = rawFeatures.map((item) => {
  if (typeof item === 'string') {
    return {
      title: item.split(':')[0] || item,
      description: item.split(':')[1]?.trim() || item
    };
  }
  return item;
});

// Normalize workflow stages into { step, title, description } format
const rawWorkflow = initialData.workflow || [
  {
    step: 1,
    title: "Client-Side DOM Ingestion & Parsing",
    description: "The lightweight content script intercepts page text, strips boilerplate scripts and ads, and packages clean semantic text in memory."
  },
  {
    step: 2,
    title: "Privacy-Preserving Execution Pipeline",
    description: "Processes text through high-speed on-device models or private encrypted cloud endpoints without storing user telemetry."
  },
  {
    step: 3,
    title: "Structured Markdown Output Rendering",
    description: "Streams executive summaries, bullet points, and actionable takeaways directly into a clean non-intrusive floating sidebar."
  }
];

const normalizedWorkflow: WorkflowStageData[] = rawWorkflow.map((item, idx) => {
  if (typeof item === 'string') {
    return {
      step: idx + 1,
      title: item.split(':')[0] || item,
      description: item.split(':')[1]?.trim() || item
    };
  }
  return { ...item, step: idx + 1 };
});

// Normalize comparison matrix
const rawComparison: ComparisonItem[] = initialData.comparison || [
  {
    feature: "Privacy & Data Storage",
    current: "100% Client-side RAM execution, zero telemetry logging",
    others: "Third-party cloud storage with marketing trackers"
  },
  {
    feature: "Execution Latency",
    current: "Sub-2-second streaming summaries on any active webpage",
    others: "Slow 8-15 second external API roundtrips"
  },
  {
    feature: "Pricing & Access",
    current: "100% Free & Open Source without locked paywalls",
    others: "Freemium with strict daily request paywalls ($19/mo)"
  }
];

// Normalize FAQs (SEO Schema.org FAQPage)
const rawFaqs: FAQItem[] = initialData.faqs || [
  {
    q: "How does this extension protect my browsing privacy?",
    a: "All page text parsing and tokenization run entirely within your local browser memory using Manifest V3 background workers. No browsing history or prompt contents are ever logged or sent to third-party ad brokers."
  },
  {
    q: "Can I use my own OpenAI, Anthropic, or Gemini API keys?",
    a: "Yes. You can switch to Direct Custom Key Mode inside the settings popup, allowing unlimited high-speed summaries directly billed to your own private developer account."
  },
  {
    q: "Does this work on YouTube video transcripts and PDF files?",
    a: "Yes. The extension automatically detects embedded video captions and local PDF documents, extracting timestamped outlines and key takeaways in under two seconds."
  }
];

// Screenshots normalization
const initialScreenshots: string[] = initialData.screenshots || [
  initialData.screenshot1 || "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200&auto=format&fit=crop&q=80",
  initialData.screenshot2 || "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&auto=format&fit=crop&q=80"
].filter(Boolean);

const allAvailableBrowsers = [
  { id: "chrome", name: "Chrome", checkedByDefault: true },
  { id: "brave", name: "Brave", checkedByDefault: true },
  { id: "edge", name: "Edge", checkedByDefault: true },
  { id: "firefox", name: "Firefox", checkedByDefault: true },
  { id: "arc", name: "Arc", checkedByDefault: true },
  { id: "opera", name: "Opera", checkedByDefault: true },
  { id: "safari", name: "Safari", checkedByDefault: false }
];

const data = {
  id: initialData.id || "",
  name: initialData.name || "",
  version: initialData.version || "1.0.0",
  category: initialData.category || "AI & Machine Learning",
  tagline: initialData.tagline || "",
  description: initialData.description || "",
  githubUrl: initialData.githubUrl || (isEdit && initialData.id ? `https://github.com/neural-labs/${initialData.id}` : ""),
  downloadUrl: initialData.downloadUrl || "",
  docsUrl: initialData.docsUrl || "",
  supportEmail: initialData.supportEmail || "support@neurallabs.dev",
  developerWebsite: initialData.developerWebsite || "",
  monetagUrl: initialData.monetagUrl || (isEdit && initialData.id ? `https://monetag.com/direct/${initialData.id.replace(/-/g, '_')}_live_8912` : "https://monetag.com/direct/54829103"),
  frequency: initialData.frequency || "24h",
  manifestVersion: initialData.manifestVersion || "v3",
  license: initialData.license || "MIT",
  supportedBrowsers: initialData.supportedBrowsers || ["chrome", "brave", "edge", "firefox", "arc", "opera"],
  privacyPolicyUrl: initialData.privacyPolicyUrl || (isEdit && initialData.id ? `https://github.com/neural-labs/${initialData.id}/blob/main/PRIVACY.md` : ""),
  iconUrl: initialData.iconUrl || (isEdit ? "/icons/extension-placeholder.avif" : ""),
  promoTileUrl: initialData.promoTileUrl || (isEdit ? "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=600&auto=format&fit=crop&q=80" : ""),
  screenshots: isEdit ? initialScreenshots : [],
  youtubeVideoUrl: initialData.youtubeVideoUrl || (isEdit ? "https://www.youtube.com/watch?v=dQw4w9WgXcQ" : ""),
  features: normalizedFeatures,
  workflow: normalizedWorkflow,
  comparison: rawComparison,
  faqs: rawFaqs,
  permissions: initialData.permissions || "activeTab, storage",
  status: initialData.status || "Production"
};
---

<!-- Extension Editor Workspace -->
<div class="space-y-6">

  <!-- Top Page Header & Main Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
    <div class="space-y-1">
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {isEdit ? `Edit: ${data.name || 'Details'}` : "Submit New Extension"}
        </h1>
        <span class={`text-xs font-semibold ${isEdit ? 'text-blue-600' : 'text-emerald-600'}`}>
          • {isEdit ? "Active Listing" : "Quick Draft"}
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500">
        {isEdit 
          ? "Manage your extension metadata, media assets, and connected Monetag direct stream." 
          : "Publish a new browser extension in under 60 seconds with our Smart Auto-Import."
        }
      </p>
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href={isEdit && data.id ? `/developers/manage/${data.id}` : "/developers/dashboard"}
        class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium rounded-lg border border-slate-300 transition-colors cursor-pointer"
      >
        Cancel
      </a>

      <button
        type="button"
        id="top-save-btn"
        class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
      >
        <Save class="w-3.5 h-3.5 text-white" />
        <span>{isEdit ? "Save Changes" : "Publish Extension"}</span>
      </button>
    </div>
  </div>

  <!-- 🌟 1-CLICK MAGIC GITHUB AUTO-IMPORT BAR (Frictionless Onboarding) -->
  <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-2xl space-y-2.5 shadow-2xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <span class="text-xs font-bold text-slate-900 block">Magic Auto-Fill from GitHub</span>
        <span class="text-[11px] text-slate-500">Paste your repository URL to instantly populate 85% of your store listing from manifest.json & README.</span>
      </div>
      <span id="magic-status-text" class="text-[11px] font-mono text-blue-600 font-medium hidden sm:block">
        Instant Manifest & Repo Sync
      </span>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <div class="relative flex-1">
        <input
          id="magic-github-input"
          type="url"
          value={data.githubUrl || ""}
          placeholder="https://github.com/username/my-awesome-extension"
          class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:border-blue-400 focus:outline-none text-slate-900 font-mono shadow-2xs"
        />
      </div>

      <button
        type="button"
        id="magic-import-btn"
        class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl inline-flex items-center justify-center transition-colors cursor-pointer shrink-0 shadow-2xs"
      >
        <span>Fetch & Auto-Fill</span>
      </button>
    </div>
  </div>

  <!-- 📑 4-TAB MINIMALIST NAVIGATION HEADER -->
  <div class="border-b border-slate-200">
    <nav class="flex items-center space-x-1 sm:space-x-4 overflow-x-auto no-scrollbar" aria-label="Editor Tabs">
      
      <!-- Tab 1: Essentials -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-blue-600 text-blue-600"
        data-tab="1"
      >
        <Box class="w-4 h-4" />
        <span>1. Basic & Source</span>
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 tab-dot"></span>
      </button>

      <!-- Tab 2: Visual Media -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="2"
      >
        <ImageIcon class="w-4 h-4" />
        <span>2. Visual Media</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

      <!-- Tab 3: Store Story & SEO -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="3"
      >
        <FileText class="w-4 h-4" />
        <span>3. Store Story & SEO</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

      <!-- Tab 4: Monetization & Specs -->
      <button
        type="button"
        class="tab-btn py-3 px-3 text-xs font-semibold border-b-2 transition-colors cursor-pointer inline-flex items-center gap-2 shrink-0 border-transparent text-slate-500 hover:text-slate-800"
        data-tab="4"
      >
        <Zap class="w-4 h-4" />
        <span>4. Monetization & Specs</span>
        <span class="w-1.5 h-1.5 rounded-full bg-transparent tab-dot"></span>
      </button>

    </nav>
  </div>

  <!-- Extension Editor Form Body -->
  <form id="extension-editor-form">

    <!-- ========================================================================= -->
    <!-- TAB PANE 1: ESSENTIALS & SOURCE CODE -->
    <!-- ========================================================================= -->
    <div id="tab-pane-1" class="tab-pane space-y-8">
      
      <!-- General Identity Section -->
      <section class="space-y-5">
        <div class="space-y-0.5">
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">
            Extension Identity & Category
          </h2>
          <p class="text-xs text-slate-500">
            Basic naming, unique slug, and store categorization.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Name -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-name-input" class="block text-xs font-semibold text-slate-700">
                Extension Display Name <span class="text-red-500">*</span>
              </label>
              <span id="name-char-counter" class="text-[10px] font-mono text-slate-400">
                {data.name.length} / 50
              </span>
            </div>
            <input
              id="ext-name-input"
              type="text"
              required
              maxlength="50"
              value={data.name}
              placeholder="e.g. Deep Summarize AI"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-medium"
            />
          </div>

          <!-- Directory Slug -->
          <div class="space-y-1.5">
            <label for="ext-slug-input" class="block text-xs font-semibold text-slate-700">
              Directory URL Slug <span class="text-red-500">*</span>
            </label>
            <div class="flex items-center">
              <span class="px-3 py-2 text-xs bg-slate-50 border border-r-0 border-slate-200 rounded-l-lg text-slate-400 font-mono select-none">
                extlabs.io/extension/
              </span>
              <input
                id="ext-slug-input"
                type="text"
                required
                value={data.id}
                placeholder="deep-summarize-ai"
                class="flex-1 px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-r-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
              />
            </div>
          </div>

          <!-- Category -->
          <div class="space-y-1.5">
            <label for="ext-category-input" class="block text-xs font-semibold text-slate-700">
              Primary Store Category <span class="text-red-500">*</span>
            </label>
            <select
              id="ext-category-input"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-800 cursor-pointer"
            >
              <option value="AI & Machine Learning" selected={data.category.includes("AI")}>AI & Machine Learning</option>
              <option value="Developer Tools" selected={data.category.includes("Dev")}>Developer Tools</option>
              <option value="Productivity" selected={data.category.includes("Productivity")}>Productivity</option>
              <option value="Privacy & Security" selected={data.category.includes("Privacy")}>Privacy & Security</option>
              <option value="Workflow & Utilities" selected={data.category.includes("Utilities")}>Workflow & Utilities</option>
            </select>
          </div>

          <!-- Version -->
          <div class="space-y-1.5">
            <label for="ext-version-input" class="block text-xs font-semibold text-slate-700">
              Release Version <span class="text-red-500">*</span>
            </label>
            <input
              id="ext-version-input"
              type="text"
              required
              value={data.version}
              placeholder="e.g. 1.0.0"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Tagline -->
          <div class="sm:col-span-2 space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-tagline-input" class="block text-xs font-semibold text-slate-700">
                Catchy Tagline <span class="text-red-500">*</span>
              </label>
              <span id="tagline-char-counter" class="text-[10px] font-mono text-slate-400">
                {data.tagline.length} / 120
              </span>
            </div>
            <input
              id="ext-tagline-input"
              type="text"
              required
              maxlength="120"
              value={data.tagline}
              placeholder="e.g. Instant AI summaries for research papers, articles, and video transcripts."
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900"
            />
          </div>
        </div>
      </section>

      <hr class="border-slate-200" />

      <!-- Package & Support Section -->
      <section class="space-y-5">
        <div class="space-y-0.5">
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">
            Repository, Package Source & Support
          </h2>
          <p class="text-xs text-slate-500">
            Source repository, release package asset, and developer support channels.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- GitHub Repo -->
          <div class="space-y-1.5">
            <label for="ext-github-input" class="block text-xs font-semibold text-slate-700">
              GitHub Repository URL <span class="text-red-500">*</span>
            </label>
            <input
              id="ext-github-input"
              type="url"
              required
              value={data.githubUrl}
              placeholder="https://github.com/your-username/your-extension"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Direct ZIP Asset -->
          <div class="space-y-1.5">
            <label for="ext-download-input" class="block text-xs font-semibold text-slate-700">
              Direct Package (.zip / .crx) Release Asset
            </label>
            <input
              id="ext-download-input"
              type="url"
              value={data.downloadUrl}
              placeholder="https://github.com/your-username/repo/releases/latest/download/extension.zip"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Support Email -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-support-email-input" class="block text-xs font-semibold text-slate-700">
                Support Center Email <span class="text-red-500">*</span>
              </label>
              <span id="support-email-source-badge" class="text-[10px] font-mono text-blue-600 font-medium">
                Auto-filled from Settings
              </span>
            </div>
            <input
              id="ext-support-email-input"
              type="email"
              required
              value={data.supportEmail}
              placeholder="support@yourdomain.com"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Developer Website -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="ext-dev-website-input" class="block text-xs font-semibold text-slate-700">
                Developer / Studio Website <span class="text-red-500">*</span>
              </label>
              <span id="dev-website-source-badge" class="text-[10px] font-mono text-blue-600 font-medium">
                Auto-filled from Settings
              </span>
            </div>
            <input
              id="ext-dev-website-input"
              type="url"
              required
              value={data.developerWebsite}
              placeholder="https://github.com/..."
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>

          <!-- Docs URL -->
          <div class="sm:col-span-2 space-y-1.5">
            <label for="ext-docs-input" class="block text-xs font-semibold text-slate-700">
              Documentation / Product Homepage URL (Optional)
            </label>
            <input
              id="ext-docs-input"
              type="url"
              value={data.docsUrl}
              placeholder="https://neurallabs.dev/docs/deep-summarize"
              class="w-full px-3.5 py-2 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none text-slate-900 font-mono"
            />
          </div>
        </div>
      </section>

      <!-- Step Navigation Footer -->
      <div class="flex items-center justify-end pt-4 border-t border-slate-200">
        <button
          type="button"
          class="next-tab-btn px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg inline-flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
          data-next="2"
        >
          <span>Next: Visual Media</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </button>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB PANE 2: VISUAL MEDIA & SHOWCASE -->
    <!-- ========================================================================= -->
    <div id="tab-pane-2" class="tab-pane space-y-8 hidden">
      
      <div class="space-y-0.5">
        <h2 class="text-sm font-bold text-slate-900 tracking-tight">
          Visual Media & Store Assets
        </h2>
        <p class="text-xs text-slate-500">
          Upload your extension icon, promotional shelf banner, store screenshots, and link a YouTube demo.
        </p>
      </div>

      <!-- Icon & Promo Banner Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        
        <!-- Extension Icon / Logo (Required *) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-semibold text-slate-700">
              Extension Logo / Icon <span class="text-red-500">*</span>
            </label>
            <span class="text-[10px] font-mono text-slate-400">
              128x128 or 512x512
            </span>
          </div>

          <input
            type="file"
            id="ext-icon-file-input"
            accept="image/png,image/webp,image/svg+xml,image/jpeg"
            class="hidden"
          />
          <input type="hidden" id="ext-icon-url-val" value={data.iconUrl} />

          <div
            id="icon-upload-dropzone"
            class="border-2 border-dashed border-slate-200 hover:border-blue-400 rounded-xl p-4 transition-colors cursor-pointer bg-white group flex flex-col items-center justify-center text-center min-h-[140px] relative"
          >
            <div id="icon-empty-state" class={`flex flex-col items-center gap-2 ${data.iconUrl ? 'hidden' : ''}`}>
