    // 9.4 YouTube Video Preview Handler
    const youtubeInput = document.getElementById('ext-youtube-input') as HTMLInputElement | null;
    const youtubePreviewContainer = document.getElementById('youtube-preview-container');
    const youtubeIframe = document.getElementById('youtube-preview-iframe') as HTMLIFrameElement | null;
    const youtubeBadge = document.getElementById('youtube-video-id-badge');

    function extractYouTubeId(url: string): string | null {
      if (!url) return null;
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : null;
    }

    function syncYouTubePreview() {
      if (!youtubeInput || !youtubePreviewContainer || !youtubeIframe) return;
      const videoId = extractYouTubeId(youtubeInput.value.trim());

      if (videoId) {
        youtubeIframe.src = `https://www.youtube.com/embed/${videoId}`;
        if (youtubeBadge) youtubeBadge.textContent = `Video ID: ${videoId}`;
        youtubePreviewContainer.classList.remove('hidden');
      } else {
        youtubeIframe.src = '';
        youtubePreviewContainer.classList.add('hidden');
      }
    }

    youtubeInput?.addEventListener('input', syncYouTubePreview);
    syncYouTubePreview();

