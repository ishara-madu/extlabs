    function validateInput(
      input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null,
      errEl: HTMLElement | null,
      isValid: boolean,
      errMsg: string
    ): boolean {
      if (!input) return true;
      if (!isValid) {
        input.classList.add('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
        input.classList.remove('border-slate-200', 'focus:border-blue-400');
        if (errEl) {
          errEl.textContent = errMsg;
          errEl.classList.remove('hidden');
        }
        return false;
      } else {
        input.classList.remove('border-red-400', 'focus:border-red-500', 'bg-red-50/20');
        input.classList.add('border-slate-200', 'focus:border-blue-400');
        if (errEl) {
          errEl.textContent = '';
          errEl.classList.add('hidden');
        }
        return true;
      }
    }

