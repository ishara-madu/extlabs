            />
          </div>

          <div class="lg:col-span-4 space-y-1">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-semibold text-slate-700 inline-flex items-center gap-1.5">
                <span>Your Extension</span>
                <span class="text-emerald-600 font-semibold text-[11px]">✓ Advantage</span>
                <span class="text-red-500">*</span>
              </label>
              <span class="comp-current-count text-[10px] font-mono text-slate-400">0 / 100</span>
            </div>
            <input
              type="text"
              required
              maxlength="100"
              minlength="10"
              placeholder="e.g. Fully functional offline with local cache"
              class="comp-current-input w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none placeholder-slate-400"
            />
          </div>

          <div class="lg:col-span-4 space-y-1">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-semibold text-slate-700 inline-flex items-center gap-1.5">
                <span>Other Tools</span>
                <span class="text-slate-400 font-medium text-[11px]">✕ Alternative</span>
                <span class="text-red-500">*</span>
              </label>
              <span class="comp-others-count text-[10px] font-mono text-slate-400">0 / 100</span>
            </div>
            <input
              type="text"
              required
              maxlength="100"
              minlength="10"
              placeholder="e.g. Completely fails when network disconnects"
              class="comp-others-input w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none placeholder-slate-400"
            />
          </div>
        </div>
      `;

      comparisonContainer.appendChild(newCard);
      refreshComparisonUI();
      attachComparisonRemoveEvents();
      attachComparisonInputEvents();
      validateTab3(false);
    });

    attachComparisonRemoveEvents();
    attachComparisonInputEvents();
    refreshComparisonUI();

    // 8. Dynamic FAQs (Min 3, Max 6)
    function updateFaqCounters(card: Element) {
      const qInput = card.querySelector('.faq-q-input') as HTMLInputElement | null;
      const qCount = card.querySelector('.faq-q-count');
      const aInput = card.querySelector('.faq-a-input') as HTMLTextAreaElement | null;
      const aCount = card.querySelector('.faq-a-count');

      if (qInput && qCount) {
        qCount.textContent = `${qInput.value.length} / 100`;
        qCount.className = qInput.value.length >= 90 ? 'faq-q-count text-[10px] font-mono text-amber-600 font-semibold' : 'faq-q-count text-[10px] font-mono text-slate-400';
      }

      if (aInput && aCount) {
        aCount.textContent = `${aInput.value.length} / 300`;
        aCount.className = aInput.value.length >= 280 ? 'faq-a-count text-[10px] font-mono text-amber-600 font-semibold' : 'faq-a-count text-[10px] font-mono text-slate-400';
      }
    }

    function refreshFaqsUI() {
      if (!faqsContainer) return;
      const cards = faqsContainer.querySelectorAll('.faq-card');
      const count = cards.length;

      if (faqsBadge) {
        faqsBadge.textContent = `${count} / ${MAX_FAQS} Questions (Min: ${MIN_FAQS})`;
        faqsBadge.className = (count >= MIN_FAQS && count <= MAX_FAQS)
          ? 'text-xs font-mono font-medium text-emerald-600 self-start sm:self-auto'
          : 'text-xs font-mono font-medium text-amber-600 self-start sm:self-auto';
      }

      if (addFaqBtn) {
        addFaqBtn.classList.toggle('opacity-50', count >= MAX_FAQS);
        addFaqBtn.disabled = count >= MAX_FAQS;
      }

      cards.forEach((card, index) => {
        const numLabel = card.querySelector('.faq-index-num');
        const textLabel = card.querySelector('.faq-number-label');
        const removeBtn = card.querySelector('.remove-faq-btn') as HTMLButtonElement | null;

        if (numLabel) numLabel.textContent = `${index + 1}`;
        if (textLabel) textLabel.textContent = `FAQ #${index + 1}: Query & Answer`;

        if (removeBtn) {
          removeBtn.classList.toggle('opacity-30', count <= MIN_FAQS);
          removeBtn.disabled = count <= MIN_FAQS;
        }

        updateFaqCounters(card);
      });
    }

    function attachFaqInputEvents() {
      if (!faqsContainer) return;
      faqsContainer.querySelectorAll('.faq-card').forEach((card) => {
        const qInput = card.querySelector('.faq-q-input');
        const aInput = card.querySelector('.faq-a-input');

        qInput?.addEventListener('input', () => {
          updateFaqCounters(card);
          validateTab4(false);
        });
        aInput?.addEventListener('input', () => {
          updateFaqCounters(card);
          validateTab4(false);
        });
      });
    }

    function attachFaqRemoveEvents() {
      if (!faqsContainer) return;
      faqsContainer.querySelectorAll('.remove-faq-btn').forEach((btn) => {
        btn.replaceWith(btn.cloneNode(true));
      });

      faqsContainer.querySelectorAll('.remove-faq-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const cards = faqsContainer.querySelectorAll('.faq-card');
          if (cards.length > MIN_FAQS) {
            const card = (e.target as HTMLElement).closest('.faq-card');
            card?.remove();
            refreshFaqsUI();
            attachFaqRemoveEvents();
            attachFaqInputEvents();
            validateTab4(false);
          } else {
            alert(`A minimum of ${MIN_FAQS} FAQs is required for store SEO and Schema.org rich results.`);
          }
        });
      });
    }

    addFaqBtn?.addEventListener('click', () => {
      if (!faqsContainer) return;
      const currentCount = faqsContainer.querySelectorAll('.faq-card').length;
      if (currentCount >= MAX_FAQS) return;

      const nextNum = currentCount + 1;
      const newCard = document.createElement('div');
      newCard.className = 'faq-card p-4 bg-slate-50/80 rounded-xl border border-slate-200 space-y-3 shadow-2xs';
      newCard.setAttribute('data-index', `${currentCount}`);
      newCard.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-slate-900 text-white font-mono text-[10px] flex items-center justify-center font-bold faq-index-num">
              ${nextNum}
            </span>
            <span class="text-xs font-bold text-slate-900 faq-number-label">
              FAQ #${nextNum}: Query & Answer
            </span>
          </div>
          <button
            type="button"
            class="remove-faq-btn text-slate-400 hover:text-red-600 p-1 rounded hover:bg-red-50 transition-colors cursor-pointer"
            title="Remove FAQ"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
          </button>
        </div>

        <div class="space-y-3">
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-semibold text-slate-700">
                Question <span class="text-red-500">*</span>
              </label>
              <span class="faq-q-count text-[10px] font-mono text-slate-400">0 / 100</span>
            </div>
            <input
              type="text"
              required
              maxlength="100"
              minlength="10"
              placeholder="e.g. Does this extension store any user browsing data?"
              class="faq-q-input w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none font-medium placeholder-slate-400"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-semibold text-slate-700">
                Answer & Explanation <span class="text-red-500">*</span>
              </label>
              <span class="faq-a-count text-[10px] font-mono text-slate-400">0 / 300</span>
            </div>
            <textarea
              rows="2"
              required
              maxlength="300"
              minlength="20"
              placeholder="e.g. No, all processing occurs locally in memory with zero cloud telemetry or data retention."
              class="faq-a-input w-full px-3 py-1.5 text-xs bg-white border border-slate-200 rounded-lg focus:border-blue-400 focus:outline-none placeholder-slate-400 leading-relaxed font-normal"
            ></textarea>
          </div>
        </div>
      `;

      faqsContainer.appendChild(newCard);
      refreshFaqsUI();
      attachFaqRemoveEvents();
      attachFaqInputEvents();
      validateTab4(false);
    });

    attachFaqRemoveEvents();
    attachFaqInputEvents();
    refreshFaqsUI();

    // 9. Visual Media Direct File Uploads & Live Previews
    // 9.1 Extension Icon Upload
    iconDropzone?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#remove-icon-btn')) return;
      iconFileInput?.click();
    });

    iconDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      iconDropzone.classList.add('border-blue-500', 'bg-blue-50/20');
    });

    iconDropzone?.addEventListener('dragleave', () => {
      iconDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
    });

    iconDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      iconDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleIconFile(e.dataTransfer.files[0]);
      }
    });

    iconFileInput?.addEventListener('change', () => {
      if (iconFileInput.files && iconFileInput.files.length > 0) {
        handleIconFile(iconFileInput.files[0]);
      }
    });

    async function handleIconFile(file: File) {
      if (!file.type.startsWith('image/')) {
        alert('Please upload a valid image file (PNG, WebP, SVG, JPG).');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('Icon image file size must not exceed 5MB.');
        return;
      }

      const result = await compressImageFile(file, 256, 256, 0.9);
      if (!result) return;

      if (iconPreviewImg) iconPreviewImg.src = result;
      if (iconFileName) iconFileName.textContent = file.name;
      if (iconFileSize) iconFileSize.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      if (iconUrlVal) iconUrlVal.value = result;

      iconEmptyState?.classList.add('hidden');
      iconPreviewState?.classList.remove('hidden');
      validateTab2(false);
    }

    removeIconBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (iconFileInput) iconFileInput.value = '';
      if (iconUrlVal) iconUrlVal.value = '';
      if (iconPreviewImg) iconPreviewImg.src = '';
      iconPreviewState?.classList.add('hidden');
      iconEmptyState?.classList.remove('hidden');
      validateTab2(false);
    });

    // 9.2 Promo Banner Upload
    promoDropzone?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#remove-promo-btn')) return;
      promoFileInput?.click();
    });

    promoDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      promoDropzone.classList.add('border-blue-500', 'bg-blue-50/20');
    });

    promoDropzone?.addEventListener('dragleave', () => {
      promoDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
    });

    promoDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      promoDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handlePromoFile(e.dataTransfer.files[0]);
      }
    });

    promoFileInput?.addEventListener('change', () => {
      if (promoFileInput.files && promoFileInput.files.length > 0) {
        handlePromoFile(promoFileInput.files[0]);
      }
    });

    async function handlePromoFile(file: File) {
      if (!file.type.startsWith('image/')) {
        alert('Please upload a valid image file (PNG, WebP, JPG).');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('Promotional banner file size must not exceed 5MB.');
        return;
      }

      const result = await compressImageFile(file, 880, 560, 0.85);
      if (!result) return;

      if (promoPreviewImg) promoPreviewImg.src = result;
      if (promoFileName) promoFileName.textContent = file.name;
      if (promoFileSize) promoFileSize.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      if (promoUrlVal) promoUrlVal.value = result;

      promoEmptyState?.classList.add('hidden');
      promoPreviewState?.classList.remove('hidden');
      validateTab2(false);
    }

    removePromoBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (promoFileInput) promoFileInput.value = '';
      if (promoUrlVal) promoUrlVal.value = '';
      if (promoPreviewImg) promoPreviewImg.src = '';
      promoPreviewState?.classList.add('hidden');
      promoEmptyState?.classList.remove('hidden');
      validateTab2(false);
    });

    // 9.3 Store Screenshots Management
    function refreshScreenshotsUI() {
      if (!screenshotsContainer) return;
      const cards = screenshotsContainer.querySelectorAll('.screenshot-card');
      const count = cards.length;

      if (screenshotsBadge) {
        screenshotsBadge.textContent = `${count} / ${MAX_SCREENSHOTS} Screenshots (Min: ${MIN_SCREENSHOTS})`;
        screenshotsBadge.className = (count >= MIN_SCREENSHOTS && count <= MAX_SCREENSHOTS)
          ? 'text-xs font-mono font-medium text-emerald-600 self-start sm:self-auto'
          : 'text-xs font-mono font-medium text-amber-600 self-start sm:self-auto';
      }

      if (screenshotsDropzone) {
        screenshotsDropzone.classList.toggle('opacity-50', count >= MAX_SCREENSHOTS);
        screenshotsDropzone.classList.toggle('pointer-events-none', count >= MAX_SCREENSHOTS);
      }

      cards.forEach((card, index) => {
        const label = card.querySelector('.screenshot-number-label');
        if (label) label.textContent = `Screenshot #${index + 1}`;
      });
    }

    function attachScreenshotRemoveEvents() {
      if (!screenshotsContainer) return;
      screenshotsContainer.querySelectorAll('.remove-screenshot-btn').forEach((btn) => {
        btn.replaceWith(btn.cloneNode(true));
      });

      screenshotsContainer.querySelectorAll('.remove-screenshot-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const card = (e.target as HTMLElement).closest('.screenshot-card');
          card?.remove();
          refreshScreenshotsUI();
          attachScreenshotRemoveEvents();
          validateTab2(false);
        });
      });
    }

    screenshotsDropzone?.addEventListener('click', () => {
      screenshotsFileInput?.click();
    });

    screenshotsDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      screenshotsDropzone.classList.add('border-blue-500', 'bg-blue-50/20');
    });

    screenshotsDropzone?.addEventListener('dragleave', () => {
      screenshotsDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
    });

    screenshotsDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      screenshotsDropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleScreenshotFiles(e.dataTransfer.files);
      }
    });

    screenshotsFileInput?.addEventListener('change', () => {
      if (screenshotsFileInput.files && screenshotsFileInput.files.length > 0) {
        handleScreenshotFiles(screenshotsFileInput.files);
      }
    });

    async function handleScreenshotFiles(files: FileList) {
      if (!screenshotsContainer) return;
      
      for (const file of Array.from(files)) {
        const total = screenshotsContainer.querySelectorAll('.screenshot-card').length;
        if (total >= MAX_SCREENSHOTS) {
          alert(`You can upload a maximum of ${MAX_SCREENSHOTS} screenshots.`);
          break;
        }

        if (!file.type.startsWith('image/')) {
          alert(`File "${file.name}" is not a supported image.`);
          continue;
        }

        const result = await compressImageFile(file, 1280, 800, 0.85);
        if (!result) continue;

        const nextIndex = screenshotsContainer.querySelectorAll('.screenshot-card').length + 1;
        const card = document.createElement('div');
        card.className = 'screenshot-card p-3 bg-white rounded-xl border border-slate-200 space-y-2 shadow-2xs relative group';
        card.innerHTML = `
          <div class="relative aspect-video rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
            <img
              src="${result}"
              alt="Screenshot #${nextIndex}"
              class="w-full h-full object-cover screenshot-preview-img"
            />
            <button
              type="button"
              class="remove-screenshot-btn absolute top-2 right-2 p-1.5 bg-slate-900/80 hover:bg-red-600 text-white rounded-lg transition-colors cursor-pointer shadow-sm"
              title="Remove Screenshot"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
            </button>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-800 screenshot-number-label">
              Screenshot #${nextIndex}
            </span>
            <span class="text-[10px] font-mono text-slate-400">${(file.size / 1024).toFixed(1)} KB</span>
          </div>
        `;

        screenshotsContainer.appendChild(card);
        refreshScreenshotsUI();
        attachScreenshotRemoveEvents();
        validateTab2(false);
      }
    }

    attachScreenshotRemoveEvents();
    refreshScreenshotsUI();

    // 9.4 YouTube Video Preview Handler
    function syncYouTubePreview() {
      if (!youtubeInput || !youtubePreviewContainer || !youtubeIframe) return;
      const videoId = extractYouTubeId(youtubeInput.value.trim());

      if (videoId) {
        youtubeIframe.src = `https://www.youtube.com/embed/${videoId}`;
        if (youtubeBadge) youtubeBadge.textContent = `Video ID: ${videoId}`;
        youtubePreviewContainer.classList.remove('hidden');
      } else {
        youtubeIframe.src = '';
        youtubePreviewContainer.classList.add('hidden');
      }
    }

    youtubeInput?.addEventListener('input', () => {
      syncYouTubePreview();
      validateTab2(false);
    });
    syncYouTubePreview();

    // 10. Monetag Test Link Button
    testBtn?.addEventListener('click', () => {
      if (monetagInput && monetagInput.value) {
        window.open(monetagInput.value, '_blank');
      } else {
        alert('Please enter a Monetag direct link URL first.');
      }
    });

    // 11. Form Submit & Publish Action
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await saveSpecsToDb(false, true);
    });
  });
</script>
