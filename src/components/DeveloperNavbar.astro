---
// src/components/DeveloperNavbar.astro
import Logo from './Logo.astro';
import { 
  Bell, 
  HelpCircle, 
  LogOut, 
  ExternalLink, 
  ChevronDown, 
  ChevronUp, 
  Settings, 
  User, 
  ShieldCheck, 
  Zap, 
  Trash2,
  BellOff
} from '@lucide/astro';
import { getDb, getDeveloperNotifications, getUnreadNotificationCount, type DbNotification } from '../lib/db';
import { getSessionUser } from '../lib/auth';

const db = getDb();
let user = (Astro.locals as any)?.user;
if (!user && db) {
  try {
    user = await getSessionUser(db, Astro.request);
  } catch {}
}

let notifications: DbNotification[] = [];
let unreadCount = 0;

if (db) {
  try {
    notifications = await getDeveloperNotifications(db, {
      userId: user?.id,
      developerId: (user as any)?.developer_id,
      limit: 20
    });
    unreadCount = await getUnreadNotificationCount(db, {
      userId: user?.id,
      developerId: (user as any)?.developer_id
    });
  } catch (err) {
    console.error('Failed to load notifications in DeveloperNavbar:', err);
  }
}
---

<header class="sticky top-0 z-40 w-full bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-14 gap-6">
      
      <!-- Brand & Console Title -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <Logo class="w-7 h-7 shrink-0" />
          <span class="text-sm font-bold tracking-tight text-slate-900">ExtLabs</span>
        </a>
        
        <span class="text-slate-300 font-normal">/</span>
        
        <a href="/developers/dashboard" class="flex items-center gap-1.5 hover:text-blue-600 transition-colors">
          <span class="text-xs font-semibold text-slate-800">Developer Console</span>
        </a>
      </div>

      <!-- Right Action Items (Docs, Monetag, Notifications, Profile Dropdown) -->
      <div class="flex items-center gap-3 sm:gap-4">
        
        <!-- Documentation / Setup Guide Link -->
        <a
          href="/developers#how-it-works"
          target="_blank"
          class="hidden sm:inline-flex items-center gap-1 text-xs text-slate-500 hover:text-slate-900 transition-colors"
        >
          <HelpCircle class="w-3.5 h-3.5" />
          <span>Docs</span>
        </a>

        <!-- Monetag Dashboard Link (Green) -->
        <a
          href="https://monetag.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-xs text-emerald-600 hover:text-emerald-700 font-semibold transition-colors group"
        >
          <span>Monetag</span>
          <ExternalLink class="w-3 h-3 text-emerald-600 group-hover:text-emerald-700 transition-colors" />
        </a>

        <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>

        <!-- 1. GOOGLE PLAY CONSOLE STYLE NOTIFICATIONS DROPDOWN -->
        <div class="relative">
          <button
            type="button"
            id="notifications-toggle-btn"
            class="relative p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer"
            title="View notifications"
          >
            <Bell class="w-4 h-4" />
            <!-- Notification Alert Dot -->
            {unreadCount > 0 && (
              <span id="notification-alert-dot" class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-blue-600 ring-2 ring-white"></span>
            )}
          </button>

          <!-- Notification Dropdown Window -->
          <div
            id="notifications-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-88 sm:w-[440px] bg-white rounded-2xl border border-slate-200 shadow-2xl z-50 overflow-hidden"
          >
            <!-- Dropdown Header Bar -->
            <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between bg-white">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-900">Notifications</span>
                <span class="text-[10px] font-medium text-slate-400 uppercase tracking-wider">Developer Inbox</span>
              </div>
              <span id="notifications-count-badge" class={`text-[11px] font-medium text-slate-500 font-mono ${notifications.length === 0 ? 'hidden' : ''}`}>
                {notifications.length} total
              </span>
            </div>
            
            <!-- Notification Deleted Undo Banner (Hidden by default) -->
            <div id="notification-deleted-banner" class="hidden m-3 p-3 bg-[#f0f4f9] rounded-xl flex items-center justify-between text-xs text-slate-800">
              <span class="font-medium">Notification deleted</span>
              <button
                type="button"
                id="notification-undo-btn"
                class="text-blue-600 hover:text-blue-700 font-semibold hover:underline cursor-pointer"
              >
                Undo
              </button>
            </div>

            <!-- Notifications List Container -->
            <div class="p-3 space-y-3 max-h-[420px] overflow-y-auto" id="notifications-list">
              <!-- Empty State (Always in DOM, dynamically toggled if 0 notifications or all deleted) -->
              <div 
                id="notifications-empty-state" 
                class={`py-12 px-4 text-center space-y-2.5 ${notifications.length === 0 ? '' : 'hidden'}`}
              >
                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center mx-auto text-slate-400">
                  <BellOff class="w-5 h-5" />
                </div>
                <div class="space-y-1">
                  <p class="text-xs font-semibold text-slate-800">No notifications yet</p>
                  <p class="text-[11px] text-slate-500 max-w-[240px] mx-auto leading-relaxed">
                    You're all caught up! Updates about your extensions, review decisions, and moderation notices will appear here.
                  </p>
                </div>
              </div>

              <!-- Notification Items -->
              {notifications.map((notif, index) => {
                const isFirst = index === 0;
                const dateStr = new Date(notif.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                const isError = notif.type === 'error';
                const hasExtension = Boolean(notif.extension_id && notif.extension_icon_url);

                return (
                  <div
                    class={`notification-item rounded-2xl p-4 transition-colors space-y-3 cursor-pointer ${
                      isError 
                        ? 'bg-[#fff5f5] hover:bg-[#ffecec] ring-1 ring-rose-200/80' 
                        : 'bg-[#f0f4f9] hover:bg-[#e9eef6]'
                    }`}
                    data-id={notif.id}
                    data-expanded={isFirst ? "true" : "false"}
                  >
                    <!-- Top Header Row -->
                    <div class="flex items-center justify-between">
                      <!-- User / Sender / Extension Pill -->
                      <div class="inline-flex items-center gap-1.5 bg-white border border-slate-200/80 rounded-full pl-1 pr-2.5 py-0.5 text-xs text-slate-800 shadow-2xs">
                        {hasExtension ? (
                          <img
                            src={notif.extension_icon_url!}
                            alt={notif.extension_name || 'Extension'}
                            class="w-4.5 h-4.5 rounded-full object-cover shrink-0"
                          />
                          <span class="font-medium text-[11px] truncate max-w-[150px]">{notif.extension_name || notif.sender_name}</span>
                        ) : (
                          <img
                            src={notif.sender_avatar_url || "/icons/github-profile-placeholder.avif"}
                            alt={notif.sender_name}
                            class="w-4.5 h-4.5 rounded-full object-cover shrink-0"
                          />
                          <span class="font-medium text-[11px]">{notif.sender_name}</span>
                        )}
                      </div>

                      <!-- Status Tag & Date & Expand/Collapse Chevron -->
                      <div class="flex items-center gap-2 text-xs">
                        {isError && (
                          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-rose-600">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                            <span>Rejected</span>
                          </span>
                        )}
                        <span class={`font-normal text-[11px] ${isError ? 'text-rose-700/70' : 'text-slate-500'}`}>
                          {dateStr}
                        </span>
                        {isFirst ? (
                          <ChevronUp class={`w-3.5 h-3.5 notif-chevron ${isError ? 'text-rose-600' : 'text-slate-600'}`} />
                        ) : (
                          <ChevronDown class={`w-3.5 h-3.5 notif-chevron ${isError ? 'text-rose-600' : 'text-slate-600'}`} />
                        )}
                      </div>
                    </div>

                    <!-- Expanded Content Area -->
                    <div class={`notif-expanded-body space-y-2 ${isFirst ? '' : 'hidden'}`}>
                      <h4 class={`text-xs sm:text-[13px] font-semibold leading-snug ${
                        isError ? 'text-rose-950' : 'text-slate-900'
                      }`}>
                        {notif.title}
                      </h4>
                      
                      <p class={`text-xs leading-relaxed font-normal ${
                        isError ? 'text-rose-800' : 'text-slate-600'
                      }`}>
                        {notif.message}
                      </p>

                      <!-- Bottom Actions Row -->
                      <div class="flex items-center justify-between pt-1">
                        {notif.action_url ? (
                          <a
                            href={notif.action_url}
                            class={`text-xs font-semibold hover:underline inline-flex items-center ${
                              isError 
                                ? 'text-rose-600 hover:text-rose-700' 
                                : 'text-blue-600 hover:text-blue-700'
                            }`}
                          >
                            {notif.action_label || 'View details'}
                          </a>
                        ) : (
                          <span></span>
                        )}

                        <button
                          type="button"
                          class={`notif-delete-btn p-1 transition-colors cursor-pointer ${
                            isError 
                              ? 'text-rose-400 hover:text-rose-700' 
                              : 'text-slate-500 hover:text-slate-800'
                          }`}
                          title="Delete notification"
                          data-id={notif.id}
                        >
                          <Trash2 class="w-4 h-4" />
                        </button>
                      </div>
                    </div>

                    <!-- Collapsed Preview (Hidden when expanded) -->
                    <div class={`notif-collapsed-preview text-xs font-normal leading-snug ${isFirst ? 'hidden' : ''} ${
                      isError ? 'text-rose-900 font-medium' : 'text-slate-800'
                    }`}>
                      {notif.title}
                    </div>

                  </div>
                );
              })}
            </div>

          </div>
        </div>

        <!-- 2. PROFILE AVATAR & DROPDOWN (Avatar Only) -->
        <div class="relative">
          <button
            type="button"
            id="profile-toggle-btn"
            class="p-0.5 rounded-full hover:ring-2 hover:ring-slate-300 focus:outline-none transition-all cursor-pointer flex items-center justify-center shrink-0"
            title="Account & Settings"
          >
            <img
              id="dev-navbar-avatar"
              src="/icons/github-profile-placeholder.avif"
              alt="Developer Avatar"
              class="w-7.5 h-7.5 rounded-full border border-slate-200 object-cover"
            />
          </button>

          <!-- Profile Dropdown Menu -->
          <div
            id="profile-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl border border-slate-200 shadow-xl z-50 overflow-hidden"
          >
            <!-- User Info Header -->
            <div class="p-4 border-b border-slate-100 bg-slate-50/50 space-y-1">
              <div class="flex items-center gap-2.5">
                <img
                  id="dev-dropdown-avatar"
                  src="/icons/github-profile-placeholder.avif"
                  alt="Developer Avatar"
                  class="w-9 h-9 rounded-full border border-slate-200 object-cover"
                />
                <div class="space-y-0.5 overflow-hidden">
                  <span id="dev-dropdown-name" class="text-xs font-bold text-slate-900 block truncate">Ishara Madusanka</span>
                  <span id="dev-dropdown-handle" class="text-[11px] text-slate-500 font-mono block truncate">@ishara-madu</span>
                </div>
              </div>
              <div class="pt-1.5 flex items-center gap-1 text-[10px] text-blue-700 font-medium">
                <ShieldCheck class="w-3.5 h-3.5 text-blue-600" />
                <span>Verified Developer (GitHub OAuth)</span>
              </div>
            </div>

            <!-- Menu Navigation Links (Strictly requested items) -->
            <div class="p-1.5 space-y-0.5 text-xs text-slate-700">
              <a
                id="dev-dropdown-github-link"
                href="https://github.com/ishara-madu"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors"
              >
                <div class="flex items-center gap-2.5">
                  <User class="w-3.5 h-3.5 text-slate-500" />
                  <span>GitHub Profile</span>
                </div>
                <ExternalLink class="w-3 h-3 text-slate-400" />
              </a>

              <a
                href="https://monetag.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors"
              >
                <div class="flex items-center gap-2.5">
                  <img
                    src="/icons/monetag-icon.avif"
                    alt="Monetag"
                    class="w-4 h-4 object-contain"
                  />
                  <span>Monetag Publisher Hub</span>
                </div>
                <ExternalLink class="w-3 h-3 text-slate-400" />
              </a>

              <a
                href="/developers/settings"
                class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors"
              >
                <Settings class="w-3.5 h-3.5 text-slate-500" />
                <span>Settings</span>
              </a>
            </div>

            <!-- Sign Out Action -->
            <div class="p-1.5 border-t border-slate-100">
              <button
                type="button"
                id="dev-signout-menu-btn"
                class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer text-left"
              >
                <LogOut class="w-3.5 h-3.5 text-red-500" />
                <span>Logout</span>
              </button>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dropdown Controllers
    const notifBtn = document.getElementById('notifications-toggle-btn');
    const notifMenu = document.getElementById('notifications-dropdown-menu');
    const profileBtn = document.getElementById('profile-toggle-btn');
    const profileMenu = document.getElementById('profile-dropdown-menu');
    const signOutBtn = document.getElementById('dev-signout-menu-btn');
    const deletedBanner = document.getElementById('notification-deleted-banner');
    const undoBtn = document.getElementById('notification-undo-btn');
    
    let lastDeletedItem: HTMLElement | null = null;
    let pendingDeleteNotifId: string | null = null;
    let deleteTimeout: any = null;

    function updateEmptyState() {
      const emptyState = document.getElementById('notifications-empty-state');
      const countBadge = document.getElementById('notifications-count-badge');
      const notifItems = document.querySelectorAll('.notification-item');
      let visibleCount = 0;
      notifItems.forEach((it) => {
        if ((it as HTMLElement).style.display !== 'none') {
          visibleCount++;
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      if (countBadge) {
        if (visibleCount === 0) {
          countBadge.classList.add('hidden');
        } else {
          countBadge.textContent = `${visibleCount} total`;
          countBadge.classList.remove('hidden');
        }
      }
    }

    function finalizePendingDeletion() {
      if (deleteTimeout) {
        clearTimeout(deleteTimeout);
        deleteTimeout = null;
      }
      if (pendingDeleteNotifId) {
        const idToDelete = pendingDeleteNotifId;
        pendingDeleteNotifId = null;
        fetch('/api/developers/notifications/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', notificationId: idToDelete })
        }).catch(err => console.error('Failed to commit notification deletion:', err));
      }
      if (deletedBanner) {
        deletedBanner.classList.add('hidden');
      }
      lastDeletedItem = null;
      updateEmptyState();
    }

    // Toggle Notifications Dropdown
    if (notifBtn && notifMenu) {
      notifBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = notifMenu.classList.contains('hidden');

        if (willOpen) {
          // Opening: Ensure undo banner is NEVER shown from previous sessions
          finalizePendingDeletion();
          if (deletedBanner) deletedBanner.classList.add('hidden');

          // Remove alert dot and mark notifications as read in D1
          const alertDot = document.getElementById('notification-alert-dot');
          if (alertDot) {
            alertDot.remove();
            fetch('/api/developers/notifications/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'mark_all_read' })
            }).catch(err => console.error('Failed to mark all as read:', err));
          }

          updateEmptyState();
          notifMenu.classList.remove('hidden');
          if (profileMenu) profileMenu.classList.add('hidden');
        } else {
          // Closing: Commit any pending deletions and hide undo banner
          finalizePendingDeletion();
          notifMenu.classList.add('hidden');
        }
      });
    }

    // Toggle Profile Dropdown
    if (profileBtn && profileMenu) {
      profileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        finalizePendingDeletion();
        profileMenu.classList.toggle('hidden');
        if (notifMenu) notifMenu.classList.add('hidden');
      });
    }

    // Expand / Collapse Google Play Console Notification Items
    const notifItems = document.querySelectorAll('.notification-item');
    notifItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        // Prevent toggle if clicking delete button or links
        const target = e.target as HTMLElement;
        if (target.closest('.notif-delete-btn') || target.closest('a')) {
          return;
        }

        const expandedBody = item.querySelector('.notif-expanded-body');
        const collapsedPreview = item.querySelector('.notif-collapsed-preview');
        const chevron = item.querySelector('.notif-chevron');
        const isExpanded = item.getAttribute('data-expanded') === 'true';

        if (isExpanded) {
          // Collapse
          item.setAttribute('data-expanded', 'false');
          expandedBody?.classList.add('hidden');
          collapsedPreview?.classList.remove('hidden');
          if (chevron) {
            chevron.classList.add('rotate-180');
          }
        } else {
          // Expand
          item.setAttribute('data-expanded', 'true');
          expandedBody?.classList.remove('hidden');
          collapsedPreview?.classList.add('hidden');
          if (chevron) {
            chevron.classList.remove('rotate-180');
          }
        }
      });

      // Delete Button Handler (immediate undoable in UI, finalized on close or timeout)
      const delBtn = item.querySelector('.notif-delete-btn');
      if (delBtn) {
        delBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const notifId = item.getAttribute('data-id');

          // If another item was pending, finalize it first
          if (pendingDeleteNotifId && pendingDeleteNotifId !== notifId) {
            finalizePendingDeletion();
          }

          lastDeletedItem = item as HTMLElement;
          pendingDeleteNotifId = notifId;
          lastDeletedItem.style.display = 'none';
          updateEmptyState();

          if (deletedBanner) {
            deletedBanner.classList.remove('hidden');
          }

          if (deleteTimeout) clearTimeout(deleteTimeout);
          deleteTimeout = setTimeout(() => {
            finalizePendingDeletion();
          }, 6000);
        });
      }
    });

    // Undo Deleted Notification (Only available immediately in the same open session)
    if (undoBtn && deletedBanner) {
      undoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (deleteTimeout) {
          clearTimeout(deleteTimeout);
          deleteTimeout = null;
        }
        if (lastDeletedItem) {
          lastDeletedItem.style.display = '';
          lastDeletedItem = null;
        }
        pendingDeleteNotifId = null;
        deletedBanner.classList.add('hidden');
        updateEmptyState();
      });
    }

    // Close when clicking outside - automatically commit and clear undo
    document.addEventListener('click', () => {
      finalizePendingDeletion();
      if (notifMenu) notifMenu.classList.add('hidden');
      if (profileMenu) profileMenu.classList.add('hidden');
    });

    if (notifMenu) {
      notifMenu.addEventListener('click', (e) => e.stopPropagation());
    }

    if (profileMenu) {
      profileMenu.addEventListener('click', (e) => e.stopPropagation());
    }

    // Sign Out Handler calling /api/auth/logout
    if (signOutBtn) {
      signOutBtn.addEventListener('click', () => {
        localStorage.removeItem('extlabs_dev_session');
        window.location.href = '/api/auth/logout';
      });
    }

    // Dynamic GitHub Profile Hydration from /api/auth/me
    fetch('/api/auth/me')
      .then(res => res.json())
      .then(data => {
        if (data.authenticated && data.user) {
          const u = data.user;
          const navAvatar = document.getElementById('dev-navbar-avatar') as HTMLImageElement | null;
          const dropAvatar = document.getElementById('dev-dropdown-avatar') as HTMLImageElement | null;
          const dropName = document.getElementById('dev-dropdown-name');
          const dropHandle = document.getElementById('dev-dropdown-handle');
          const ghLink = document.getElementById('dev-dropdown-github-link') as HTMLAnchorElement | null;

          if (u.avatarUrl) {
            if (navAvatar) navAvatar.src = u.avatarUrl;
            if (dropAvatar) dropAvatar.src = u.avatarUrl;
          }
          if (u.name && dropName) dropName.textContent = u.name;
          if (u.username) {
            if (dropHandle) dropHandle.textContent = `@${u.username}`;
            if (ghLink) ghLink.href = `https://github.com/${u.username}`;
          }
        }
      })
      .catch(() => {});
  });
</script>
