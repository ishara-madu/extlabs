---
// src/components/DeveloperNavbar.astro
import { Box, Search, HelpCircle, LogOut, ExternalLink, Plus } from '@lucide/astro';
---

<header class="sticky top-0 z-40 w-full bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-14 gap-6">
      
      <!-- Brand & Console Title -->
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center shadow-2xs">
            <Box class="w-3.5 h-3.5 text-white" />
          </div>
          <span class="text-sm font-bold tracking-tight text-slate-900">ExtLabs</span>
        </a>
        
        <span class="text-slate-300">/</span>
        
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-semibold text-slate-800">Developer Console</span>
        </div>
      </div>

      <!-- Quick Search inside Console -->
      <div class="flex-1 max-w-sm hidden md:block">
        <div class="relative">
          <Search class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" />
          <input
            id="console-search-input"
            type="text"
            placeholder="Search all extensions & releases..."
            class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 hover:bg-slate-100/80 focus:bg-white text-slate-900 rounded-lg border border-slate-200 focus:border-slate-400 focus:outline-none placeholder-slate-400"
          />
        </div>
      </div>

      <!-- Right Profile & Console Actions -->
      <div class="flex items-center gap-4">
        
        <!-- Documentation / Setup Guide Link -->
        <a
          href="/developers#how-it-works"
          target="_blank"
          class="hidden sm:inline-flex items-center gap-1 text-xs text-slate-500 hover:text-slate-900 transition-colors"
        >
          <HelpCircle class="w-3.5 h-3.5" />
          <span>Docs</span>
        </a>

        <!-- Monetag Dashboard Link -->
        <a
          href="https://monetag.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-xs text-slate-600 hover:text-blue-600 font-medium transition-colors"
        >
          <span>Monetag</span>
          <ExternalLink class="w-3 h-3 text-slate-400" />
        </a>

        <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>

        <!-- Developer Account Profile & Sign Out -->
        <div class="flex items-center gap-2.5">
          <img
            src="https://avatars.githubusercontent.com/u/583231"
            alt="Developer Avatar"
            class="w-7 h-7 rounded-full border border-slate-200 object-cover"
          />
          <div class="hidden lg:flex flex-col text-left">
            <span class="text-xs font-semibold text-slate-900 leading-tight">NeuralLabs</span>
            <span class="text-[10px] text-slate-400 font-mono leading-none">@neural-labs</span>
          </div>

          <!-- Sign Out Button -->
          <button
            type="button"
            id="dev-signout-btn"
            class="ml-1 p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer"
            title="Sign out of Developer Console"
          >
            <LogOut class="w-3.5 h-3.5" />
          </button>
        </div>

      </div>

    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const signOutBtn = document.getElementById('dev-signout-btn');
    if (signOutBtn) {
      signOutBtn.addEventListener('click', () => {
        localStorage.removeItem('extlabs_dev_session');
        window.location.href = '/developers/login';
      });
    }
  });
</script>
