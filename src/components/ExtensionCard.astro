---
// ExtensionCard.astro
import type { Extension } from '../data/extensions';
import { Star } from '@lucide/astro';
import VerifiedBadge from './VerifiedBadge.astro';

interface Props {
  extension: Extension;
}

const { extension } = Astro.props;

const hasRating = extension.reviewCount > 0 && extension.rating > 0;
const isNew = (() => {
  const dateStr = extension.createdDate || extension.updatedDate;
  if (!dateStr) return true;
  const d = new Date(dateStr).getTime();
  if (isNaN(d)) return true;
  const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;
  return (Date.now() - d) < thirtyDaysMs;
})();
---

<a
  href={`/extension/${extension.id}`}
  class="extension-item group flex flex-col justify-between bg-white rounded-xl border border-slate-200/80 hover:border-slate-300 hover:shadow-xs cursor-pointer select-none overflow-hidden transition-all text-inherit no-underline"
  data-id={extension.id}
  data-category={extension.category}
  data-name={extension.name.toLowerCase()}
  data-description={extension.description.toLowerCase()}
  data-tags={extension.tags.join(' ').toLowerCase()}
>
  <!-- Top Visual Artwork Banner -->
  <div class="w-full aspect-[16/9] bg-slate-900 overflow-hidden relative border-b border-slate-100">
    <Fragment set:html={extension.bannerSvg} />
  </div>

  <!-- Card Body -->
  <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
    <div>
      <div class="flex items-center gap-1.5 mb-1">
        <img
          src={extension.iconUrl || "/icons/extension-placeholder.avif"}
          alt=""
          class="w-4 h-4 rounded object-contain shrink-0"
        />
        <h3 class="text-xs font-bold text-slate-800 group-hover:text-slate-900 truncate">
          {extension.name}
        </h3>
        {extension.isVerified && (
          <VerifiedBadge class="w-3.5 h-3.5 shrink-0 inline" />
        )}
      </div>

      <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
        {extension.tagline || extension.description}
      </p>
    </div>

    <!-- Bottom Details -->
    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
      <div class="flex items-center gap-1.5">
        {hasRating ? (
          <>
            <Star class="w-3 h-3 text-amber-500 fill-amber-500" />
            <span class="font-medium text-slate-700">{extension.rating.toFixed(1)}</span>
            {extension.userCount ? <span class="text-slate-300">•</span> : null}
          </>
        ) : (
          <>
            {isNew ? (
              <span class="text-[11px] font-semibold text-blue-600">New</span>
            ) : (
              <span class="text-[10px] font-mono text-slate-400">v{extension.version}</span>
            )}
            {extension.userCount ? <span class="text-slate-300">•</span> : null}
          </>
        )}
        {extension.userCount ? (
          <span>{extension.userCount}</span>
        ) : null}
      </div>

      <span class="text-[10px] text-slate-400">
        {extension.categoryLabel.split(' ')[0]}
      </span>
    </div>
  </div>
</a>
