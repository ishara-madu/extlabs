---
// FeaturedCard.astro
import type { Extension } from '../data/extensions';
import { Image } from 'astro:assets';
import { Star, ArrowRight } from '@lucide/astro';
import VerifiedBadge from './VerifiedBadge.astro';

interface Props {
  extension: Extension;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { 
  extension, 
  loading = 'lazy',
  fetchpriority = (loading === 'eager' ? 'high' : 'auto')
} = Astro.props;

const hasRating = extension.reviewCount > 0 && extension.rating > 0;
const isNew = (() => {
  const dateStr = extension.createdDate || extension.updatedDate;
  if (!dateStr) return true;
  const d = new Date(dateStr).getTime();
  if (isNaN(d)) return true;
  const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;
  return (Date.now() - d) < thirtyDaysMs;
})();
---

<a
  href={`/extension/${extension.id}`}
  class="extension-item group flex flex-col justify-between bg-white rounded-xl border border-slate-200/80 hover:border-slate-300 hover:shadow-xs cursor-pointer select-none overflow-hidden transition-all text-inherit no-underline"
  data-id={extension.id}
  data-category={extension.category}
  data-name={extension.name.toLowerCase()}
  data-description={extension.description.toLowerCase()}
  data-tags={extension.tags.join(' ').toLowerCase()}
>
  <!-- Top Visual Artwork Banner -->
  <div class="w-full aspect-[16/9] bg-slate-950 overflow-hidden relative border-b border-slate-100 flex items-center justify-center">
    {extension.headerImageUrl ? (
      <>
        <img
          src={extension.headerImageUrl}
          alt=""
          aria-hidden="true"
          fetchpriority={fetchpriority}
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover blur-md opacity-25 scale-110 select-none pointer-events-none"
        />
        <Image
          src={extension.headerImageUrl}
          alt={extension.name}
          width={640}
          height={360}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          class="relative z-10 w-full h-full object-contain"
        />
      </>
    ) : (
      <Fragment set:html={extension.bannerSvg} />
    )}
    {extension.badge && (
      <span class="absolute top-3 right-3 z-20 text-[10px] font-semibold text-slate-900 bg-white/95 px-2 py-0.5 rounded shadow-2xs">
        {extension.badge}
      </span>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
    <div>
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-black leading-snug flex items-center gap-2 truncate">
          <Image
            src={extension.iconUrl || "/icons/extension-placeholder.avif"}
            alt={extension.name}
            width={20}
            height={20}
            loading={loading}
            class="w-5 h-5 rounded object-contain shrink-0"
          />
          <span class="truncate">{extension.name}</span>
          {extension.isVerified && (
            <VerifiedBadge class="w-3.5 h-3.5 shrink-0 inline" />
          )}
        </h3>

        <span class="text-[10px] font-medium text-slate-500 shrink-0">
          {extension.categoryLabel.split(' ')[0]}
        </span>
      </div>

      <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
        {extension.tagline || extension.description}
      </p>
    </div>

    <!-- Bottom Details -->
    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <div class="flex items-center gap-2">
        {hasRating ? (
          <div class="flex items-center gap-1 font-semibold text-slate-800">
            <Star class="w-3.5 h-3.5 text-amber-500 fill-amber-500" />
            <span>{extension.rating.toFixed(1)}</span>
            {extension.userCount ? <span class="text-slate-300 font-normal ml-1">•</span> : null}
          </div>
        ) : (
          <div class="flex items-center gap-1.5">
            {isNew ? (
              <span class="text-xs font-semibold text-blue-600">New</span>
            ) : (
              <span class="text-[11px] font-mono text-slate-400">v{extension.version}</span>
            )}
            {extension.userCount ? <span class="text-slate-300 font-normal ml-1">•</span> : null}
          </div>
        )}
        {extension.userCount ? (
          <span>{extension.userCount}</span>
        ) : null}
      </div>

      <span class="text-xs font-medium text-blue-600 group-hover:text-blue-700 flex items-center gap-1 transition-colors">
        <span>View</span>
        <ArrowRight class="w-3 h-3 text-blue-600" />
      </span>
    </div>
  </div>
</a>
