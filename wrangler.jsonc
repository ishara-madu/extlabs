{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extlabs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "extlabs.store",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "fdef5b631e3a49e68b5fb9183414415d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "extlabs-db",
      "database_id": "d31a721e-13a0-48f6-88c6-5458b75b41b3"
    }
  ]
}
